  <!-- ===================== HERO ===================== -->
  <section id="hero" aria-label="Hero section">
    <div class="hero-aurora"></div>
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero-blob hero-blob-3"></div>
    <canvas id="particles-canvas" aria-hidden="true"></canvas>

    <div class="container position-relative" style="z-index:2;">
      <div class="hero-content-box reveal">
        <img src="/logo/hamd-full-light.png" alt="Huffaz Alumni Malik Deenar" class="hero-logo" />
        <div class="hero-badge">
          <i class="bi bi-star-fill" style="font-size:0.6rem"></i>
          Huffaz Alumni Malik Deenar · Parappalli Markaz
        </div>
        <h1 class="hero-title">
          Welcome to<br><span>HAMD Alumni Portal</span>
        </h1>
        <p class="hero-subtitle">
          Connecting graduates across the world, celebrating our heritage, and continuing the legacy of knowledge and Da'wa rooted in Parappalli Markaz.
        </p>
        <div class="hero-actions">
          <button class="btn-hero-primary" onclick="document.getElementById('about').scrollIntoView({behavior:'smooth'})">
            <i class="bi bi-compass"></i> Explore
          </button>
          <button class="btn-hero-outline" onclick="document.getElementById('donate').scrollIntoView({behavior:'smooth'})">
            <i class="bi bi-heart"></i> Donate
          </button>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator" aria-hidden="true">
      <div class="scroll-mouse"><div class="scroll-dot"></div></div>
      <span>Scroll</span>
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  <section id="about" class="section-pad">
    <div class="container">
      <div class="row align-items-center g-5">
        <!-- Left: Text -->
        <div class="col-lg-5 reveal-left">
          <div class="section-label"><i class="bi bi-info-circle"></i> About HAMD</div>
          <h2 class="section-title mb-4">
            A Legacy Built on<br><span class="gradient-text">Knowledge & Devotion</span>
          </h2>
          <p class="section-sub mb-4">
            Huffaz Alumni Malik Deenar (HAMD) is the alumni association of graduates from Parappalli Markaz — an institution that has shaped thousands of Huffaz who now serve communities across Kerala, India, and beyond.
          </p>
          <p style="font-size:0.9rem;color:var(--muted);line-height:1.8;margin-bottom:28px;">
            Our mission is to remain connected, support ongoing Da'wa efforts, uplift one another professionally and spiritually, and honour the teachings instilled in us during our years at the Markaz.
          </p>
          <div class="timeline">
            {{#each timeline}}
            <div class="timeline-item">
              <div class="timeline-year">{{this.year}}</div>
              <div class="timeline-title">{{this.title}}</div>
              <div class="timeline-desc">{{this.desc}}</div>
            </div>
            {{/each}}
          </div>
        </div>

        <!-- Right: Cards -->
        <div class="col-lg-7">
          <div class="row g-4">
            {{#each aboutCards}}
            <div class="col-sm-6 reveal">
              <div class="glass-card about-card">
                <div class="about-icon-wrap"><i class="bi {{this.icon}}"></i></div>
                <h4>{{this.title}}</h4>
                <p>{{this.text}}</p>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== STATISTICS ===================== -->
  <section id="stats" class="section-pad">
    <div class="stats-blob stats-blob-1"></div>
    <div class="stats-blob stats-blob-2"></div>
    <div class="container">
      <div class="text-center mb-5 dark-section reveal">
        <div class="section-label"><i class="bi bi-bar-chart"></i> By the Numbers</div>
        <h2 class="section-title">HAMD in Figures</h2>
      </div>
      <div class="row g-3 g-md-4 justify-content-center">
        {{#each stats}}
        <div class="col-6 col-md-4 col-lg-2dot4 reveal">
          <div class="glass-card-dark stat-card">
            <div class="stat-icon"><i class="bi {{this.icon}}"></i></div>
            <div class="stat-number" data-target="{{this.target}}" data-suffix="{{this.suffix}}">0</div>
            <div class="stat-label">{{this.label}}</div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    <style>
      .col-lg-2dot4 { flex: 0 0 auto; width: 20%; }
      @media (max-width: 991px) { .col-lg-2dot4 { width: auto; } }
    </style>
  </section>

  <!-- ===================== COMMITTEE ===================== -->
  <section id="committee" class="section-pad">
    <div class="container">
      <div class="text-center mb-5 reveal">
        <div class="section-label"><i class="bi bi-people-fill"></i> Leadership</div>
        <h2 class="section-title">Executive Committee</h2>
        <p class="section-sub mx-auto mt-3">Dedicated alumni serving the community through leadership, guidance, and vision.</p>
      </div>
      <div class="row g-4">
        {{#each committee}}
        <div class="col-sm-6 col-lg-4 reveal">
          <div class="glass-card committee-card">
            <div class="avatar-placeholder">{{this.initials}}</div>
            <div class="committee-role">{{this.role}}</div>
            <div class="committee-name">{{this.name}}</div>
            <div class="committee-place"><i class="bi bi-geo-alt" style="color:var(--blue-400)"></i> {{this.place}}</div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ===================== GALLERY ===================== -->
  <section id="gallery" class="section-pad">
    <div class="container">
      <div class="text-center mb-5 reveal">
        <div class="section-label"><i class="bi bi-images"></i> Gallery</div>
        <h2 class="section-title">Moments & Memories</h2>
        <p class="section-sub mx-auto mt-3">Glimpses from our gatherings, programmes, and milestones over the years.</p>
      </div>
      {{#if gallery.length}}
      <div class="gallery-grid reveal">
        {{#each gallery}}
        <div class="gallery-item" onclick="openGallery(this)" tabindex="0" role="button" aria-label="{{this.description}}">
          <img src="{{this.url}}" alt="{{this.description}}" loading="lazy" />
          <div class="gallery-overlay"><i class="bi bi-zoom-in"></i></div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="empty-note">No gallery images have been published yet.</p>
      {{/if}}
    </div>
  </section>

  <!-- Gallery Modal -->
  <div class="gallery-modal" id="gallery-modal" role="dialog" aria-modal="true" aria-label="Image viewer" onclick="closeGallery()">
    <button class="modal-close-btn" onclick="closeGallery()" aria-label="Close image viewer">
      <i class="bi bi-x"></i>
    </button>
    <img id="gallery-modal-img" src="" alt="Gallery full view" onclick="event.stopPropagation()" />
  </div>

  <!-- ===================== EVENTS ===================== -->
  <section id="events" class="section-pad">
    <div class="container">
      <div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-5">
        <div class="reveal">
          <div class="section-label"><i class="bi bi-calendar-event"></i> Upcoming</div>
          <h2 class="section-title">Latest Events</h2>
        </div>
        <div class="carousel-controls reveal">
          <button class="carousel-btn" id="events-prev" aria-label="Previous events"><i class="bi bi-chevron-left"></i></button>
          <button class="carousel-btn" id="events-next" aria-label="Next events"><i class="bi bi-chevron-right"></i></button>
        </div>
      </div>
      {{#if events.length}}
      <div class="events-carousel reveal">
        <div class="events-track" id="events-track">
          {{#each events}}
          <article class="event-card">
            <div class="event-img-wrap">
              <img src="{{this.imageUrl}}" alt="{{this.title}}" loading="lazy" />
              <div class="event-date-badge"><div class="day">{{this.day}}</div><div class="month">{{this.month}}</div></div>
            </div>
            <div class="event-body">
              <div class="event-tag">{{this.category}}</div>
              <div class="event-title">{{this.title}}</div>
              <div class="event-location"><i class="bi bi-geo-alt"></i> {{this.location}}</div>
              <a href="/users" class="btn-primary-hamd" style="font-size:0.82rem;padding:10px 22px;">
                <i class="bi bi-ticket"></i> Register
              </a>
            </div>
          </article>
          {{/each}}
        </div>
      </div>
      {{else}}
      <p class="empty-note">No events have been scheduled yet. Please check back soon.</p>
      {{/if}}
    </div>
  </section>

  <!-- ===================== NEWS ===================== -->
  <section id="news" class="section-pad" style="background:var(--light);">
    <div class="container">
      <div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-5">
        <div class="reveal">
          <div class="section-label"><i class="bi bi-newspaper"></i> Updates</div>
          <h2 class="section-title">Latest News</h2>
        </div>
        <a href="#" class="btn-outline-hamd reveal">View All <i class="bi bi-arrow-right"></i></a>
      </div>
      <div class="row g-4">
        {{#each news}}
        <div class="col-md-6 col-lg-4 reveal">
          <div class="news-card">
            <div class="news-img"><img src="{{this.image}}" alt="{{this.title}}" loading="lazy" /></div>
            <div class="news-body">
              <div class="news-category"><i class="bi bi-dot"></i> {{this.category}}</div>
              <h3 class="news-title">{{this.title}}</h3>
              <p class="news-desc">{{this.desc}}</p>
              <div class="news-meta">
                <span class="news-date"><i class="bi bi-clock"></i> {{this.date}}</span>
                <a href="#news" class="news-read">Read More <i class="bi bi-arrow-right"></i></a>
              </div>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ===================== DONATION ===================== -->
  <section id="donate" class="section-pad">
    <div class="donate-bg"></div>
    <div class="donate-blob donate-blob-1"></div>
    <div class="donate-blob donate-blob-2"></div>
    <div class="container position-relative" style="z-index:1;">
      <div class="glass-card-dark donate-card reveal">
        <div class="row align-items-center g-5">
          <div class="col-lg-7">
            <div class="section-label dark-section" style="display:inline-flex;background:rgba(96,165,250,0.12);border-color:rgba(96,165,250,0.25);color:var(--blue-200);">
              <i class="bi bi-heart-pulse"></i> Support HAMD
            </div>
            <h2 style="font-size:clamp(1.7rem,3.5vw,2.6rem);font-weight:800;color:#fff;margin-bottom:16px;line-height:1.2;">
              Your Donation Fuels<br><span style="background:linear-gradient(90deg,#93c5fd,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Knowledge & Service</span>
            </h2>
            <p style="color:rgba(255,255,255,0.6);line-height:1.75;margin-bottom:28px;">
              Every contribution helps us sustain Da'wa activities, fund scholarships for deserving students, organise community events, and maintain the programs that keep our alumni network strong and active.
            </p>
            <div class="donate-features">
              {{#each donate.features}}
              <div class="donate-feature"><i class="bi bi-check-circle-fill"></i> {{this}}</div>
              {{/each}}
            </div>
            <a href="#contact" class="btn-hero-primary" style="font-size:0.95rem;">
              <i class="bi bi-heart-fill"></i> Donate Now
            </a>
          </div>
          <div class="col-lg-5">
            <div class="donate-methods">
              <div class="donate-method">
                <div class="qr-placeholder">QR Code<br/>Coming Soon</div>
                <div class="method-title" style="margin-top:12px;">Scan & Pay</div>
                <div class="method-detail">UPI / GPay / PhonePe</div>
              </div>
              <div class="donate-method" style="display:flex;flex-direction:column;gap:12px;">
                <div>
                  <i class="bi bi-bank" style="font-size:1.4rem;color:var(--blue-300);"></i>
                  <div class="method-title">Bank Transfer</div>
                  <div class="method-detail">Account: {{donate.bank.account}}</div>
                  <div class="method-detail">A/C No: {{donate.bank.number}}</div>
                  <div class="method-detail">IFSC: {{donate.bank.ifsc}}</div>
                </div>
                <div style="border-top:1px solid rgba(255,255,255,0.1);padding-top:12px;">
                  <i class="bi bi-whatsapp" style="font-size:1.4rem;color:#25d366;"></i>
                  <div class="method-title" style="margin-top:4px;">WhatsApp</div>
                  <div class="method-detail">{{donate.whatsapp}}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TESTIMONIALS ===================== -->
  <section id="testimonials" class="section-pad-sm" style="background:var(--white);">
    <div class="container mb-5">
      <div class="text-center reveal">
        <div class="section-label"><i class="bi bi-chat-quote"></i> Alumni Voices</div>
        <h2 class="section-title">What Our Alumni Say</h2>
      </div>
    </div>
    <div class="testi-track-wrapper">
      <div class="testi-track" aria-label="Alumni testimonials carousel">
        {{#each testimonials}}
        <div class="glass-card testi-card">
          <div class="testi-stars">★★★★★</div>
          <p class="testi-text">"{{this.text}}"</p>
          <div class="testi-author"><div class="testi-avatar">{{this.initials}}</div><div><div class="testi-name">{{this.name}}</div><div class="testi-batch">{{this.batch}}</div></div></div>
        </div>
        {{/each}}
        <!-- duplicated for the seamless marquee loop -->
        {{#each testimonials}}
        <div class="glass-card testi-card">
          <div class="testi-stars">★★★★★</div>
          <p class="testi-text">"{{this.text}}"</p>
          <div class="testi-author"><div class="testi-avatar">{{this.initials}}</div><div><div class="testi-name">{{this.name}}</div><div class="testi-batch">{{this.batch}}</div></div></div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section id="contact" class="section-pad" style="background:var(--light);">
    <div class="container">
      <div class="text-center mb-5 reveal">
        <div class="section-label"><i class="bi bi-envelope"></i> Get in Touch</div>
        <h2 class="section-title">Contact Us</h2>
        <p class="section-sub mx-auto mt-3">Reach out for membership inquiries, event collaboration, or anything else on your mind.</p>
      </div>
      <div class="row g-5 align-items-start">
        <!-- Contact Info -->
        <div class="col-lg-5 reveal-left">
          <div class="glass-card" style="padding:36px;">
            <h3 style="font-size:1.15rem;font-weight:700;color:var(--navy);margin-bottom:28px;">Get in Touch</h3>
            <div class="contact-info-item">
              <div class="contact-info-icon"><i class="bi bi-geo-alt-fill"></i></div>
              <div>
                <div class="contact-info-label">Address</div>
                <div class="contact-info-value">{{{contact.address}}}</div>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon"><i class="bi bi-envelope-fill"></i></div>
              <div>
                <div class="contact-info-label">Email</div>
                <div class="contact-info-value">{{contact.email}}</div>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon"><i class="bi bi-telephone-fill"></i></div>
              <div>
                <div class="contact-info-label">Phone</div>
                <div class="contact-info-value">{{contact.phone}}</div>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon"><i class="bi bi-whatsapp"></i></div>
              <div>
                <div class="contact-info-label">WhatsApp</div>
                <div class="contact-info-value">{{contact.whatsapp}}</div>
              </div>
            </div>

            <div style="margin-top:20px;padding-top:20px;border-top:1px solid rgba(37,99,235,0.1);">
              <div class="contact-info-label" style="margin-bottom:12px;">Follow Us</div>
              <div class="social-links">
                <a href="#" class="social-link" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" class="social-link" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                <a href="#" class="social-link" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                <a href="#" class="social-link" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                <a href="#" class="social-link" aria-label="Twitter/X"><i class="bi bi-twitter-x"></i></a>
              </div>
            </div>

            <div class="map-placeholder" aria-label="Map location placeholder">
              <i class="bi bi-map"></i>
              <span>{{contact.mapLabel}}</span>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="col-lg-7 reveal-right">
          <div class="glass-card" style="padding:40px;">
            <h3 style="font-size:1.15rem;font-weight:700;color:var(--navy);margin-bottom:28px;">Send a Message</h3>
            <form id="contact-form" novalidate>
              <div class="row g-3">
                <div class="col-sm-6 form-group">
                  <label class="form-label-hamd" for="c-name">Full Name</label>
                  <input type="text" id="c-name" class="form-control-hamd" placeholder="Your full name" required autocomplete="name" />
                </div>
                <div class="col-sm-6 form-group">
                  <label class="form-label-hamd" for="c-email">Email Address</label>
                  <input type="email" id="c-email" class="form-control-hamd" placeholder="you@example.com" required autocomplete="email" />
                </div>
                <div class="col-sm-6 form-group">
                  <label class="form-label-hamd" for="c-phone">Phone Number</label>
                  <input type="tel" id="c-phone" class="form-control-hamd" placeholder="+91 00000 00000" autocomplete="tel" />
                </div>
                <div class="col-sm-6 form-group">
                  <label class="form-label-hamd" for="c-subject">Subject</label>
                  <input type="text" id="c-subject" class="form-control-hamd" placeholder="How can we help?" />
                </div>
                <div class="col-12 form-group">
                  <label class="form-label-hamd" for="c-message">Message</label>
                  <textarea id="c-message" class="form-control-hamd" placeholder="Write your message here..." required></textarea>
                </div>
                <div class="col-12">
                  <button type="submit" class="btn-primary-hamd w-100" style="justify-content:center;padding:14px;">
                    <i class="bi bi-send"></i> Send Message
                  </button>
                  <p id="form-feedback" style="font-size:0.82rem;margin-top:10px;text-align:center;min-height:20px;color:var(--blue-600);"></p>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

