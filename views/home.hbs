<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HAMD Alumni Portal – Huffaz Alumni Malik Deenar</title>
  <meta name="description" content="Official Alumni Management Portal of Huffaz Alumni Malik Deenar Parappalli Markaz. Connecting graduates, celebrating legacy, and serving the Ummah together." />
  <meta name="keywords" content="HAMD, Huffaz Alumni, Malik Deenar, Parappalli, Markaz, Alumni Portal, Islamic Institution" />
  <meta property="og:title" content="HAMD Alumni Portal" />
  <meta property="og:description" content="Official Alumni Management Portal of Huffaz Alumni Malik Deenar Parappalli Markaz." />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/logo/favicon.ico" />
  <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <style>
    /* ============================================================
       CSS CUSTOM PROPERTIES
    ============================================================ */
    :root {
      --blue-50:  #eff6ff;
      --blue-100: #dbeafe;
      --blue-200: #bfdbfe;
      --blue-400: #60a5fa;
      --blue-500: #3b82f6;
      --blue-600: #2563eb;
      --blue-700: #1d4ed8;
      --blue-800: #1e40af;
      --blue-900: #1e3a8a;
      --navy:     #0f172a;
      --navy-mid: #1e293b;
      --slate:    #334155;
      --muted:    #64748b;
      --light:    #f8fafc;
      --white:    #ffffff;

      --grad-primary: linear-gradient(135deg, #1d4ed8 0%, #2563eb 40%, #3b82f6 100%);
      --grad-hero:    linear-gradient(160deg, #0f172a 0%, #1e3a8a 50%, #1e40af 100%);
      --grad-aurora:  linear-gradient(120deg, #0f172a, #1e3a8a, #2563eb, #1e40af, #0f172a);

      --glass-bg:     rgba(255,255,255,0.07);
      --glass-border: rgba(255,255,255,0.13);
      --glass-shadow: 0 8px 32px rgba(0,0,0,0.25);

      --glass-light-bg:     rgba(255,255,255,0.65);
      --glass-light-border: rgba(255,255,255,0.85);
      --glass-light-shadow: 0 4px 24px rgba(37,99,235,0.10);

      --radius-sm: 12px;
      --radius:    20px;
      --radius-lg: 32px;
      --radius-xl: 48px;

      --transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
      --font: 'Outfit', sans-serif;
    }

    /* ============================================================
       RESET & BASE
    ============================================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font);
      background: var(--light);
      color: var(--navy);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    ::selection { background: var(--blue-200); color: var(--blue-900); }

    img { max-width: 100%; height: auto; }

    a { text-decoration: none; color: inherit; }

    /* ============================================================
       LOADING SCREEN
    ============================================================ */
    #loading-screen {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: var(--navy);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 28px;
      transition: opacity 0.6s ease, visibility 0.6s ease;
    }
    #loading-screen.hidden { opacity: 0; visibility: hidden; }
    #loading-screen img { width: 80px; animation: pulse-logo 1.4s ease-in-out infinite; }
    .loader-ring {
      width: 56px; height: 56px;
      border: 3px solid rgba(255,255,255,0.12);
      border-top-color: var(--blue-400);
      border-radius: 50%;
      animation: spin 0.9s linear infinite;
    }
    .loader-text {
      color: rgba(255,255,255,0.45);
      font-size: 0.78rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes pulse-logo {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.06); opacity: 0.8; }
    }

    /* ============================================================
       BACK TO TOP
    ============================================================ */
    #back-top {
      position: fixed;
      bottom: 32px; right: 32px;
      z-index: 800;
      width: 48px; height: 48px;
      border-radius: 50%;
      background: var(--grad-primary);
      color: #fff;
      border: none;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
      box-shadow: 0 4px 20px rgba(37,99,235,0.4);
      cursor: pointer;
      opacity: 0; visibility: hidden;
      transform: translateY(12px);
      transition: var(--transition);
    }
    #back-top.visible { opacity: 1; visibility: visible; transform: translateY(0); }
    #back-top:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(37,99,235,0.5); }

    /* ============================================================
       NAVBAR
    ============================================================ */
    #main-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 700;
      padding: 16px 0;
      transition: var(--transition);
    }
    #main-nav.scrolled {
      background: rgba(255,255,255,0.82);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid rgba(37,99,235,0.10);
      box-shadow: 0 2px 24px rgba(37,99,235,0.07);
      padding: 10px 0;
    }
    .nav-brand img { height: 36px; transition: var(--transition); }
    .nav-link-item {
      color: rgba(255,255,255,0.85);
      font-size: 0.88rem;
      font-weight: 500;
      padding: 6px 14px;
      border-radius: 8px;
      transition: var(--transition);
      letter-spacing: 0.01em;
    }
    #main-nav.scrolled .nav-link-item { color: var(--slate); }
    .nav-link-item:hover {
      color: var(--blue-500);
      background: rgba(37,99,235,0.08);
    }
    .nav-profile-btn {
      width: 38px; height: 38px;
      border-radius: 50%;
      background: var(--glass-bg);
      border: 1.5px solid var(--glass-border);
      backdrop-filter: blur(8px);
      color: #fff;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      transition: var(--transition);
      font-size: 1rem;
    }
    #main-nav.scrolled .nav-profile-btn {
      background: rgba(37,99,235,0.08);
      border-color: rgba(37,99,235,0.18);
      color: var(--blue-600);
    }
    .nav-profile-btn:hover { transform: scale(1.07); }
    .profile-dropdown {
      position: absolute;
      right: 0; top: calc(100% + 10px);
      min-width: 180px;
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(37,99,235,0.12);
      border-radius: var(--radius-sm);
      box-shadow: 0 12px 40px rgba(15,23,42,0.14);
      padding: 8px;
      display: none;
      z-index: 100;
    }
    .profile-dropdown.show { display: block; animation: dropdown-in 0.2s ease; }
    @keyframes dropdown-in {
      from { opacity: 0; transform: translateY(-6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .profile-dropdown a {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px;
      border-radius: 8px;
      color: var(--slate);
      font-size: 0.87rem;
      font-weight: 500;
      transition: var(--transition);
    }
    .profile-dropdown a:hover { background: var(--blue-50); color: var(--blue-700); }
    .nav-hamburger {
      background: none; border: none;
      color: #fff; font-size: 1.4rem; cursor: pointer;
      transition: var(--transition);
      display: none;
    }
    #main-nav.scrolled .nav-hamburger { color: var(--navy); }
    .mobile-nav {
      display: none;
      flex-direction: column;
      gap: 4px;
      padding: 16px 0 8px;
      border-top: 1px solid rgba(255,255,255,0.1);
      margin-top: 8px;
    }
    #main-nav.scrolled .mobile-nav { border-top-color: rgba(37,99,235,0.10); }
    .mobile-nav.open { display: flex; }
    .mobile-nav .nav-link-item { padding: 10px 16px; }

    @media (max-width: 991px) {
      .nav-hamburger { display: block; }
      .desktop-nav { display: none !important; }
    }

    /* ============================================================
       HERO
    ============================================================ */
    #hero {
      min-height: 100vh;
      position: relative;
      display: flex; align-items: center;
      overflow: hidden;
      background: var(--navy);
    }
    .hero-aurora {
      position: absolute; inset: 0;
      background: var(--grad-aurora);
      background-size: 400% 400%;
      animation: aurora-shift 18s ease infinite;
      opacity: 0.8;
    }
    @keyframes aurora-shift {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .hero-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.28;
      animation: blob-float 12s ease-in-out infinite;
      pointer-events: none;
    }
    .hero-blob-1 {
      width: 520px; height: 520px;
      background: radial-gradient(circle, #3b82f6, #1d4ed8);
      top: -120px; right: -80px;
      animation-delay: 0s;
    }
    .hero-blob-2 {
      width: 380px; height: 380px;
      background: radial-gradient(circle, #60a5fa, #2563eb);
      bottom: -60px; left: -80px;
      animation-delay: -4s;
    }
    .hero-blob-3 {
      width: 260px; height: 260px;
      background: radial-gradient(circle, #93c5fd, #3b82f6);
      top: 40%; left: 40%;
      animation-delay: -8s;
    }
    @keyframes blob-float {
      0%, 100% { transform: translateY(0) scale(1); }
      33%  { transform: translateY(-30px) scale(1.05); }
      66%  { transform: translateY(20px) scale(0.96); }
    }
    #particles-canvas {
      position: absolute; inset: 0;
      pointer-events: none;
      opacity: 0.45;
    }
    .hero-content-box {
      position: relative; z-index: 2;
      text-align: center;
      padding: 56px 48px;
      background: rgba(255,255,255,0.05);
      backdrop-filter: blur(32px);
      -webkit-backdrop-filter: blur(32px);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: var(--radius-xl);
      box-shadow: 0 32px 80px rgba(0,0,0,0.4);
      max-width: 720px; margin: 0 auto;
    }
    .hero-logo { height: 88px; margin-bottom: 32px; }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(96,165,250,0.15);
      border: 1px solid rgba(96,165,250,0.3);
      border-radius: 100px;
      padding: 6px 18px;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--blue-200);
      margin-bottom: 20px;
    }
    .hero-title {
      font-size: clamp(2rem, 5vw, 3.6rem);
      font-weight: 800;
      color: #fff;
      line-height: 1.12;
      margin-bottom: 18px;
      letter-spacing: -0.02em;
    }
    .hero-title span {
      background: linear-gradient(90deg, #93c5fd, #60a5fa, #bfdbfe);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-subtitle {
      font-size: clamp(0.95rem, 2vw, 1.15rem);
      color: rgba(255,255,255,0.62);
      line-height: 1.7;
      max-width: 520px; margin: 0 auto 36px;
    }
    .hero-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .btn-hero-primary {
      padding: 14px 36px;
      background: var(--grad-primary);
      color: #fff;
      border: none;
      border-radius: 100px;
      font-family: var(--font);
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 24px rgba(37,99,235,0.5);
      transition: var(--transition);
      position: relative; overflow: hidden;
    }
    .btn-hero-primary::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.18), transparent);
      opacity: 0;
      transition: var(--transition);
    }
    .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(37,99,235,0.6); }
    .btn-hero-primary:hover::after { opacity: 1; }
    .btn-hero-outline {
      padding: 14px 36px;
      background: rgba(255,255,255,0.08);
      color: #fff;
      border: 1.5px solid rgba(255,255,255,0.25);
      border-radius: 100px;
      font-family: var(--font);
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      backdrop-filter: blur(8px);
      transition: var(--transition);
    }
    .btn-hero-outline:hover { background: rgba(255,255,255,0.15); transform: translateY(-2px); }
    .scroll-indicator {
      position: absolute; bottom: 36px; left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      display: flex; flex-direction: column; align-items: center; gap: 8px;
    }
    .scroll-indicator span {
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.38);
    }
    .scroll-mouse {
      width: 24px; height: 38px;
      border: 1.5px solid rgba(255,255,255,0.3);
      border-radius: 100px;
      display: flex; justify-content: center;
      padding-top: 6px;
    }
    .scroll-dot {
      width: 4px; height: 8px;
      background: rgba(255,255,255,0.55);
      border-radius: 100px;
      animation: scroll-bounce 2s ease-in-out infinite;
    }
    @keyframes scroll-bounce {
      0%, 100% { transform: translateY(0); opacity: 1; }
      50% { transform: translateY(10px); opacity: 0.3; }
    }

    @media (max-width: 576px) {
      .hero-content-box { padding: 36px 24px; border-radius: var(--radius-lg); }
      .hero-logo { height: 64px; }
    }

    /* ============================================================
       SECTION HELPERS
    ============================================================ */
    .section-pad { padding: 100px 0; }
    .section-pad-sm { padding: 72px 0; }
    .section-label {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--blue-50);
      border: 1px solid var(--blue-100);
      border-radius: 100px;
      padding: 5px 16px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--blue-700);
      margin-bottom: 16px;
    }
    .section-title {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 800;
      color: var(--navy);
      line-height: 1.15;
      letter-spacing: -0.025em;
    }
    .section-sub {
      font-size: 1.02rem;
      color: var(--muted);
      line-height: 1.75;
      max-width: 540px;
    }
    .dark-section .section-title { color: #fff; }
    .dark-section .section-label {
      background: rgba(96,165,250,0.12);
      border-color: rgba(96,165,250,0.25);
      color: var(--blue-200);
    }
    .dark-section .section-sub { color: rgba(255,255,255,0.55); }

    /* Glass card light */
    .glass-card {
      background: var(--glass-light-bg);
      border: 1px solid var(--glass-light-border);
      border-radius: var(--radius);
      box-shadow: var(--glass-light-shadow);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      transition: var(--transition);
    }
    .glass-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 48px rgba(37,99,235,0.15);
    }
    /* Glass card dark */
    .glass-card-dark {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      box-shadow: var(--glass-shadow);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      transition: var(--transition);
    }
    .glass-card-dark:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    }

    /* Reveal animations */
    .reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.65s cubic-bezier(0.4,0,0.2,1), transform 0.65s cubic-bezier(0.4,0,0.2,1);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-left  { opacity: 0; transform: translateX(-32px); transition: opacity 0.65s ease, transform 0.65s ease; }
    .reveal-left.visible { opacity: 1; transform: translateX(0); }
    .reveal-right { opacity: 0; transform: translateX(32px);  transition: opacity 0.65s ease, transform 0.65s ease; }
    .reveal-right.visible { opacity: 1; transform: translateX(0); }
    .reveal-scale { opacity: 0; transform: scale(0.9); transition: opacity 0.55s ease, transform 0.55s ease; }
    .reveal-scale.visible { opacity: 1; transform: scale(1); }
    .delay-1 { transition-delay: 0.1s; }
    .delay-2 { transition-delay: 0.2s; }
    .delay-3 { transition-delay: 0.3s; }
    .delay-4 { transition-delay: 0.4s; }
    .delay-5 { transition-delay: 0.5s; }
    .delay-6 { transition-delay: 0.6s; }

    /* Buttons */
    .btn-primary-hamd {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 13px 30px;
      background: var(--grad-primary);
      color: #fff;
      border: none;
      border-radius: 100px;
      font-family: var(--font);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 18px rgba(37,99,235,0.35);
      transition: var(--transition);
    }
    .btn-primary-hamd:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(37,99,235,0.5); color: #fff; }
    .btn-outline-hamd {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 28px;
      background: transparent;
      color: var(--blue-600);
      border: 1.5px solid var(--blue-300);
      border-radius: 100px;
      font-family: var(--font);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
    }
    .btn-outline-hamd:hover {
      background: var(--blue-50); transform: translateY(-2px); color: var(--blue-700);
    }
    .btn-outline-white {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 28px;
      background: rgba(255,255,255,0.1);
      color: #fff;
      border: 1.5px solid rgba(255,255,255,0.25);
      border-radius: 100px;
      font-family: var(--font);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      backdrop-filter: blur(8px);
      transition: var(--transition);
    }
    .btn-outline-white:hover { background: rgba(255,255,255,0.2); transform: translateY(-2px); }

    /* ============================================================
       ABOUT SECTION
    ============================================================ */
    #about { background: var(--white); }
    .about-icon-wrap {
      width: 56px; height: 56px;
      border-radius: 16px;
      background: var(--blue-50);
      border: 1px solid var(--blue-100);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem;
      color: var(--blue-600);
      flex-shrink: 0;
      margin-bottom: 16px;
    }
    .about-card { padding: 32px; }
    .about-card h4 {
      font-size: 1.08rem; font-weight: 700;
      color: var(--navy); margin-bottom: 10px;
    }
    .about-card p { font-size: 0.91rem; color: var(--muted); line-height: 1.75; }
    .timeline {
      position: relative;
      padding-left: 28px;
    }
    .timeline::before {
      content: '';
      position: absolute;
      left: 6px; top: 8px; bottom: 8px;
      width: 2px;
      background: linear-gradient(to bottom, var(--blue-500), var(--blue-200));
      border-radius: 4px;
    }
    .timeline-item { position: relative; margin-bottom: 32px; }
    .timeline-item::before {
      content: '';
      position: absolute;
      left: -25px; top: 6px;
      width: 12px; height: 12px;
      background: var(--blue-500);
      border: 3px solid #fff;
      border-radius: 50%;
      box-shadow: 0 0 0 3px var(--blue-200);
    }
    .timeline-year {
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--blue-500); margin-bottom: 4px;
    }
    .timeline-title { font-size: 0.97rem; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
    .timeline-desc { font-size: 0.87rem; color: var(--muted); line-height: 1.65; }

    /* ============================================================
       STATISTICS
    ============================================================ */
    #stats {
      background: var(--navy);
      position: relative;
      overflow: hidden;
    }
    .stats-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.18;
      pointer-events: none;
    }
    .stats-blob-1 { width: 400px; height: 400px; background: var(--blue-600); top: -100px; right: -80px; }
    .stats-blob-2 { width: 320px; height: 320px; background: var(--blue-400); bottom: -80px; left: -60px; }
    .stat-card {
      padding: 36px 28px;
      text-align: center;
      position: relative; z-index: 1;
    }
    .stat-icon {
      font-size: 1.8rem;
      color: var(--blue-400);
      margin-bottom: 16px;
    }
    .stat-number {
      font-size: clamp(2.2rem, 4vw, 3.2rem);
      font-weight: 900;
      color: #fff;
      line-height: 1;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #fff, var(--blue-200));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .stat-label { font-size: 0.88rem; color: rgba(255,255,255,0.5); font-weight: 500; letter-spacing: 0.04em; }

    /* ============================================================
       COMMITTEE
    ============================================================ */
    #committee { background: var(--light); }
    .committee-card { padding: 32px 24px; text-align: center; }
    .committee-avatar {
      width: 88px; height: 88px;
      border-radius: 50%;
      object-fit: cover;
      margin: 0 auto 16px;
      border: 3px solid var(--blue-100);
      box-shadow: 0 4px 20px rgba(37,99,235,0.15);
    }
    .avatar-placeholder {
      width: 88px; height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blue-500), var(--blue-700));
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
      font-size: 1.8rem;
      color: #fff;
      font-weight: 700;
      box-shadow: 0 4px 20px rgba(37,99,235,0.3);
    }
    .committee-role {
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--blue-500); margin-bottom: 6px;
    }
    .committee-name { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
    .committee-place { font-size: 0.83rem; color: var(--muted); }

    /* ============================================================
       GALLERY
    ============================================================ */
    #gallery { background: var(--white); }
    .gallery-grid {
      columns: 3;
      column-gap: 16px;
    }
    @media (max-width: 768px) { .gallery-grid { columns: 2; } }
    @media (max-width: 480px) { .gallery-grid { columns: 1; } }
    .gallery-item {
      break-inside: avoid;
      margin-bottom: 16px;
      border-radius: var(--radius-sm);
      overflow: hidden;
      position: relative;
      cursor: pointer;
    }
    .gallery-item img {
      width: 100%; display: block;
      transition: transform 0.5s ease;
    }
    .gallery-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(30,58,138,0.7), rgba(37,99,235,0.6));
      opacity: 0;
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .gallery-overlay i { font-size: 2rem; color: #fff; }
    .gallery-item:hover img { transform: scale(1.07); }
    .gallery-item:hover .gallery-overlay { opacity: 1; }
    /* Gallery Modal */
    .gallery-modal {
      display: none;
      position: fixed; inset: 0;
      z-index: 2000;
      background: rgba(15,23,42,0.9);
      backdrop-filter: blur(16px);
      align-items: center; justify-content: center;
    }
    .gallery-modal.open { display: flex; }
    .gallery-modal img {
      max-width: 90vw; max-height: 85vh;
      border-radius: var(--radius-sm);
      box-shadow: 0 32px 80px rgba(0,0,0,0.5);
    }
    .modal-close-btn {
      position: absolute; top: 20px; right: 24px;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      color: #fff;
      width: 44px; height: 44px;
      border-radius: 50%;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .modal-close-btn:hover { background: rgba(255,255,255,0.2); }

    /* ============================================================
       EVENTS
    ============================================================ */
    #events { background: var(--light); }
    .events-carousel { overflow: hidden; }
    .events-track {
      display: flex;
      gap: 24px;
      transition: transform 0.5s cubic-bezier(0.4,0,0.2,1);
    }
    .event-card {
      min-width: 320px;
      max-width: 320px;
      flex-shrink: 0;
      border-radius: var(--radius);
      overflow: hidden;
      background: #fff;
      box-shadow: 0 4px 24px rgba(37,99,235,0.08);
      border: 1px solid rgba(37,99,235,0.07);
      transition: var(--transition);
    }
    .event-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(37,99,235,0.16); }
    .event-img-wrap {
      position: relative;
      height: 180px;
      overflow: hidden;
    }
    .event-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
    .event-card:hover .event-img-wrap img { transform: scale(1.06); }
    .event-date-badge {
      position: absolute; top: 12px; left: 12px;
      background: #fff;
      border-radius: 10px;
      padding: 6px 12px;
      text-align: center;
      box-shadow: 0 2px 12px rgba(0,0,0,0.12);
    }
    .event-date-badge .day { font-size: 1.3rem; font-weight: 800; color: var(--blue-700); line-height: 1; }
    .event-date-badge .month { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
    .event-body { padding: 20px; }
    .event-tag {
      display: inline-block;
      font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--blue-600);
      background: var(--blue-50);
      border-radius: 6px;
      padding: 3px 10px;
      margin-bottom: 8px;
    }
    .event-title { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 8px; }
    .event-location { font-size: 0.82rem; color: var(--muted); display: flex; align-items: center; gap: 5px; margin-bottom: 16px; }
    .carousel-controls { display: flex; gap: 10px; }
    .carousel-btn {
      width: 44px; height: 44px;
      border-radius: 50%;
      border: 1.5px solid var(--blue-200);
      background: #fff;
      color: var(--blue-600);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      font-size: 1rem;
      transition: var(--transition);
      box-shadow: 0 2px 10px rgba(37,99,235,0.1);
    }
    .carousel-btn:hover { background: var(--blue-600); color: #fff; border-color: var(--blue-600); }

    /* ============================================================
       NEWS
    ============================================================ */
    #news { background: var(--white); }
    .news-card {
      border-radius: var(--radius);
      overflow: hidden;
      background: #fff;
      border: 1px solid rgba(37,99,235,0.07);
      box-shadow: 0 4px 20px rgba(37,99,235,0.07);
      transition: var(--transition);
      height: 100%;
    }
    .news-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(37,99,235,0.14); }
    .news-img {
      height: 200px; overflow: hidden;
    }
    .news-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
    .news-card:hover .news-img img { transform: scale(1.06); }
    .news-body { padding: 24px; }
    .news-category {
      font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--blue-600); margin-bottom: 8px;
    }
    .news-title { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 10px; line-height: 1.45; }
    .news-desc { font-size: 0.87rem; color: var(--muted); line-height: 1.7; margin-bottom: 16px; }
    .news-meta { display: flex; align-items: center; gap: 10px; }
    .news-date { font-size: 0.78rem; color: var(--muted); }
    .news-read {
      font-size: 0.82rem; font-weight: 600;
      color: var(--blue-600);
      display: inline-flex; align-items: center; gap: 4px;
      margin-left: auto;
      transition: var(--transition);
    }
    .news-read:hover { color: var(--blue-800); gap: 8px; }

    /* ============================================================
       DONATION
    ============================================================ */
    #donate {
      background: var(--navy);
      position: relative;
      overflow: hidden;
    }
    .donate-bg {
      position: absolute; inset: 0;
      background: var(--grad-aurora);
      background-size: 300% 300%;
      animation: aurora-shift 20s ease infinite;
      opacity: 0.6;
    }
    .donate-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.2;
      pointer-events: none;
    }
    .donate-blob-1 { width: 500px; height: 500px; background: var(--blue-500); top: -150px; right: -100px; }
    .donate-blob-2 { width: 350px; height: 350px; background: var(--blue-300); bottom: -100px; left: -60px; }
    .donate-card {
      position: relative; z-index: 1;
      padding: 56px 48px;
      max-width: 820px; margin: 0 auto;
    }
    .donate-card h2 {
      font-size: clamp(1.7rem, 3.5vw, 2.6rem);
      font-weight: 800; color: #fff;
      margin-bottom: 16px; line-height: 1.2;
    }
    .donate-card p { color: rgba(255,255,255,0.6); line-height: 1.75; margin-bottom: 32px; }
    .donate-features { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 36px; }
    .donate-feature {
      display: flex; align-items: center; gap: 8px;
      font-size: 0.87rem; color: rgba(255,255,255,0.75);
    }
    .donate-feature i { color: var(--blue-400); font-size: 1rem; }
    .donate-methods {
      display: flex; gap: 16px; flex-wrap: wrap; margin-top: 28px;
    }
    .donate-method {
      flex: 1; min-width: 160px;
      padding: 20px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: var(--radius-sm);
      text-align: center;
    }
    .donate-method i { font-size: 1.6rem; color: var(--blue-300); margin-bottom: 8px; display: block; }
    .donate-method .method-title { font-size: 0.8rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
    .donate-method .method-detail { font-size: 0.74rem; color: rgba(255,255,255,0.45); }
    .qr-placeholder {
      width: 100px; height: 100px;
      background: rgba(255,255,255,0.1);
      border: 2px dashed rgba(255,255,255,0.25);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.65rem; color: rgba(255,255,255,0.35);
      text-align: center; padding: 8px;
      margin: 0 auto;
    }

    @media (max-width: 576px) { .donate-card { padding: 36px 24px; } }

    /* ============================================================
       TESTIMONIALS
    ============================================================ */
    #testimonials { background: var(--light); }
    .testi-track-wrapper { overflow: hidden; }
    .testi-track {
      display: flex;
      gap: 24px;
      animation: auto-slide 40s linear infinite;
      width: max-content;
    }
    .testi-track:hover { animation-play-state: paused; }
    @keyframes auto-slide {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .testi-card {
      min-width: 300px; max-width: 300px;
      padding: 28px;
      flex-shrink: 0;
    }
    .testi-stars { color: #f59e0b; font-size: 0.8rem; margin-bottom: 14px; }
    .testi-text {
      font-size: 0.9rem; color: var(--slate);
      line-height: 1.75; margin-bottom: 20px;
      font-style: italic;
    }
    .testi-author { display: flex; align-items: center; gap: 12px; }
    .testi-avatar {
      width: 42px; height: 42px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blue-500), var(--blue-700));
      display: flex; align-items: center; justify-content: center;
      font-size: 0.95rem; font-weight: 700; color: #fff; flex-shrink: 0;
    }
    .testi-name { font-size: 0.88rem; font-weight: 700; color: var(--navy); }
    .testi-batch { font-size: 0.75rem; color: var(--muted); }

    /* ============================================================
       CONTACT
    ============================================================ */
    #contact { background: var(--white); }
    .contact-info-item {
      display: flex; align-items: flex-start; gap: 16px; margin-bottom: 24px;
    }
    .contact-info-icon {
      width: 44px; height: 44px;
      border-radius: 12px;
      background: var(--blue-50);
      border: 1px solid var(--blue-100);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; color: var(--blue-600);
      flex-shrink: 0;
    }
    .contact-info-label { font-size: 0.73rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }
    .contact-info-value { font-size: 0.92rem; color: var(--navy); font-weight: 500; }
    .social-links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
    .social-link {
      width: 40px; height: 40px;
      border-radius: 50%;
      background: var(--blue-50);
      border: 1px solid var(--blue-100);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem; color: var(--blue-600);
      transition: var(--transition);
    }
    .social-link:hover { background: var(--blue-600); color: #fff; transform: translateY(-3px); }
    .map-placeholder {
      width: 100%; height: 240px;
      background: linear-gradient(135deg, var(--blue-50), var(--blue-100));
      border-radius: var(--radius-sm);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 10px;
      color: var(--blue-400); font-size: 2rem;
      border: 1px solid var(--blue-200);
      margin-top: 24px;
    }
    .map-placeholder span { font-size: 0.85rem; color: var(--muted); }
    .contact-form { }
    .form-group { margin-bottom: 18px; }
    .form-label-hamd {
      font-size: 0.8rem; font-weight: 600;
      color: var(--slate); margin-bottom: 6px;
      display: block; letter-spacing: 0.03em;
    }
    .form-control-hamd {
      width: 100%;
      padding: 12px 16px;
      background: var(--light);
      border: 1.5px solid #e2e8f0;
      border-radius: var(--radius-sm);
      font-family: var(--font);
      font-size: 0.9rem;
      color: var(--navy);
      outline: none;
      transition: var(--transition);
    }
    .form-control-hamd:focus {
      border-color: var(--blue-400);
      box-shadow: 0 0 0 3px rgba(96,165,250,0.18);
      background: #fff;
    }
    textarea.form-control-hamd { resize: vertical; min-height: 120px; }

    /* ============================================================
       FOOTER
    ============================================================ */
    #footer {
      background: var(--navy);
      color: rgba(255,255,255,0.6);
      position: relative;
      overflow: hidden;
    }
    .footer-top { padding: 72px 0 48px; }
    .footer-logo { height: 52px; margin-bottom: 16px; }
    .footer-tagline { font-size: 0.88rem; line-height: 1.7; max-width: 260px; margin-bottom: 24px; color: rgba(255,255,255,0.45); }
    .footer-social { display: flex; gap: 8px; }
    .footer-social-link {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem; color: rgba(255,255,255,0.5);
      transition: var(--transition);
    }
    .footer-social-link:hover { background: var(--blue-600); color: #fff; border-color: var(--blue-600); }
    .footer-heading {
      font-size: 0.75rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: rgba(255,255,255,0.35); margin-bottom: 20px;
    }
    .footer-links { list-style: none; }
    .footer-links li { margin-bottom: 10px; }
    .footer-links a {
      font-size: 0.87rem; color: rgba(255,255,255,0.5);
      transition: var(--transition);
      display: inline-flex; align-items: center; gap: 5px;
    }
    .footer-links a:hover { color: var(--blue-300); padding-left: 4px; }
    .footer-divider { border-color: rgba(255,255,255,0.08); margin: 0; }
    .footer-bottom {
      padding: 20px 0;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px;
    }
    .footer-bottom-text { font-size: 0.8rem; color: rgba(255,255,255,0.35); }
    .footer-bottom-links { display: flex; gap: 16px; }
    .footer-bottom-links a {
      font-size: 0.78rem; color: rgba(255,255,255,0.35);
      transition: var(--transition);
    }
    .footer-bottom-links a:hover { color: var(--blue-300); }

    /* ============================================================
       MISC UTILITIES
    ============================================================ */
    .gradient-text {
      background: var(--grad-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .divider-line {
      height: 1px; background: rgba(37,99,235,0.1);
      border: none; margin: 0;
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }

    /* ============================================================
       RESPONSIVE / DEVICE FIT  (desktop + tablet + phone)
    ============================================================ */
    html { -webkit-text-size-adjust: 100%; }
    body { overflow-x: hidden; }
    img, canvas, svg, video { max-width: 100%; }

    .container {
      width: 100%;
      padding-left: clamp(16px, 4vw, 32px);
      padding-right: clamp(16px, 4vw, 32px);
      padding-left: max(clamp(16px, 4vw, 32px), env(safe-area-inset-left));
      padding-right: max(clamp(16px, 4vw, 32px), env(safe-area-inset-right));
    }

    .empty-note {
      text-align: center;
      color: var(--muted);
      font-size: 0.92rem;
      padding: 40px 0;
      margin: 0;
    }

    /* ---- Navbar ---- */
    #main-nav { padding: clamp(10px, 2vw, 16px) 0; }
    #main-nav > .container > .d-flex { gap: 12px; min-width: 0; }
    .nav-brand { flex: 0 0 auto; display: inline-flex; align-items: center; }
    .nav-brand img { height: clamp(28px, 6vw, 40px); width: auto; }
    .desktop-nav { min-width: 0; flex-wrap: nowrap; }
    .nav-link-item { white-space: nowrap; font-size: clamp(0.78rem, 1.1vw, 0.88rem); padding: 6px clamp(8px, 1vw, 14px); }
    .nav-profile-btn { width: clamp(34px, 8vw, 38px); height: clamp(34px, 8vw, 38px); flex: 0 0 auto; }
    .mobile-nav { max-height: 70vh; overflow-y: auto; }
    .profile-dropdown { max-width: calc(100vw - 32px); }

    /* ---- Hero ---- */
    #hero { min-height: 100svh; padding: clamp(96px, 18vh, 140px) 0 clamp(72px, 12vh, 110px); }
    .hero-content-box { padding: clamp(28px, 5vw, 56px) clamp(20px, 4vw, 48px); max-width: min(720px, 100%); }
    .hero-logo { display: block; height: clamp(52px, 14vw, 88px); width: auto; margin: 0 auto clamp(18px, 4vw, 32px); }
    .hero-badge { font-size: clamp(0.62rem, 2.2vw, 0.78rem); padding: 6px clamp(12px, 3vw, 18px); line-height: 1.4; }
    .hero-subtitle { margin-bottom: clamp(22px, 5vw, 36px); }
    .hero-actions > * { flex: 1 1 auto; min-width: 150px; justify-content: center; }
    .btn-hero-primary, .btn-hero-outline { padding: 13px clamp(20px, 5vw, 36px); font-size: clamp(0.85rem, 2.4vw, 0.95rem); }

    /* ---- Sections ---- */
    #stats, #donate, #committee, #news, #testimonials, #contact, #footer { overflow-x: clip; }
    .section-pad { padding: clamp(56px, 9vw, 100px) 0; }
    .section-pad-sm { padding: clamp(44px, 7vw, 72px) 0; }

    /* ---- Stats ---- */
    .col-lg-2dot4 { min-width: 0; }
    .stat-card { padding: clamp(18px, 3vw, 28px) clamp(12px, 2vw, 20px); }
    .stat-number { font-size: clamp(1.5rem, 6vw, 2.4rem); }
    .stat-label { font-size: clamp(0.7rem, 2.4vw, 0.85rem); }

    /* ---- Gallery ---- */
    .gallery-grid { columns: 3; column-gap: clamp(10px, 2vw, 16px); }
    .gallery-item { margin-bottom: clamp(10px, 2vw, 16px); }
    @media (max-width: 991px) { .gallery-grid { columns: 2; } }
    @media (max-width: 520px) { .gallery-grid { columns: 1; } }

    /* ---- Events carousel: swipeable on touch screens ---- */
    .event-card { min-width: 300px; max-width: 320px; }
    @media (max-width: 767px) {
      .events-carousel { overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
      .events-carousel::-webkit-scrollbar { display: none; }
      .events-track { transform: none !important; gap: 16px; padding-bottom: 4px; }
      .event-card { min-width: min(84vw, 320px); max-width: min(84vw, 320px); scroll-snap-align: start; }
      .carousel-controls { display: none; }
    }

    /* ---- Testimonials ---- */
    .testi-card { min-width: min(88vw, 380px); max-width: min(88vw, 380px); }

    /* ---- Donate / contact / footer ---- */
    .donate-card { padding: clamp(24px, 5vw, 56px); }
    .qr-placeholder { max-width: 100%; }
    .footer-top { padding: clamp(48px, 8vw, 72px) 0 clamp(32px, 5vw, 48px); }
    .footer-logo { display: block; height: clamp(40px, 10vw, 52px); width: auto; }
    .footer-tagline { max-width: 100%; }
    .footer-bottom { justify-content: center; text-align: center; }
    @media (min-width: 768px) { .footer-bottom { justify-content: space-between; text-align: left; } }

    @media (max-width: 575.98px) {
      #back-top { right: 14px; bottom: 14px; }
      .section-title { font-size: clamp(1.5rem, 7vw, 2rem); }
      .glass-card { border-radius: var(--radius-sm); }
      .testi-card, .event-card { min-width: 86vw; max-width: 86vw; }
      .footer-bottom-links { justify-content: center; flex-wrap: wrap; }
    }
  </style>
</head>

<body>

  <!-- ===================== LOADING SCREEN ===================== -->
  <div id="loading-screen" role="status" aria-label="Loading HAMD Alumni Portal">
    <img src="/logo/hamd-icon.png" alt="HAMD Logo" />
    <div class="loader-ring"></div>
    <p class="loader-text">Loading Portal</p>
  </div>

  <!-- ===================== BACK TO TOP ===================== -->
  <button id="back-top" aria-label="Scroll to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
    <i class="bi bi-arrow-up"></i>
  </button>

  <!-- ===================== NAVBAR ===================== -->
  <nav id="main-nav" aria-label="Main navigation">
    <div class="container">
      <div class="d-flex align-items-center justify-content-between">
        <!-- Logo -->
        <a href="#hero" class="nav-brand" aria-label="HAMD Alumni Portal Home">
          <img src="/logo/hamd-navbar.png" alt="HAMD" />
        </a>

        <!-- Desktop Nav -->
        <div class="desktop-nav d-flex align-items-center gap-1">
          <a href="#hero"        class="nav-link-item">Home</a>
          <a href="#about"       class="nav-link-item">About</a>
