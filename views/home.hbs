              {{else}}
              <div class="event-img-fallback"><i class="bi bi-calendar-event"></i></div>
              {{/if}}
              <div class="event-date-badge"><div class="day">{{this.day}}</div><div class="month">{{this.month}}</div></div>
            </div>
            <div class="event-body">
              <span class="event-tag">{{this.category}}</span>
              <h3 class="event-title">{{this.title}}</h3>
              {{#if this.location}}
              <div class="event-location"><i class="bi bi-geo-alt"></i> {{this.location}}</div>
