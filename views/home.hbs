  <!-- Bootstrap 5 Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    /* ============================================================
       APPLICATION LOGIC & ANIMATION ENGINE
    ============================================================ */

    // 1. Loading Screen Handler
    // Block scroll/interaction while loading screen is visible
    document.documentElement.style.overflow = 'hidden';
    document.body.style.pointerEvents = 'none';

    function dismissLoader() {
      const loader = document.getElementById('loading-screen');
      if (!loader || loader.classList.contains('hidden')) return;
      loader.classList.add('hidden');
      // Reveal page body — content was hidden via visibility:hidden
      document.body.classList.add('page-ready');
      // Re-enable scroll and interaction
      document.documentElement.style.overflow = '';
      document.body.style.pointerEvents = '';
    }

    // Primary trigger: window 'load' fires after all resources (images, fonts, scripts)
    window.addEventListener('load', () => {
      // Small grace period for final paint
      setTimeout(dismissLoader, 500);
    });

    // Fallback safety net: dismiss after 5 s max regardless
    setTimeout(dismissLoader, 5000);

    // 2. Navbar & Indicator Mechanics
    const nav = document.getElementById('main-nav');
    const backTop = document.getElementById('back-top');
    const navLinks = document.querySelectorAll('.desktop-nav-wrap .nav-link-item');
    const indicator = document.getElementById('nav-indicator');

    function updateNavIndicator(activeEl) {
      if (!activeEl || !indicator) return;
      const rect = activeEl.getBoundingClientRect();
      const parentRect = activeEl.parentElement.getBoundingClientRect();
      indicator.style.left = `${rect.left - parentRect.left}px`;
      indicator.style.width = `${rect.width}px`;
      indicator.style.opacity = '1';
    }

    // Initialize indicator on active link
    const initialActive = document.querySelector('.desktop-nav-wrap .nav-link-item.active');
    if (initialActive) setTimeout(() => updateNavIndicator(initialActive), 100);

    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav.classList.add('scrolled');
        backTop.classList.add('visible');
      } else {
        nav.classList.remove('scrolled');
        backTop.classList.remove('visible');
      }
    }, { passive: true });

    // Active Section Tracking via Observer
    const sections = document.querySelectorAll('section[id]');
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach(link => {
            if (link.getAttribute('href') === `#${id}`) {
              navLinks.forEach(l => l.classList.remove('active'));
              link.classList.add('active');
              updateNavIndicator(link);
            }
          });
        }
      });
    }, { threshold: 0.35 });

    sections.forEach(s => sectionObserver.observe(s));

    // Profile Dropdown Toggle (single source of truth)
    const profileBtn = document.getElementById('profile-btn');
    const profileDropdown = document.getElementById('profile-dropdown');

    function closeProfileDropdown() {
      if (!profileDropdown || !profileBtn) return;
      profileDropdown.classList.remove('show');
      profileBtn.setAttribute('aria-expanded', 'false');
    }

    if (profileBtn && profileDropdown) {
      profileBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = profileDropdown.classList.toggle('show');
        profileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        // Never let both menus be open at once on mobile
        if (isOpen && typeof closeMobileNav === 'function') closeMobileNav();
      });

      // Keep clicks inside the menu from bubbling to the outside-close handler
      profileDropdown.addEventListener('click', (e) => e.stopPropagation());

      document.addEventListener('click', closeProfileDropdown);
      document.addEventListener('touchstart', function (e) {
        if (!profileBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
          closeProfileDropdown();
        }
      }, { passive: true });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeProfileDropdown();
      });

      window.addEventListener('scroll', () => {
        if (profileDropdown.classList.contains('show')) closeProfileDropdown();
      }, { passive: true });
    }

    // Mobile Navigation Toggle
    const hamburger = document.getElementById('hamburger');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const mobileNav = document.getElementById('mobile-nav');
    const mobileOverlay = document.getElementById('mobile-overlay');

    function toggleMobileNav() {
      const isOpen = mobileNav.classList.toggle('open');
      if (isOpen) closeProfileDropdown();
      mobileOverlay.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', isOpen);
      hamburgerIcon.className = isOpen ? 'bi bi-x-lg' : 'bi bi-list';
    }

    function closeMobileNav() {
      mobileNav.classList.remove('open');
      mobileOverlay.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburgerIcon.className = 'bi bi-list';
    }

    hamburger.addEventListener('click', toggleMobileNav);

    // 3. High-DPI Interactive Particle Canvas with Mouse Repel
    (function initParticles() {
      const canvas = document.getElementById('particles-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let particles = [];
      let mouse = { x: null, y: null, radius: 140 };
      // Cache last known good dimensions — used when hero is scrolled off-screen
      let lastW = 0, lastH = 0;
      let isHeroVisible = true;
      let rafId = null;

      const heroSection = document.getElementById('hero');

      // Watch hero visibility — re-init canvas when it becomes visible again
      // so the drawing dimensions are always correct
      const heroObserver = new IntersectionObserver((entries) => {
        const wasHidden = !isHeroVisible;
        isHeroVisible = entries[0].isIntersecting;
        if (isHeroVisible && wasHidden) {
          // Hero came back into view: re-sync canvas size and restart loop
          initCanvas();
        }
      }, { threshold: 0 });
      heroObserver.observe(heroSection);

      function initCanvas() {
        const dpr = window.devicePixelRatio || 1;
        // Use the hero section's dimensions as the authoritative source
        // (more reliable than canvas.offsetWidth when hero is partially off-screen)
        const w = heroSection.offsetWidth  || lastW || window.innerWidth;
        const h = heroSection.offsetHeight || lastH || window.innerHeight;
        lastW = w; lastH = h;
        canvas.width  = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0); // reset + scale in one call
      }

      function createParticle(w, h) {
        return {
          x:  Math.random() * w,
          y:  Math.random() * h,
          r:  Math.random() * 2.5 + 0.8,
          dx: (Math.random() - 0.5) * 0.45,
          dy: (Math.random() - 0.5) * 0.45,
          alpha: Math.random() * 0.6 + 0.25
        };
      }

      function init() {
        initCanvas();
        const count = Math.min(Math.floor(lastW / 12), 90);
        particles = Array.from({ length: count }, () => createParticle(lastW, lastH));
      }

      // Touch support — treat finger position as mouse for repel effect
      canvas.addEventListener('touchmove', (e) => {
        const rect = canvas.getBoundingClientRect();
        const t = e.touches[0];
        mouse.x = t.clientX - rect.left;
        mouse.y = t.clientY - rect.top;
      }, { passive: true });
      canvas.addEventListener('touchend', () => { mouse.x = null; mouse.y = null; });

      window.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      }, { passive: true });
      window.addEventListener('mouseleave', () => { mouse.x = null; mouse.y = null; });

      function draw() {
        rafId = requestAnimationFrame(draw);

        // Skip drawing when hero is off-screen (save battery) but keep loop alive
        if (!isHeroVisible) return;

        const w = lastW; const h = lastH;
        if (!w || !h) return;

        ctx.clearRect(0, 0, w, h);

        particles.forEach(p => {
          if (mouse.x !== null && mouse.y !== null) {
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < mouse.radius) {
              const force = (mouse.radius - dist) / mouse.radius;
              const angle = Math.atan2(dy, dx);
              p.x -= Math.cos(angle) * force * 3;
              p.y -= Math.sin(angle) * force * 3;
            }
          }

          p.x += p.dx;
          p.y += p.dy;

          // Wrap particles at cached dimensions
          if (p.x < 0) p.x = w;
          if (p.x > w) p.x = 0;
          if (p.y < 0) p.y = h;
          if (p.y > h) p.y = 0;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(147, 197, 253, ${p.alpha})`;
          ctx.fill();
        });
      }

      // On resize, re-init fully (new canvas size + fresh particle positions)
      window.addEventListener('resize', () => { init(); }, { passive: true });

      // Reduce motion: skip particles entirely if user prefers reduced motion
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      init();
      draw();
    })();

    // 4. Scroll Reveal Observer with Fallback
    const revealElements = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });

    revealElements.forEach(el => revealObserver.observe(el));

    // Fallback safety net to reveal stuck elements
    setTimeout(() => {
      revealElements.forEach(el => el.classList.add('visible'));
    }, 1200);

    // 5. Stat Counter Animation Observer
    const statElements = document.querySelectorAll('.stat-number[data-target]');
    const statObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const target = parseInt(el.getAttribute('data-target'), 10);
          const suffix = el.getAttribute('data-suffix') || '';
          const duration = 2000;
          const startTime = performance.now();

          function updateCounter(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easeOutCubic = 1 - Math.pow(1 - progress, 3);
            const currentVal = Math.floor(easeOutCubic * target);
            el.textContent = currentVal + suffix;
            if (progress < 1) requestAnimationFrame(updateCounter);
          }

          requestAnimationFrame(updateCounter);
          statObserver.unobserve(el);
        }
      });
    }, { threshold: 0.15 });

    statElements.forEach(el => statObserver.observe(el));

    // 6. Touch-Enabled Events Carousel
    (function initEventsCarousel() {
      const track   = document.getElementById('events-track');
      const prevBtn = document.getElementById('events-prev');
      const nextBtn = document.getElementById('events-next');
      const dotsBox = document.getElementById('events-dots');
      if (!track) return;

      const cards = Array.from(track.querySelectorAll('.event-card'));
      if (!cards.length) return;

      cards.forEach((card, i) => { card.style.animationDelay = (i * 90) + 'ms'; });

      let currentIndex = 0;
      let startX = 0;
      let prevTranslate = 0;
      let isDragging = false;
      let autoTimer = null;
      const AUTO_MS = 3800;

      function getCardWidth() {
        return cards[0] ? cards[0].offsetWidth + 24 : 344;
      }

      function getMaxIndex() {
        const visible = Math.max(1, Math.floor(track.parentElement.offsetWidth / getCardWidth()));
        return Math.max(0, cards.length - visible);
      }

      function buildDots() {
        if (!dotsBox) return;
        dotsBox.innerHTML = '';
        if (window.innerWidth < 768) return;
        const total = getMaxIndex() + 1;
        if (total <= 1) return;
        for (let i = 0; i < total; i++) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'carousel-dot' + (i === currentIndex ? ' active' : '');
          b.setAttribute('aria-label', 'Go to event slide ' + (i + 1));
          b.addEventListener('click', () => { currentIndex = i; updateCarousel(); restartAuto(); });
          dotsBox.appendChild(b);
        }
      }

      function syncDots() {
        if (!dotsBox) return;
        Array.from(dotsBox.children).forEach((d, i) => d.classList.toggle('active', i === currentIndex));
      }

      function updateCarousel() {
        if (window.innerWidth < 768) { track.style.transform = 'none'; return; }
        const max = getMaxIndex();
        currentIndex = Math.max(0, Math.min(currentIndex, max));
        prevTranslate = -currentIndex * getCardWidth();
        track.style.transform = 'translateX(' + prevTranslate + 'px)';
        if (prevBtn) prevBtn.disabled = false;
        if (nextBtn) nextBtn.disabled = false;
        syncDots();
      }

      function goNext() {
        currentIndex = currentIndex >= getMaxIndex() ? 0 : currentIndex + 1;
        updateCarousel();
      }
      function goPrev() {
        currentIndex = currentIndex <= 0 ? getMaxIndex() : currentIndex - 1;
        updateCarousel();
      }

      function stopAuto() { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } }
      function startAuto() {
        stopAuto();
        if (window.innerWidth < 768 || getMaxIndex() < 1) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        autoTimer = setInterval(() => {
          const modal = document.getElementById('event-modal');
          if (document.hidden || (modal && modal.classList.contains('open'))) return;
          goNext();
        }, AUTO_MS);
      }
      function restartAuto() { startAuto(); }

      if (prevBtn) prevBtn.addEventListener('click', () => { goPrev(); restartAuto(); });
      if (nextBtn) nextBtn.addEventListener('click', () => { goNext(); restartAuto(); });

      const carouselEl = track.parentElement;
      carouselEl.addEventListener('mouseenter', stopAuto);
      carouselEl.addEventListener('mouseleave', startAuto);
      carouselEl.addEventListener('focusin', stopAuto);
      carouselEl.addEventListener('focusout', startAuto);

      track.addEventListener('touchstart', (e) => {
        if (window.innerWidth < 768) return;
        stopAuto();
        startX = e.touches[0].clientX;
        isDragging = true;
      }, { passive: true });

      track.addEventListener('touchmove', (e) => {
        if (!isDragging || window.innerWidth < 768) return;
        const diff = e.touches[0].clientX - startX;
        track.style.transform = 'translateX(' + (prevTranslate + diff) + 'px)';
      }, { passive: true });

      track.addEventListener('touchend', (e) => {
        if (!isDragging || window.innerWidth < 768) return;
        isDragging = false;
        const diff = e.changedTouches[0].clientX - startX;
        if (diff < -50) goNext();
        else if (diff > 50) goPrev();
        else updateCarousel();
        startAuto();
      });

      window.addEventListener('resize', () => { buildDots(); updateCarousel(); startAuto(); }, { passive: true });
      document.addEventListener('visibilitychange', () => { document.hidden ? stopAuto() : startAuto(); });

      buildDots();
      updateCarousel();
      startAuto();
    })();

    // 7. Lightbox Gallery Modal
    function openGallery(element) {
      const img = element.querySelector('img');
      const modal = document.getElementById('gallery-modal');
      const modalImg = document.getElementById('gallery-modal-img');
      const modalCaption = document.getElementById('gallery-modal-caption');

      if (!img || !modal) return;
      modalImg.src = img.src;
      modalCaption.textContent = img.alt || 'Gallery View';
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function openArticle(el) {
      const modal = document.getElementById('article-modal');
      if (!modal) return;
      const imgEl   = document.getElementById('article-modal-img');
      const heading = el.getAttribute('data-article-heading') || 'Untitled';
      const author  = el.getAttribute('data-article-author')  || 'HAMD Alumni';
      const date    = el.getAttribute('data-article-date')    || '';
      const image   = el.getAttribute('data-article-image')   || '';
      const content = el.getAttribute('data-article-content') || '';
      const id      = el.getAttribute('data-article-id')      || '';

      document.getElementById('article-modal-title').textContent  = heading;
      document.getElementById('article-modal-author').textContent = author;
      document.getElementById('article-modal-date').textContent   = date;
      document.getElementById('article-modal-text').textContent   = content || 'No content available for this article.';

      if (image) { imgEl.src = image; imgEl.alt = heading; imgEl.classList.remove('d-none'); }
      else { imgEl.src = ''; imgEl.classList.add('d-none'); }

      const shareBtn = document.getElementById('article-modal-share');
      if (shareBtn) {
        if (id) { shareBtn.classList.remove('d-none'); shareBtn.setAttribute('data-article-id', id); shareBtn.setAttribute('data-article-heading', heading); }
        else { shareBtn.classList.add('d-none'); }
      }

      if (id && ('#article-' + id) !== window.location.hash) {
        history.replaceState(null, '', '#article-' + id);
      }

      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeArticle() {
      const modal = document.getElementById('article-modal');
      if (modal) modal.classList.remove('open');
      document.body.style.overflow = '';
      if (String(window.location.hash || '').indexOf('#article-') === 0) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    }

    /* ---------- Article share link ---------- */
    function articleShareUrl(id) {
      return window.location.origin + window.location.pathname + '#article-' + id;
    }

    function articleToast(text) {
      let box = document.getElementById('article-share-toast');
      if (!box) {
        box = document.createElement('div');
        box.id = 'article-share-toast';
        box.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);' +
          'background:#0f172a;color:#fff;padding:11px 20px;border-radius:999px;font-size:.87rem;font-weight:600;' +
          'box-shadow:0 12px 32px rgba(15,23,42,.28);z-index:20000;opacity:0;transition:opacity .25s ease,transform .25s ease;';
        document.body.appendChild(box);
      }
      box.textContent = text;
      requestAnimationFrame(function () {
        box.style.opacity = '1';
        box.style.transform = 'translateX(-50%) translateY(0)';
      });
      clearTimeout(box._t);
      box._t = setTimeout(function () {
        box.style.opacity = '0';
        box.style.transform = 'translateX(-50%) translateY(20px)';
      }, 2200);
    }

    function copyTextFallback(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:-1000px;opacity:0;';
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, ta.value.length);
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      return ok;
    }

    function shareArticle(event, el) {
      if (event) { event.preventDefault(); event.stopPropagation(); }
      const holder = el || (event && event.currentTarget);
      if (!holder) return;
      const id = holder.getAttribute('data-article-id');
      if (!id) return;
      const heading = holder.getAttribute('data-article-heading') || 'Article';
      const url = articleShareUrl(id);

      if (navigator.share) {
        navigator.share({ title: heading, text: heading, url: url })
          .catch(function () { /* user dismissed the share sheet */ });
        return;
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url)
          .then(function () { articleToast('Link copied'); })
          .catch(function () {
            articleToast(copyTextFallback(url) ? 'Link copied' : url);
          });
        return;
      }

      articleToast(copyTextFallback(url) ? 'Link copied' : url);
    }

    function openArticleFromHash() {
      const hash = String(window.location.hash || '');
      if (hash.indexOf('#article-') !== 0) return;
      const id = hash.slice('#article-'.length);
      if (!id) return;
      const card = document.querySelector('.article-card[data-article-id="' + (window.CSS && CSS.escape ? CSS.escape(id) : id) + '"]');
      if (!card) return;
      const section = document.getElementById('articles');
      if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(function () { openArticle(card); }, 350);
    }

    window.addEventListener('DOMContentLoaded', function () { setTimeout(openArticleFromHash, 250); });
    window.addEventListener('hashchange', openArticleFromHash);


    function openEvent(el) {
      const modal = document.getElementById('event-modal');
      if (!modal) return;
      const imgEl = document.getElementById('event-modal-img');
      const title = el.getAttribute('data-event-title') || 'Event';
      const cat   = el.getAttribute('data-event-category') || '';
      const loc   = el.getAttribute('data-event-location') || '';
      const date  = el.getAttribute('data-event-date') || '';
      const image = el.getAttribute('data-event-image') || '';
      const desc  = el.getAttribute('data-event-description') || '';
      const reg   = el.getAttribute('data-event-registration') === '1';

      document.getElementById('event-modal-title').textContent = title;
      const catEl = document.getElementById('event-modal-category');
      catEl.textContent = cat;
      catEl.style.display = cat ? 'inline-block' : 'none';

      document.getElementById('event-modal-date').textContent = date;
      document.getElementById('event-modal-date-wrap').style.display = date ? 'inline-flex' : 'none';
      document.getElementById('event-modal-location').textContent = loc;
      document.getElementById('event-modal-location-wrap').style.display = loc ? 'inline-flex' : 'none';
      document.getElementById('event-modal-text').textContent = desc || 'More details about this event will be announced soon.';

      const regBtn = document.getElementById('event-modal-register');
      if (reg) regBtn.classList.remove('d-none'); else regBtn.classList.add('d-none');

      if (image) { imgEl.src = image; imgEl.alt = title; imgEl.classList.remove('d-none'); }
      else { imgEl.src = ''; imgEl.classList.add('d-none'); }

      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeEvent() {
      const modal = document.getElementById('event-modal');
      if (modal) modal.classList.remove('open');
      document.body.style.overflow = '';
    }

    function closeGallery() {
      const modal = document.getElementById('gallery-modal');
      if (modal) modal.classList.remove('open');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { closeGallery(); closeArticle(); closeEvent(); }
    });

    /* Image fallback — replaces a failed image with an icon placeholder.
       Defined as a real function so it does not depend on quote escaping
       inside an inline onerror attribute. */
    function imgFallback(img, kind) {
      img.onerror = null;
      var parent = img.parentElement;
      if (!parent) { img.remove(); return; }
      var markup = kind === 'gallery'
        ? '<div class="gallery-img-fallback"><i class="bi bi-image"></i></div>'
        : kind === 'event'
          ? '<div class="event-img-fallback"><i class="bi bi-calendar-event"></i></div>'
          : '<i class="bi bi-journal-richtext"></i>';
      parent.innerHTML = markup;
    }
    window.imgFallback = imgFallback;

    // 8. Contact Form Handling
    const contactForm = document.getElementById('contact-form');
    const formFeedback = document.getElementById('form-feedback');

    if (contactForm) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name    = document.getElementById('c-name').value.trim();
        const email   = document.getElementById('c-email').value.trim();
        const phone   = document.getElementById('c-phone').value.trim();
        const subject = document.getElementById('c-subject').value.trim();
        const message = document.getElementById('c-message').value.trim();

        if (!name || !email || !message) {
          formFeedback.style.color = '#ef4444';
          formFeedback.textContent = 'Please fill out all required fields (*).';
          return;
        }

        const btn = contactForm.querySelector('button[type="submit"]');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sending...';
        formFeedback.textContent = '';

        try {
          const res = await fetch('/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, phone, subject, message })
          });
          const data = await res.json().catch(() => ({}));

          if (res.ok && data.success) {
            formFeedback.style.color = 'var(--emerald-500)';
            formFeedback.textContent = data.message || 'Thank you! Your message has been sent successfully.';
            contactForm.reset();
          } else {
            formFeedback.style.color = '#ef4444';
            formFeedback.textContent = (data && data.message) || 'Could not send your message. Please try again.';
          }
        } catch (err) {
          formFeedback.style.color = '#ef4444';
          formFeedback.textContent = 'Network error. Please check your connection and try again.';
        } finally {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
          setTimeout(() => { formFeedback.textContent = ''; }, 6000);
        }
      });
    }
  </script>
</body>
</html>
