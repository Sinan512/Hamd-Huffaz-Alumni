<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Member Dashboard</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root {
      --font-main: 'Plus Jakarta Sans', sans-serif;
      --bg-body: #f8fafc;
      --sidebar-width: 270px;
      --sidebar-bg: #0b0f19;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --card-bg: #ffffff;
      --card-border: rgba(226, 232, 240, 0.8);
      --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
      --card-shadow-hover: 0 12px 28px -4px rgba(0, 0, 0, 0.08), 0 4px 12px -2px rgba(0, 0, 0, 0.04);
      --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      --emerald-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-main);
      background-color: var(--bg-body);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    /* --- SIDEBAR STYLING --- */
    .sidebar {
      width: var(--sidebar-width);
      background: linear-gradient(180deg, #0b0f19 0%, #111827 100%);
      min-height: 100vh;
      color: #94a3b8;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1040;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-right: 1px solid rgba(255, 255, 255, 0.06);
      display: flex;
      flex-direction: column;
    }

    .sidebar .brand {
      padding: 24px 28px;
      font-size: 20px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .sidebar .brand-icon {
      width: 40px;
      height: 40px;
      background: var(--emerald-gradient);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 20px;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }

    .sidebar-menu {
      padding: 20px 16px;
      flex-grow: 1;
      overflow-y: auto;
    }

    .sidebar-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #475569;
      padding: 12px 14px 6px 14px;
    }

    .sidebar a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #94a3b8;
      text-decoration: none;
      padding: 12px 16px;
      font-size: 14px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 4px;
      transition: all 0.2s ease;
    }

    .sidebar a .nav-link-content {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .sidebar a i {
      font-size: 18px;
      transition: transform 0.2s ease;
    }

    .sidebar a:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.05);
    }

    .sidebar a:hover i {
      transform: translateX(2px);
    }

    .sidebar a.active {
      background: var(--primary-gradient);
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
    }

    .sidebar-user-card {
      margin: 16px;
      padding: 14px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* --- MAIN CONTENT AREA --- */
    .main {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .boxed {
      max-width: 1440px;
      margin: 0 auto;
    }

    /* --- NAVBAR STYLING --- */
    .navbar {
      background: #ffffff;
      border-bottom: 1px solid var(--card-border);
      padding: 14px 28px;
      position: sticky;
      top: 0;
      z-index: 1020;
      backdrop-filter: blur(8px);
    }

    .search-box {
      position: relative;
      max-width: 440px;
      width: 100%;
    }

    .search-box i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 16px;
    }

    .search-box input {
      padding-left: 42px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #f8fafc;
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .search-box input:focus {
      background: #ffffff;
      border-color: #6366f1;
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .nav-icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #475569;
      position: relative;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .nav-icon-btn:hover {
      background: #f1f5f9;
      color: #1e293b;
    }

    .nav-icon-btn .badge-dot {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 8px;
      height: 8px;
      background: #ef4444;
      border-radius: 50%;
      border: 2px solid #ffffff;
    }

    .user-profile-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 12px 6px 6px;
      border: 1px solid #e2e8f0;
      border-radius: 30px;
      background: #ffffff;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .user-profile-btn:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
    }

    /* --- CARDS & WIDGETS --- */
    .card {
      border: 1px solid var(--card-border);
      border-radius: 16px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      transition: all 0.25s ease;
    }

    .card-header {
      background: transparent;
      border-bottom: 1px solid var(--card-border);
      padding: 20px 24px;
      font-weight: 700;
      font-size: 16px;
      color: #0f172a;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* --- STAT CARDS --- */
    .stat-card {
      padding: 20px;
      position: relative;
      overflow: hidden;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--card-shadow-hover);
    }

    .stat-icon-wrapper {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    .stat-title {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 4px;
    }

    .stat-value {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
      margin: 0;
    }

    /* Stat Color Variants */
    .stat-indigo .stat-icon-wrapper { background: rgba(99, 102, 241, 0.12); color: #6366f1; }
    .stat-amber .stat-icon-wrapper { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .stat-rose .stat-icon-wrapper { background: rgba(244, 63, 94, 0.12); color: #f43f5e; }
    .stat-cyan .stat-icon-wrapper { background: rgba(6, 182, 212, 0.12); color: #06b6d4; }

    /* --- PROFILE CARD --- */
    .profile-card-img {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid #ffffff;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
      margin: 0 auto 16px auto;
      display: block;
    }

    .profile-verified-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 20px;
      background: #dcfce7;
      color: #15803d;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    /* --- NOTIFICATION LIST --- */
    .notification-item {
      padding: 18px 24px;
      border-bottom: 1px solid #f1f5f9;
      display: flex;
      align-items: flex-start;
      gap: 16px;
      transition: background 0.2s ease;
      text-decoration: none;
      color: inherit;
    }

    .notification-item:last-child {
      border-bottom: none;
    }

    .notification-item:hover {
      background-color: #f8fafc;
    }

    .notification-icon-box {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }

    /* --- EVENT CARDS --- */
    .event-card-item {
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 16px;
      transition: all 0.2s ease;
      background: #ffffff;
    }

    .event-card-item:last-child {
      margin-bottom: 0;
    }

    .event-card-item:hover {
      border-color: #cbd5e1;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
    }

    .event-cover-img {
      width: 100%;
      height: 140px;
      object-fit: cover;
    }

    /* --- GALLERY ALBUM CARDS --- */
    .album-card {
      position: relative;
      height: 140px;
      border-radius: 14px;
      overflow: hidden;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
      transition: all 0.3s ease;
    }

    .album-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .album-card:hover img {
      transform: scale(1.08);
    }

    .album-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.75) 100%);
      padding: 14px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      color: #ffffff;
    }

    .album-title {
      font-size: 13px;
      font-weight: 700;
      margin: 0;
      line-height: 1.2;
    }

    .album-count {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.8);
    }

    /* --- DOWNLOAD ITEM --- */
    .download-item {
      padding: 16px 24px;
      border-bottom: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: background 0.15s ease;
    }

    .download-item:last-child {
      border-bottom: none;
    }

    .download-item:hover {
      background: #f8fafc;
    }

    .download-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: #fee2e2;
      color: #ef4444;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }

    /* --- FOOTER --- */
    .footer {
      border-top: 1px solid var(--card-border);
      color: #64748b;
      font-size: 13px;
    }

    /* RESPONSIVE TOGGLES */
    @media (max-width: 992px) {
      .sidebar {
        transform: translateX(-100%);
      }
      .sidebar.show {
        transform: translateX(0);
      }
      .main {
        margin-left: 0;
      }
    }
  </style>
</head>
<body>

  <!-- SIDEBAR NAVIGATION -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-icon">
        <i class="bi bi-mortarboard-fill"></i>
      </div>
      <div>
        <span>Alumni</span><span style="color: #10b981;">Portal</span>
        <div style="font-size: 10px; font-weight: 500; color: #64748b; margin-top: -2px;">MEMBER DASHBOARD</div>
      </div>
    </div>

    <div class="sidebar-menu">
      <div class="sidebar-section-title">Member Area</div>
      <a class="active" href="#"><i class="bi bi-grid-1x2-fill me-2"></i>Dashboard</a>
      <a href="#profile-section" data-bs-toggle="modal" data-bs-target="#profileModal"><i class="bi bi-person-fill me-2"></i>My Profile</a>
      <a href="#notifications-section"><i class="bi bi-bell-fill me-2"></i>Notifications <span class="badge bg-danger rounded-pill px-2">5</span></a>
      <a href="#events-section"><i class="bi bi-calendar2-event-fill me-2"></i>Events <span class="badge bg-primary rounded-pill px-2">3</span></a>
      
      <div class="sidebar-section-title mt-3">Resources</div>
      <a href="#gallery-section"><i class="bi bi-images me-2"></i>Gallery</a>
      <a href="#downloads-section"><i class="bi bi-download me-2"></i>Downloads</a>
      <a href="#settings-section" data-bs-toggle="modal" data-bs-target="#settingsModal"><i class="bi bi-gear-fill me-2"></i>Settings</a>
    </div>

    <div class="sidebar-user-card">
      <img src="{{user.avatar}}" class="rounded-circle" width="38" height="38" alt="{{user.name}}">
      <div class="overflow-hidden">
        <div style="font-size: 13px; font-weight: 700; color: #fff;" class="text-truncate">{{user.name}}</div>
        <div style="font-size: 11px; color: #10b981; font-weight: 600;" class="text-truncate">Batch {{user.batch}} • Verified</div>
      </div>
    </div>
  </aside>

  <!-- MAIN WRAPPER -->
  <div class="main">
    
    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg">
      <div class="container-fluid boxed px-0">
        
        <div class="d-flex align-items-center gap-3 w-100">
          <!-- Mobile Sidebar Toggle -->
          <button class="btn btn-light d-lg-none" id="sidebarToggleBtn">
            <i class="bi bi-list fs-4"></i>
          </button>

          <!-- Search Box -->
          <div class="search-box me-auto">
            <i class="bi bi-search"></i>
            <input type="text" id="memberSearchInput" class="form-control" placeholder="Search announcements, events or documents...">
          </div>

          <!-- Right Action Items -->
          <div class="d-flex align-items-center gap-3">
            
            <!-- Quick Alert Notification -->
            <div class="dropdown">
              <div class="nav-icon-btn" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-bell fs-5"></i>
                <span class="badge-dot"></span>
              </div>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="width: 320px;">
                <li class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                  <span class="fw-bold fs-6">Unread Alerts</span>
                  <span class="badge bg-danger-subtle text-danger rounded-pill">5 New</span>
                </li>
                {{#each notifications}}
                <li>
                  <a class="dropdown-item py-2 rounded-3 text-wrap" href="#notifications-section">
                    <strong>{{this.title}}</strong>
                    <span class="text-muted d-block small" style="font-size: 11px;">{{this.date}}</span>
                  </a>
                </li>
                {{/each}}
              </ul>
            </div>

            <!-- User Profile Dropdown -->
            <div class="dropdown">
              <div class="user-profile-btn" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="{{user.avatar}}" class="user-avatar" alt="{{user.name}}">
                <div class="d-none d-sm-block text-start me-1">
                  <div style="font-size: 13px; font-weight: 700; color: #0f172a;">{{user.name}}</div>
                  <div style="font-size: 10px; font-weight: 600; color: #10b981;">CLASS OF {{user.batch}}</div>
                </div>
                <i class="bi bi-chevron-down small text-muted"></i>
              </div>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="width: 200px;">
                <li><a class="dropdown-item rounded-3" href="#" data-bs-toggle="modal" data-bs-target="#profileModal"><i class="bi bi-person me-2"></i>My Profile</a></li>
                <li><a class="dropdown-item rounded-3" href="#" data-bs-toggle="modal" data-bs-target="#settingsModal"><i class="bi bi-shield-lock me-2"></i>Security Settings</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item rounded-3 text-danger" href="/admin"><i class="bi bi-box-arrow-right me-2"></i>Switch to Admin Portal</a></li>
              </ul>
            </div>

          </div>
        </div>

      </div>
    </nav>

    <!-- CONTENT BODY -->
    <div class="container-fluid boxed px-4 py-4">

      <!-- WELCOME BANNER -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
          <h3 class="fw-800 text-slate-900 m-0" style="font-weight: 800; letter-spacing: -0.5px;">Welcome back, {{user.name}}! 👋</h3>
          <p class="text-muted m-0 small">Class of {{user.batch}} • Stay connected with your alumni network, events, and announcements.</p>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary btn-sm rounded-3 fw-semibold shadow-sm px-3" style="background: var(--primary-gradient); border: none;" data-bs-toggle="modal" data-bs-target="#profileModal">
            <i class="bi bi-person-circle me-1"></i> View My Profile
          </button>
        </div>
      </div>

      <!-- 4 STAT CARDS GRID -->
      <div class="row g-3 mb-4">
        
        <!-- Stat 1: My Batch -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-indigo h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">My Batch</div>
                <h3 class="stat-value">{{stats.myBatch}}</h3>
                <span class="badge bg-indigo-subtle text-indigo rounded-pill mt-2" style="font-size: 11px;">Class of {{stats.myBatch}}</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-collection-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 2: Upcoming Events -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-amber h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Upcoming Events</div>
                <h3 class="stat-value">{{stats.upcomingEvents}}</h3>
                <span class="badge bg-warning-subtle text-warning rounded-pill mt-2" style="font-size: 11px;">Scheduled Meets</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-calendar-event-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 3: Unread Notifications -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-rose h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Unread Notifications</div>
                <h3 class="stat-value">{{stats.unreadNotifications}}</h3>
                <span class="badge bg-danger-subtle text-danger rounded-pill mt-2" style="font-size: 11px;">New Alerts</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-bell-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 4: Gallery Albums -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-cyan h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Gallery Albums</div>
                <h3 class="stat-value">{{stats.galleryAlbums}}</h3>
                <span class="badge bg-info-subtle text-info rounded-pill mt-2" style="font-size: 11px;">Photo Collections</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-images"></i>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- MAIN ROW 1: MY PROFILE & NOTIFICATIONS -->
      <div class="row g-4 mb-4">
        
        <!-- My Profile Card -->
        <div class="col-lg-4">
          <div class="card h-100">
            <div class="card-header">
              <span><i class="bi bi-person-badge-fill text-primary me-2"></i>My Profile</span>
              <span class="badge bg-success-subtle text-success rounded-pill">Verified</span>
            </div>
            <div class="card-body text-center p-4">
              <img src="{{user.avatar}}" class="profile-card-img" alt="{{user.name}}">
              
              <h5 class="fw-800 text-dark mb-1" style="font-weight: 800;">{{user.name}}</h5>
              <div class="profile-verified-badge">
                <i class="bi bi-patch-check-fill"></i> {{user.status}}
              </div>

              <div class="p-3 bg-light rounded-3 text-start mb-3" style="font-size: 13px;">
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted"><i class="bi bi-mortarboard me-2"></i>Batch Year</span>
                  <span class="fw-bold text-dark">Class of {{user.batch}}</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted"><i class="bi bi-briefcase me-2"></i>Occupation</span>
                  <span class="fw-bold text-dark">{{user.occupation}}</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                  <span class="text-muted"><i class="bi bi-geo-alt me-2"></i>Location</span>
                  <span class="fw-bold text-dark">{{user.location}}</span>
                </div>
              </div>

              <button class="btn btn-primary w-100 rounded-3 fw-semibold" style="background: var(--primary-gradient); border:none;" data-bs-toggle="modal" data-bs-target="#profileModal">
                <i class="bi bi-eye me-1"></i> View Full Profile
              </button>

              <p class="small text-muted mt-3 mb-0" style="font-size: 11px;">
                <i class="bi bi-info-circle me-1"></i> Profile information is officially verified and managed by the Alumni Office.
              </p>
            </div>
          </div>
        </div>

        <!-- Notifications Panel -->
        <div class="col-lg-8" id="notifications-section">
          <div class="card h-100">
            <div class="card-header">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-bell-fill text-danger me-1"></i>
                <span>Notifications & Announcements</span>
              </div>
              <span class="badge bg-danger-subtle text-danger rounded-pill px-3">{{stats.unreadNotifications}} New</span>
            </div>
            
            <div class="p-0">
              {{#each notifications}}
              <div class="notification-item">
                <div class="notification-icon-box">
                  <i class="bi {{this.icon}}"></i>
                </div>
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                    <h6 class="mb-0 fw-bold text-dark fs-6">{{this.title}}</h6>
                    {{#if this.isNew}}
                    <span class="badge bg-danger-subtle text-danger rounded-pill" style="font-size: 10px;">NEW</span>
                    {{/if}}
                  </div>
                  <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-secondary border" style="font-size: 11px;">{{this.category}}</span>
                    <small class="text-muted"><i class="bi bi-clock me-1"></i>{{this.date}}</small>
                  </div>
                </div>
              </div>
              {{/each}}
            </div>
          </div>
        </div>

      </div>

      <!-- MAIN ROW 2: UPCOMING EVENTS & LATEST GALLERY -->
      <div class="row g-4 mb-4">
        
        <!-- Upcoming Events -->
        <div class="col-lg-7" id="events-section">
          <div class="card h-100">
            <div class="card-header">
              <span><i class="bi bi-calendar2-event-fill text-amber me-2"></i>Upcoming Alumni Events</span>
              <span class="badge bg-primary-subtle text-primary rounded-pill">RSVP Open</span>
            </div>
            <div class="card-body">
              {{#each upcomingEvents}}
              <div class="event-card-item">
                <img src="{{this.image}}" class="event-cover-img" alt="{{this.title}}">
                <div class="p-3">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="fw-bold text-dark m-0">{{this.title}}</h5>
                    <span class="badge bg-info-subtle text-info rounded-pill" style="font-size: 11px;">{{this.category}}</span>
                  </div>
                  <p class="text-muted small mb-3">
                    <i class="bi bi-calendar-check text-primary me-2"></i>{{this.date}} • {{this.time}}<br>
                    <i class="bi bi-geo-alt text-danger me-2"></i>{{this.location}}
                  </p>
                  <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary btn-sm rounded-3 px-3 fw-semibold" style="background: var(--primary-gradient); border:none;" onclick="handleRSVP('{{this.title}}', 'Register')">
                      <i class="bi bi-check-circle me-1"></i> Register Now
                    </button>
                    <button class="btn btn-outline-secondary btn-sm rounded-3 px-3" onclick="handleRSVP('{{this.title}}', 'Interested')">
                      <i class="bi bi-star me-1"></i> Interested
                    </button>
                    <button class="btn btn-outline-primary btn-sm rounded-3 px-3 ms-auto" data-bs-toggle="modal" data-bs-target="#eventModal{{this.id}}">
                      View Details
                    </button>
                  </div>
                </div>
              </div>
              {{/each}}
            </div>
          </div>
        </div>

        <!-- Latest Gallery Albums -->
        <div class="col-lg-5" id="gallery-section">
          <div class="card h-100">
            <div class="card-header">
              <span><i class="bi bi-images text-cyan me-2"></i>Latest Photo Gallery</span>
              <span class="badge bg-light text-dark">4 Albums</span>
            </div>
            <div class="card-body">
              <div class="row g-3">
                {{#each galleryAlbums}}
                <div class="col-6">
                  <div class="album-card" data-bs-toggle="modal" data-bs-target="#galleryModal">
                    <img src="{{this.cover}}" alt="{{this.title}}">
                    <div class="album-overlay">
                      <h6 class="album-title">{{this.title}}</h6>
                      <span class="album-count"><i class="bi bi-camera me-1"></i>{{this.photoCount}} Photos</span>
                    </div>
                  </div>
                </div>
                {{/each}}
              </div>
              <div class="mt-4">
                <button class="btn btn-outline-primary w-100 rounded-3 fw-semibold py-2" data-bs-toggle="modal" data-bs-target="#galleryModal">
                  <i class="bi bi-grid me-2"></i>View Full Gallery
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- DOWNLOADS SECTION -->
      <div class="card mb-4" id="downloads-section">
        <div class="card-header">
          <span><i class="bi bi-file-earmark-arrow-down-fill text-emerald me-2"></i>Downloads & Official Resources</span>
          <span class="badge bg-light text-dark">Updated July 2026</span>
        </div>
        <div class="p-0">
          {{#each downloads}}
          <div class="download-item">
            <div class="d-flex align-items-center gap-3">
              <div class="download-icon">
                <i class="bi bi-file-earmark-pdf-fill"></i>
              </div>
              <div>
                <div class="fw-bold text-dark mb-1">{{this.name}}</div>
                <div class="text-muted small">{{this.type}} • {{this.size}} • Uploaded on {{this.date}}</div>
              </div>
            </div>
            <a href="#" class="btn btn-outline-primary btn-sm rounded-3 px-3 fw-semibold" onclick="alert('Downloading {{this.name}}...'); return false;">
              <i class="bi bi-download me-1"></i> Download
            </a>
          </div>
          {{/each}}
        </div>
      </div>

      <!-- FOOTER -->
      <footer class="footer py-4 text-center mt-4">
        <div class="container">
          <p class="m-0 mb-1 fw-medium">© 2026 Alumni Management System. All rights reserved.</p>
          <div class="d-flex justify-content-center gap-4 small text-muted">
            <a href="#" class="text-muted text-decoration-none">Help & Contact</a> •
            <a href="#" class="text-muted text-decoration-none">Privacy Policy</a> •
            <a href="#" class="text-muted text-decoration-none">Terms of Service</a> •
            <a href="/admin" class="text-primary text-decoration-none fw-bold">Admin Portal</a>
          </div>
        </div>
      </footer>

    </div>
  </div>

  <!-- ==================== MODALS ==================== -->

  <!-- Profile Modal -->
  <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="fw-bold m-0"><i class="bi bi-person-badge text-primary me-2"></i>Alumni Member Profile</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row align-items-center mb-4">
            <div class="col-auto">
              <img src="{{user.avatar}}" class="rounded-circle border" width="80" height="80" alt="{{user.name}}">
            </div>
            <div class="col">
              <h4 class="fw-bold m-0">{{user.name}}</h4>
              <p class="text-muted mb-1">Batch {{user.batch}} • {{user.occupation}}</p>
              <span class="badge bg-success-subtle text-success rounded-pill px-3"><i class="bi bi-check-circle me-1"></i>Official Verified Member</span>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <div class="p-3 bg-light rounded-3">
                <small class="text-muted d-block font-monospace">FULL NAME</small>
                <strong>{{user.name}}</strong>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-3 bg-light rounded-3">
                <small class="text-muted d-block font-monospace">EMAIL ADDRESS</small>
                <strong>{{user.email}}</strong>
              </div>
            </div>
            <div class="col-md-6">
              <div class="col-12 p-3 bg-light rounded-3">
                <small class="text-muted d-block font-monospace">GRADUATION BATCH</small>
                <strong>Class of {{user.batch}}</strong>
              </div>
            </div>
            <div class="col-md-6">
              <div class="col-12 p-3 bg-light rounded-3">
                <small class="text-muted d-block font-monospace">CURRENT LOCATION</small>
                <strong>{{user.location}}</strong>
              </div>
            </div>
          </div>

          <div class="mt-4 p-3 border rounded-3 bg-warning-subtle text-dark">
            <small><i class="bi bi-shield-lock me-1"></i> To update your official degree or name details, please submit an update request to the Alumni Admin Office.</small>
          </div>
        </div>
        <div class="modal-footer border-top-0">
          <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary rounded-3 px-4" style="background: var(--primary-gradient); border:none;" onclick="alert('Profile update request sent to Admin office!')">Request Profile Update</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Event Detail Modals -->
  {{#each upcomingEvents}}
  <div class="modal fade" id="eventModal{{this.id}}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="fw-bold m-0"><i class="bi bi-calendar-event text-amber me-2"></i>{{this.title}}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <img src="{{this.image}}" class="w-100 rounded-3 mb-3" style="height: 180px; object-fit: cover;" alt="{{this.title}}">
          <p class="text-muted small mb-2"><i class="bi bi-calendar-check text-primary me-2"></i><strong>Date & Time:</strong> {{this.date}} ({{this.time}})</p>
          <p class="text-muted small mb-3"><i class="bi bi-geo-alt text-danger me-2"></i><strong>Venue:</strong> {{this.location}}</p>
          <p class="small text-secondary">Join fellow alumni for networking, discussions, and updates on community initiatives. Refreshments will be served.</p>
        </div>
        <div class="modal-footer border-top-0">
          <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary rounded-3 px-4" style="background: var(--primary-gradient); border:none;" onclick="handleRSVP('{{this.title}}', 'Register');">Confirm Registration</button>
        </div>
      </div>
    </div>
  </div>
  {{/each}}

  <!-- Gallery Viewer Modal -->
  <div class="modal fade" id="galleryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="fw-bold m-0"><i class="bi bi-images text-cyan me-2"></i>Alumni Photo Gallery Album</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row g-2">
            {{#each galleryAlbums}}
            <div class="col-md-6">
              <div class="position-relative rounded-3 overflow-hidden" style="height: 180px;">
                <img src="{{this.cover}}" class="w-100 h-100" style="object-fit: cover;" alt="{{this.title}}">
                <div class="position-absolute bottom-0 start-0 end-0 p-2 text-white" style="background: rgba(0,0,0,0.6);">
                  <div class="fw-bold small">{{this.title}}</div>
                  <div class="small" style="font-size: 10px;">{{this.photoCount}} High-Resolution Photos</div>
                </div>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Settings Modal -->
  <div class="modal fade" id="settingsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="fw-bold m-0"><i class="bi bi-gear me-2"></i>Account & Privacy Settings</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <form>
            <div class="mb-3">
              <label class="form-label small fw-bold">Email Notifications</label>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" checked id="switch1">
                <label class="form-check-label small" for="switch1">Receive Event Invites & Announcements</label>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Directory Visibility</label>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" checked id="switch2">
                <label class="form-check-label small" for="switch2">Show profile in member directory</label>
              </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4">
              <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary rounded-3 px-4" style="background: var(--primary-gradient); border:none;">Save Settings</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- SCRIPTS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // --- SIDEBAR TOGGLE FOR MOBILE ---
    const sidebar = document.getElementById('sidebar');
    const sidebarToggleBtn = document.getElementById('sidebarToggleBtn');

    if (sidebarToggleBtn) {
      sidebarToggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('show');
      });
    }

    // --- SEARCH FILTER FOR NOTIFICATIONS, EVENTS, DOWNLOADS ---
    const searchInput = document.getElementById('memberSearchInput');
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();

        // Filter notifications
        document.querySelectorAll('.notification-item').forEach(item => {
          item.style.display = item.innerText.toLowerCase().includes(query) ? '' : 'none';
        });

        // Filter events
        document.querySelectorAll('.event-card-item').forEach(item => {
          item.style.display = item.innerText.toLowerCase().includes(query) ? '' : 'none';
        });

        // Filter downloads
        document.querySelectorAll('.download-item').forEach(item => {
          item.style.display = item.innerText.toLowerCase().includes(query) ? '' : 'none';
        });
      });
    }

    // --- RSVP INTERACTION FEEDBACK ---
    function handleRSVP(eventTitle, actionType) {
      alert(`Success! You have selected "${actionType}" for "${eventTitle}". Confirmation details sent to your registered email.`);
    }
  </script>

</body>
</html>
