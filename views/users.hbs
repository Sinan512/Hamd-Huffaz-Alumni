        </div>
        <div class="modal-body px-4 py-3">
          <form id="submitContributionForm" enctype="multipart/form-data">
            <div id="paymentModalAlert" class="alert d-none rounded-3 py-2 px-3 small mb-3"></div>

            <div class="row g-4">
              <!-- Left Column: Summary & Payment Info -->
              <div class="col-12 col-md-6">
                <div class="p-3 rounded-3 mb-3" style="background: var(--primary-light); border: 1px solid var(--border-color);">
                  <div class="small fw-bold text-uppercase opacity-75 text-primary">Months Selected</div>
                  <div class="fw-bold fs-6 mb-1 text-break text-primary" id="modalSelectedMonthsList">None</div>
                  <div class="fs-4 fw-extrabold text-primary">Total Amount: ₹<span id="modalTotalAmount">0</span></div>
                </div>

                <!-- Hidden GPay number for JS clipboard use -->
                <input type="hidden" id="gpayNumberCopyText" value="{{#if paymentSetup.gpayNumber}}{{paymentSetup.gpayNumber}}{{else}}Not set{{/if}}">

                <!-- UPI Details -->
                <div class="mb-3">
                  <label class="form-label fw-semibold small text-muted text-uppercase mb-1">UPI ID</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                    <input type="text" class="form-control fw-bold" id="upiIdCopyText" value="{{#if paymentSetup.upiId}}{{paymentSetup.upiId}}{{else}}Not set{{/if}}" readonly>
                    <button type="button" class="btn btn-outline-secondary" onclick="copyTextFromInput('upiIdCopyText', 'UPI ID')">
                      <i class="bi bi-copy me-1"></i>Copy
                    </button>
                  </div>
                </div>

                <!-- Proceed to UPI App Button -->
                <div class="mt-4">
                  <button type="button" id="proceedUpiBtn" class="btn btn-success w-100 rounded-3 py-2 fw-bold shadow-sm">
                    <i class="bi bi-box-arrow-up-right me-2"></i>Proceed to UPI App
                  </button>
                  <div class="form-text text-center small mt-1">Copies GPay number &amp; opens your UPI app to paste &amp; pay.</div>
                </div>

                <!-- UPI App Picker Popup -->
                <div id="upiCopyPopup" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.65); backdrop-filter:blur(4px); align-items:center; justify-content:center;">
                  <div style="background:var(--surface); border:1px solid var(--border-color); border-radius:24px; padding:28px 24px; max-width:360px; width:92%; text-align:center; box-shadow:var(--card-shadow-hover);">
                    <div style="font-size:36px; margin-bottom:8px;">📋</div>
                    <div class="fw-bold mb-1" style="font-size:17px; color:var(--text-primary);">GPay number copied!</div>
                    <div class="small mb-4" style="color:var(--text-muted); line-height:1.6;">
                      Choose your UPI app below. <strong>Paste</strong> the copied number in the recipient / search field.
                    </div>

                    <!-- App Grid -->
                    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:18px;">
                      <!-- Google Pay -->
                      <button type="button" class="upi-app-btn" data-scheme="gpay://upi/ui/v2" data-fallback="tez://upi/ui/v2">
                        <img src="https://img.icons8.com/?size=100&id=w0MU3YDSYG7T&format=png&color=000000" alt="GPay" style="width:36px;height:36px;object-fit:contain;border-radius:8px;">
                        <span style="font-size:11px;font-weight:700;color:var(--text-primary);">GPay</span>
                      </button>

                      <!-- PhonePe -->
                      <button type="button" class="upi-app-btn" data-scheme="phonepe://pay" data-fallback="phonepe://main">
                        <img src="https://w7.pngwing.com/pngs/332/615/png-transparent-phonepe-india-unified-payments-interface-india-purple-violet-text-thumbnail.png" alt="PhonePe" style="width:36px;height:36px;object-fit:contain;border-radius:50px;">
                        <span style="font-size:11px;font-weight:700;color:var(--text-primary);">PhonePe</span>
                      </button>

                      <!-- Paytm -->
                      <a href="paytmmp://" class="upi-app-btn">
                        <img src="https://img.icons8.com/?size=100&id=zB8j6RfneRmV&format=png&color=000000" alt="Paytm" style="width:36px;height:36px;object-fit:contain;border-radius:8px;">
                        <span style="font-size:11px;font-weight:700;color:var(--text-primary);">Paytm</span>
                      </a>

                      <!-- WhatsApp -->
                      <button type="button" class="upi-app-btn" data-scheme="https://wa.me" data-fallback="https://wa.me">
                        <img src="https://img.icons8.com/?size=100&id=A1JUR9NRH7sC&format=png&color=000000" alt="WhatsApp" style="width:36px;height:36px;object-fit:contain;border-radius:8px;">
                        <span style="font-size:11px;font-weight:700;color:var(--text-primary);">WhatsApp</span>
                      </button>

                      <!-- BHIM -->
                      <a href="bhim://pay" class="upi-app-btn">
                        <img src="https://img.icons8.com/?size=100&id=1AzdGyrT9jI0&format=png&color=000000" alt="BHIM" style="width:36px;height:36px;object-fit:contain;border-radius:8px;">
                        <span style="font-size:11px;font-weight:700;color:var(--text-primary);">BHIM</span>
                      </a>

                      <!-- Amazon Pay -->
                      <a href="amazonpay://pay" class="upi-app-btn">
                        <img src="https://img.icons8.com/?size=100&id=qkqX9kwk5D0_&format=png&color=000000" alt="Amazon Pay" style="width:36px;height:36px;object-fit:contain;border-radius:8px;">
                        <span style="font-size:11px;font-weight:700;color:var(--text-primary);">Amazon Pay</span>
                      </a>
                    </div>

                    <button type="button" id="upiCopyPopupCancel" class="btn btn-link w-100 small text-muted text-decoration-none">Cancel</button>
                  </div>
                </div>
              </div>

              <!-- Right Column: QR Code & Screenshot Upload -->
              <div class="col-12 col-md-6 border-start-md">
                <div class="text-center mb-3">
                  <label class="form-label fw-semibold small text-muted text-uppercase d-block mb-2">Scan QR Code to Pay</label>
                  {{#if paymentSetup.hasQrCode}}
                  <img src="/users/payment-setup/qr-code" alt="Payment QR Code" class="img-fluid rounded-3 border shadow-sm" style="max-height:180px; object-fit:contain;">
                  {{else}}
                  <div class="border rounded-3 p-4 bg-body-tertiary text-muted">
                    <i class="bi bi-qr-code fs-1 d-block mb-1 text-secondary"></i>
                    <span class="small">QR Code not uploaded by Admin</span>
                  </div>
                  {{/if}}
                </div>

                <div class="mb-3">
                  <label for="paymentScreenshot" class="form-label fw-semibold">Upload Payment Screenshot <span class="text-danger">*</span></label>
                  <input type="file" name="paymentScreenshot" id="paymentScreenshot" class="form-control" accept="image/*" required>
                  <div class="form-text">Attach receipt/screenshot of the completed payment.</div>
                </div>

                <button type="submit" id="submitPaymentBtn" class="btn btn-primary w-100 rounded-3 py-2 fw-bold mt-3 shadow">
                  <i class="bi bi-upload me-1"></i>Submit Payment Receipt
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================================================== -->
  <!-- PERSONAL DATA REQUIRED POPUP MODAL                    -->
  <!-- ===================================================== -->
  {{#if user.missingPersonalData}}
  <div class="modal fade" id="personalDataPromptModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="personalDataPromptLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
