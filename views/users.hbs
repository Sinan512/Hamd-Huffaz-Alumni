          </div>
          <div class="col-6">
            <div class="mb-3">
              <label class="form-label-custom" for="ep_motherName">
                <span data-en="Mother's Name" data-ml="ഉമ്മയുടെ പേര്">Mother's Name</span>
              </label>
              <input type="text" class="form-control" id="ep_motherName" name="motherName" value="{{user.motherName}}">
            </div>
          </div>
        </div>


        <!-- ── OTHER MISC ── -->
        <div class="form-section-title">
          <span data-en="🏠 Other Details" data-ml="🏠 മറ്റ് വിവരങ്ങൾ">🏠 Other Details</span>
        </div>

        <div class="mb-4">
          <label class="form-label-custom">
            <span data-en="Own a house?" data-ml="സ്വന്തമായി വീടുണ്ടോ?">Own a house?</span>
          </label>
          <div class="radio-group">
            <label>
              <input type="radio" name="ownHouse" value="yes" {{#if user.ownHouse_yes}}checked{{/if}}>
              <span data-en="Yes" data-ml="ഉണ്ട്">Yes</span>
            </label>
            <label>
              <input type="radio" name="ownHouse" value="no" {{#if user.ownHouse_no}}checked{{/if}}>
              <span data-en="No" data-ml="ഇല്ല">No</span>
            </label>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label-custom">
            <span data-en="Married?" data-ml="വിവാഹം കഴിഞ്ഞിട്ടുണ്ടോ?">Married?</span>
          </label>
          <div class="radio-group">
            <label>
              <input type="radio" name="married" value="yes" {{#if user.married_yes}}checked{{/if}}>
              <span data-en="Yes" data-ml="ഉണ്ട്">Yes</span>
            </label>
            <label>
              <input type="radio" name="married" value="no" {{#if user.married_no}}checked{{/if}}>
              <span data-en="No" data-ml="ഇല്ല">No</span>
            </label>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label-custom" for="ep_childrenCount">
            <span data-en="Children (count)" data-ml="കുട്ടികൾ (എണ്ണം)">Children (count)</span>
          </label>
          <input type="number" class="form-control" id="ep_childrenCount" name="childrenCount" value="{{user.childrenCount}}" min="0" placeholder="0">
        </div>

        <!-- SAVE BUTTON -->
        <div class="d-grid mt-2 mb-3">
          <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-3"
            style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border:none;">
            <i class="bi bi-cloud-check me-2"></i>Save Profile
          </button>
        </div>

      </form>
    </div>
  </div><!-- /offcanvas -->


  <!-- ===================================================== -->
  <!-- CHANGE PASSWORD MODAL (separate from Edit Profile)    -->
  <!-- ===================================================== -->
  <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-shield-lock me-2 text-primary"></i>Change Password
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 pb-2">
          <p class="small mb-4" style="color:var(--text-muted);">
            Your password keeps your account secure. Use a strong password you haven't used before.
          </p>
          <div id="changePwAlert" class="alert d-none rounded-3 py-2 px-3 small mb-3"></div>
          <form id="changePasswordForm" onsubmit="handleChangePassword(event)">
            <div class="mb-3">
              <label class="form-label-custom" for="cp_current">Current Password</label>
              <input type="password" class="form-control" id="cp_current" name="currentPassword"
                placeholder="Your current password" required>
            </div>
            <div class="mb-3">
              <label class="form-label-custom" for="cp_new">New Password</label>
              <input type="password" class="form-control" id="cp_new" name="newPassword"
                placeholder="At least 6 characters" required minlength="6">
            </div>
            <div class="mb-4">
              <label class="form-label-custom" for="cp_confirm">Confirm New Password</label>
              <input type="password" class="form-control" id="cp_confirm" name="confirmPassword"
                placeholder="Repeat new password" required minlength="6">
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-primary fw-bold rounded-3"
                style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border:none;">
                Update Password
              </button>
            </div>
          </form>
        </div>
        <div class="modal-footer border-0 pt-2 pb-4 px-4"></div>
      </div>
    </div>
  </div>

  {{else}}
  <!-- ==================== LOGIN VIEW ==================== -->
  <!-- Theme toggle visible even on login page -->
  <div style="position:fixed; top:16px; right:16px; z-index:9999;">
    <button type="button" class="nav-icon-btn border-0" id="themeToggleBtn" aria-label="Toggle theme">
      <i class="bi bi-moon-stars" id="themeToggleIcon"></i>
    </button>
  </div>

  <div class="login-wrapper">
    <div class="login-card">
      <div class="text-center mb-4">
        <div class="login-brand-icon">
          <i class="bi bi-mortarboard-fill"></i>
        </div>
        <h3 class="mt-0 mb-1">Alumni Portal</h3>
        <p class="sub">Sign in to your member dashboard</p>
      </div>

      {{#if error}}
      <div class="alert alert-danger py-2 small rounded-3 mb-3">
        <i class="bi bi-exclamation-circle me-1"></i>{{error}}
      </div>
      {{/if}}

      <form method="POST" action="/users/login">
        <div class="mb-3">
          <label class="form-label-custom" for="loginName">Full Name</label>
          <input type="text" name="name" id="loginName" class="form-control"
            placeholder="Enter your full name" required autocomplete="name">
        </div>
        <div class="mb-4">
          <label class="form-label-custom" for="loginPassword">Password</label>
          <input type="password" name="password" id="loginPassword" class="form-control"
            placeholder="Enter your password" required autocomplete="current-password">
        </div>
        <div class="d-grid">
          <button type="submit" class="btn btn-primary fw-bold rounded-3"
            style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border:none; padding:11px;">
            <i class="bi bi-box-arrow-in-right me-2"></i>Login
          </button>
        </div>
      </form>

    </div>
  </div>
  {{/if}}

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
  /* ============================================================ */
  /* THEME TOGGLE                                                  */
  /* ============================================================ */
  (function () {
    var btn  = document.getElementById('themeToggleBtn');
    var icon = document.getElementById('themeToggleIcon');

    function applyTheme(t) {
      document.documentElement.setAttribute('data-bs-theme', t);
      try { localStorage.setItem('userTheme', t); } catch (e) {}
      if (icon) {
        icon.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars';
      }
    }

    // Set icon to match current theme on load
    var current = document.documentElement.getAttribute('data-bs-theme') || 'light';
    applyTheme(current);

    if (btn) {
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-bs-theme') || 'light';
        applyTheme(cur === 'dark' ? 'light' : 'dark');
      });
    }
  })();


  /* ============================================================ */
  /* GALLERY POPUP                                                 */
  /* ============================================================ */
  document.addEventListener('click', function (e) {
    var trigger = e.target.closest('[data-gallery-popup]');
    if (!trigger) return;

    var src  = trigger.getAttribute('data-img-src');
    var desc = trigger.getAttribute('data-img-desc') || '';

    var popupImg     = document.getElementById('galleryPopupImg');
    var popupCaption = document.getElementById('galleryPopupCaption');

    if (popupImg)     popupImg.src         = src;
    if (popupImg)     popupImg.alt         = desc;
    if (popupCaption) popupCaption.textContent = desc || 'Gallery Image';

    var modalEl = document.getElementById('galleryPopupModal');
    if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
  });


  /* ============================================================ */
  /* EVENT REGISTRATION                                            */
  /* ============================================================ */
  var _pendingRegEventId    = null;
  var _pendingRegEventTitle = null;

  // Get registration state key per user
  var REG_STORAGE_KEY = 'alumni_registrations_{{#if user}}{{user.admissionNumber}}{{/if}}';

  function getRegistrations() {
    try {
      return JSON.parse(localStorage.getItem(REG_STORAGE_KEY) || '{}');
    } catch (e) { return {}; }
  }

  function saveRegistrations(obj) {
    try { localStorage.setItem(REG_STORAGE_KEY, JSON.stringify(obj)); } catch (e) {}
  }


  function openRegisterConfirm(eventId, eventTitle) {
    var btn = document.getElementById('reg-btn-' + eventId);
    if (btn && btn.classList.contains('btn-registered')) return; // already done

    _pendingRegEventId    = eventId;
    _pendingRegEventTitle = eventTitle;

    var titleEl = document.getElementById('regConfirmEventTitle');
    if (titleEl) titleEl.textContent = eventTitle;

  }

  function markRegistered(btn) {
    btn.className   = 'btn-registered';
    btn.innerHTML   = '<i class="bi bi-check-circle-fill me-1"></i>Registered';
    btn.onclick     = null;
    btn.disabled    = false;
  }

  document.addEventListener('DOMContentLoaded', function () {
    var confirmBtn = document.getElementById('regConfirmYesBtn');
    if (confirmBtn) {
      confirmBtn.addEventListener('click', function () {
        
          if (!_pendingRegEventId) return;

fetch('/user/register-event/' + _pendingRegEventId, {
  method: 'POST'
})
.then(function(res) {
  if (!res.ok) throw new Error();
  location.reload();
})
.catch(function() {
  alert('Registration failed');
});
      });
    }
  });


  /* ============================================================ */
  /* LANGUAGE TOGGLE (Edit Profile form)                           */
  /* ============================================================ */
  var currentLang = 'en';

  function setLang(lang) {
    currentLang = lang;
    document.querySelectorAll('[data-en][data-ml]').forEach(function (el) {
      el.textContent = lang === 'ml' ? el.getAttribute('data-ml') : el.getAttribute('data-en');
    });
    document.getElementById('btnLangEn').classList.toggle('active', lang === 'en');
    document.getElementById('btnLangMl').classList.toggle('active', lang === 'ml');
  }


  /* ============================================================ */
  /* JOB / STUDY CONDITIONAL FIELDS                               */
  /* ============================================================ */
  function toggleJobStudy() {
    var val = document.getElementById('ep_status').value;
    var showJob   = (val === 'Job'  || val === 'Job & Study');
    var showStudy = (val === 'Study'|| val === 'Job & Study');
    var jobDiv   = document.getElementById('jobFields');
    var studyDiv = document.getElementById('studyFields');
    if (jobDiv)   jobDiv.style.display   = showJob   ? 'block' : 'none';
    if (studyDiv) studyDiv.style.display = showStudy ? 'block' : 'none';
  }

  // Run on load to restore saved state
  document.addEventListener('DOMContentLoaded', function () {
    toggleJobStudy();
  });


  /* ============================================================ */
  /* SAVE PROFILE FORM                                             */
  /* ============================================================ */
  function handleSaveProfile(e) {
    e.preventDefault();

    var alertEl = document.getElementById('profileSaveAlert');
    var form    = document.getElementById('editProfileForm');
    var btn     = form.querySelector('[type="submit"]');
    var origTxt = btn.innerHTML;

    function showAlert(type, msg) {
      alertEl.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-3';
      alertEl.textContent = msg;
      alertEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    btn.disabled  = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';

    var data = {};
    var fd   = new FormData(form);
    fd.forEach(function (val, key) { data[key] = val; });

    fetch('/user/profile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(function (res) {
      return res.json().then(function (d) { return { ok: res.ok, data: d }; });
    })
    .then(function (result) {
      if (result.ok && result.data && result.data.success) {
        showAlert('success', result.data.message || 'Profile saved successfully.');
      } else {
        showAlert('danger', (result.data && result.data.message) || 'Could not save profile. Please try again.');
      }
    })
    .catch(function () {
      showAlert('danger', 'Network error. Please check your connection and try again.');
    })
    .finally(function () {
      btn.disabled  = false;
      btn.innerHTML = origTxt;
    });
  }


  /* ============================================================ */
  /* CHANGE PASSWORD                                               */
  /* ============================================================ */
  function handleChangePassword(e) {
    e.preventDefault();

    var alertEl = document.getElementById('changePwAlert');
    var form    = document.getElementById('changePasswordForm');
    var btn     = form.querySelector('[type="submit"]');
    var origTxt = btn.textContent;

    function showAlert(type, msg) {
      alertEl.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-3';
      alertEl.textContent = msg;
    }

    var curr    = document.getElementById('cp_current').value;
    var newPw   = document.getElementById('cp_new').value;
    var confirm = document.getElementById('cp_confirm').value;

    if (newPw !== confirm) {
      showAlert('danger', 'New password and confirmation do not match.');
      return;
    }

    btn.disabled  = true;
    btn.textContent = 'Updating…';
    alertEl.className = 'alert d-none';

    fetch('/user/change-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ currentPassword: curr, newPassword: newPw })
    })
    .then(function (res) {
      return res.json().then(function (d) { return { ok: res.ok, data: d }; });
    })
    .then(function (result) {
      if (result.ok && result.data && result.data.success) {
        showAlert('success', result.data.message || 'Password updated successfully.');
        form.reset();
      } else {
        showAlert('danger', (result.data && result.data.message) || 'Could not update password.');
      }
    })
    .catch(function () {
      showAlert('danger', 'Network error. Please try again.');
    })
    .finally(function () {
      btn.disabled    = false;
      btn.textContent = origTxt;
    });
  }
  </script>

</body>
</html>
