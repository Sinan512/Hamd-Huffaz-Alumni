            <option value="" {{#unless user.currentStatus}}selected{{/unless}}>-- Select --</option>
            <option value="Job" {{#if user.currentStatus_job}}selected{{/if}}>Job</option>
            <option value="Study" {{#if user.currentStatus_study}}selected{{/if}}>Study</option>
            <option value="Job & Study" {{#if user.currentStatus_both}}selected{{/if}}>Job &amp; Study</option>
            <option value="Other" {{#if user.currentStatus_other}}selected{{/if}}>Other</option>
          </select>
        </div>

        <!-- Job fields -->
        <div id="jobFields" style="display:none;">
          <div class="mb-3">
            <label class="form-label-custom" for="ep_workLocation">
              <span data-en="Work Location" data-ml="ജോലി ചെയ്യുന്ന സ്ഥലം">Work Location</span>
            </label>
            <input type="text" class="form-control" id="ep_workLocation" name="workLocation" value="{{user.workLocation}}" placeholder="City / Country">
          </div>
          <div class="mb-3">
            <label class="form-label-custom" for="ep_jobRole">
              <span data-en="Job Role" data-ml="നിങ്ങളുടെ ജോലി">Job Role</span>
            </label>
            <input type="text" class="form-control" id="ep_jobRole" name="jobRole" value="{{user.jobRole}}" placeholder="e.g. Software Engineer, Teacher...">
          </div>
        </div>

        <!-- Study fields -->
        <div id="studyFields" style="display:none;">
          <div class="mb-3">
            <label class="form-label-custom" for="ep_college">
              <span data-en="Current College" data-ml="നിലവിൽ പഠിക്കുന്ന കോളേജ്">Current College</span>
            </label>
            <input type="text" class="form-control" id="ep_college" name="college" value="{{user.college}}" placeholder="College name">
          </div>
          <div class="mb-3">
            <label class="form-label-custom" for="ep_course">
              <span data-en="Course" data-ml="നിലവിൽ പഠിച്ച് കൊണ്ടിരിക്കുന്ന കോഴ്സ്">Course</span>
            </label>
            <input type="text" class="form-control" id="ep_course" name="course" value="{{user.course}}" placeholder="e.g. B.Tech CSE">
          </div>
        </div>


        <!-- ── OTHER INFO ── -->
        <div class="form-section-title">
          <span data-en="🌟 Other Information" data-ml="🌟 മറ്റു വിവരങ്ങൾ">🌟 Other Information</span>
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="ep_skills">
            <span data-en="Creative Skills" data-ml="സർഗാത്മക കഴിവുകൾ">Creative Skills</span>
          </label>
          <input type="text" class="form-control" id="ep_skills" name="skills" value="{{user.skills}}" placeholder="e.g. Calligraphy, Oratory, Quran recitation...">
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="ep_languages">
            <span data-en="Languages Known" data-ml="അറിയുന്ന ഭാഷകൾ">Languages Known</span>
          </label>
          <input type="text" class="form-control" id="ep_languages" name="languages" value="{{user.languages}}" placeholder="e.g. Malayalam, Arabic, English...">
        </div>

        <div class="mb-4">
          <label class="form-label-custom" for="ep_orgRoles">
            <span data-en="Organizational Roles" data-ml="സംഘടനാ ഭാരവാഹിത്വം">Organizational Roles</span>
          </label>
          <input type="text" class="form-control" id="ep_orgRoles" name="orgRoles" value="{{user.orgRoles}}" placeholder="e.g. Secretary, President...">
        </div>


        <!-- ── FAMILY DETAILS ── -->
        <div class="form-section-title">
          <span data-en="🔹 Family Details" data-ml="🔹 കുടുംബ വിവരങ്ങൾ">🔹 Family Details</span>
        </div>

        <div class="row g-3">
          <div class="col-6">
            <div class="mb-3">
              <label class="form-label-custom" for="ep_familyCount">
                <span data-en="Family Members Count" data-ml="കുടുംബത്തിലെ അംഗങ്ങൾ">Family Members</span>
              </label>
              <input type="number" class="form-control" id="ep_familyCount" name="familyCount" value="{{user.familyCount}}" min="0" placeholder="Total count">
            </div>
          </div>
          <div class="col-6">
            <div class="mb-3">
              <label class="form-label-custom" for="ep_earningMembers">
                <span data-en="Earning Members" data-ml="ഫാമിലിയിൽ ആരൊക്കെ ജോലി ചെയ്യുന്നുണ്ട്">Earning Members</span>
              </label>
              <input type="text" class="form-control" id="ep_earningMembers" name="earningMembers" value="{{user.earningMembers}}" placeholder="Who earns in family">
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label-custom">
            <span data-en="Dependents?" data-ml="ആശ്രിതരുടെ എണ്ണം">Dependents?</span>
          </label>
          <div class="radio-group mb-2">
            <label>
              <input type="radio" name="hasDependents" value="yes" id="depYes"
                onchange="document.getElementById('depWhoWrap').style.display='block'"
                {{#if user.hasDependents_yes}}checked{{/if}}>
              <span data-en="Yes" data-ml="ഉണ്ട്">Yes</span>
            </label>
            <label>
              <input type="radio" name="hasDependents" value="no" id="depNo"
                onchange="document.getElementById('depWhoWrap').style.display='none'"
                {{#if user.hasDependents_no}}checked{{/if}}>
              <span data-en="No" data-ml="ഇല്ല">No</span>
            </label>
          </div>
          <div id="depWhoWrap" style="display:{{#if user.hasDependents_yes}}block{{else}}none{{/if}};">
            <input type="text" class="form-control" name="dependentsWho" value="{{user.dependentsWho}}"
              placeholder="Who are the dependents?">
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label-custom">
            <span data-en="Parents deceased?" data-ml="മാതാപിതാക്കൾ മരണപ്പെട്ടിട്ടുണ്ടോ?">Parents deceased?</span>
          </label>
          <div class="radio-group">
            <label>
              <input type="radio" name="parentsDeceased" value="yes" {{#if user.parentsDeceased_yes}}checked{{/if}}>
              <span data-en="Yes" data-ml="ഉണ്ട്">Yes</span>
            </label>
            <label>
              <input type="radio" name="parentsDeceased" value="no" {{#if user.parentsDeceased_no}}checked{{/if}}>
              <span data-en="No" data-ml="ഇല്ല">No</span>
            </label>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label-custom">
            <span data-en="Chronically ill family members?" data-ml="വീട്ടിൽ നിത്യ രോഗികൾ ഉണ്ടോ?">Chronically ill family members?</span>
          </label>
          <div class="radio-group mb-2">
            <label>
              <input type="radio" name="chronicIll" value="yes" id="ciYes"
                onchange="document.getElementById('ciDetailWrap').style.display='block'"
                {{#if user.chronicIll_yes}}checked{{/if}}>
              <span data-en="Yes" data-ml="ഉണ്ട്">Yes</span>
            </label>
            <label>
              <input type="radio" name="chronicIll" value="no" id="ciNo"
                onchange="document.getElementById('ciDetailWrap').style.display='none'"
                {{#if user.chronicIll_no}}checked{{/if}}>
              <span data-en="No" data-ml="ഇല്ല">No</span>
            </label>
          </div>
          <div id="ciDetailWrap" style="display:{{#if user.chronicIll_yes}}block{{else}}none{{/if}};">
            <input type="text" class="form-control" name="chronicIllDetails" value="{{user.chronicIllDetails}}"
              placeholder="Who? What illness?">
          </div>
        </div>


        <!-- ── PARENTS INFO ── -->
        <div class="form-section-title">
          <span data-en="👪 Parents' Details" data-ml="👪 മാതാപിതാക്കളുടെ വിവരങ്ങൾ">👪 Parents' Details</span>
        </div>

        <div class="row g-3">
          <div class="col-6">
            <div class="mb-3">
              <label class="form-label-custom" for="ep_fatherName">
