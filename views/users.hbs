            <!-- Quick Study fields -->
            <div id="quickStudyFields" style="display:none;">
              <div class="mb-3">
                <label class="form-label fw-semibold small text-muted text-uppercase mb-1" for="quick_college">
                  Current College
                </label>
                <input type="text" class="form-control rounded-3" id="quick_college" name="college" value="{{user.college}}" placeholder="College name">
              </div>
              <div class="mb-3">
                <label class="form-label fw-semibold small text-muted text-uppercase mb-1" for="quick_collegePlace">
