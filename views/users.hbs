                    <button type="button" class="btn btn-outline-secondary" onclick="copyTextFromInput('upiIdCopyText', 'UPI ID')">
                      <i class="bi bi-copy me-1"></i>Copy
                    </button>
                  </div>
                </div>

                <!-- Proceed to UPI App Button -->
                <div class="mt-4">
                  <a href="#" id="proceedUpiLink" target="_blank" class="btn btn-success w-100 rounded-3 py-2 fw-bold shadow-sm">
                    <i class="bi bi-box-arrow-up-right me-2"></i>Proceed to UPI App
                  </a>
                  <div class="form-text text-center small mt-1">Launches your UPI app (GPay / PhonePe / Paytm) with pre-filled amount.</div>
                </div>
              </div>

              <!-- Right Column: QR Code & Screenshot Upload -->
              <div class="col-12 col-md-6 border-start-md">
                <div class="text-center mb-3">
                  <label class="form-label fw-semibold small text-muted text-uppercase d-block mb-1">Scan QR Code to Pay</label>
                  {{#if paymentSetup.hasQrCode}}
                  <img src="/users/payment-setup/qr-code" alt="Payment QR Code" class="img-fluid rounded-3 border shadow-sm" style="max-height:180px; object-fit:contain;">
                  {{else}}
                  <div class="border rounded-3 p-4 bg-body-tertiary text-muted">
                    <i class="bi bi-qr-code fs-1 d-block mb-1 text-secondary"></i>
                    <span class="small">QR Code not uploaded by Admin</span>
                  </div>
                  {{/if}}
                </div>

                <div class="mb-3">
                  <label for="paymentScreenshot" class="form-label fw-semibold">Upload Payment Screenshot <span class="text-danger">*</span></label>
                  <input type="file" name="paymentScreenshot" id="paymentScreenshot" class="form-control" accept="image/*" required>
                  <div class="form-text">Attach receipt/screenshot of the completed payment.</div>
                </div>

                <button type="submit" id="submitPaymentBtn" class="btn btn-primary w-100 rounded-3 py-2 fw-bold mt-3">
                  <i class="bi bi-upload me-1"></i>Submit Payment Receipt
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== UNPAID MONTHS POPUP MODAL ===== -->
  {{#if contribution.hasUnpaidMonths}}
  <div class="modal fade" id="unpaidMonthsPopupModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="unpaidMonthsPopupLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow">
        <div class="modal-header border-bottom bg-warning-subtle text-warning-emphasis px-4 py-3">
          <h5 class="modal-title fw-bold" id="unpaidMonthsPopupLabel">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Unpaid Monthly Contributions
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 py-3">
          <p class="mb-2">You have <strong class="text-danger">{{contribution.unpaidCount}}</strong> unpaid monthly contribution(s) pending:</p>
          <div class="p-3 bg-body-tertiary rounded-3 border mb-3 fw-bold text-dark text-break">
            {{contribution.unpaidListLabels}}
          </div>
          <p class="small text-muted mb-0">Please clear your contribution payments to support alumni activities.</p>
        </div>
        <div class="modal-footer border-top px-4 py-3 d-flex justify-content-between">
          <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Pay Later</button>
          <button type="button" class="btn btn-primary rounded-3 px-4 fw-bold" id="unpaidPayNowBtn">Pay Now</button>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

  <!-- ===== CONTRIBUTION PAYMENT SCRIPT ===== -->
  <script>
    (function () {
      var checkboxes = document.querySelectorAll('.month-checkbox');
      var countEl = document.getElementById('selectedMonthsCount');
      var totalEl = document.getElementById('selectedTotalAmount');
      var payBtn = document.getElementById('openPayModalBtn');

      var modalSelectedList = document.getElementById('modalSelectedMonthsList');
      var modalTotalEl = document.getElementById('modalTotalAmount');
      var proceedUpiLink = document.getElementById('proceedUpiLink');

      var form = document.getElementById('submitContributionForm');
      var alertBox = document.getElementById('paymentModalAlert');
      var submitBtn = document.getElementById('submitPaymentBtn');

      function getSelectedMonths() {
        var selected = [];
        checkboxes.forEach(function (cb) {
          if (cb.checked && !cb.disabled) {
            selected.push({
              key: cb.value,
              month: cb.getAttribute('data-month'),
              year: cb.getAttribute('data-year'),
              label: cb.getAttribute('data-label'),
              amount: Number(cb.getAttribute('data-amount')) || 30
            });
          }
        });
        return selected;
      }

      function updateSummary() {
        var selected = getSelectedMonths();
        var count = selected.length;
        var total = count * 30;

        if (countEl) countEl.textContent = String(count);
        if (totalEl) totalEl.textContent = String(total);
        if (payBtn) payBtn.disabled = (count === 0);
      }

      function drawReceiptLine(ctx, label, value, y) {
        ctx.font = '600 22px Arial';
        ctx.fillStyle = '#64748b';
        ctx.fillText(label, 90, y);
        ctx.font = '600 22px Arial';
        ctx.fillStyle = '#172033';
        ctx.fillText(value || '—', 330, y);
      }

      function downloadReceipt(button) {
        var canvas = document.createElement('canvas');
        canvas.width = 1200;
        canvas.height = 900;
        var ctx = canvas.getContext('2d');
        var contributionSection = document.getElementById('contribution-section');
        var memberName = button.getAttribute('data-receipt-name') ||
          (contributionSection && contributionSection.getAttribute('data-member-name')) || '';
        var admissionNumber = button.getAttribute('data-receipt-admission') ||
          (contributionSection && contributionSection.getAttribute('data-member-admission')) || '';

        ctx.fillStyle = '#f8fafc';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#4f46e5';
        ctx.fillRect(0, 0, canvas.width, 150);
        ctx.fillStyle = '#ffffff';
        ctx.font = '700 38px Arial';
        ctx.fillText('HAMD Alumni Association', 90, 70);
        ctx.font = '500 23px Arial';
        ctx.fillText('Monthly Contribution Receipt', 90, 112);

        ctx.fillStyle = '#16a34a';
        ctx.beginPath();
        ctx.arc(1040, 75, 42, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = '700 48px Arial';
        ctx.fillText('✓', 1025, 91);

        ctx.fillStyle = '#172033';
        ctx.font = '700 28px Arial';
        ctx.fillText('Payment completed', 90, 220);
        drawReceiptLine(ctx, 'Member name', memberName, 285);
        drawReceiptLine(ctx, 'Admission no.', admissionNumber, 335);
        drawReceiptLine(ctx, 'Contribution month', button.getAttribute('data-receipt-month'), 385);
        drawReceiptLine(ctx, 'Amount paid', '₹' + (button.getAttribute('data-receipt-amount') || '30'), 435);
        drawReceiptLine(ctx, 'Approved by', button.getAttribute('data-receipt-approved-by'), 485);
        drawReceiptLine(ctx, 'Completed at', button.getAttribute('data-receipt-time'), 535);
        drawReceiptLine(ctx, 'Submitted at', button.getAttribute('data-receipt-submitted-time'), 585);
        drawReceiptLine(ctx, 'Payment reference', button.getAttribute('data-receipt-payment-id'), 635);

        ctx.strokeStyle = '#cbd5e1';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(90, 700);
        ctx.lineTo(1110, 700);
        ctx.stroke();
        ctx.fillStyle = '#64748b';
        ctx.font = '500 18px Arial';
        ctx.fillText('This is a digitally generated confirmation of the approved contribution.', 90, 755);
        ctx.fillText('Thank you for supporting HAMD alumni activities.', 90, 790);

        var link = document.createElement('a');
        var month = button.getAttribute('data-receipt-month') || 'contribution';
        link.download = 'HAMD-Contribution-Receipt-' + month.replace(/[^a-z0-9]+/gi, '-') + '.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      }

      checkboxes.forEach(function (cb) {
        cb.addEventListener('change', updateSummary);
      });

      document.querySelectorAll('.resubmit-month-btn').forEach(function (button) {
        button.addEventListener('click', function () {
          var key = button.getAttribute('data-month-key');
          var checkbox = document.getElementById('mchk-' + key);
          if (!checkbox || !payBtn) return;
          checkbox.disabled = false;
          checkbox.checked = true;
          var card = checkbox.closest('.month-card');
          if (card) card.classList.remove('opacity-75');
          updateSummary();
          payBtn.click();
        });
      });

      document.querySelectorAll('.download-receipt-btn').forEach(function (button) {
        button.addEventListener('click', function () {
          downloadReceipt(button);
        });
      });

      if (payBtn) {
        payBtn.addEventListener('click', function () {
          var selected = getSelectedMonths();
          if (selected.length === 0) return;

          var labels = selected.map(function (s) { return s.label; }).join(', ');
          var total = selected.length * 30;

          if (modalSelectedList) modalSelectedList.textContent = labels;
          if (modalTotalEl) modalTotalEl.textContent = String(total);

          var upiId = (document.getElementById('upiIdCopyText') ? document.getElementById('upiIdCopyText').value : '').trim();
          if (proceedUpiLink) {
            if (upiId && upiId !== 'Not set') {
              proceedUpiLink.href = 'upi://pay?pa=' + encodeURIComponent(upiId) + '&pn=HAMD%20Alumni&am=' + total + '&cu=INR';
            } else {
              proceedUpiLink.href = '#';
            }
          }

          var modalEl = document.getElementById('payContributionModal');
          if (modalEl && window.bootstrap) {
            var modalInst = window.bootstrap.Modal.getInstance(modalEl) || new window.bootstrap.Modal(modalEl);
            modalInst.show();
          }
        });
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (!alertBox) return;

          alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-3';
          alertBox.textContent = '';

          var selected = getSelectedMonths();
          if (selected.length === 0) {
            alertBox.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
            alertBox.textContent = 'Please select at least one month to pay.';
            return;
          }

          var fileInput = document.getElementById('paymentScreenshot');
          var file = fileInput && fileInput.files && fileInput.files[0];
          if (!file) {
            alertBox.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
            alertBox.textContent = 'Please select a payment screenshot image.';
            return;
          }

          submitBtn.disabled = true;
          var originalText = submitBtn.innerHTML;
          submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Submitting...';

          var formData = new FormData();
          var monthKeys = selected.map(function (s) { return s.key; });
          formData.append('months', JSON.stringify(monthKeys));
          formData.append('paymentScreenshot', file);

          fetch('/users/submit-contribution-payment', {
            method: 'POST',
            body: formData
          })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }); })
            .then(function (result) {
              if (!result.ok || !result.data.success) {
                alertBox.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
                alertBox.textContent = (result.data && result.data.message) || 'Could not submit payment.';
                return;
              }

              alertBox.className = 'alert alert-success rounded-3 py-2 px-3 small mb-3';
              alertBox.textContent = result.data.message || 'Payment submitted successfully!';

              selected.forEach(function (s) {
                var cb = document.getElementById('mchk-' + s.key);
                if (cb) {
                  cb.checked = false;
                  cb.disabled = true;
                  var card = cb.closest('.month-card');
                  if (card) {
                    card.classList.add('bg-body-tertiary', 'opacity-75');
                    var badge = card.querySelector('.badge');
                    if (badge) {
                      badge.className = 'badge bg-warning text-dark px-2 py-1';
                      badge.textContent = 'PENDING';
                    }
                  }
                }
              });

              updateSummary();

              setTimeout(function () {
                var modalEl = document.getElementById('payContributionModal');
                if (modalEl && window.bootstrap) {
                  var inst = window.bootstrap.Modal.getInstance(modalEl);
                  if (inst) inst.hide();
                }
                form.reset();
              }, 1200);
            })
            .catch(function () {
              alertBox.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
              alertBox.textContent = 'Network error while submitting payment.';
            })
            .finally(function () {
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalText;
            });
        });
      }

      document.addEventListener('DOMContentLoaded', function () {
        var unpaidModalEl = document.getElementById('unpaidMonthsPopupModal');
        if (unpaidModalEl && window.bootstrap) {
          var unpaidInst = new window.bootstrap.Modal(unpaidModalEl);
          unpaidInst.show();

          var payNowBtn = document.getElementById('unpaidPayNowBtn');
          if (payNowBtn) {
            payNowBtn.addEventListener('click', function () {
              unpaidInst.hide();
              var targetSec = document.getElementById('contribution-section');
              if (targetSec) {
                targetSec.scrollIntoView({ behavior: 'smooth' });
              }
            });
          }
        }
      });
    })();

    function copyTextFromInput(inputId, labelName) {
      var input = document.getElementById(inputId);
      if (!input || !input.value || input.value === 'Not set') return;
      navigator.clipboard.writeText(input.value.trim()).then(function () {
        alert(labelName + ' copied to clipboard!');
      }).catch(function () {
        input.select();
        document.execCommand('copy');
        alert(labelName + ' copied to clipboard!');
      });
    }
  </script>

</body>
</html>
