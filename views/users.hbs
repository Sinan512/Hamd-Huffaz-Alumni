  /* ============================================================ */
  /* SHARED FETCH HELPERS                                          */
  /* ============================================================ */
  function readJsonResponse(res) {
    return res.text().then(function (text) {
      var data = null;
      try { data = text ? JSON.parse(text) : null; } catch (e) { data = null; }
      return { ok: res.ok, status: res.status, data: data };
    });
  }

  function serverMessage(result, fallback) {
    if (result && result.status === 401) {
      return 'Your session has expired. Please log in again.';
    }
    if (result && result.data && result.data.message) {
      return result.data.message;
    }
    if (result && result.status === 404) {
      return 'The server could not find this action (404). Please refresh the page and try again.';
    }
    if (result && result.status) {
      return fallback + ' (server responded ' + result.status + ')';
    }
    return fallback;
  }

  /* ============================================================ */
  /* EVENT REGISTRATION LOGIC                                     */
  /* ============================================================ */
  var _pendingRegEventId    = null;
  var _pendingRegEventTitle = null;

  function openRegisterConfirm(eventId, eventTitle) {
    var btn = document.getElementById('reg-btn-' + eventId);
    if (btn && btn.classList.contains('btn-registered')) return;

    _pendingRegEventId    = eventId;
    _pendingRegEventTitle = eventTitle;

    var titleEl = document.getElementById('regConfirmEventTitle');
    if (titleEl) titleEl.textContent = eventTitle;

    var modalEl = document.getElementById('registerConfirmModal');
    if (modalEl && window.bootstrap && window.bootstrap.Modal) {
      window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }
  }

  function markRegistered(btn) {
    btn.className   = 'btn-registered';
    btn.innerHTML   = '<i class="bi bi-check-circle-fill me-1"></i>Registered';
    btn.onclick     = null;
    btn.disabled    = false;
  }

  document.addEventListener('DOMContentLoaded', function () {
    var confirmBtn = document.getElementById('regConfirmYesBtn');
    if (!confirmBtn) return;

    confirmBtn.addEventListener('click', function () {
      if (!_pendingRegEventId) return;

      var eventId  = _pendingRegEventId;
      var origHtml = confirmBtn.innerHTML;
      confirmBtn.disabled  = true;
      confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Registering…';

      fetch('/users/user/register-event/' + encodeURIComponent(eventId), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin'
      })
      .then(readJsonResponse)
      .then(function (result) {
        if (result.ok && result.data && result.data.success) {
          var btn = document.getElementById('reg-btn-' + eventId);
          if (btn) markRegistered(btn);

          var modalEl = document.getElementById('registerConfirmModal');
          if (modalEl && window.bootstrap && window.bootstrap.Modal) {
            window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
          }
          _pendingRegEventId = null;
          alert(result.data.message || 'Registered successfully.');
        } else {
          alert(serverMessage(result, 'Could not register for this event. Please try again.'));
        }
      })
      .catch(function () {
        alert('Could not reach the server. Please try again.');
      })
      .finally(function () {
        confirmBtn.disabled  = false;
        confirmBtn.innerHTML = origHtml;
      });
    });
  });

