  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
  /* ============================================================ */
  /* THEME TOGGLE                                                  */
  /* ============================================================ */
  (function () {
    var btn  = document.getElementById('themeToggleBtn');
    var icon = document.getElementById('themeToggleIcon');

    function applyTheme(t) {
      document.documentElement.setAttribute('data-bs-theme', t);
      try { localStorage.setItem('userTheme', t); } catch (e) {}
      if (icon) {
        icon.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars';
      }
    }

    // Set icon to match current theme on load
    var current = document.documentElement.getAttribute('data-bs-theme') || 'light';
    applyTheme(current);

    if (btn) {
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-bs-theme') || 'light';
        applyTheme(cur === 'dark' ? 'light' : 'dark');
      });
    }
  })();


  /* ============================================================ */
  /* GALLERY POPUP                                                 */
  /* ============================================================ */
  document.addEventListener('click', function (e) {
    var trigger = e.target.closest('[data-gallery-popup]');
    if (!trigger) return;

    var src  = trigger.getAttribute('data-img-src');
    var desc = trigger.getAttribute('data-img-desc') || '';

    var popupImg     = document.getElementById('galleryPopupImg');
    var popupCaption = document.getElementById('galleryPopupCaption');

    if (popupImg)     popupImg.src         = src;
    if (popupImg)     popupImg.alt         = desc;
    if (popupCaption) popupCaption.textContent = desc || 'Gallery Image';

    var modalEl = document.getElementById('galleryPopupModal');
    if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
  });


  /* ============================================================ */
  /* SHARED FETCH HELPERS                                          */
  /* ============================================================ */
  /* Reads a response as JSON, but never throws when the server
     replied with HTML (404 / 500 page) — so the UI can show a real
     message instead of a misleading "network error". */
  function readJsonResponse(res) {
    return res.text().then(function (text) {
      var data = null;
      try { data = text ? JSON.parse(text) : null; } catch (e) { data = null; }
      return { ok: res.ok, status: res.status, data: data };
    });
  }

  function serverMessage(result, fallback) {
    if (result && result.status === 401) {
      return 'Your session has expired. Please log in again.';
    }
    if (result && result.data && result.data.message) {
      return result.data.message;
    }
    if (result && result.status === 404) {
      return 'The server could not find this action (404). Please refresh the page and try again.';
    }
    if (result && result.status) {
      return fallback + ' (server responded ' + result.status + ')';
    }
    return fallback;
  }

  /* ============================================================ */
  /* EVENT REGISTRATION                                            */
  /* ============================================================ */
  var _pendingRegEventId    = null;
  var _pendingRegEventTitle = null;

  function openRegisterConfirm(eventId, eventTitle) {
    var btn = document.getElementById('reg-btn-' + eventId);
    if (btn && btn.classList.contains('btn-registered')) return; // already done

    _pendingRegEventId    = eventId;
    _pendingRegEventTitle = eventTitle;

    var titleEl = document.getElementById('regConfirmEventTitle');
    if (titleEl) titleEl.textContent = eventTitle;

    var modalEl = document.getElementById('registerConfirmModal');
    if (modalEl && window.bootstrap && window.bootstrap.Modal) {
      window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }
  }

  function markRegistered(btn) {
    btn.className   = 'btn-registered';
    btn.innerHTML   = '<i class="bi bi-check-circle-fill me-1"></i>Registered';
    btn.onclick     = null;
    btn.disabled    = false;
  }

  document.addEventListener('DOMContentLoaded', function () {
    var confirmBtn = document.getElementById('regConfirmYesBtn');
    if (!confirmBtn) return;

    confirmBtn.addEventListener('click', function () {
      if (!_pendingRegEventId) return;

      var eventId  = _pendingRegEventId;
      var origHtml = confirmBtn.innerHTML;
      confirmBtn.disabled  = true;
      confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Registering…';

      fetch('/users/user/register-event/' + encodeURIComponent(eventId), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin'
      })
      .then(readJsonResponse)
      .then(function (result) {
        if (result.ok && result.data && result.data.success) {
          var btn = document.getElementById('reg-btn-' + eventId);
          if (btn) markRegistered(btn);

          var modalEl = document.getElementById('registerConfirmModal');
          if (modalEl && window.bootstrap && window.bootstrap.Modal) {
            window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
          }
          _pendingRegEventId = null;
          alert(result.data.message || 'Registered successfully.');
        } else {
          alert(serverMessage(result, 'Could not register for this event. Please try again.'));
        }
      })
      .catch(function () {
        alert('Could not reach the server. Please try again.');
      })
      .finally(function () {
        confirmBtn.disabled  = false;
        confirmBtn.innerHTML = origHtml;
      });
    });
  });


  /* ============================================================ */
  /* LANGUAGE TOGGLE (Edit Profile form)                           */
  /* ============================================================ */
  var currentLang = 'en';

  function setLang(lang) {
    currentLang = lang;
    document.querySelectorAll('[data-en][data-ml]').forEach(function (el) {
      el.textContent = lang === 'ml' ? el.getAttribute('data-ml') : el.getAttribute('data-en');
    });
    document.getElementById('btnLangEn').classList.toggle('active', lang === 'en');
    document.getElementById('btnLangMl').classList.toggle('active', lang === 'ml');
  }


  /* ============================================================ */
  /* JOB / STUDY CONDITIONAL FIELDS                               */
  /* ============================================================ */
  function toggleJobStudy() {
    var val = document.getElementById('ep_status').value;
    var showJob   = (val === 'Job'  || val === 'Job & Study');
    var showStudy = (val === 'Study'|| val === 'Job & Study');
    var jobDiv   = document.getElementById('jobFields');
    var studyDiv = document.getElementById('studyFields');
    if (jobDiv)   jobDiv.style.display   = showJob   ? 'block' : 'none';
    if (studyDiv) studyDiv.style.display = showStudy ? 'block' : 'none';
  }

  // Run on load to restore saved state
  document.addEventListener('DOMContentLoaded', function () {
    toggleJobStudy();
  });


  /* ============================================================ */
  /* SAVE PROFILE FORM                                             */
  /* ============================================================ */
  function handleSaveProfile(e) {
    e.preventDefault();

    var alertEl = document.getElementById('profileSaveAlert');
    var form    = document.getElementById('editProfileForm');
    var btn     = form.querySelector('[type="submit"]');
    var origTxt = btn.innerHTML;

    function showAlert(type, msg) {
      alertEl.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-3';
      alertEl.textContent = msg;
      alertEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    btn.disabled  = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';

    var data = {};
    var fd   = new FormData(form);
    fd.forEach(function (val, key) { data[key] = val; });

    fetch('/users/user/profile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(data)
    })
    .then(readJsonResponse)
    .then(function (result) {
      if (result.ok && result.data && result.data.success) {
        showAlert('success', result.data.message || 'Profile saved successfully.');
      } else {
        showAlert('danger', serverMessage(result, 'Could not save profile. Please try again.'));
      }
    })
    .catch(function () {
      showAlert('danger', 'Could not reach the server. Please check your connection and try again.');
    })
    .finally(function () {
      btn.disabled  = false;
      btn.innerHTML = origTxt;
    });
  }


  /* ============================================================ */
  /* CHANGE PASSWORD                                               */
  /* ============================================================ */
  function handleChangePassword(e) {
    e.preventDefault();

    var alertEl = document.getElementById('changePwAlert');
    var form    = document.getElementById('changePasswordForm');
    var btn     = form.querySelector('[type="submit"]');
    var origTxt = btn.textContent;

    function showAlert(type, msg) {
      alertEl.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-3';
      alertEl.textContent = msg;
    }

    var curr    = document.getElementById('cp_current').value;
    var newPw   = document.getElementById('cp_new').value;
    var confirm = document.getElementById('cp_confirm').value;

    if (newPw !== confirm) {
      showAlert('danger', 'New password and confirmation do not match.');
      return;
    }

    btn.disabled  = true;
    btn.textContent = 'Updating…';
    alertEl.className = 'alert d-none';

    fetch('/users/user/change-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ currentPassword: curr, newPassword: newPw })
    })
    .then(readJsonResponse)
    .then(function (result) {
      if (result.ok && result.data && result.data.success) {
        showAlert('success', result.data.message || 'Password updated successfully.');
        form.reset();
      } else {
        showAlert('danger', serverMessage(result, 'Could not update password.'));
      }
    })
    .catch(function () {
      showAlert('danger', 'Could not reach the server. Please try again.');
    })
    .finally(function () {
      btn.disabled    = false;
      btn.textContent = origTxt;
    });
  }
  </script>

  <!-- ===== PAYMENT DETAILS MODAL ===== -->
