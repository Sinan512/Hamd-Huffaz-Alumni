  function initLanguagesMultiSelect() {
    var cbs = document.querySelectorAll('.lang-cb');
    var otherWrap = document.getElementById('languagesOtherWrap');
    var otherInput = document.getElementById('ep_languages_other');
    var hiddenInput = document.getElementById('ep_languages');
    var badgesContainer = document.getElementById('ep_languages_badges');
    var placeholderEl = document.getElementById('ep_languages_placeholder');

    function updateLanguages() {
      var selected = [];
      var hasOther = false;

      cbs.forEach(function (cb) {
        if (cb.checked) {
          if (cb.value === 'Other') {
            hasOther = true;
          } else {
            selected.push(cb.value);
          }
        }
      });

      if (otherWrap) {
        otherWrap.style.display = hasOther ? 'block' : 'none';
      }

      var customVal = (otherInput && hasOther) ? otherInput.value.trim() : '';
      if (customVal) {
        var parts = customVal.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
        parts.forEach(function (p) {
          if (!selected.includes(p)) selected.push(p);
        });
      } else if (hasOther && selected.length === 0) {
        selected.push('Other');
      }

      if (hiddenInput) {
        hiddenInput.value = selected.join(', ');
      }

      if (badgesContainer) {
        badgesContainer.innerHTML = '';
        if (selected.length === 0) {
          if (placeholderEl) placeholderEl.textContent = '-- Select Languages --';
        } else {
          if (placeholderEl) placeholderEl.textContent = selected.length + ' selected (' + selected.slice(0, 2).join(', ') + (selected.length > 2 ? '...' : '') + ')';
          selected.forEach(function (lang) {
            var badge = document.createElement('span');
            badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small fw-semibold';
            badge.textContent = lang;
            badgesContainer.appendChild(badge);
          });
        }
      }
    }

    cbs.forEach(function (cb) {
      cb.addEventListener('change', updateLanguages);
    });

    if (otherInput) {
      otherInput.addEventListener('input', updateLanguages);
    }

    updateLanguages();
  }

  function initSameWhatsappHandlers() {
    // Edit Profile form
