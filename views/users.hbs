<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumni User Dashboard</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        /*==========================================================
        PREMIUM USER DASHBOARD CSS
==========================================================*/

/* Smooth scrolling */
html{
    scroll-behavior:smooth;
}

/* Scrollbar */

::-webkit-scrollbar{
    width:10px;
}

::-webkit-scrollbar-track{
    background:#111827;
}

::-webkit-scrollbar-thumb{
    background:linear-gradient(180deg,#7c3aed,#4f46e5);
    border-radius:20px;
}

::-webkit-scrollbar-thumb:hover{
    background:#8b5cf6;
}

/*==========================================================
        BODY
==========================================================*/

body{

    background:
        radial-gradient(circle at top left,#312e8140 0%,transparent 40%),
        radial-gradient(circle at bottom right,#6d28d940 0%,transparent 40%),
        var(--bg);

    min-height:100vh;
    color:var(--text);

}

/*==========================================================
        NAVBAR
==========================================================*/

.navbar{

    backdrop-filter:blur(18px);
    background:rgba(17,24,39,.92)!important;
    box-shadow:0 10px 25px rgba(0,0,0,.35);
    z-index:1000;

}

.navbar-brand{

    letter-spacing:.5px;

}

.nav-link{

    position:relative;
    font-weight:500;

}

.nav-link::after{

    content:"";
    position:absolute;
    left:0;
    bottom:-6px;

    width:0;
    height:2px;

    background:var(--primary);

    transition:.35s;

}

.nav-link:hover::after{

    width:100%;

}

.profile-btn{

    transition:.35s;

}

.profile-btn:hover{

    transform:scale(1.08);

    box-shadow:0 0 18px rgba(124,58,237,.5);

}

/*==========================================================
        SECTION TITLE
==========================================================*/

.section-title{

    position:relative;
    display:inline-block;
    padding-bottom:10px;

}

.section-title::after{

    content:"";
    position:absolute;

    left:0;
    bottom:0;

    width:60%;
    height:4px;

    border-radius:20px;

    background:linear-gradient(90deg,#7c3aed,#4f46e5);

}

/*==========================================================
        GLASS CARD
==========================================================*/

.profile-card,
.gallery-card,
.event-card{

    background:rgba(23,32,51,.88);

    backdrop-filter:blur(20px);

    border:1px solid rgba(255,255,255,.08);

    transition:.35s;

    box-shadow:
        0 10px 30px rgba(0,0,0,.30);

}

.profile-card:hover,
.gallery-card:hover,
.event-card:hover{

    transform:translateY(-6px);

    box-shadow:
        0 18px 35px rgba(124,58,237,.18);

}

/*==========================================================
        PROFILE
==========================================================*/

.profile-icon{

    transition:.4s;

}

.profile-card:hover .profile-icon{

    transform:rotate(10deg) scale(1.08);

    box-shadow:

    0 0 30px rgba(124,58,237,.35);

}

.profile-name{

    letter-spacing:.5px;

}

.profile-table{

    margin-top:30px;

}

.profile-table td{

    vertical-align:middle;

}

/*==========================================================
        GALLERY
==========================================================*/

.gallery-card{

    overflow:hidden;

}

.gallery-card img{

    transition:.6s;

}

.gallery-card:hover img{

    transform:scale(1.03);

}

.gallery-caption{

    background:#172033;

}

.gallery-caption h4{

    margin-bottom:12px;

}

/*==========================================================
        EVENT CARD
==========================================================*/

.event-card{

    border-radius:18px;

    overflow:hidden;

}

.event-image{

    width:100%;
    height:230px;

    object-fit:cover;

    transition:.5s;

}

.event-card:hover .event-image{

    transform:scale(1.06);

}

.event-body{

    padding:24px;

}

.event-body h4{

    font-size:24px;
    font-weight:600;

}

.event-info{

    color:var(--muted);

    margin-bottom:10px;

}

.event-description{

    color:#d4d4d8;

    line-height:1.8;

    min-height:95px;

}

.badge{

    padding:8px 15px;

    font-size:13px;

    border-radius:50px;

}

/*==========================================================
        BUTTONS
==========================================================*/

.btn-primary{

    background:linear-gradient(135deg,#7c3aed,#4f46e5);

    border:none;

    border-radius:10px;

    transition:.35s;

}

.btn-primary:hover{

    transform:translateY(-2px);

    box-shadow:

        0 8px 22px rgba(124,58,237,.35);

}

.btn-secondary{

    border-radius:10px;

}

/*==========================================================
        MODALS
==========================================================*/

.modal-content{

    border-radius:18px;

    background:#172033;

}

.modal-header{

    border-bottom:1px solid rgba(255,255,255,.08);

}

.modal-footer{

    border-top:1px solid rgba(255,255,255,.08);

}

.form-control{

    background:#0f172a;

    border:1px solid rgba(255,255,255,.08);

    color:white;

}

.form-control:focus{

    background:#0f172a;

    color:white;

    border-color:#7c3aed;

    box-shadow:0 0 0 .2rem rgba(124,58,237,.25);

}

/*==========================================================
        FOOTER
==========================================================*/

footer{

    background:#101827;

}

footer a{

    transition:.3s;

}

footer a:hover{

    color:white!important;

}

footer i{

    cursor:pointer;

    transition:.35s;

}

footer i:hover{

    color:#8b5cf6;

    transform:translateY(-4px);

}

/*==========================================================
        ANIMATIONS
==========================================================*/

.fade-section{

    opacity:0;

    transform:translateY(35px);

    transition:.8s;

}

.fade-section.show{

    opacity:1;

    transform:translateY(0);

}

/*==========================================================
        MOBILE
==========================================================*/

@media(max-width:992px){

    .navbar-nav{

        text-align:center;
        margin-top:15px;

    }

    .profile-name{

        margin-top:25px;
        text-align:center;

    }

    .profile-table{

        margin-top:20px;

    }

}

@media(max-width:768px){

    section{

        padding:55px 0;

    }

    .section-title{

        font-size:26px;

    }

    .event-image{

        height:210px;

    }

    .gallery-card img{

        height:240px;

    }

}

@media(max-width:576px){

    .profile-icon{

        width:90px;
        height:90px;
        font-size:45px;

    }

    .profile-name{

        font-size:24px;

    }

    .event-body h4{

        font-size:21px;

    }

}

    </style>

</head>

<body>

<!-- ===========================
        NAVBAR
=========================== -->

<nav class="navbar navbar-expand-lg sticky-top">

<div class="container">

<a class="navbar-brand" href="#">

<i class="bi bi-mortarboard-fill me-2"></i>

Alumni

</a>

<button class="navbar-toggler bg-light"
type="button"
data-bs-toggle="collapse"
data-bs-target="#navbar">

<span class="navbar-toggler-icon"></span>

</button>

<div class="collapse navbar-collapse"
id="navbar">

<ul class="navbar-nav mx-auto">

<li class="nav-item">
<a href="#profile"
class="nav-link">
Dashboard
</a>
</li>

<li class="nav-item">
<a href="#gallery"
class="nav-link">
Gallery
</a>
</li>

<li class="nav-item">
<a href="#events"
class="nav-link">
Events
</a>
</li>

</ul>

<div class="dropdown">

<button
class="profile-btn"
data-bs-toggle="dropdown">

<i class="bi bi-person-fill"></i>

</button>

<ul class="dropdown-menu dropdown-menu-end">

<li>

<a
class="dropdown-item"
href="#">

<i class="bi bi-pencil-square me-2"></i>

Edit Profile

</a>

</li>

<li>

<a
class="dropdown-item"
href="#">

<i class="bi bi-key me-2"></i>

Change Password

</a>

</li>

<li><hr class="dropdown-divider"></li>

<li>

<a
class="dropdown-item text-danger"
href="/logout">

<i class="bi bi-box-arrow-right me-2"></i>

Logout

</a>

</li>

</ul>

</div>

</div>

</div>

</nav>

<!-- ===========================
        PROFILE
=========================== -->

<section
id="profile">

<div class="container">

<h2 class="section-title">

My Profile

</h2>

<div class="profile-card">

<div class="row align-items-center">

<div class="col-lg-3 text-center">

<div class="profile-icon">

<i class="bi bi-person-fill"></i>

</div>

</div>

<div class="col-lg-9">

<h2 class="profile-name">

{{user.name}}

</h2>

<table class="table table-borderless text-light profile-table">

<tr>

<td>

Admission Number

</td>

<td>

{{user.admissionNumber}}

</td>

</tr>

<tr>

<td>

Batch

</td>

<td>

{{user.batch}}

</td>

</tr>

<tr>

<td>

Email

</td>

<td>

{{user.email}}

</td>

</tr>

</table>

</div>

</div>

</div>

</div>

</section>

<!-- ===========================
        GALLERY
=========================== -->

<section id="gallery">

<div class="container">

<h2 class="section-title">

Gallery

</h2>

<div id="galleryCarousel"
class="carousel slide"
data-bs-ride="carousel"
data-bs-interval="5000">

<div class="carousel-indicators">

{{#each galleryImages}}

<button
type="button"
data-bs-target="#galleryCarousel"
data-bs-slide-to="{{@index}}"
class="{{#if @first}}active{{/if}}">
</button>

{{/each}}

</div>

<div class="carousel-inner">

{{#each galleryImages}}

<div class="carousel-item {{#if @first}}active{{/if}}">

<div class="gallery-card">

<img
src="/user/gallery/{{this._id}}/image"
alt="Gallery Image">

<div class="gallery-caption">

<h4>

Gallery Image

</h4>

<p>

{{this.description}}

</p>

</div>

</div>

</div>

{{/each}}

</div>

<button class="carousel-control-prev"
type="button"
data-bs-target="#galleryCarousel"
data-bs-slide="prev">

<span class="carousel-control-prev-icon"></span>

</button>

<button class="carousel-control-next"
type="button"
data-bs-target="#galleryCarousel"
data-bs-slide="next">

<span class="carousel-control-next-icon"></span>

</button>

</div>

</div>

</section>

<!-- PART 2 STARTS FROM HERE -->
  <!-- ===========================
        EVENTS
=========================== -->

<section id="events">

    <div class="container">

        <h2 class="section-title">

            Upcoming Events

        </h2>

        <div class="row g-4">

            {{#each events}}

            <div class="col-lg-4 col-md-6">

                <div class="event-card h-100">

                    <img
                        src="/user/events/{{this._id}}/image"
                        class="event-image"
                        alt="{{this.title}}">

                    <div class="event-body">

                        <span class="badge bg-primary">

                            {{this.category}}

                        </span>

                        <h4 class="mt-3">

                            {{this.title}}

                        </h4>

                        <p class="event-info">

                            <i class="bi bi-calendar-event me-2"></i>

                            {{this.date}}

                        </p>

                        <p class="event-info">

                            <i class="bi bi-geo-alt-fill me-2"></i>

                            {{this.location}}

                        </p>

                        <p class="event-description">

                            {{this.description}}

                        </p>

                        {{#if this.registration}}

                        <button
                            class="btn btn-primary register-btn w-100"
                            data-event="{{this._id}}">

                            <i class="bi bi-person-plus-fill me-2"></i>

                            Register

                        </button>

                        {{/if}}

                    </div>

                </div>

            </div>

            {{/each}}

        </div>

    </div>

</section>

<!-- ===========================
        EDIT PROFILE MODAL
=========================== -->

<div
    class="modal fade"
    id="editProfileModal"
    tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content bg-dark text-light border-secondary">

            <div class="modal-header">

                <h5 class="modal-title">

                    Edit Profile

                </h5>

                <button
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal">

                </button>

            </div>

            <form
                action="/user/profile/update"
                method="POST">

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">

                            Name

                        </label>

                        <input
                            type="text"
                            name="name"
                            class="form-control"
                            value="{{user.name}}"
                            required>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

                            Admission Number

                        </label>

                        <input
                            type="text"
                            class="form-control"
                            value="{{user.admissionNumber}}"
                            readonly>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

                            Batch

                        </label>

                        <input
                            type="text"
                            class="form-control"
                            value="{{user.batch}}"
                            readonly>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

                            Email

                        </label>

                        <input
                            type="email"
                            name="email"
                            class="form-control"
                            value="{{user.email}}">

                    </div>

                </div>

                <div class="modal-footer">

                    <button
                        class="btn btn-secondary"
                        data-bs-dismiss="modal"
                        type="button">

                        Cancel

                    </button>

                    <button
                        class="btn btn-primary"
                        type="submit">

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ===========================
      CHANGE PASSWORD
=========================== -->

<div
    class="modal fade"
    id="changePasswordModal"
    tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content bg-dark text-light border-secondary">

            <div class="modal-header">

                <h5 class="modal-title">

                    Change Password

                </h5>

                <button
                    class="btn-close btn-close-white"
                    data-bs-dismiss="modal">

                </button>

            </div>

            <form
                action="/user/change-password"
                method="POST">

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">

                            Current Password

                        </label>

                        <input
                            type="password"
                            class="form-control"
                            name="currentPassword"
                            required>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

                            New Password

                        </label>

                        <input
                            type="password"
                            class="form-control"
                            name="newPassword"
                            required>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

                            Confirm Password

                        </label>

                        <input
                            type="password"
                            class="form-control"
                            name="confirmPassword"
                            required>

                    </div>

                </div>

                <div class="modal-footer">

                    <button
                        class="btn btn-secondary"
                        type="button"
                        data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button
                        class="btn btn-primary"
                        type="submit">

                        Update Password

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ===========================
          FOOTER
=========================== -->

<footer class="py-5 mt-5 border-top border-secondary">

    <div class="container">

        <div class="row">

            <div class="col-lg-4">

                <h4>

                    Alumni Association

                </h4>

                <p class="text-secondary">

                    Building stronger connections between alumni and the institution.

                </p>

            </div>

            <div class="col-lg-4">

                <h5>

                    Quick Links

                </h5>

                <ul class="list-unstyled">

                    <li>

                        <a
                            href="#profile"
                            class="text-secondary">

                            Dashboard

                        </a>

                    </li>

                    <li>

                        <a
                            href="#gallery"
                            class="text-secondary">

                            Gallery

                        </a>

                    </li>

                    <li>

                        <a
                            href="#events"
                            class="text-secondary">

                            Events

                        </a>

                    </li>

                </ul>

            </div>

            <div class="col-lg-4">

                <h5>

                    Contact

                </h5>

                <p class="text-secondary">

                    alumni@example.com

                </p>

                <div class="fs-4">

                    <i class="bi bi-facebook me-3"></i>

                    <i class="bi bi-instagram me-3"></i>

                    <i class="bi bi-youtube me-3"></i>

                    <i class="bi bi-twitter-x"></i>

                </div>

            </div>

        </div>

        <hr class="border-secondary my-4">

        <div class="text-center text-secondary">

            © 2026 Alumni Association. All Rights Reserved.

        </div>

    </div>

</footer>

<!-- Bootstrap -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<!-- PART 3 CONTINUES FROM HERE -->

  </body>

</html>