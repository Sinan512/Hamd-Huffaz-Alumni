<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Member Dashboard</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root {
      --font-main: 'Plus Jakarta Sans', sans-serif;
      --bg-black: #000000;
      --surface: #111111;
      --surface-alt: #1a1a1a;
      --border-color: rgba(255, 255, 255, 0.12);
      --text-primary: #ffffff;
      --text-muted: #a3a3a3;
    }

    * { box-sizing: border-box; }

    body {
      font-family: var(--font-main);
      background-color: var(--bg-black);
      color: var(--text-primary);
      margin: 0;
      padding: 0;
    }

    .boxed { max-width: 1100px; margin: 0 auto; }

    /* ===== HEADER ===== */
    .app-header {
      background: #000000;
      border-bottom: 1px solid var(--border-color);
      padding: 16px 28px;
      position: sticky;
      top: 0;
      z-index: 1030;
    }

    .brand-title {
      font-weight: 800;
      font-size: 20px;
      letter-spacing: -0.5px;
      color: #ffffff;
    }

    .brand-title span { color: #737373; }

    .brand-sub {
      font-size: 11px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: -2px;
    }

    .profile-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--surface);
      border: 1px solid var(--border-color);
      color: #ffffff;
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
    }

    .profile-btn:hover { background: var(--surface-alt); }
    .profile-btn i.bi-person-circle { font-size: 20px; }

    .dropdown-menu-dark {
      background: var(--surface);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 6px;
    }

    .dropdown-menu-dark .dropdown-item {
      color: #e5e5e5;
      border-radius: 6px;
      padding: 10px 12px;
      font-size: 14px;
    }

    .dropdown-menu-dark .dropdown-item:hover { background: var(--surface-alt); color: #ffffff; }
    .dropdown-menu-dark .dropdown-item.text-danger:hover { background: #2a1414; color: #f87171; }
    .dropdown-menu-dark hr.dropdown-divider { border-color: var(--border-color); }

    /* ===== CARDS / SECTIONS ===== */
    .card-dark {
      background: var(--surface);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      margin-bottom: 24px;
    }

    .card-header-dark {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-color);
      font-weight: 700;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #ffffff;
    }

    .card-body-dark { padding: 24px; }

    /* ===== SECTION 1: DETAILS ===== */
    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 13px 0;
      border-bottom: 1px solid var(--border-color);
    }

    .detail-row:last-child { border-bottom: none; }

    .detail-label {
      color: var(--text-muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .detail-value { font-weight: 600; color: #ffffff; font-size: 14px; }

    /* ===== SECTION 2: GALLERY CAROUSEL ===== */
    .carousel-item img {
      height: 360px;
      object-fit: cover;
      border-radius: 8px;
    }

    .carousel-caption {
      background: rgba(0, 0, 0, 0.55);
      border-radius: 8px;
      bottom: 20px;
      padding: 10px 16px;
    }

    .carousel-indicators [data-bs-target] {
      background-color: #ffffff;
      opacity: 0.4;
    }

    .carousel-indicators .active { opacity: 1; }

    @media (max-width: 576px) {
      .carousel-item img { height: 220px; }
    }

    /* ===== SECTION 3: EVENTS ===== */
    .event-block {
      border: 1px solid var(--border-color);
      background: var(--surface-alt);
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 16px;
    }

    .event-block:last-child { margin-bottom: 0; }

    .event-title { font-weight: 700; font-size: 16px; color: #ffffff; }

    .event-meta { color: var(--text-muted); font-size: 13px; line-height: 1.7; }

    .event-badge {
      background: var(--surface);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 20px;
    }

    .btn-outline-mono {
      border: 1px solid #ffffff;
      color: #ffffff;
      background: transparent;
      border-radius: 8px;
      padding: 8px 18px;
      font-weight: 600;
      font-size: 14px;
    }

    .btn-outline-mono:hover { background: #ffffff; color: #000000; }

    /* ===== FOOTER ===== */
    .app-footer {
      border-top: 1px solid var(--border-color);
      color: var(--text-muted);
      font-size: 13px;
      padding: 26px 0;
      text-align: center;
    }

    .app-footer a { color: var(--text-muted); text-decoration: none; }
    .app-footer a:hover { color: #ffffff; }

    /* ===== LOGIN VIEW ===== */
    .login-wrapper {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .login-card {
      background: var(--surface);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 40px;
      width: 100%;
      max-width: 380px;
    }

    .login-card h3 { font-weight: 800; margin-bottom: 2px; }
    .login-card p.sub { color: var(--text-muted); font-size: 13px; margin-bottom: 24px; }

    .form-control-dark {
      background: #000000;
      border: 1px solid var(--border-color);
      color: #ffffff;
      border-radius: 8px;
      padding: 10px 14px;
    }

    .form-control-dark::placeholder { color: #666666; }

    .form-control-dark:focus {
      border-color: #ffffff;
      box-shadow: none;
      background: #000000;
      color: #ffffff;
    }

    .btn-solid-mono {
      background: #ffffff;
      color: #000000;
      font-weight: 700;
      border: none;
      border-radius: 8px;
      padding: 10px;
      width: 100%;
      font-size: 14px;
    }

    .btn-solid-mono:hover { background: #d4d4d4; color: #000000; }

    /* ===== MODAL (DARK) ===== */
    .modal-content-dark {
      background: var(--surface);
      color: #ffffff;
      border: 1px solid var(--border-color);
    }

    .modal-content-dark .modal-header,
    .modal-content-dark .modal-footer {
      border-color: var(--border-color);
    }

    .modal-content-dark .form-label { color: var(--text-muted); font-size: 13px; }

    .modal-content-dark .form-control {
      background: #000000;
      border: 1px solid var(--border-color);
      color: #ffffff;
    }

    .modal-content-dark .form-control:disabled {
      background: #0a0a0a;
      color: var(--text-muted);
    }

    .modal-content-dark .form-control:focus {
      border-color: #ffffff;
      box-shadow: none;
      background: #000000;
      color: #ffffff;
    }

    .modal-content-dark hr { border-color: var(--border-color); }
  </style>
</head>
<body>

  {{#if user}}
  <!-- ==================== LOGGED-IN DASHBOARD ==================== -->

  <!-- HEADER -->
  <header class="app-header">
    <div class="boxed d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <div class="brand-title">Alumni<span>Portal</span></div>
        <div class="brand-sub">Member Dashboard</div>
      </div>

      <div class="dropdown">
        <button class="profile-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-person-circle"></i>
          <span class="d-none d-sm-inline">{{user.name}}</span>
          <i class="bi bi-chevron-down small"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark mt-2">
          <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#editProfileModal"><i class="bi bi-pencil-square me-2"></i>Edit Profile</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
        </ul>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="boxed px-3 py-4">

    <!-- SECTION 1: MY DETAILS -->
    <section class="card-dark" id="details-section">
      <div class="card-header-dark">
        <span><i class="bi bi-person-badge me-2"></i>My Details</span>
      </div>
      <div class="card-body-dark">
        <div class="detail-row">
          <span class="detail-label">Name</span>
          <span class="detail-value">{{user.name}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Admission Number</span>
          <span class="detail-value">{{user.admissionNumber}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Batch</span>
          <span class="detail-value">{{user.batch}}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Email</span>
          <span class="detail-value">{{user.email}}</span>
        </div>
      </div>
    </section>

    <!-- SECTION 2: GALLERY (auto-moving carousel, from admin's GALLERY collection) -->
    <section class="card-dark" id="gallery-section">
      <div class="card-header-dark">
        <span><i class="bi bi-images me-2"></i>Gallery</span>
      </div>
      <div class="card-body-dark">
        {{#if galleryItems.length}}
        <div id="galleryCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3500">
          <div class="carousel-indicators">
            {{#each galleryItems}}
            <button type="button" data-bs-target="#galleryCarousel" data-bs-slide-to="{{@index}}" class="{{#if @first}}active{{/if}}" aria-current="{{#if @first}}true{{/if}}" aria-label="Slide {{@index}}"></button>
            {{/each}}
          </div>
          <div class="carousel-inner rounded-3 overflow-hidden">
            {{#each galleryItems}}
            <div class="carousel-item {{#if @first}}active{{/if}}">
              <img src="{{this.image}}" class="d-block w-100" alt="{{this.description}}">
              <div class="carousel-caption d-none d-md-block">
                <p class="m-0 small">{{this.description}}</p>
              </div>
            </div>
            {{/each}}
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#galleryCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#galleryCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
          </button>
        </div>
        {{else}}
        <p class="text-center m-0 py-4" style="color: var(--text-muted);">No gallery images have been added yet.</p>
        {{/if}}
      </div>
    </section>

    <!-- SECTION 3: EVENTS (Register button hidden entirely when registration is disabled) -->
    <section class="card-dark" id="events-section">
      <div class="card-header-dark">
        <span><i class="bi bi-calendar2-event me-2"></i>Events</span>
      </div>
      <div class="card-body-dark">
        {{#if events.length}}
        {{#each events}}
        <div class="event-block">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
            <div class="event-title">{{this.title}}</div>
            {{#if this.category}}<span class="event-badge">{{this.category}}</span>{{/if}}
          </div>
          <div class="event-meta mb-2">
            <i class="bi bi-calendar-check me-1"></i>{{this.date}} • {{this.time}}<br>
            <i class="bi bi-geo-alt me-1"></i>{{this.location}}
          </div>
          {{#if this.description}}<p class="mb-3 small" style="color: #d4d4d4;">{{this.description}}</p>{{/if}}
          {{#if this.registrationEnabled}}
          <button type="button" class="btn-outline-mono" onclick="handleRegister('{{this.title}}')">
            <i class="bi bi-check-circle me-1"></i> Register
          </button>
          {{/if}}
        </div>
        {{/each}}
        {{else}}
        <p class="text-center m-0 py-4" style="color: var(--text-muted);">No events at the moment.</p>
        {{/if}}
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="app-footer">
    <div class="boxed">
      <p class="m-0 mb-1 fw-medium" style="color: #ffffff;">© 2026 Alumni Management System. All rights reserved.</p>
      <div class="d-flex justify-content-center flex-wrap gap-2 gap-md-3">
        <a href="#">Help & Contact</a><span>•</span>
        <a href="#">Privacy Policy</a><span>•</span>
        <a href="#">Terms of Service</a><span>•</span>
        <a href="/admin">Admin Portal</a>
      </div>
    </div>
  </footer>

  <!-- EDIT PROFILE MODAL (with change password) -->
  <div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark rounded-4">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="fw-bold m-0"><i class="bi bi-person-badge me-2"></i>Edit Profile</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <p class="small mb-4" style="color: var(--text-muted);">Name, admission number and batch are official records managed by the admin office and cannot be edited here.</p>

          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" value="{{user.name}}" disabled>
          </div>
          <div class="mb-3">
            <label class="form-label">Admission Number</label>
            <input type="text" class="form-control" value="{{user.admissionNumber}}" disabled>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" id="editEmail" name="email" value="{{user.email}}">
          </div>

          <hr>

          <h6 class="fw-bold mb-3"><i class="bi bi-shield-lock me-2"></i>Change Password</h6>
          <form id="changePasswordForm" onsubmit="return handleChangePassword(event)">
            <div class="mb-3">
              <label class="form-label">Current Password</label>
              <input type="password" class="form-control" id="currentPassword" name="currentPassword" placeholder="Your admission number or current password" required>
            </div>
            <div class="mb-3">
              <label class="form-label">New Password</label>
              <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6">
            </div>
            <div class="mb-3">
              <label class="form-label">Confirm New Password</label>
              <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="6">
            </div>
            <!-- On submit, save new password against this user's record in the "member details" collection -->
            <button type="submit" class="btn-solid-mono">Update Password</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  {{else}}
  <!-- ==================== LOGIN VIEW ==================== -->
  <div class="login-wrapper">
    <div class="login-card">
      <div class="text-center mb-4">
        <i class="bi bi-mortarboard-fill" style="font-size: 34px;"></i>
        <h3 class="mt-2 mb-0">Alumni Portal</h3>
        <p class="sub">Sign in with your name and admission number</p>
      </div>

      {{#if error}}
      <div class="alert alert-danger py-2 small">{{error}}</div>
      {{/if}}

      <!-- name + admission number (used as password) submitted to the auth route -->
      <form method="POST" action="/login">
        <div class="mb-3">
          <label class="form-label small" style="color: var(--text-muted);">Full Name</label>
          <input type="text" name="name" class="form-control form-control-dark" placeholder="Enter your full name" required>
        </div>
        <div class="mb-3">
          <label class="form-label small" style="color: var(--text-muted);">Admission Number</label>
          <input type="password" name="admissionNumber" class="form-control form-control-dark" placeholder="Used as your password" required>
        </div>
        <button type="submit" class="btn-solid-mono mt-2">Login</button>
      </form>
    </div>
  </div>
  {{/if}}

  <!-- SCRIPTS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function handleRegister(eventTitle) {
      alert(`You have registered for "${eventTitle}". Confirmation details will be sent to your registered email.`);
    }

    function handleChangePassword(e) {
      e.preventDefault();
      const newPass = document.getElementById('newPassword').value;
      const confirmPass = document.getElementById('confirmPassword').value;

      if (newPass !== confirmPass) {
        alert('New password and confirmation do not match.');
        return false;
      }

      // TODO (backend): POST currentPassword/newPassword to the server route that
      // updates this user's password field in the "member details" collection.
      alert('Password updated successfully.');
      return false;
    }
  </script>

</body>
</html>
