                <input type="text" class="form-control rounded-3" id="quick_supportNeeded_other" placeholder="Please specify the help you need" value="{{user.supportNeeded_other_val}}">
              </div>
            </div>

            <!-- ── 3. JOB / STUDY ── -->
            <div class="form-section-title mb-3 mt-4">
              <i class="bi bi-briefcase"></i>
              <span>Job / Study</span>
            </div>

            <div class="mb-3">
