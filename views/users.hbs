  <!-- ===================================================== -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="editProfileOffcanvas" style="width: min(540px, 100);">
    <div class="offcanvas-header">
      <div>
        <h5 class="offcanvas-title fw-bold d-flex align-items-center gap-2">
          <span class="card-header-icon"><i class="bi bi-person-badge"></i></span>
          Edit Profile
        </h5>
        <div class="small text-muted mt-1">
          Fill what you want. Leave others blank. Changes save with the button at the bottom.
        </div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <!-- Language Toggle -->
        <div class="d-flex gap-1" id="langToggleGroup">
          <button type="button" class="lang-badge active" id="btnLangEn" onclick="setLang('en')">EN</button>
          <button type="button" class="lang-badge" id="btnLangMl" onclick="setLang('ml')">ML</button>
        </div>
        <button type="button" class="btn-close ms-2" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
    </div>

    <div class="offcanvas-body">
      <div id="profileSaveAlert" class="alert d-none rounded-3 py-2 px-3 small mb-3"></div>

      <form id="editProfileForm" onsubmit="handleSaveProfile(event)">

        <!-- ── PERSONAL DETAILS ── -->
        <div class="form-section-title">
          <i class="bi bi-person"></i>
          <span data-en="Personal Details" data-ml="വ്യക്തിഗത വിവരങ്ങൾ">Personal Details</span>
        </div>

        <div class="mb-3">
          <label class="form-label-custom">
            <span data-en="Name (official — cannot be changed)" data-ml="പേര് (ഔദ്യോഗികം — മാറ്റാൻ കഴിയില്ല)">Name (official — cannot be changed)</span>
          </label>
          <input type="text" class="form-control" value="{{user.name}}" disabled>
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="ep_place">
            <span data-en="Place" data-ml="സ്ഥലം">Place</span>
          </label>
          <input type="text" class="form-control" id="ep_place" name="place" value="{{user.place}}" placeholder="Your hometown or city">
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="ep_address">
            <span data-en="Address" data-ml="മേൽവിലാസം">Address</span>
          </label>
          <textarea class="form-control" id="ep_address" name="address" rows="2" placeholder="Full address">{{user.address}}</textarea>
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="ep_email">
            <span data-en="Email" data-ml="ഇ-മെയിൽ">Email</span>
          </label>
          <input type="email" class="form-control" id="ep_email" name="email" value="{{user.email}}" placeholder="name@example.com">
        </div>

        <div class="row g-3 mb-0">
          <div class="col-6">
            <div class="mb-3">
              <label class="form-label-custom" for="ep_phone">
                <span data-en="Phone Number" data-ml="ഫോൺ നമ്പർ">Phone Number</span>
              </label>
              <input type="tel" class="form-control" id="ep_phone" name="phone" value="{{user.phone}}" placeholder="+91...">
            </div>
          </div>
          <div class="col-6">
            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label-custom mb-0" for="ep_whatsapp">
                  <span data-en="WhatsApp Number" data-ml="വാട്സ്ആപ്പ് നമ്പർ">WhatsApp Number</span>
                </label>
                <div class="form-check d-inline-flex align-items-center gap-1 mb-0" style="font-size: 11.5px;">
                  <input class="form-check-input mt-0" type="checkbox" id="ep_sameWhatsapp" style="cursor: pointer; width: 14px; height: 14px;">
                  <label class="form-check-label mb-0 fw-semibold text-muted" for="ep_sameWhatsapp" style="cursor: pointer;" data-en="Same" data-ml="ഇത് തന്നെ">Same</label>
                </div>
              </div>
              <input type="tel" class="form-control" id="ep_whatsapp" name="whatsapp" value="{{user.whatsapp}}" placeholder="+91...">
            </div>
          </div>
        </div>

        <!-- ── EDUCATION ── -->
        <div class="form-section-title">
          <i class="bi bi-mortarboard"></i>
          <span data-en="Education Details" data-ml="വിദ്യാഭ്യാസ വിവരങ്ങൾ">Education Details</span>
        </div>

        <div class="row g-3">
          <div class="col-6">
            <div class="mb-3">
              <label class="form-label-custom" for="ep_admYear">
                <span data-en="Year of Admission" data-ml="സ്ഥാപനത്തിൽ ചേർന്ന വർഷം">Year of Admission</span>
              </label>
              <input type="number" disabled class="form-control" id="ep_admYear" name="admYear" value="{{user.admYear}}" min="1950" max="2099">
            </div>
          </div>
          <div class="col-6">
            <div class="mb-3">
              <label class="form-label-custom" for="ep_leaveYear">
                <span data-en="Year of Leaving" data-ml="സ്ഥാപനത്തിൽ നിന്നും പോയ വർഷം">Year of Leaving</span>
              </label>
              <input type="number" class="form-control" id="ep_leaveYear" name="leaveYear" value="{{user.leaveYear}}" min="1950" max="2099" placeholder="e.g. 2022">
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="ep_eduQual">
            <span data-en="Educational Qualification" data-ml="വിദ്യാഭ്യാസ യോഗ്യത">Educational Qualification</span>
          </label>
          <select class="form-select" id="ep_eduQual" name="eduQual" onchange="toggleEduQualOther()">
            <option value="" {{#unless user.eduQual}}selected{{/unless}}>-- Select --</option>
            <option value="SSLC" {{#if user.eduQual_sslc}}selected{{/if}}>SSLC</option>
            <option value="Plus Two" {{#if user.eduQual_plustwo}}selected{{/if}}>Plus Two</option>
            <option value="Degree" {{#if user.eduQual_degree}}selected{{/if}}>Degree</option>
            <option value="PG" {{#if user.eduQual_pg}}selected{{/if}}>PG</option>
            <option value="Other" {{#if user.eduQual_other}}selected{{/if}}>Other</option>
          </select>
          <div id="eduQualOtherWrap" class="mt-2" style="display: {{#if user.eduQual_other}}block{{else}}none{{/if}};">
            <input type="text" class="form-control" id="ep_eduQual_other" placeholder="Please specify your qualification" value="{{user.eduQual_other_val}}">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label-custom" for="ep_religiousDegree">
            <span data-en="Religious / General Degree" data-ml="മത-ബിരുദം / ഭൗതിക-ബിരുദം">Religious / General Degree</span>
          </label>
          <select class="form-select" id="ep_religiousDegree" name="religiousDegree" onchange="toggleReligiousDegreeOther()">
            <option value="" {{#unless user.religiousDegree}}selected{{/unless}}>-- Select --</option>
            <option value="Saquafi" {{#if user.rel_saquafi}}selected{{/if}}>Saquafi</option>
            <option value="Ahsani" {{#if user.rel_ahsani}}selected{{/if}}>Ahsani</option>
            <option value="Baqavi" {{#if user.rel_baqavi}}selected{{/if}}>Baqavi</option>
            <option value="Saa'di" {{#if user.rel_saadi}}selected{{/if}}>Saa'di</option>
            <option value="Adany" {{#if user.rel_adany}}selected{{/if}}>Adany</option>
            <option value="Hadi" {{#if user.rel_hadi}}selected{{/if}}>Hadi</option>
            <option value="Fazili" {{#if user.rel_fazili}}selected{{/if}}>Fazili</option>
            <option value="Shamil Ifani" {{#if user.rel_shamil}}selected{{/if}}>Shamil Ifani</option>
            <option value="Noorani" {{#if user.rel_noorani}}selected{{/if}}>Noorani</option>
            <option value="Mueeni" {{#if user.rel_mueeni}}selected{{/if}}>Mueeni</option>
