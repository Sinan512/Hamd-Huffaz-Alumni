<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Member Dashboard</title>
  <link rel="icon" href="/logo/hamd-icon-white.png" />
  <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Apply saved theme before paint (avoids flash) -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('userTheme');
        if (t !== 'dark' && t !== 'light') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-bs-theme', t);
      } catch (e) {}
    })();
  </script>

  <style>
    :root {
      --font-main: 'Plus Jakarta Sans', sans-serif;
      --bg-body: #f8fafc;
      --surface: #ffffff;
      --surface-alt: #f1f5f9;
      --border-color: rgba(156, 156, 156, 0.8);
      --text-primary: #1e293b;
      --text-muted: #64748b;
      --card-shadow: 0 4px 20px -2px rgba(0,0,0,0.04), 0 2px 6px -1px rgba(0,0,0,0.02);
      --primary: #6366f1;
    }

    * { box-sizing: border-box; }

    body {
      font-family: var(--font-main);
      background-color: var(--bg-body);
      color: var(--text-primary);
      margin: 0; padding: 0;
    }

    .boxed { max-width: 1000px; margin: 0 auto; }

    /* ===== DARK MODE ===== */
    [data-bs-theme="dark"] {
      --bg-body: #0b0f19;
      --surface: #111827;
      --surface-alt: #151c2c;
      --border-color: rgba(148, 163, 184, 0.16);
      --text-primary: #e2e8f0;
      --text-muted: #94a3b8;
      --card-shadow: 0 4px 20px -2px rgba(0,0,0,0.5), 0 2px 6px -1px rgba(0,0,0,0.3);
      color-scheme: dark;
    }

    /* ===== HEADER ===== */
    .app-header {
      background: var(--surface);
      border-bottom: 1px solid var(--border-color);
      padding: 14px 28px;
      position: sticky;
      top: 0;
      z-index: 1030;
      box-shadow: var(--card-shadow);
    }

    .brand-title {
      font-weight: 800;
      font-size: 20px;
      letter-spacing: -0.5px;
      color: var(--text-primary);
    }

    .brand-title span { color: var(--primary); }

    .brand-sub {
      font-size: 11px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: -2px;
    }

    /* Theme-aware logo switching */
    .logo-light-mode { display: block; }
    .logo-dark-mode  { display: none;  }
    [data-bs-theme="dark"] .logo-light-mode { display: none;  }
    [data-bs-theme="dark"] .logo-dark-mode  { display: block; }

    .nav-icon-btn {
      width: 40px; height: 40px;
      border-radius: 10px;
      border: 1px solid var(--border-color);
      background: var(--surface);
      display: flex; align-items: center; justify-content: center;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 18px;
    }

    .nav-icon-btn:hover {
      background: var(--surface-alt);
      color: var(--text-primary);
    }

    .profile-btn {
      display: flex; align-items: center; gap: 10px;
      padding: 6px 12px 6px 6px;
      border: 1px solid var(--border-color);
      border-radius: 30px;
      background: var(--surface);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .profile-btn:hover { background: var(--surface-alt); }

    .profile-avatar {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: rgba(99,102,241,0.12);
      color: var(--primary);
      display: flex; align-items: center; justify-content: center;
      font-size: 20px;
    }

    .profile-name {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .profile-role {
      font-size: 10px;
      font-weight: 600;
      color: var(--primary);
    }

    /* ===== DROPDOWN ===== */
    .dropdown-menu {
      background: var(--surface);
      border: 1px solid var(--border-color);
    }

    .dropdown-item {
      color: var(--text-primary);
      font-size: 14px;
    }

    .dropdown-item:hover { background: var(--surface-alt); }
    .dropdown-item.text-danger:hover { background: rgba(239,68,68,0.1); }

    /* ===== CARD ===== */
    .card-surface {
      background: var(--surface);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      margin-bottom: 24px;
      box-shadow: var(--card-shadow);
    }

    .card-header-bar {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-color);
      font-weight: 700;
      font-size: 15px;
      display: flex; align-items: center; justify-content: space-between;
      color: var(--text-primary);
    }

    .card-body-pad { padding: 24px; }

    /* ===== SECTION 1: PROFILE ===== */
    .profile-hero {
      display: flex; align-items: center; gap: 20px;
      padding: 24px;
      border-bottom: 1px solid var(--border-color);
    }

    .profile-icon-big {
      width: 80px; height: 80px;
      border-radius: 50%;
      background: rgba(99,102,241,0.12);
      color: var(--primary);
      display: flex; align-items: center; justify-content: center;
      font-size: 44px;
      flex-shrink: 0;
      border: 3px solid var(--border-color);
    }

    .profile-hero-name {
      font-size: 22px;
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.2;
    }

    .profile-hero-sub { color: var(--text-muted); font-size: 13px; margin-top: 4px; }

    .detail-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 13px 24px;
      border-bottom: 1px solid var(--border-color);
    }

    .detail-row:last-child { border-bottom: none; }

    .detail-label {
      color: var(--text-muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .detail-value { font-weight: 600; color: var(--text-primary); font-size: 14px; }

    /* ===== SECTION 2: GALLERY ===== */
    .gallery-carousel-wrap { position: relative; border-radius: 10px; overflow: hidden; }

    .carousel-item img {
      height: 380px;
      object-fit: cover;
      width: 100%;
      border-radius: 10px;
      cursor: pointer;
    }

    .carousel-caption {
      background: rgba(0,0,0,0.55);
      border-radius: 8px;
      bottom: 20px;
      padding: 10px 16px;
      cursor: pointer;
    }

    .carousel-indicators [data-bs-target] { background-color: #ffffff; opacity: 0.5; }
    .carousel-indicators .active { opacity: 1; }

    @media (max-width: 576px) { .carousel-item img { height: 220px; } }

    /* ===== SECTION 3: EVENTS ===== */
    .event-block {
      border: 1px solid var(--border-color);
      background: var(--surface-alt);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px;
      transition: box-shadow 0.2s ease;
    }

    .event-block:last-child { margin-bottom: 0; }
    .event-block:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }

    .event-title { font-weight: 700; font-size: 16px; color: var(--text-primary); }
    .event-meta { color: var(--text-muted); font-size: 13px; line-height: 1.8; }

    .event-date-box {
      width: 52px; height: 54px;
      background: rgba(99,102,241,0.1);
      border: 1px solid rgba(99,102,241,0.25);
      border-radius: 12px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      flex-shrink: 0;
    }

    .event-date-month { font-size: 10px; font-weight: 800; text-transform: uppercase; color: var(--primary); }
    .event-date-day { font-size: 20px; font-weight: 800; color: var(--text-primary); line-height: 1; }

    .btn-register {
      border: 1.5px solid var(--primary);
      color: var(--primary);
      background: transparent;
      border-radius: 8px;
      padding: 8px 20px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-register:hover { background: var(--primary); color: #ffffff; }

    .btn-registered {
      border: 1.5px solid #10b981;
      color: #10b981;
      background: rgba(16,185,129,0.1);
      border-radius: 8px;
      padding: 8px 20px;
      font-weight: 600;
      font-size: 14px;
      cursor: default;
    }

    /* ===== FOOTER ===== */
    .app-footer {
      border-top: 1px solid var(--border-color);
      color: var(--text-muted);
      font-size: 13px;
      padding: 26px 0;
      text-align: center;
      background: var(--surface);
    }

    .app-footer a { color: var(--text-muted); text-decoration: none; }
    .app-footer a:hover { color: var(--primary); }

    /* ===== LOGIN VIEW ===== */
    .login-wrapper {
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
      background: var(--bg-body);
    }

    .login-card {
      background: var(--surface);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 40px;
      width: 100%; max-width: 400px;
      box-shadow: var(--card-shadow);
    }

    .login-brand-icon {
      width: 80px; height: 80px;
      border-radius: 18px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px;
      margin: 0 auto 16px;
      box-shadow: 0 4px 14px rgba(99,102,241,0.35);
    }

    .login-card h3 {
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .login-card p.sub { color: var(--text-muted); font-size: 13px; margin-bottom: 28px; }

    .login-theme-toggle {
      position: absolute;
      top: 20px; right: 20px;
    }

    /* ===== OFFCANVAS PROFILE FORM ===== */
    .offcanvas {
      background: var(--surface);
      color: var(--text-primary);
    }

    .offcanvas-header {
      border-bottom: 1px solid var(--border-color);
    }

    .offcanvas-title { font-weight: 800; color: var(--text-primary); }

    .form-section-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--primary);
      padding: 8px 0 4px;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 16px;
      margin-top: 24px;
    }

    .form-section-title:first-child { margin-top: 0; }

    .form-label-custom {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 6px;
      display: block;
    }

    .lang-badge {
      background: rgba(99,102,241,0.1);
      color: var(--primary);
      border: 1px solid rgba(99,102,241,0.3);
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .lang-badge.active { background: var(--primary); color: #fff; border-color: var(--primary); }

    /* Form controls adapt to theme via Bootstrap data-bs-theme */
    .form-control, .form-select {
      background: var(--surface-alt);
      border-color: var(--border-color);
      color: var(--text-primary);
    }

    .form-control:focus, .form-select:focus {
      background: var(--surface-alt);
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
      color: var(--text-primary);
    }

    .form-control::placeholder { color: var(--text-muted); }

    /* ===== MODAL (image popup & confirm) ===== */
    .modal-content {
      background: var(--surface);
      border: 1px solid var(--border-color);
      color: var(--text-primary);
    }

    .modal-header, .modal-footer {
      border-color: var(--border-color);
    }

    .img-popup-wrap img {
      max-height: 70vh;
      width: 100%;
      object-fit: contain;
      border-radius: 8px;
    }

    /* ===== BADGE ===== */
    .event-cat-badge {
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 20px;
      background: var(--surface);
      border: 1px solid var(--border-color);
      color: #00000;
    }

    /* ===== RADIO GROUP ===== */
    .radio-group { display: flex; gap: 20px; flex-wrap: wrap; }
    .radio-group label { color: var(--text-primary); font-size: 14px; cursor: pointer; }

    /* ===== EMPTY STATE ===== */
    .empty-state { text-align: center; padding: 48px 24px; color: var(--text-muted); }
    .empty-state i { font-size: 42px; margin-bottom: 12px; opacity: 0.4; }

    /* Responsive nav gap */
    @media (max-width: 480px) {
      .app-header { padding: 12px 16px; }
      .brand-title { font-size: 17px; }
    }
  </style>
</head>
<body>

  {{#if user}}
  <!-- ==================== LOGGED-IN DASHBOARD ==================== -->

  <!-- HEADER -->
  <header class="app-header">
    <div class="boxed d-flex align-items-center justify-content-between flex-wrap gap-2">

      <!-- Brand -->
      <div style="display:flex; align-items:center;">
        <img src="/logo/hamd-full-light.png" alt="HAMD Logo" class="logo-light-mode"
             style="height:50px; max-width:160px; object-fit:contain;">
        <img src="/logo/hamd-full-white.png"  alt="HAMD Logo" class="logo-dark-mode"
             style="height:50px; max-width:160px; object-fit:contain;">
      </div>

      <!-- Right actions -->
      <div class="d-flex align-items-center gap-2">

        <!-- Dark/Light Toggle -->
        <button type="button" class="nav-icon-btn border-0" id="themeToggleBtn" aria-label="Toggle theme" title="Toggle dark / light mode">
          <i class="bi bi-moon-stars" id="themeToggleIcon"></i>
        </button>

        <!-- Profile Dropdown -->
        <div class="dropdown">
          <div class="profile-btn" data-bs-toggle="dropdown" aria-expanded="false" role="button" tabindex="0">
            <div class="profile-avatar">
              <i class="bi bi-person-circle"></i>
            </div>
            <div class="d-none d-sm-block text-start me-1">
              <div class="profile-name">{{user.name}}</div>
              <div class="profile-role">MEMBER</div>
            </div>
            <i class="bi bi-chevron-down small" style="color:var(--text-muted);"></i>
          </div>
          <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="min-width:190px;">
            <li>
              <a class="dropdown-item rounded-3 py-2" href="#"
                 data-bs-toggle="offcanvas" data-bs-target="#editProfileOffcanvas">
                <i class="bi bi-pencil-square me-2 text-primary"></i>Edit Profile
              </a>
            </li>
            <li>
              <a class="dropdown-item rounded-3 py-2" href="#"
                 data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                <i class="bi bi-shield-lock me-2 text-primary"></i>Change Password
              </a>
            </li>
            <li><hr class="dropdown-divider" style="border-color:var(--border-color);"></li>
            <li>
              <a class="dropdown-item rounded-3 py-2 text-danger" href="/users/logout">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
              </a>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="boxed px-3 py-4">

    <!-- ===== SECTION 1: MY PROFILE ===== -->
    <section class="card-surface" id="details-section">
      <div class="card-header-bar">
        <span><i class="bi bi-person-badge me-2" style="color:var(--primary);"></i>My Profile</span>
      </div>

      <!-- Profile hero -->
      <div class="profile-hero flex-wrap gap-3">
        <div class="profile-icon-big">
          <i class="bi bi-person-circle"></i>
        </div>
        <div>
          <div class="profile-hero-name">{{user.name}}</div>
          <div class="profile-hero-sub">
            <i class="bi bi-mortarboard me-1"></i>Admission No: <strong>{{user.admissionNumber}}</strong>
            &nbsp;•&nbsp;
            <i class="bi bi-calendar3 me-1"></i>Batch: <strong>{{user.batch}}</strong>
          </div>
          <div class="profile-hero-sub mt-1">
            <i class="bi bi-envelope me-1"></i>{{user.email}}
          </div>
        </div>
      </div>

      {{#if user.place}}
      <div class="detail-row">
        <span class="detail-label">Place</span>
        <span class="detail-value">{{user.place}}</span>
      </div>
      {{/if}}
      {{#if user.address}}
      <div class="detail-row">
        <span class="detail-label">Address</span>
        <span class="detail-value">{{user.address}}</span>
      </div>
      {{/if}}
      {{#if user.phone}}
      <div class="detail-row">
        <span class="detail-label">Phone</span>
        <span class="detail-value">{{user.phone}}</span>
      </div>
      {{/if}}
      {{#if user.whatsapp}}
      <div class="detail-row">
        <span class="detail-label">WhatsApp</span>
        <span class="detail-value">{{user.whatsapp}}</span>
      </div>
      {{/if}}
      {{#if user.currentStatus}}
      <div class="detail-row">
        <span class="detail-label">Current Status</span>
        <span class="detail-value">{{user.currentStatus}}</span>
      </div>
      {{/if}}
    </section>

    <!-- ===== SECTION 2: GALLERY ===== -->
    <section class="card-surface" id="gallery-section">
      <div class="card-header-bar">
        <span><i class="bi bi-images me-2" style="color:var(--primary);"></i>Gallery</span>
      </div>
      <div class="card-body-pad">
        {{#if galleryImages.length}}
        <div id="galleryCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2000">
          <div class="carousel-indicators">
            {{#each galleryImages}}
            <button type="button" data-bs-target="#galleryCarousel"
              data-bs-slide-to="{{@index}}"
              class="{{#if @first}}active{{/if}}"
              aria-current="{{#if @first}}true{{/if}}"
              aria-label="Slide {{@index}}"></button>
            {{/each}}
          </div>
          <div class="carousel-inner rounded-3 overflow-hidden">
            {{#each galleryImages}}
            <div class="carousel-item {{#if @first}}active{{/if}}">
              {{#if this.hasImage}}
              <img src="/media/gallery/{{this._id}}"
                   class="d-block w-100"
                   alt="{{this.description}}"
                   data-gallery-popup
                   data-img-src="/media/gallery/{{this._id}}"
                   data-img-desc="{{this.description}}">
              {{/if}}
              {{#if this.description}}
              <div class="carousel-caption d-none d-md-block"
                   data-gallery-popup
                   data-img-src="/media/gallery/{{this._id}}"
                   data-img-desc="{{this.description}}">
                <p class="m-0 small fw-semibold">{{this.description}}</p>
              </div>
              {{/if}}
            </div>
            {{/each}}
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#galleryCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#galleryCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
          </button>
        </div>
        {{else}}
        <div class="empty-state">
          <i class="bi bi-images d-block"></i>
          <p class="m-0">No gallery images have been added yet.</p>
        </div>
        {{/if}}
      </div>
    </section>

    <!-- ===== SECTION 3: EVENTS ===== -->
    <section class="card-surface" id="events-section">
      <div class="card-header-bar">
        <span><i class="bi bi-calendar2-event me-2" style="color:var(--primary);"></i>Events</span>
      </div>
      <div class="card-body-pad">
        {{#if events.length}}
        {{#each events}}
        {{#unless this.isEnded}}
        <div class="event-block">
          <div class="d-flex gap-3 align-items-start">

            <!-- Date box -->
            <div class="event-date-box">
              <div class="event-date-month">{{this.month}}</div>
              <div class="event-date-day">{{this.day}}</div>
            </div>

            <!-- Content -->
            <div class="flex-grow-1 min-w-0">
              <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                <div class="event-title">{{this.title}}</div>
                <div>
                  {{#if this.category}}
                  <span class="event-cat-badge {{this.badgeColor}}">{{this.category}}</span>
                  {{/if}}
                </div>
              </div>
              <div class="event-meta">
                {{#if this.location}}<i class="bi bi-geo-alt me-1"></i>{{this.location}}<br>{{/if}}
              </div>
              {{#if this.description}}
              <p class="mb-3 mt-1 small" style="color:var(--text-primary); opacity:0.85; line-height:1.6;">{{this.description}}</p>
              {{/if}}

              {{#if this.registration}}
                {{#if this.isRegistered}}
                <button type="button"
                  class="btn-registered"
                  id="reg-btn-{{this.id}}">
                  <i class="bi bi-check-circle-fill me-1"></i>Registered
                </button>
                {{else}}
                <button type="button"
                  class="btn-register"
                  id="reg-btn-{{this.id}}"
                  onclick="openRegisterConfirm('{{this.id}}', '{{this.title}}')">
                  <i class="bi bi-check-circle me-1"></i>Register
                </button>
                {{/if}}
              {{/if}}
            </div>

          </div>
        </div>
        {{/unless}}
        {{/each}}

        {{#each events}}
        {{#if this.isEnded}}
        {{#if @first}}
        <div class="fw-bold small text-muted text-uppercase mb-3 mt-4 pt-3 border-top" style="letter-spacing: .06em;">
          <i class="bi bi-clock-history me-1"></i>Ended Events
        </div>
        {{/if}}
        <div class="event-block opacity-75">
          <div class="d-flex gap-3 align-items-start">

            <!-- Date box -->
            <div class="event-date-box opacity-75">
              <div class="event-date-month text-muted">{{this.month}}</div>
              <div class="event-date-day text-muted">{{this.day}}</div>
            </div>

            <!-- Content -->
            <div class="flex-grow-1 min-w-0">
              <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                <div class="event-title">{{this.title}}</div>
                <div class="d-flex gap-1 align-items-center">
                  <span class="event-cat-badge bg-secondary text-white">Ended</span>
                  {{#if this.category}}
                  <span class="event-cat-badge {{this.badgeColor}}">{{this.category}}</span>
                  {{/if}}
                </div>
              </div>
              <div class="event-meta">
                {{#if this.location}}<i class="bi bi-geo-alt me-1"></i>{{this.location}}<br>{{/if}}
              </div>
              {{#if this.description}}
              <p class="mb-3 mt-1 small" style="color:var(--text-primary); opacity:0.85; line-height:1.6;">{{this.description}}</p>
              {{/if}}

              {{#if this.registration}}
                {{#if this.isRegistered}}
                <button type="button" class="btn-registered" disabled>
                  <i class="bi bi-check-circle-fill me-1"></i>Registered (Ended)
                </button>
                {{else}}
                <span class="badge bg-light text-muted border py-2 px-3 fw-normal" style="font-size:12px;">
                  <i class="bi bi-x-circle me-1"></i>Registration Closed
                </span>
                {{/if}}
              {{/if}}
            </div>

          </div>
        </div>
        {{/if}}
        {{/each}}
        {{else}}
        <div class="empty-state">
          <i class="bi bi-calendar2-x d-block"></i>
          <p class="m-0">No events at the moment.</p>
        </div>
        {{/if}}
      </div>
    </section>

    <!-- ===== SECTION: MONTHLY CONTRIBUTION PAYMENT ===== -->
    <section class="card-surface" id="contribution-section"
      data-member-name="{{user.name}}" data-member-admission="{{user.admissionNumber}}">
      <div class="card-header-bar">
        <span><i class="bi bi-wallet2 me-2" style="color:var(--primary);"></i>Monthly Contribution Payment</span>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">₹30 / Month</span>
      </div>
      <div class="card-body-pad">
        {{#if contribution.hasUnpaidMonths}}
        <div class="alert alert-warning border-warning-subtle rounded-3 d-flex align-items-center mb-4 py-3 px-4 shadow-sm" role="alert">
          <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
          <div>
            <div class="fw-bold mb-1">Select month and pay 30 for each month</div>
            <div class="small opacity-75">You have {{contribution.unpaidCount}} unpaid month(s): {{contribution.unpaidListLabels}}</div>
          </div>
        </div>
        {{else}}
        <div class="alert alert-success border-success-subtle rounded-3 d-flex align-items-center mb-4 py-3 px-4 shadow-sm" role="alert">
          <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
          <div>
            <div class="fw-bold mb-1">All Up to Date!</div>
            <div class="small opacity-75">You have paid all monthly contributions up to current month.</div>
          </div>
        </div>
        {{/if}}

        <div class="mb-3">
          <label class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing:0.5px;">Contribution Months Checklist</label>
          <div class="row g-3" id="contributionMonthsGrid">
            {{#each contribution.months}}
            <div class="col-6 col-sm-4 col-md-3">
              <div class="card h-100 border p-3 rounded-3 month-card {{#unless this.isSelectable}}bg-body-tertiary opacity-75{{/unless}}" style="transition: all 0.2s ease;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <div class="form-check m-0">
                    <input class="form-check-input month-checkbox" type="checkbox"
                      value="{{this.key}}"
                      id="mchk-{{this.key}}"
                      data-month="{{this.month}}"
                      data-year="{{this.year}}"
                      data-label="{{this.label}}"
                      data-amount="{{this.amount}}"
                      {{#unless this.isSelectable}}disabled{{/unless}}>
                    <label class="form-check-label fw-bold ms-1" for="mchk-{{this.key}}" style="cursor: pointer;">
                      {{this.label}}
                    </label>
                  </div>
                </div>
                <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
                  <span class="fw-semibold text-secondary small">₹{{this.amount}}</span>
                  <span class="badge {{this.badgeColor}} px-2 py-1" style="font-size: 11px;">{{this.status}}</span>
                </div>
                {{#if this.rejectionReason}}
                <div class="small text-danger mt-2">
                  <strong>Reason:</strong> {{this.rejectionReason}}
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-3 w-100 mt-2 resubmit-month-btn"
                  data-month-key="{{this.key}}" data-month-label="{{this.label}}">
                  <i class="bi bi-arrow-repeat me-1"></i>Submit Again
                </button>
                {{/if}}
                {{#if this.isApproved}}
                <button type="button" class="btn btn-sm btn-outline-success rounded-3 w-100 mt-2 download-receipt-btn"
                  data-receipt-name="{{../../user.name}}"
                  data-receipt-admission="{{../../user.admissionNumber}}"
                  data-receipt-month="{{this.label}}"
                  data-receipt-amount="{{this.amount}}"
                  data-receipt-approved-by="{{this.approvedBy}}"
                  data-receipt-time="{{this.approvedAt}}"
                  data-receipt-submitted-time="{{this.submittedAt}}"
                  data-receipt-payment-id="{{this.paymentId}}">
                  <i class="bi bi-download me-1"></i>Download Receipt
                </button>
                {{/if}}
              </div>
            </div>
            {{/each}}
          </div>
        </div>

        <!-- Selected Summary & Pay Action Bar -->
        <div class="card bg-body-tertiary border rounded-3 p-3 mt-4 d-flex flex-row flex-wrap align-items-center justify-content-between gap-3">
          <div>
            <div class="small text-muted fw-semibold">Selected Months: <span id="selectedMonthsCount">0</span></div>
            <div class="fs-5 fw-extrabold text-primary">Total: ₹<span id="selectedTotalAmount">0</span></div>
          </div>
          <button type="button" id="openPayModalBtn" class="btn btn-primary rounded-3 px-4 py-2 fw-bold" disabled>
            <i class="bi bi-credit-card me-1"></i>Pay Now
          </button>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="app-footer">
    <div class="boxed px-3">
      <p class="m-0 mb-2 fw-bold" style="color:var(--text-primary);">
