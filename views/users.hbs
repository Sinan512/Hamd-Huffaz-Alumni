              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small text-muted text-uppercase mb-1" for="quick_leaveYear">
                  Year of Leaving
                </label>
                <input type="number" class="form-control rounded-3" id="quick_leaveYear" name="leaveYear" value="{{user.leaveYear}}" min="1950" max="2099" placeholder="e.g. 2022">
              </div>
