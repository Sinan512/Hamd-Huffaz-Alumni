<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Member Dashboard | HAMD</title>
  <link rel="icon" href="/logo/hamd-icon-white.png" />
  <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />

  <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <!-- Apply saved theme before paint (prevents theme flash) -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('userTheme');
        if (t !== 'dark' && t !== 'light') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-bs-theme', t);
      } catch (e) {}
    })();
  </script>

  <style>
    /* ============================================================
       DESIGN SYSTEM — "The Continuing Thread"
       A flowing editorial dashboard replacing boxed-card sections
       with a single connected spine, generous whitespace and one
       deliberate hero moment. Palette drawn from illuminated
       manuscript greens and gold leaf rather than generic SaaS indigo.
    ============================================================ */
    :root {
      --font-display: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      /* Colors — Light */
      --bg-body: #f5f8f6;
      --bg-grid-pattern: radial-gradient(circle, rgba(11, 110, 82, 0.07) 1px, transparent 1px);
      --surface: #ffffff;
      --surface-alt: #eef4f0;
      --surface-subtle: #f5f8f6;
      --surface-glass: rgba(255, 255, 255, 0.82);
      --surface-glass-border: rgba(15, 50, 40, 0.1);
      --border-color: rgba(33, 71, 101, 0.792);
      --border-subtle: rgba(15, 50, 40, 0.09);

      --text-primary: #101624;
      --text-secondary: #343d49;
      --text-muted: #667179;
      --text-dim: #96a0a6;

      --primary: #0b3c6e;
      --primary-hover: #083157;
      --primary-light: #e2edf2;
      --primary-glow: rgba(11, 65, 110, 0.22);

      --gold: #b3862d;
      --gold-light: #faf1dd;
      --gold-glow: rgba(179, 134, 45, 0.28);

      --emerald: #0b396e;
      --emerald-light: #e2f2ea;
      --amber: #b3862d;
      --amber-light: #faf1dd;
      --rose: #c8433f;
      --rose-light: #fbeceb;
      --cyan: #0a7f8c;

      --card-shadow: 0 4px 20px -4px rgba(9, 17, 30, 0.06), 0 2px 6px -2px rgba(9, 20, 30, 0.03);
      --card-shadow-hover: 0 20px 34px -8px rgba(9, 18, 30, 0.1), 0 8px 14px -4px rgba(9, 20, 30, 0.05);
      --card-shadow-lift: 0 12px 28px -6px rgba(11, 51, 110, 0.16);

      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --radius-xl: 32px;
      --radius-pill: 9999px;

      --transition-base: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      --transition-smooth: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* ===== DARK MODE ===== */
    [data-bs-theme="dark"] {
      --bg-body: #070d0f;
      --bg-grid-pattern: radial-gradient(circle, rgba(53, 199, 149, 0.09) 1px, transparent 1px);
      --surface: #0e141a;
      --surface-alt: #142228;
      --surface-subtle: #101a1f;
      --surface-glass: rgba(14, 21, 26, 0.82);
      --surface-glass-border: rgba(255, 255, 255, 0.402);
      --border-color: rgba(85, 92, 137, 0.614);
      --border-subtle: rgba(116, 132, 164, 0.566);

      --text-primary: #f2f5f7;
      --text-secondary: #c4ccd3;
      --text-muted: #909ca4;
      --text-dim: #5f6c72;

      --primary: #3577c7;
      --primary-hover: #4f92da;
      --primary-light: rgba(53, 114, 199, 0.14);
      --primary-glow: rgba(53, 133, 199, 0.32);

      --gold: #e2b750;
      --gold-light: rgba(226, 183, 80, 0.14);
      --gold-glow: rgba(226, 183, 80, 0.3);

      --emerald-light: rgba(53, 131, 199, 0.14);
      --amber-light: rgba(226, 183, 80, 0.14);
      --rose-light: rgba(239, 100, 92, 0.16);

      --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.5), 0 2px 6px -1px rgba(0, 0, 0, 0.3);
      --card-shadow-hover: 0 20px 40px -4px rgba(0, 0, 0, 0.65), 0 8px 16px -3px rgba(0, 0, 0, 0.4);
      --card-shadow-lift: 0 14px 34px -4px rgba(53, 104, 199, 0.22);
      color-scheme: dark;
    }

    /* ===== BASE RESET & TYPOGRAPHY ===== */
    *, *::before, *::after { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      max-width: 100%;
      overflow-x: clip;
    }

    body {
      max-width: 100%;
      font-family: var(--font-body);
      background-color: var(--bg-body);
      background-image: var(--bg-grid-pattern);
      background-size: 32px 32px;
      color: var(--text-primary);
      margin: 0;
      padding: 0;
      min-height: 100vh;
      overflow-x: clip; /* was overflow-x: hidden — that forces overflow-y to
        an implicit 'auto', turning <body> into its own scroll container and
        making the sticky header's scroll math unstable. overflow-x: clip
        gives the same "no horizontal scrollbar" result without that side
        effect. */
    }

    h1, h2, h3, h4, h5, h6, .brand-title, .font-display {
      font-family: var(--font-display);
      letter-spacing: -0.02em;
    }

    ::selection { background: var(--primary); color: #fff; }

    /* ===== ENTRANCE / SCROLL-REVEAL MOTION ===== */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes pulseGlow {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 0.9; transform: scale(1.05); }
    }

    @keyframes floatOrb {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(15px, -15px); }
    }

    @keyframes threadGrow {
      from { transform: scaleY(0); }
      to { transform: scaleY(1); }
    }

    .animate-in { animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .animate-delay-1 { animation-delay: 0.08s; }
    .animate-delay-2 { animation-delay: 0.16s; }
    .animate-delay-3 { animation-delay: 0.24s; }
    .animate-delay-4 { animation-delay: 0.32s; }

    /* Scroll-triggered reveal: elements start hidden, IntersectionObserver adds .is-visible */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--reveal-delay, 0s);
    }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }

    @media (prefers-reduced-motion: reduce) {
      .animate-in, .member-hero, .reveal, * {
        animation: none !important;
        transition: none !important;
      }
      .reveal { opacity: 1; transform: none; }
    }

    /* ===== HEADER & NAVIGATION ===== */
    .app-header {
      background: var(--surface-glass);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--surface-glass-border);
      padding: 12px 0;
      position: sticky;
      top: 0;
      z-index: 1030;
      transition: var(--transition-base);
      /* Promote the sticky header to its own compositor layer. Without this,
         the browser has to recompute the backdrop-filter blur against the
         page content on every scroll frame, which is what causes the header
         to visibly judder/shift by a pixel or two while scrolling. */
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
      will-change: transform;
      backface-visibility: hidden;
    }

    .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .brand-group { display: flex; align-items: center; gap: 12px; text-decoration: none; }
    .brand-logo-img { height: 44px; max-width: 150px; object-fit: contain; transition: var(--transition-base); }
    .brand-logo-img:hover { transform: scale(1.02); }
    .logo-light-mode { display: block; }
    .logo-dark-mode  { display: none; }
    [data-bs-theme="dark"] .logo-light-mode { display: none; }
    [data-bs-theme="dark"] .logo-dark-mode  { display: block; }

    .nav-actions { display: flex; align-items: center; gap: 10px; }

    .nav-icon-btn {
      width: 42px; height: 42px; border-radius: 12px;
      border: 1px solid var(--border-color);
      background: var(--surface);
      color: var(--text-secondary);
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 1.15rem;
      transition: var(--transition-base);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    }
    .nav-icon-btn:hover {
      background: var(--surface-alt); color: var(--primary); border-color: var(--primary);
      transform: translateY(-2px); box-shadow: 0 4px 12px var(--primary-glow);
    }

    .profile-btn {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 5px 14px 5px 6px; border: 1px solid var(--border-color);
      border-radius: var(--radius-pill); background: var(--surface);
      cursor: pointer; transition: var(--transition-base);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04); user-select: none;
    }
    .profile-btn:hover {
      background: var(--surface-alt); border-color: var(--primary);
      transform: translateY(-2px); box-shadow: 0 4px 14px var(--primary-glow);
    }

    .profile-avatar-sm {
      width: 34px; height: 34px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), #5088e2);
      color: #ffffff; display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; font-weight: 700; box-shadow: 0 2px 8px var(--primary-glow);
    }

    .profile-info { text-align: left; line-height: 1.2; }
    .profile-name {
      font-size: 13px; font-weight: 700; color: var(--text-primary);
      max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .profile-role-badge { font-size: 10px; font-weight: 800; color: var(--primary); letter-spacing: 0.8px; }

    /* ===== DROPDOWNS ===== */
    .dropdown-menu {
      background: var(--surface); border: 1px solid var(--border-color);
      border-radius: var(--radius-md); box-shadow: var(--card-shadow-hover);
      padding: 8px; min-width: 210px;
      animation: fadeInUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .dropdown-item {
      color: var(--text-secondary); font-size: 13.5px; font-weight: 600;
      padding: 10px 14px; border-radius: 10px; display: flex; align-items: center; gap: 10px;
      transition: var(--transition-base);
    }
    .dropdown-item i { font-size: 1.05rem; }
    .dropdown-item:hover { background: var(--surface-alt); color: var(--primary); }
    .dropdown-item.text-danger:hover { background: var(--rose-light); color: var(--rose) !important; }

    /* ============================================================
       HERO — the one deliberate bold moment. Full-bleed, no card box.
    ============================================================ */
    .member-hero {
      position: relative;
      overflow: hidden;
      color: #ffffff;
      background:
        radial-gradient(circle at 15% 20%, rgba(53, 102, 199, 0.35), transparent 55%),
        radial-gradient(circle at 85% 75%, rgba(45, 161, 179, 0.28), transparent 55%),
        linear-gradient(160deg, #060d14 0%, #0a1620 45%, #0b1c36 100%);
      padding: 76px 0 56px;
      margin: -1px 0 0;
    }

    .hero-orb { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; z-index: 0; }
    .hero-orb-1 {
      width: 380px; height: 380px; top: -140px; right: 6%;
      background: radial-gradient(circle, rgba(53, 199, 149, 0.45), transparent 70%);
      animation: floatOrb 11s ease-in-out infinite;
    }
    .hero-orb-2 {
      width: 300px; height: 300px; bottom: -120px; left: 8%;
      background: radial-gradient(circle, rgba(226, 183, 80, 0.32), transparent 70%);
      animation: floatOrb 9s ease-in-out infinite reverse;
    }
    .hero-grid-overlay {
      position: absolute; inset: 0;
      background-image: radial-gradient(circle, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
      background-size: 26px 26px; pointer-events: none; z-index: 0; opacity: 0.5;
    }

    .hero-content { position: relative; z-index: 1; }

    .member-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 14px; border-radius: var(--radius-pill);
      background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: #cdeee0; font-size: 12px; font-weight: 700; letter-spacing: 0.3px;
    }

    .member-hero-main { display: flex; align-items: center; gap: 28px; margin-top: 28px; }

    .member-avatar-xl {
      width: 92px; height: 92px; flex-shrink: 0; border-radius: 26px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.06));
      backdrop-filter: blur(12px); border: 1.5px solid rgba(255, 255, 255, 0.28);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
      display: flex; align-items: center; justify-content: center;
      font-size: 2.8rem; color: #ffffff; position: relative;
    }
    .member-avatar-xl::after {
      content: ""; position: absolute; bottom: -2px; right: -2px;
      width: 18px; height: 18px; background: #3568c7;
      border: 3px solid #0a1320; border-radius: 50%;
    }

    .member-hero h1 {
      margin: 0; font-size: clamp(30px, 4.6vw, 54px); font-weight: 800;
      letter-spacing: -0.03em; color: #ffffff; line-height: 1.05;
    }

    .member-hero-meta {
      display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px;
      margin-top: 12px; color: #c9dcd1; font-size: 13.5px;
    }
    .hero-meta-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(255, 255, 255, 0.07); padding: 4px 10px; border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .hero-meta-badge strong { color: #ffffff; }

    .member-hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
    .hero-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px;
      border-radius: 12px; font-size: 13.5px; font-weight: 700; text-decoration: none;
      transition: var(--transition-base); cursor: pointer;
    }
    .hero-btn-primary {
      background: #ffffff; color: #0b3626; border: 1px solid #ffffff;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.22);
    }
    .hero-btn-primary:hover { background: #eafff5; transform: translateY(-2px); box-shadow: 0 10px 22px rgba(0, 0, 0, 0.3); }
    .hero-btn-glass {
      background: rgba(255, 255, 255, 0.09); backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2); color: #ffffff;
    }
    .hero-btn-glass:hover { background: rgba(255, 255, 255, 0.18); transform: translateY(-2px); color: #fff; }

    /* Stat rail — a thin divided strip, not a grid of boxed cards */
    .member-stats {
      display: flex; flex-wrap: wrap; margin-top: 46px;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
    .member-stat-card {
      flex: 1 1 200px; padding: 20px 22px 4px 0; margin-right: 34px;
      border-top: 2px solid transparent;
      transition: var(--transition-base);
    }
    .member-stat-card:hover { border-top-color: var(--gold); }
    .stat-label {
      color: #a9d9c4; font-size: 11px; font-weight: 700; letter-spacing: 0.5px;
      margin-bottom: 6px; display: flex; align-items: center; gap: 6px;
    }
    .stat-value {
      font-family: var(--font-display); font-size: 20px; font-weight: 700; color: #ffffff;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* ============================================================
       THE THREAD — a continuous spine connecting flowing sections,
       replacing repeated boxed cards.
    ============================================================ */
    .thread-page { position: relative; }

    .thread-line {
      position: absolute;
      left: 15px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: linear-gradient(to bottom, var(--primary), var(--gold) 55%, transparent);
      opacity: 0.35;
      transform-origin: top;
      animation: threadGrow 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
      display: none;
    }
    @media (min-width: 992px) { .thread-line { display: block; } }

    .flow-section {
      position: relative;
      padding: 72px 0;
      border-top: 1px solid var(--border-subtle);
    }
    .flow-section:first-of-type { border-top: none; padding-top: 56px; }

    .flow-section-inner { position: relative; padding-left: 0; }
    @media (min-width: 992px) { .flow-section-inner { padding-left: 46px; } }

    .flow-node {
      display: none;
      position: absolute;
      left: -46px;
      top: 6px;
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--surface);
      border: 2px solid var(--primary);
      color: var(--primary);
      align-items: center;
      justify-content: center;
      font-size: 15px;
      box-shadow: 0 0 0 6px var(--bg-body);
    }
    @media (min-width: 992px) { .flow-node { display: flex; } }

    .section-head {
      display: flex; align-items: flex-end; justify-content: space-between;
      flex-wrap: wrap; gap: 14px; margin-bottom: 34px;
    }
    .section-title {
      font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; color: var(--text-primary);
      margin: 0; display: flex; align-items: center; gap: 12px;
    }
    .section-sub { color: var(--text-muted); font-size: 14px; margin-top: 6px; max-width: 52ch; }
    .section-tag {
      font-size: 12px; font-weight: 700; color: var(--primary);
      background: var(--primary-light); border-radius: var(--radius-pill);
      padding: 6px 14px; white-space: nowrap;
    }
    .section-tag.gold { color: var(--gold); background: var(--gold-light); }

    .card-header-icon {
      width: 36px; height: 36px; border-radius: 10px;
      background: var(--primary-light); color: var(--primary);
      display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }

    /* ===== PROFILE + GALLERY — asymmetric split, no card boxes ===== */
    .profile-hero-card {
      display: flex; align-items: center; gap: 18px; padding-bottom: 22px;
      margin-bottom: 6px; border-bottom: 1px solid var(--border-subtle);
    }
    .profile-icon-big {
      width: 66px; height: 66px; border-radius: 18px;
      background: var(--primary-light); border: none; color: var(--primary);
      display: flex; align-items: center; justify-content: center; font-size: 2rem; flex-shrink: 0;
    }
    .profile-hero-name { font-size: 19px; font-weight: 800; color: var(--text-primary); line-height: 1.2; }
    .profile-hero-sub { color: var(--text-muted); font-size: 13px; margin-top: 4px; }

    .detail-list { padding: 4px 0 0; }
    .detail-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 15px 2px; border-bottom: 1px solid var(--border-subtle);
      transition: var(--transition-base);
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-row:hover { padding-left: 8px; }
    .detail-label-group { display: flex; align-items: center; gap: 10px; }
    .detail-icon {
      width: 30px; height: 30px; border-radius: 8px; background: var(--surface-alt);
      color: var(--primary); display: inline-flex; align-items: center; justify-content: center; font-size: 0.9rem;
    }
    .detail-label { color: var(--text-muted); font-size: 12px; font-weight: 700; letter-spacing: 0.3px; }
    .detail-value { font-weight: 700; color: var(--text-primary); font-size: 14px; text-align: right; max-width: 60%; word-break: break-word; }

    .gallery-carousel-wrap {
      position: relative; border-radius: var(--radius-md); overflow: hidden;
      background: #000; box-shadow: var(--card-shadow);
    }
    .carousel-item img { height: 420px; object-fit: cover; width: 100%; cursor: pointer; transition: transform 0.6s ease; }
    .carousel-item img:hover { transform: scale(1.03); }
    .carousel-caption-glass {
      position: absolute; bottom: 16px; left: 16px; right: 16px;
      background: rgba(8, 20, 15, 0.78); backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 12px;
      padding: 12px 18px; color: #ffffff; text-align: left; cursor: pointer; transition: var(--transition-base);
    }
    .carousel-caption-glass:hover { background: rgba(8, 20, 15, 0.92); border-color: rgba(255, 255, 255, 0.28); }
    .carousel-indicators [data-bs-target] {
      width: 8px; height: 8px; border-radius: 50%; background-color: #ffffff;
      opacity: 0.4; margin: 0 4px; border: none; transition: var(--transition-base);
    }
    .carousel-indicators .active { opacity: 1; width: 24px; border-radius: 4px; background-color: var(--primary); }
    .carousel-nav-btn {
      width: 40px; height: 40px; border-radius: 50%; background: rgba(8, 20, 15, 0.55);
      backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.2); color: #ffffff;
      display: flex; align-items: center; justify-content: center; position: absolute; top: 50%;
      transform: translateY(-50%); transition: var(--transition-base); opacity: 0.85;
    }
    .carousel-nav-btn:hover { background: var(--primary); opacity: 1; color: #ffffff; }

    /* ===== EVENTS — vertical timeline rows, not boxed cards ===== */
    .events-grid { display: flex; flex-direction: column; }
    .event-card {
      border: none; border-bottom: 1px solid var(--border-subtle);
      background: transparent; border-radius: 0; padding: 22px 4px;
      transition: var(--transition-base); position: relative;
      display: flex; gap: 22px; align-items: flex-start;
    }
    .event-card:last-child { border-bottom: none; }
    .event-card:hover { padding-left: 12px; background: var(--surface-alt); border-radius: var(--radius-sm); }

    .event-date-box {
      width: 58px; height: 62px; border-radius: 14px; background: var(--primary-light);
      border: none; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .event-date-month { font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--primary); letter-spacing: 0.5px; }
    .event-date-day { font-size: 22px; font-weight: 900; color: var(--text-primary); line-height: 1; font-family: var(--font-display); }

    .event-content { flex: 1; min-width: 0; }
    .event-header { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 6px; }
    .event-title { font-size: 17px; font-weight: 800; color: var(--text-primary); margin: 0; }
    .event-cat-badge {
      font-size: 11px; font-weight: 700; padding: 4px 12px; border-radius: var(--radius-pill);
      letter-spacing: 0.3px; border: 1px solid var(--border-color);
    }
    .event-location { font-size: 13px; color: var(--text-muted); display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
    .event-desc { font-size: 13.5px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 14px; }

    .btn-register {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--primary); color: #ffffff; border: none; border-radius: 10px;
      padding: 8px 18px; font-size: 13.5px; font-weight: 700; cursor: pointer;
      transition: var(--transition-base); box-shadow: 0 4px 12px var(--primary-glow);
    }
    .btn-register:hover { transform: translateY(-2px); box-shadow: 0 6px 18px var(--primary-glow); color: #ffffff; }
    .btn-registered {
      display: inline-flex; align-items: center; gap: 6px; background: var(--emerald-light); color: var(--emerald);
      border: 1.5px solid var(--emerald); border-radius: 10px; padding: 8px 18px; font-size: 13.5px; font-weight: 700; cursor: default;
    }
    .event-card.ended-event { opacity: 0.72; }
    .event-card.ended-event:hover { opacity: 0.92; padding-left: 4px; background: transparent; }

    /* ===== MONTHLY CONTRIBUTION — invitation band, flat tiles ===== */
    .contribution-band {
      background: linear-gradient(180deg, var(--surface-subtle), transparent);
      border-radius: var(--radius-lg);
      padding: 40px 30px;
      border: 1px solid var(--border-subtle);
    }

    .status-alert-card {
      border-radius: var(--radius-md); padding: 18px 22px; display: flex; align-items: center; gap: 16px;
      margin-bottom: 26px; border: 1px solid transparent;
    }
    .status-alert-warning { background: var(--amber-light); border-color: rgba(179, 134, 45, 0.3); color: var(--text-primary); }
    .status-alert-success { background: var(--emerald-light); border-color: rgba(11, 110, 82, 0.3); color: var(--text-primary); }
    .alert-icon-wrap {
      width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
      font-size: 1.35rem; flex-shrink: 0;
    }
    .status-alert-warning .alert-icon-wrap { background: rgba(179, 134, 45, 0.2); color: var(--amber); }
    .status-alert-success .alert-icon-wrap { background: rgba(11, 110, 82, 0.18); color: var(--emerald); }

    .prepay-box { padding: 0; margin-bottom: 30px; }
    .prepay-card {
      border: none; border-bottom: 3px solid var(--border-color);
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      background: var(--surface); padding: 22px; cursor: pointer; position: relative;
      transition: var(--transition-base); display: flex; flex-direction: column; height: 100%;
    }
    .prepay-card:hover { border-bottom-color: var(--primary); transform: translateY(-3px); }
    .prepay-card.active-plan, .prepay-card.border-primary {
      border-bottom-color: var(--gold) !important; background: var(--primary-light) !important;
    }
    .prepay-icon {
      width: 46px; height: 46px; border-radius: 14px; background: var(--primary-light); color: var(--primary);
      display: flex; align-items: center; justify-content: center; font-size: 1.35rem; margin-bottom: 12px;
    }
    .prepay-price { font-size: 26px; font-weight: 900; font-family: var(--font-display); color: var(--gold); margin: 6px 0; }

    .month-card {
      border: none; border-bottom: 3px solid var(--border-color); border-radius: 10px 10px 0 0;
      background: var(--surface); padding: 16px; transition: var(--transition-base);
      display: flex; flex-direction: column; justify-content: space-between; height: 100%; position: relative;
    }
    .month-card:hover { border-bottom-color: var(--primary); transform: translateY(-2px); }
    .month-card.disabled-card { background: var(--surface-subtle); opacity: 0.75; }
    .month-checkbox { width: 18px; height: 18px; border-radius: 5px; border: 1.5px solid var(--border-color); cursor: pointer; }
    .month-checkbox:checked { background-color: var(--primary); border-color: var(--primary); }
    .month-badge { font-size: 10.5px; font-weight: 800; letter-spacing: 0.4px; padding: 4px 8px; border-radius: 6px; }

    .checkout-action-bar {
      background: var(--surface); border: 1.5px solid var(--border-color); border-radius: var(--radius-md);
      padding: 16px 24px; margin-top: 26px; display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 16px; box-shadow: var(--card-shadow-hover); position: sticky; bottom: 20px; z-index: 100;
    }
    .checkout-total-val { font-size: 24px; font-weight: 900; font-family: var(--font-display); color: var(--gold); }
    .btn-pay-action {
      background: var(--primary); color: #ffffff; border: none; border-radius: 12px; padding: 12px 28px;
      font-size: 15px; font-weight: 800; display: inline-flex; align-items: center; gap: 8px;
      transition: var(--transition-base); box-shadow: 0 4px 16px var(--primary-glow); cursor: pointer;
    }
    .btn-pay-action:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 24px var(--primary-glow); color: #ffffff; }
    .btn-pay-action:disabled { opacity: 0.5; cursor: not-allowed; box-shadow: none; }

    /* ===== OFFCANVAS & MODALS ===== */
    .offcanvas, .modal-content {
      background: var(--surface); color: var(--text-primary); border: 1px solid var(--border-color);
      box-shadow: var(--card-shadow-hover);
    }
    .offcanvas-header, .modal-header { border-bottom: 1px solid var(--border-color); padding: 18px 24px; }
    .modal-footer { border-top: 1px solid var(--border-color); padding: 18px 24px; }

    .form-section-title {
      font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: var(--primary);
      padding: 8px 0 6px; border-bottom: 1px solid var(--border-color); margin: 24px 0 16px;
      display: flex; align-items: center; gap: 8px;
    }
    .form-section-title:first-child { margin-top: 0; }
    .form-label-custom { font-size: 12.5px; font-weight: 700; color: var(--text-secondary); margin-bottom: 6px; display: block; }
    .form-control, .form-select {
      background: var(--surface-alt); border: 1.5px solid var(--border-color); border-radius: 10px;
      color: var(--text-primary); padding: 10px 14px; font-size: 14px; transition: var(--transition-base);
    }
    .form-control:focus, .form-select:focus {
      background: var(--surface); border-color: var(--primary); box-shadow: 0 0 0 4px var(--primary-glow); color: var(--text-primary);
    }

    .lang-badge {
      background: var(--surface-alt); color: var(--text-muted); border: 1px solid var(--border-color);
      border-radius: var(--radius-pill); padding: 4px 14px; font-size: 12px; font-weight: 800; cursor: pointer;
      transition: var(--transition-base);
    }
    .lang-badge.active { background: var(--primary); color: #ffffff; border-color: var(--primary); box-shadow: 0 2px 8px var(--primary-glow); }

    .radio-group { display: flex; gap: 20px; flex-wrap: wrap; }
    .radio-group label { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; cursor: pointer; }

    .upi-app-btn {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
      padding: 14px 8px; border-radius: 14px; border: 1.5px solid var(--border-color); background: var(--surface-alt);
      cursor: pointer; transition: var(--transition-base); text-decoration: none;
    }
    .upi-app-btn:hover { border-color: var(--primary); background: var(--primary-light); transform: translateY(-2px); }

    /* Empty states */
    .empty-state { text-align: center; padding: 48px 24px; color: var(--text-muted); }
    .empty-state i { font-size: 48px; color: var(--text-dim); margin-bottom: 12px; display: inline-block; }

    /* ===== LOGIN VIEW ===== */
    .login-wrapper { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; position: relative; }
    .login-card {
      background: var(--surface-glass); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 44px 40px;
      width: 100%; max-width: 430px; box-shadow: var(--card-shadow-hover); position: relative; z-index: 1;
    }
    .login-brand-icon {
      width: 88px; height: 88px; border-radius: 24px; background: rgba(255, 255, 255, 0.018); border: 1.5px solid transparent;
      display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: var(--card-shadow);
    }

    /* ===== COMMUNITY FOOTER ===== */
    #footer { margin-top: 0; background: #061410; color: #cfe6db; border-top: 1px solid rgba(255, 255, 255, 0.08); }
    [data-bs-theme="dark"] #footer { background: #030a08; }
    .footer-top { padding: 64px 0 40px; }
    .footer-brand { display: flex; align-items: center; gap: 12px; color: #ffffff; font-size: 22px; font-weight: 800; }
    .brand-icon { width: 42px; height: 42px; border-radius: 12px; background: rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; }
    .footer-logo { width: 32px; max-height: 30px; object-fit: contain; }
    .footer-tagline { margin: 18px 0 22px; color: #90a89c; font-size: 13.5px; line-height: 1.8; max-width: 380px; }
    .footer-social { display: flex; gap: 10px; }
    .footer-social-link {
      width: 38px; height: 38px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.04); color: #d7ece1; display: inline-flex; align-items: center; justify-content: center;
      font-size: 1.1rem; text-decoration: none; transition: var(--transition-base);
    }
    .footer-social-link:hover { background: var(--primary); color: #ffffff; border-color: var(--primary); transform: translateY(-3px); }
    .footer-heading { color: #ffffff; font-size: 12px; font-weight: 800; letter-spacing: 1px; margin-bottom: 20px; }
    .footer-links { list-style: none; margin: 0; padding: 0; }
    .footer-links li { margin-bottom: 12px; }
    .footer-links a { color: #90a89c; font-size: 13.5px; text-decoration: none; transition: var(--transition-base); display: inline-flex; align-items: center; }
    .footer-links a:hover { color: #ffffff; transform: translateX(4px); }
    .footer-divider { border-color: rgba(255, 255, 255, 0.08); margin: 0; }
    .footer-bottom { padding: 24px 0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
    .footer-bottom-text { margin: 0; color: #6c8579; font-size: 13px; }
    .footer-bottom-links { display: flex; gap: 20px; }
    .footer-bottom-links a { color: #90a89c; font-size: 13px; text-decoration: none; }
    .footer-bottom-links a:hover { color: #ffffff; }

    /* Responsive adjustments */
    @media (max-width: 991px) {
      .carousel-item img { height: 320px; }
      .flow-section { padding: 56px 0; }
    }

    @media (max-width: 640px) {
      .member-hero { padding: 52px 0 40px; }
      .member-hero-main { align-items: flex-start; gap: 16px; }
      .member-avatar-xl { width: 68px; height: 68px; font-size: 2.2rem; border-radius: 20px; }
      .member-stats { gap: 18px 0; }
      .member-stat-card { flex: 1 1 46%; margin-right: 14px; padding-right: 8px; }
      .carousel-item img { height: 240px; }
      .event-card { flex-direction: column; gap: 14px; }
      .event-date-box { width: 100%; height: 48px; flex-direction: row; gap: 8px; }
      .checkout-action-bar { flex-direction: column; align-items: stretch; }
      .btn-pay-action { width: 100%; justify-content: center; }
      .contribution-band { padding: 28px 18px; }
    }
  </style>
</head>
<body>

  {{#if user}}
  <!-- ============================================================ -->
  <!-- LOGGED-IN MEMBER DASHBOARD — flowing scroll experience        -->
  <!-- ============================================================ -->

  <!-- Top Navigation Header -->
  <header class="app-header">
    <div class="container-xl">
      <div class="header-inner">

        <!-- Brand / Logos -->
        <a href="#member-overview" class="brand-group">
          <img src="/logo/hamd-full-light.png" alt="HAMD Logo" class="brand-logo-img logo-light-mode">
          <img src="/logo/hamd-full-white.png" alt="HAMD Logo" class="brand-logo-img logo-dark-mode">
        </a>

        <!-- Right Navigation Actions -->
        <div class="nav-actions">

          <!-- Theme Mode Toggle -->
          <button type="button" class="nav-icon-btn" id="themeToggleBtn" aria-label="Toggle dark/light mode" title="Toggle theme">
            <i class="bi bi-moon-stars" id="themeToggleIcon"></i>
          </button>

          <!-- Member Profile Dropdown -->
          <div class="dropdown">
            <div class="profile-btn" data-bs-toggle="dropdown" aria-expanded="false" role="button" tabindex="0">
              <div class="profile-avatar-sm">
                <i class="bi bi-person-fill"></i>
              </div>
              <div class="profile-info d-none d-sm-block">
                <div class="profile-name">{{user.name}}</div>
                <div class="profile-role-badge">MEMBER</div>
              </div>
              <i class="bi bi-chevron-down ms-1" style="font-size: 11px; color: var(--text-muted);"></i>
            </div>

            <ul class="dropdown-menu dropdown-menu-end mt-2">
              <li>
                <a class="dropdown-item" href="#" data-bs-toggle="offcanvas" data-bs-target="#editProfileOffcanvas">
                  <i class="bi bi-pencil-square text-primary"></i> Edit Profile
                </a>
              </li>
              <li><hr class="dropdown-divider my-2" style="border-color: var(--border-color);"></li>
              <li>
                <a class="dropdown-item text-danger" href="/users/logout">
                  <i class="bi bi-box-arrow-right"></i> Logout
                </a>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </div>
  </header>

  <!-- ===== MEMBER OVERVIEW HERO — full-bleed, the one bold moment ===== -->
  <section class="member-hero" id="member-overview">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-grid-overlay"></div>

    <div class="container-xl">
      <div class="hero-content animate-in">
        <div class="member-eyebrow">
          <i class="bi bi-stars"></i> HAMD Alumni
        </div>

        <div class="member-hero-main">
          <div class="member-avatar-xl">
            <i class="bi bi-person-fill"></i>
          </div>
          <div>
            <h1>{{user.name}}</h1>
            <div class="member-hero-meta">
              <span class="hero-meta-badge">
                <i class="bi bi-mortarboard text-primary"></i> Admission No: <strong>{{user.admissionNumber}}</strong>
              </span>
              <span class="hero-meta-badge">
                <i class="bi bi-calendar3 text-primary"></i> Batch: <strong>{{user.batch}}</strong>
              </span>
              {{#if user.email}}
              <span class="hero-meta-badge">
                <i class="bi bi-envelope text-primary"></i> <strong>{{user.email}}</strong>
              </span>
              {{/if}}
            </div>
          </div>
        </div>

        <div class="member-hero-actions">
          <a href="#" class="hero-btn hero-btn-primary" data-bs-toggle="offcanvas" data-bs-target="#editProfileOffcanvas">
            <i class="bi bi-pencil-square"></i> Edit Details
          </a>
          <a href="#contribution-section" class="hero-btn hero-btn-glass">
            <i class="bi bi-heart-fill text-danger"></i> Support HAMD
          </a>
        </div>

        <!-- Quick Metrics Rail -->
        <div class="member-stats" aria-label="Member overview stats">
          <div class="member-stat-card">
            <div class="stat-label"><i class="bi bi-card-heading"></i> Admission No.</div>
            <div class="stat-value">{{user.admissionNumber}}</div>
          </div>
          <div class="member-stat-card">
            <div class="stat-label"><i class="bi bi-mortarboard"></i> Batch</div>
            <div class="stat-value">{{user.batch}}</div>
          </div>
          <div class="member-stat-card">
            <div class="stat-label"><i class="bi bi-activity"></i> Current Status</div>
            <div class="stat-value">{{#if user.currentStatus}}{{user.currentStatus}}{{else}}Member{{/if}}</div>
          </div>
          <div class="member-stat-card">
            <div class="stat-label"><i class="bi bi-geo-alt"></i> Based In</div>
            <div class="stat-value">{{#if user.place}}{{user.place}}{{else}}HAMD Community{{/if}}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Container -->
  <main class="thread-page">
    <div class="thread-line"></div>
    <div class="container-xl">

      <!-- ===== PROFILE + GALLERY — asymmetric split, no card boxes ===== -->
      <div class="flow-section">
        <div class="flow-section-inner">
          <span class="flow-node"><i class="bi bi-person-badge"></i></span>
          <div class="row g-5">

            <!-- Left: My Profile Details -->
            

            <!-- Right: Alumni Gallery -->
            <div class="col-12 col-lg-12 reveal" id="gallery-section" style="--reveal-delay: .12s;">
              <div class="section-head">
                <h2 class="section-title">Alumni Gallery</h2>
                <span class="section-tag"><i class="bi bi-camera me-1"></i>Memories</span>
              </div>

            {{#if galleryImages.length}}
            <div id="galleryCarousel" class="carousel slide gallery-carousel-wrap" data-bs-ride="carousel" data-bs-interval="2500">
              <div class="carousel-indicators">
                {{#each galleryImages}}
                <button type="button" data-bs-target="#galleryCarousel"
                  data-bs-slide-to="{{@index}}"
                  class="{{#if @first}}active{{/if}}"
                  aria-current="{{#if @first}}true{{/if}}"
                  aria-label="Slide {{@index}}"></button>
                {{/each}}
              </div>

              <div class="carousel-inner">
                {{#each galleryImages}}
                <div class="carousel-item {{#if @first}}active{{/if}}">
                  {{#if this.hasImage}}
                  <img src="/media/gallery/{{this._id}}"
                       class="d-block w-100"
                       alt="{{this.description}}"
                       data-gallery-popup
                       data-img-src="/media/gallery/{{this._id}}"
                       data-img-desc="{{this.description}}">
                  {{/if}}
                  {{#if this.description}}
                  <div class="carousel-caption-glass"
                       data-gallery-popup
                       data-img-src="/media/gallery/{{this._id}}"
                       data-img-desc="{{this.description}}">
                    <p class="m-0 small fw-bold"><i class="bi bi-info-circle me-1 text-primary"></i>{{this.description}}</p>
                  </div>
                  {{/if}}
                </div>
                {{/each}}
              </div>

              <button class="carousel-nav-btn start-0 ms-3" type="button" data-bs-target="#galleryCarousel" data-bs-slide="prev" aria-label="Previous">
                <i class="bi bi-chevron-left"></i>
              </button>
              <button class="carousel-nav-btn end-0 me-3" type="button" data-bs-target="#galleryCarousel" data-bs-slide="next" aria-label="Next">
                <i class="bi bi-chevron-right"></i>
              </button>
            </div>
            {{else}}
            <div class="empty-state">
              <i class="bi bi-images"></i>
              <p class="m-0 fw-semibold">No gallery images available right now.</p>
            </div>
            {{/if}}

            </div>

          </div>
        </div>
      </div>

      <!-- ===== EVENTS — vertical timeline ===== -->
      <div class="flow-section">
        <div class="flow-section-inner reveal" id="events-section">
          <span class="flow-node"><i class="bi bi-calendar2-event"></i></span>
          <div class="section-head">
            <div>
              <h2 class="section-title">Upcoming &amp; Past Events</h2>
              <p class="section-sub">Stay connected with gatherings, reunions and programmes across the HAMD community.</p>
            </div>
            <span class="section-tag"><i class="bi bi-bell me-1"></i>Stay Connected</span>
          </div>

        {{#if events.length}}
        <div class="events-grid">
          <!-- Upcoming / Active Events -->
          {{#each events}}
          {{#unless this.isEnded}}
          <div class="event-card">
            <!-- Date Box -->
            <div class="event-date-box">
              <div class="event-date-month">{{this.month}}</div>
              <div class="event-date-day">{{this.day}}</div>
            </div>

            <!-- Content Area -->
            <div class="event-content">
              <div class="event-header">
                <h3 class="event-title">{{this.title}}</h3>
                <div>
                  {{#if this.category}}
                  <span class="event-cat-badge {{this.badgeColor}}">{{this.category}}</span>
                  {{/if}}
                </div>
              </div>

              {{#if this.location}}
              <div class="event-location">
                <i class="bi bi-geo-alt-fill text-primary"></i> {{this.location}}
              </div>
              {{/if}}

              {{#if this.description}}
              <p class="event-desc">{{this.description}}</p>
              {{/if}}

              {{#if this.registration}}
                {{#if this.isRegistered}}
                <button type="button" class="btn-registered" id="reg-btn-{{this.id}}">
                  <i class="bi bi-check-circle-fill"></i> Registered
                </button>
                {{else}}
                <button type="button" class="btn-register" id="reg-btn-{{this.id}}"
                        onclick="openRegisterConfirm('{{this.id}}', '{{this.title}}')">
                  <i class="bi bi-check-circle"></i> Register for Event
                </button>
                {{/if}}
              {{/if}}
            </div>
          </div>
          {{/unless}}
          {{/each}}

          <!-- Ended Events Archive -->
          {{#each events}}
          {{#if this.isEnded}}
          {{#if @first}}
          <div class="fw-bold small text-muted text-uppercase mt-4 mb-2 pt-3 border-top" style="letter-spacing: 1px;">
            <i class="bi bi-clock-history me-1"></i> Past / Ended Events
          </div>
          {{/if}}
          <div class="event-card ended-event">
            <div class="event-date-box opacity-75">
              <div class="event-date-month text-muted">{{this.month}}</div>
              <div class="event-date-day text-muted">{{this.day}}</div>
            </div>

            <div class="event-content">
              <div class="event-header">
                <h3 class="event-title text-muted">{{this.title}}</h3>
                <div class="d-flex gap-2 align-items-center">
                  <span class="badge bg-secondary text-white rounded-pill px-3 py-1">Ended</span>
                  {{#if this.category}}
                  <span class="event-cat-badge {{this.badgeColor}}">{{this.category}}</span>
                  {{/if}}
                </div>
              </div>

              {{#if this.location}}
              <div class="event-location">
                <i class="bi bi-geo-alt"></i> {{this.location}}
              </div>
              {{/if}}

              {{#if this.description}}
              <p class="event-desc text-muted">{{this.description}}</p>
              {{/if}}

              {{#if this.registration}}
                {{#if this.isRegistered}}
                <button type="button" class="btn-registered opacity-75" disabled>
                  <i class="bi bi-check-circle-fill"></i> Registered (Concluded)
                </button>
                {{else}}
                <span class="badge bg-body-tertiary text-muted border py-2 px-3 fw-normal">
                  <i class="bi bi-x-circle me-1"></i>Registration Closed
                </span>
                {{/if}}
              {{/if}}
            </div>
          </div>
          {{/if}}
          {{/each}}
        </div>
        {{else}}
        <div class="empty-state">
          <i class="bi bi-calendar-x"></i>
          <p class="m-0 fw-semibold">No scheduled events at this moment.</p>
        </div>
        {{/if}}

        </div>
      </div>

      <!-- ===== MONTHLY CONTRIBUTION — invitation band ===== -->
      <div class="flow-section">
        <div class="flow-section-inner reveal" id="contribution-section"
             data-member-name="{{user.name}}" data-member-admission="{{user.admissionNumber}}">
          <span class="flow-node"><i class="bi bi-wallet2"></i></span>
          <div class="section-head">
            <div>
              <h2 class="section-title">Monthly Contribution</h2>
              <p class="section-sub">Keep your alumni support up to date, one month at a time.</p>
            </div>
            <span class="section-tag gold">₹30 / Month</span>
          </div>

          <div class="contribution-band">
        {{#if contribution.hasUnpaidMonths}}
        <div class="status-alert-card status-alert-warning" role="alert">
          <div class="alert-icon-wrap">
            <i class="bi bi-exclamation-triangle-fill"></i>
          </div>
          <div>
            <div class="fw-bold mb-1" style="font-size: 15px;">Pending Monthly Contributions</div>
            <div class="small opacity-85">
              You have <strong>{{contribution.unpaidCount}}</strong> unpaid month(s): {{contribution.unpaidListLabels}}
            </div>
          </div>
        </div>
        {{else}}
        <div class="status-alert-card status-alert-success" role="alert">
          <div class="alert-icon-wrap">
            <i class="bi bi-check-circle-fill"></i>
          </div>
          <div>
            <div class="fw-bold mb-1" style="font-size: 15px;">All Up to Date!</div>
            <div class="small opacity-85">You have completed all monthly contributions up to the current month. Thank you for your support!</div>
          </div>
        </div>
        {{/if}}

        <!-- Pre-Payment Options (6 Month & 1 Year) -->
        <div class="prepay-box">
          <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
              <h6 class="fw-bold m-0 d-flex align-items-center" style="color: var(--primary);">
                <i class="bi bi-lightning-charge-fill me-2 fs-5"></i>Quick Advance Payment Plans
              </h6>
              <div class="small text-muted mt-1">Pay ahead for upcoming months in advance (₹30 / Month)</div>
            </div>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold">
              <i class="bi bi-shield-check me-1"></i>Clears Dues Sequentially
            </span>
          </div>

          <div class="row g-3" id="prepaymentOptionsRow">
            <!-- 6 Month Pre-Payment -->
            <div class="col-12 col-md-6">
              <div class="prepay-card text-center" id="prepayCard6" data-plan="6">
                <div class="form-check position-absolute top-0 end-0 m-3">
                  <input class="form-check-input prepay-radio" type="radio" name="prepaymentPlan" id="planRadio6" value="6">
                </div>
                <div class="prepay-icon mx-auto">
                  <i class="bi bi-calendar-range"></i>
                </div>
                <h6 class="fw-bold mb-1">6-Month Pre-Payment</h6>
                <div class="small text-muted mb-2">Covers the next 6 months</div>
                <div class="prepay-price">₹180</div>
                <div class="small text-muted">6 × ₹30 / month</div>
              </div>
            </div>

            <!-- 1 Year Pre-Payment -->
            <div class="col-12 col-md-6">
              <div class="prepay-card text-center" id="prepayCard12" data-plan="12">
                <div class="form-check position-absolute top-0 end-0 m-3">
                  <input class="form-check-input prepay-radio" type="radio" name="prepaymentPlan" id="planRadio12" value="12">
                </div>
                <div class="prepay-icon mx-auto" style="background: var(--emerald-light); color: var(--emerald);">
                  <i class="bi bi-calendar-check"></i>
                </div>
                <h6 class="fw-bold mb-1">1-Year Pre-Payment</h6>
                <div class="small text-muted mb-2">Covers the next 12 months</div>
                <div class="prepay-price" style="color: var(--emerald);">₹360</div>
                <div id="year-plan-calculation-text" class="small text-muted">12 × ₹30 / month</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Contribution Months Checklist Grid -->
        <div class="mb-3" id="month-checklist">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <label class="form-label fw-bold text-muted small text-uppercase m-0" style="letter-spacing: 0.6px;">
              Contribution Months Checklist
            </label>
            <span class="small text-muted">Select individual months or use advance plans above</span>
          </div>

          <div class="row g-3" id="contributionMonthsGrid">
            {{#each contribution.months}}
            <div class="col-6 col-sm-4 col-md-3">
              <div class="month-card {{#unless this.isSelectable}}disabled-card{{/unless}}">
                <div>
                  <div class="form-check m-0 d-flex align-items-center gap-2">
                    <input class="form-check-input month-checkbox" type="checkbox"
                      value="{{this.key}}"
                      id="mchk-{{this.key}}"
                      data-month="{{this.month}}"
                      data-year="{{this.year}}"
                      data-label="{{this.label}}"
                      data-amount="{{this.amount}}"
                      {{#unless this.isSelectable}}disabled{{/unless}}>
                    <label class="form-check-label fw-bold text-truncate" for="mchk-{{this.key}}" style="cursor: pointer; font-size: 13.5px;">
                      {{this.label}}
                    </label>
                  </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mt-3 pt-2 border-top" style="border-color: var(--border-subtle) !important;">
                  <span class="fw-bold text-primary small">₹{{this.amount}}</span>
                  <span class="badge {{this.badgeColor}} month-badge">{{this.status}}</span>
                </div>

                {{#if this.rejectionReason}}
                <div class="small text-danger mt-2">
                  <strong>Reason:</strong> {{this.rejectionReason}}
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-3 w-100 mt-2 resubmit-month-btn"
                  data-month-key="{{this.key}}" data-month-label="{{this.label}}">
                  <i class="bi bi-arrow-repeat me-1"></i>Submit Again
                </button>
                {{/if}}

                {{#if this.isApproved}}
                <button type="button" class="btn btn-sm btn-outline-success rounded-3 w-100 mt-2 download-receipt-btn"
                  data-receipt-name="{{../../user.name}}"
                  data-receipt-admission="{{../../user.admissionNumber}}"
                  data-receipt-month="{{this.label}}"
                  data-receipt-amount="{{this.amount}}"
                  data-receipt-approved-by="{{this.approvedBy}}"
                  data-receipt-time="{{this.approvedAt}}"
                  data-receipt-submitted-time="{{this.submittedAt}}"
                  data-receipt-payment-id="{{this.paymentId}}">
                  <i class="bi bi-download me-1"></i>Receipt
                </button>
                {{/if}}
              </div>
            </div>
            {{/each}}
          </div>
        </div>

        <!-- Sticky Checkout Summary & Pay Action Bar -->
        <div class="checkout-action-bar">
          <div>
            <div class="small text-muted fw-semibold">
              Selected Months: <span id="selectedMonthsCount" class="badge bg-primary-subtle text-primary rounded-pill px-2">0</span>
            </div>
            <div class="checkout-total-val mt-1">Total: ₹<span id="selectedTotalAmount">0</span></div>
          </div>

          <button type="button" id="openPayModalBtn" class="btn-pay-action" disabled>
            <i class="bi bi-credit-card-2-front"></i> Pay Contribution Now
          </button>
        </div>
          </div>

        </div>
      </div>

    </div>
  </main>

