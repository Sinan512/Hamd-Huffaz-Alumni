  function handleSaveProfile(e) {
    e.preventDefault();

    var alertEl = document.getElementById('profileSaveAlert');
    var form    = document.getElementById('editProfileForm');
    var btn     = form ? form.querySelector('[type="submit"]') : null;
    if (!btn) return;
    var origTxt = btn.innerHTML;

    function showAlert(type, msg) {
      alertEl.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-3';
      alertEl.textContent = msg;
      alertEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    btn.disabled  = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';

    var data = {};
    var fd   = new FormData(form);
    fd.forEach(function (val, key) { data[key] = val; });

    // Handle Educational Qualification "Other"
    var eduSelect = document.getElementById('ep_eduQual');
    var eduOtherInput = document.getElementById('ep_eduQual_other');
    if (eduSelect) {
      if (eduSelect.value === 'Other') {
        data['eduQual'] = (eduOtherInput ? eduOtherInput.value.trim() : '') || 'Other';
      } else {
        data['eduQual'] = eduSelect.value;
      }
    }

    // Handle Religious Degree "Other"
    var relSelect = document.getElementById('ep_religiousDegree');
    var relOtherInput = document.getElementById('ep_religiousDegree_other');
    if (relSelect) {
      if (relSelect.value === 'Other') {
        data['religiousDegree'] = (relOtherInput ? relOtherInput.value.trim() : '') || 'Other';
      } else {
        data['religiousDegree'] = relSelect.value;
      }
    }

    // Handle Support Needed "Other"
    var suppSelect = document.getElementById('ep_supportNeeded');
    var suppOtherInput = document.getElementById('ep_supportNeeded_other');
    if (suppSelect) {
      if (suppSelect.value === 'Other') {
        data['supportNeeded'] = (suppOtherInput ? suppOtherInput.value.trim() : '') || 'Other';
      } else {
        data['supportNeeded'] = suppSelect.value;
      }
    }

    // Handle Languages Known
    var langCbs = document.querySelectorAll('.lang-cb');
    var selectedLangs = [];
    var otherLangChecked = false;
    langCbs.forEach(function (cb) {
      if (cb.checked) {
        if (cb.value === 'Other') {
          otherLangChecked = true;
        } else {
          selectedLangs.push(cb.value);
        }
      }
    });
    var otherLangInput = document.getElementById('ep_languages_other');
    if (otherLangChecked && otherLangInput && otherLangInput.value.trim()) {
      var customParts = otherLangInput.value.trim().split(',').map(function (s) { return s.trim(); }).filter(Boolean);
      customParts.forEach(function (p) {
        if (!selectedLangs.includes(p)) selectedLangs.push(p);
      });
    }
    data['languages'] = selectedLangs.join(', ');

    // Handle Organisation & Role
    var orgSelect = document.getElementById('ep_orgName');
    var orgOtherInput = document.getElementById('ep_orgName_other');
    var orgRoleInput = document.getElementById('ep_orgRole');
    var orgNameVal = '';
    if (orgSelect) {
      if (orgSelect.value === 'Other') {
        orgNameVal = (orgOtherInput ? orgOtherInput.value.trim() : '') || 'Other';
      } else {
        orgNameVal = orgSelect.value;
      }
    }
    var orgRoleVal = orgRoleInput ? orgRoleInput.value.trim() : '';
    data['orgName'] = orgNameVal;
    data['orgRole'] = orgRoleVal;
    data['orgRoles'] = orgRoleVal ? (orgNameVal ? orgNameVal + ' - ' + orgRoleVal : orgRoleVal) : orgNameVal;

    // Make sure WhatsApp number is sent even if input is readonly
    var wpInput = document.getElementById('ep_whatsapp');
    if (wpInput) {
      data['whatsapp'] = wpInput.value.trim();
    }

    fetch('/users/user/profile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(data)
    })
    .then(readJsonResponse)
    .then(function (result) {
      if (result.ok && result.data && result.data.success) {
        showAlert('success', result.data.message || 'Profile saved successfully.');
      } else {
        showAlert('danger', serverMessage(result, 'Could not save profile. Please try again.'));
      }
    })
    .catch(function () {
      showAlert('danger', 'Could not reach the server. Please check your connection and try again.');
    })
    .finally(function () {
      btn.disabled  = false;
      btn.innerHTML = origTxt;
    });
  }

  /* ============================================================ */
  /* MONTHLY CONTRIBUTION PAYMENT & RECEIPT LOGIC                 */
  /* ============================================================ */
  (function () {
    var checkboxes = document.querySelectorAll('.month-checkbox');
    var countEl = document.getElementById('selectedMonthsCount');
    var totalEl = document.getElementById('selectedTotalAmount');
    var payBtn = document.getElementById('openPayModalBtn');

    var modalSelectedList = document.getElementById('modalSelectedMonthsList');
    var modalTotalEl = document.getElementById('modalTotalAmount');
    var proceedUpiBtn = document.getElementById('proceedUpiBtn');
    var upiCopyPopup = document.getElementById('upiCopyPopup');

    var form = document.getElementById('submitContributionForm');
    var alertBox = document.getElementById('paymentModalAlert');
    var submitBtn = document.getElementById('submitPaymentBtn');

    function getSelectedMonths() {
      var selected = [];
      checkboxes.forEach(function (cb) {
        if (cb.checked && !cb.disabled) {
          selected.push({
            key: cb.value,
            month: cb.getAttribute('data-month'),
            year: cb.getAttribute('data-year'),
            label: cb.getAttribute('data-label'),
            amount: Number(cb.getAttribute('data-amount')) || 30
          });
        }
      });
      return selected;
    }

    function updateSummary() {
      var selected = getSelectedMonths();
      var count = selected.length;
      var total = count * 30;

      if (countEl) countEl.textContent = String(count);
      if (totalEl) totalEl.textContent = String(total);
      if (payBtn) payBtn.disabled = (count === 0);
    }

    /* Canvas Receipt Generator */
    function downloadReceipt(button) {
      var W = 1200;
      var H = 1640;
      var canvas = document.createElement('canvas');
      canvas.width = W;
      canvas.height = H;
      var ctx = canvas.getContext('2d');

      var contributionSection = document.getElementById('contribution-section');
      var memberName = button.getAttribute('data-receipt-name') ||
        (contributionSection && contributionSection.getAttribute('data-member-name')) || '';
      var admissionNumber = button.getAttribute('data-receipt-admission') ||
        (contributionSection && contributionSection.getAttribute('data-member-admission')) || '';
      var month = button.getAttribute('data-receipt-month') || '';
      var amount = '₹' + (button.getAttribute('data-receipt-amount') || '30');
      var approvedBy = button.getAttribute('data-receipt-approved-by') || '';
      var completedAt = button.getAttribute('data-receipt-time') || '';
      var submittedAt = button.getAttribute('data-receipt-submitted-time') || '';
      var paymentRef = button.getAttribute('data-receipt-payment-id') || '';
      var txnId = button.getAttribute('data-receipt-txn-id') || paymentRef || '';

      var TEAL_DARK = '#0b3d3a';
      var TEAL = '#0f766e';
      var TEAL_LIGHT = '#8fd3cb';
      var TEAL_BOX = '#eef6f5';
      var INK = '#0f172a';
      var SLATE = '#64748b';
      var BG = '#f8faf9';
      var LINE = '#dbe7e5';

      function roundedRect(x, y, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y + x, y, r);
        ctx.closePath();
      }

      function iconCircle(cx, cy) {
        ctx.fillStyle = TEAL;
        ctx.beginPath();
        ctx.arc(cx, cy, 26, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(cx, cy, 8, 0, Math.PI * 2);
        ctx.fill();
      }

      function drawField(colX, y, label, value) {
        iconCircle(colX + 26, y + 26);
        ctx.textAlign = 'left';
        ctx.fillStyle = SLATE;
        ctx.font = '500 20px Arial';
        ctx.fillText(label, colX + 70, y + 18);
        ctx.fillStyle = INK;
        ctx.font = '700 27px Arial';
        ctx.fillText(value, colX + 70, y + 52);
        ctx.strokeStyle = LINE;
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 5]);
        ctx.beginPath();
        ctx.moveTo(colX + 70, y + 78);
        ctx.lineTo(colX + 480, y + 78);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      function render(logoImg) {
        ctx.fillStyle = '#e8efee';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = BG;
        roundedRect(20, 20, W - 40, H - 40, 28);
        ctx.fill();

        ctx.save();
        roundedRect(20, 20, W - 40, H - 40, 28);
        ctx.clip();

        // Header band
        ctx.fillStyle = TEAL_DARK;
        ctx.fillRect(20, 20, W - 40, 250);

        ctx.textAlign = 'left';
        ctx.fillStyle = '#ffffff';
        ctx.font = '700 52px Arial';
        ctx.fillText('HAMD Alumni Malik Deenar', 90, 130);
        ctx.fillStyle = TEAL_LIGHT;
        ctx.font = '500 30px Arial';
        ctx.fillText('Monthly Contribution Receipt', 90, 185);

        // Logo panel
        ctx.fillStyle = TEAL_DARK;
        roundedRect(830, 45, 300, 200, 20);
        ctx.fill();
        if (logoImg) {
          var maxW = 280, maxH = 200;
          var ratio = Math.min(maxW / logoImg.width, maxH / logoImg.height);
          var lw = logoImg.width * ratio, lh = logoImg.height * ratio;
          ctx.drawImage(logoImg, 880 + (300 - lw) / 2, 55 + (200 - lh) / 2 - 14, lw, lh);
        } else {
          ctx.fillStyle = TEAL;
          ctx.textAlign = 'center';
          ctx.font = '700 44px Arial';
          ctx.fillText('HAMD', 980, 160);
        }

        // Payment Successful
        var cy = 380;
        ctx.fillStyle = TEAL;
        ctx.beginPath();
        ctx.arc(450, cy, 32, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.moveTo(434, cy);
        ctx.lineTo(446, cy + 12);
        ctx.lineTo(468, cy - 14);
        ctx.stroke();

        ctx.fillStyle = INK;
        ctx.textAlign = 'left';
        ctx.font = '700 44px Arial';
        ctx.fillText('Payment Successful', 505, cy + 15);

        ctx.textAlign = 'center';
        ctx.fillStyle = SLATE;
        ctx.font = '400 24px Arial';
        ctx.fillText('Thank you! Your contribution has been received and recorded successfully.', W / 2, cy + 70);

        // Divider
        ctx.strokeStyle = LINE;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(150, cy + 115);
        ctx.lineTo(W / 2 - 30, cy + 115);
        ctx.moveTo(W / 2 + 30, cy + 115);
        ctx.lineTo(W - 150, cy + 115);
        ctx.stroke();

        // Fields Grid
        var leftX = 100, rightX = 640, startY = 545, step = 105;
        ctx.strokeStyle = LINE;
        ctx.beginPath();
        ctx.moveTo(600, startY - 10);
        ctx.lineTo(600, startY + step * 3 + 70);
        ctx.stroke();

        drawField(leftX, startY, 'Member Name', memberName);
        drawField(leftX, startY + step, 'Admission No.', admissionNumber);
        drawField(leftX, startY + step * 2, 'Contribution Month', month);
        drawField(leftX, startY + step * 3, 'Amount Paid', amount);

        drawField(rightX, startY, 'Approved By', approvedBy);
        drawField(rightX, startY + step, 'Completed At', completedAt);
        drawField(rightX, startY + step * 2, 'Submitted At', submittedAt);
        drawField(rightX, startY + step * 3, 'Payment Reference', paymentRef);

        // Summary Box
        var boxY = 1035;
        ctx.fillStyle = TEAL_BOX;
        roundedRect(110, boxY, W - 220, 170, 18);
        ctx.fill();
        ctx.strokeStyle = LINE;
        ctx.lineWidth = 2;
        roundedRect(110, boxY, W - 220, 170, 18);
        ctx.stroke();

        iconCircle(160, boxY + 45);
        ctx.textAlign = 'left';
        ctx.fillStyle = INK;
        ctx.font = '700 26px Arial';
        ctx.fillText('Transaction Summary', 200, boxY + 55);

        var colY = boxY + 100;
        var cols = [
          { label: 'Payment Method', value: 'Online Payment', cx: 220 },
          { label: 'Transaction ID', value: txnId, cx: 540 },
          { label: 'Status', value: '', cx: 880 }
        ];
        ctx.textAlign = 'center';
        cols.forEach(function (c, i) {
          ctx.fillStyle = SLATE;
          ctx.font = '400 20px Arial';
          ctx.fillText(c.label, c.cx, colY);
          if (i < 2) {
            ctx.fillStyle = INK;
            ctx.font = '700 24px Arial';
            ctx.fillText(c.value, c.cx, colY + 38);
          }
        });

        // Status pill
        ctx.fillStyle = TEAL;
        roundedRect(800, colY + 12, 170, 42, 21);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = '700 22px Arial';
        ctx.fillText('Successful', 885, colY + 40);

        // Footer Band
        var fY = H - 140;
        ctx.fillStyle = TEAL_DARK;
        ctx.fillRect(20, fY, W - 40, 120);
        ctx.textAlign = 'left';
        ctx.fillStyle = TEAL_LIGHT;
        ctx.font = '400 22px Arial';
        ctx.fillText('Your support builds a stronger', 170, fY + 50);
        ctx.fillText('community and a brighter future.', 170, fY + 82);

        ctx.restore();

        var link = document.createElement('a');
        var fileMonth = month || 'contribution';
        link.download = 'HAMD-Contribution-Receipt-' + fileMonth.replace(/[^a-z0-9]+/gi, '-') + '.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      }

      var img = new Image();
      img.onload = function () { render(img); };
      img.onerror = function () { render(null); };
      img.src = '/logo/hamd-full-white.png';
    }

    // Pre-Payment Plans Logic
    var prepayCards = document.querySelectorAll('.prepay-card');
    var prepayRadios = document.querySelectorAll('.prepay-radio');

    function getSelectableCheckboxes() {
      var list = [];
      document.querySelectorAll('.month-checkbox').forEach(function (cb) {
        if (!cb.disabled) list.push(cb);
      });
      return list;
    }

    function clearPrepaymentRadioSelection() {
      prepayRadios.forEach(function (r) { r.checked = false; });
      prepayCards.forEach(function (card) {
        card.classList.remove('border-primary', 'active-plan');
      });
    }

    function applyPrepaymentPlan(plan) {
      var selectables = getSelectableCheckboxes();
      if (selectables.length === 0) return;

      checkboxes.forEach(function (cb) {
        if (!cb.disabled) cb.checked = false;
      });

      var count = (plan === '6') ? 6 : (plan === '12' ? 12 : 0);
      var maxCount = Math.min(count, selectables.length);
      for (var i = 0; i < maxCount; i++) {
        selectables[i].checked = true;
      }

      updateSummary();
    }

    prepayCards.forEach(function (card) {
      card.addEventListener('click', function () {
        var plan = card.getAttribute('data-plan');
        var radio = card.querySelector('.prepay-radio');
        if (radio) radio.checked = true;

        prepayCards.forEach(function (c) {
          c.classList.remove('border-primary', 'active-plan');
        });
        card.classList.add('border-primary', 'active-plan');

        applyPrepaymentPlan(plan);
      });
    });

    checkboxes.forEach(function (cb) {
      cb.addEventListener('change', function () {
        clearPrepaymentRadioSelection();
        updateSummary();
      });
    });

    document.querySelectorAll('.resubmit-month-btn').forEach(function (button) {
      button.addEventListener('click', function () {
        var key = button.getAttribute('data-month-key');
        var checkbox = document.getElementById('mchk-' + key);
        if (!checkbox || !payBtn) return;
        checkbox.disabled = false;
        checkbox.checked = true;
        var card = checkbox.closest('.month-card');
        if (card) card.classList.remove('disabled-card');
        updateSummary();
        payBtn.click();
      });
    });

    document.querySelectorAll('.download-receipt-btn').forEach(function (button) {
      button.addEventListener('click', function () {
        downloadReceipt(button);
      });
    });

    if (payBtn) {
      payBtn.addEventListener('click', function () {
        var selected = getSelectedMonths();
        if (selected.length === 0) return;

        var labels = selected.map(function (s) { return s.label; }).join(', ');
        var total = selected.length * 30;

        if (modalSelectedList) modalSelectedList.textContent = labels;
        if (modalTotalEl) modalTotalEl.textContent = String(total);

        var modalEl = document.getElementById('payContributionModal');
        if (modalEl && window.bootstrap) {
          var modalInst = window.bootstrap.Modal.getInstance(modalEl) || new window.bootstrap.Modal(modalEl);
          modalInst.show();
        }
      });
    }

    // UPI Deep-link & Clipboard Logic
    function copyGpayNumber() {
      var gpayInput = document.getElementById('gpayNumberCopyText');
      var gpayNumber = gpayInput ? gpayInput.value.trim() : '';
      if (!gpayNumber || gpayNumber === 'Not set') return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(gpayNumber).catch(function () {
          try {
            var tmp = document.createElement('input');
            tmp.value = gpayNumber;
            document.body.appendChild(tmp);
            tmp.select();
            tmp.setSelectionRange(0, 99999);
            document.execCommand('copy');
            document.body.removeChild(tmp);
          } catch (e) {}
        });
      } else {
        try {
          var tmp = document.createElement('input');
          tmp.value = gpayNumber;
          document.body.appendChild(tmp);
          tmp.select();
          tmp.setSelectionRange(0, 99999);
          document.execCommand('copy');
          document.body.removeChild(tmp);
        } catch (e) {}
      }
    }

    if (proceedUpiBtn && upiCopyPopup) {
      proceedUpiBtn.addEventListener('click', function () {
        copyGpayNumber();
        upiCopyPopup.style.display = 'flex';
      });

      upiCopyPopup.querySelectorAll('.upi-app-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          upiCopyPopup.style.display = 'none';
          var scheme = btn.getAttribute('data-scheme');
          var fallback = btn.getAttribute('data-fallback') || scheme;
          if (!scheme) return;

          var didLeave = false;
          window.addEventListener('blur', function onBlur() {
            didLeave = true;
            window.removeEventListener('blur', onBlur);
          });

          window.location.href = scheme;

          setTimeout(function () {
            if (!didLeave && fallback !== scheme) {
              window.location.href = fallback;
            }
          }, 1500);
        });
      });

      var upiCopyPopupCancel = document.getElementById('upiCopyPopupCancel');
      if (upiCopyPopupCancel) {
        upiCopyPopupCancel.addEventListener('click', function () {
          upiCopyPopup.style.display = 'none';
        });
      }

      upiCopyPopup.addEventListener('click', function (e) {
        if (e.target === upiCopyPopup) {
          upiCopyPopup.style.display = 'none';
        }
      });
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!alertBox) return;

        alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-3';
        alertBox.textContent = '';

        var selected = getSelectedMonths();
        if (selected.length === 0) {
          alertBox.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
          alertBox.textContent = 'Please select at least one month to pay.';
          return;
        }

        var fileInput = document.getElementById('paymentScreenshot');
        var file = fileInput && fileInput.files && fileInput.files[0];
        if (!file) {
          alertBox.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
          alertBox.textContent = 'Please select a payment screenshot image.';
          return;
        }

        submitBtn.disabled = true;
        var originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Submitting...';

        var formData = new FormData();
        var monthKeys = selected.map(function (s) { return s.key; });
        formData.append('months', JSON.stringify(monthKeys));
        formData.append('paymentScreenshot', file);

        fetch('/users/submit-contribution-payment', {
          method: 'POST',
          body: formData
        })
          .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }); })
          .then(function (result) {
            if (!result.ok || !result.data.success) {
              alertBox.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
              alertBox.textContent = (result.data && result.data.message) || 'Could not submit payment.';
              return;
            }

            alertBox.className = 'alert alert-success rounded-3 py-2 px-3 small mb-3';
            alertBox.textContent = result.data.message || 'Payment submitted successfully!';

            selected.forEach(function (s) {
              var cb = document.getElementById('mchk-' + s.key);
              if (cb) {
                cb.checked = false;
                cb.disabled = true;
                var card = cb.closest('.month-card');
                if (card) {
                  card.classList.add('disabled-card');
                  var badge = card.querySelector('.month-badge');
                  if (badge) {
                    badge.className = 'badge bg-warning text-dark month-badge';
                    badge.textContent = 'PENDING';
                  }
                }
              }
            });

            updateSummary();

            setTimeout(function () {
              var modalEl = document.getElementById('payContributionModal');
              if (modalEl && window.bootstrap) {
                var inst = window.bootstrap.Modal.getInstance(modalEl);
                if (inst) inst.hide();
              }
              form.reset();
            }, 1200);
          })
          .catch(function () {
            alertBox.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
            alertBox.textContent = 'Network error while submitting payment.';
          })
          .finally(function () {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
          });
      });
    }

    function checkAndShowUnpaidModal() {
      var unpaidModalEl = document.getElementById('unpaidMonthsPopupModal');
      if (unpaidModalEl && window.bootstrap) {
        var unpaidInst = window.bootstrap.Modal.getOrCreateInstance(unpaidModalEl);
        unpaidInst.show();

        var payNowBtn = document.getElementById('unpaidPayNowBtn');
        if (payNowBtn) {
          payNowBtn.addEventListener('click', function () {
            unpaidInst.hide();
            var targetSec = document.getElementById('year-plan-calculation-text');
            if (targetSec) {
              targetSec.scrollIntoView({ behavior: 'smooth' });
            }
          });
        }
      }
    }

    window.handleSavePersonalDataQuick = function (e) {
      e.preventDefault();

      var alertEl = document.getElementById('personalDataAlert');
      var btn     = document.getElementById('savePersonalDataBtn');
      if (!btn) return;
      var origTxt = btn.innerHTML;

      var place    = (document.getElementById('quick_place').value || '').trim();
      var address  = (document.getElementById('quick_address').value || '').trim();
      var email    = (document.getElementById('quick_email').value || '').trim();
      var phone    = (document.getElementById('quick_phone').value || '').trim();
      var whatsapp = (document.getElementById('quick_whatsapp').value || '').trim();

      if (!place || !address || !email || !phone || !whatsapp) {
        alertEl.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
        alertEl.textContent = 'Please fill all required personal fields (Place, Address, Email, Phone, WhatsApp).';
        return;
      }

      btn.disabled  = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';

      // Education fields
      var leaveYear = (document.getElementById('quick_leaveYear') ? document.getElementById('quick_leaveYear').value : '').trim();
      
      var qEdu = document.getElementById('quick_eduQual');
      var qEduOther = document.getElementById('quick_eduQual_other');
      var eduQualVal = '';
      if (qEdu) {
        eduQualVal = qEdu.value === 'Other' ? ((qEduOther ? qEduOther.value.trim() : '') || 'Other') : qEdu.value;
      }

      var qRel = document.getElementById('quick_religiousDegree');
      var qRelOther = document.getElementById('quick_religiousDegree_other');
      var relDegVal = '';
      if (qRel) {
        relDegVal = qRel.value === 'Other' ? ((qRelOther ? qRelOther.value.trim() : '') || 'Other') : qRel.value;
      }

      var higherEduChecked = document.querySelector('input[name="quick_higherEdu"]:checked');
      var higherEduVal = higherEduChecked ? higherEduChecked.value : '';

      var qSupp = document.getElementById('quick_supportNeeded');
      var qSuppOther = document.getElementById('quick_supportNeeded_other');
      var suppVal = '';
      if (qSupp) {
        suppVal = qSupp.value === 'Other' ? ((qSuppOther ? qSuppOther.value.trim() : '') || 'Other') : qSupp.value;
      }

      // Job / Study fields
      var currentStatus = document.getElementById('quick_status') ? document.getElementById('quick_status').value : '';
      var workInstitution = document.getElementById('quick_workInstitution') ? document.getElementById('quick_workInstitution').value.trim() : '';
      var workLocation = document.getElementById('quick_workLocation') ? document.getElementById('quick_workLocation').value.trim() : '';
      var jobRole = document.getElementById('quick_jobRole') ? document.getElementById('quick_jobRole').value.trim() : '';
      var college = document.getElementById('quick_college') ? document.getElementById('quick_college').value.trim() : '';
      var collegePlace = document.getElementById('quick_collegePlace') ? document.getElementById('quick_collegePlace').value.trim() : '';
      var course = document.getElementById('quick_course') ? document.getElementById('quick_course').value.trim() : '';

      var payload = {
        place: place,
        address: address,
        email: email,
        phone: phone,
        whatsapp: whatsapp,
        leaveYear: leaveYear,
        eduQual: eduQualVal,
        religiousDegree: relDegVal,
        higherEdu: higherEduVal,
        supportNeeded: suppVal,
        currentStatus: currentStatus,
        workInstitution: workInstitution,
        workLocation: workLocation,
        jobRole: jobRole,
        college: college,
        collegePlace: collegePlace,
        course: course
      };

      fetch('/users/user/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(payload)
      })
      .then(readJsonResponse)
      .then(function (result) {
        if (result.ok && result.data && result.data.success) {
          // Sync Personal Details
          if (document.getElementById('ep_place')) document.getElementById('ep_place').value = place;
          if (document.getElementById('ep_address')) document.getElementById('ep_address').value = address;
          if (document.getElementById('ep_email')) document.getElementById('ep_email').value = email;
          if (document.getElementById('ep_phone')) document.getElementById('ep_phone').value = phone;
          if (document.getElementById('ep_whatsapp')) {
            var epWp = document.getElementById('ep_whatsapp');
            epWp.value = whatsapp;
            var epSame = document.getElementById('ep_sameWhatsapp');
            if (epSame) {
              epSame.checked = (phone === whatsapp);
              epWp.readOnly = (phone === whatsapp);
            }
          }

          // Sync Education Details
          if (document.getElementById('ep_leaveYear')) document.getElementById('ep_leaveYear').value = leaveYear;
          if (document.getElementById('ep_eduQual')) {
            var epEdu = document.getElementById('ep_eduQual');
            var epEduOther = document.getElementById('ep_eduQual_other');
            var standardEdus = ['SSLC', 'Plus Two', 'Degree', 'PG'];
            if (standardEdus.includes(eduQualVal)) {
              epEdu.value = eduQualVal;
              if (epEduOther) epEduOther.value = '';
            } else if (eduQualVal) {
              epEdu.value = 'Other';
              if (epEduOther) epEduOther.value = eduQualVal === 'Other' ? '' : eduQualVal;
            } else {
              epEdu.value = '';
            }
            toggleEduQualOther();
          }

          if (document.getElementById('ep_religiousDegree')) {
            var epRel = document.getElementById('ep_religiousDegree');
            var epRelOther = document.getElementById('ep_religiousDegree_other');
            var standardRels = ['Saquafi', 'Ahsani', 'Baqavi', 'Saa\'di', 'Adany', 'Hadi', 'Fazili', 'Shamil Ifani', 'Noorani', 'Mueeni', 'Naeemi', 'Bukhari'];
            if (standardRels.includes(relDegVal)) {
              epRel.value = relDegVal;
              if (epRelOther) epRelOther.value = '';
            } else if (relDegVal) {
              epRel.value = 'Other';
              if (epRelOther) epRelOther.value = relDegVal === 'Other' ? '' : relDegVal;
            } else {
              epRel.value = '';
            }
            toggleReligiousDegreeOther();
          }

          if (higherEduVal) {
            var epHe = document.querySelector('input[name="higherEdu"][value="' + higherEduVal + '"]');
            if (epHe) epHe.checked = true;
          }

          if (document.getElementById('ep_supportNeeded')) {
            var epSupp = document.getElementById('ep_supportNeeded');
            var epSuppOther = document.getElementById('ep_supportNeeded_other');
            var standardSupps = ['Degree completion', 'Higher education', 'Research', 'Competitive Exams', 'Study Abroad opportunities', 'English or Arabic language', 'Computer skills', 'Online earning opportunities'];
            if (standardSupps.includes(suppVal)) {
              epSupp.value = suppVal;
              if (epSuppOther) epSuppOther.value = '';
            } else if (suppVal) {
              epSupp.value = 'Other';
              if (epSuppOther) epSuppOther.value = suppVal === 'Other' ? '' : suppVal;
            } else {
              epSupp.value = '';
            }
            toggleSupportNeededOther();
          }

          // Sync Job / Study Details
          if (document.getElementById('ep_status')) {
            document.getElementById('ep_status').value = currentStatus;
            toggleJobStudy();
          }
          if (document.getElementById('ep_workInstitution')) document.getElementById('ep_workInstitution').value = workInstitution;
          if (document.getElementById('ep_workLocation')) document.getElementById('ep_workLocation').value = workLocation;
          if (document.getElementById('ep_jobRole')) document.getElementById('ep_jobRole').value = jobRole;
          if (document.getElementById('ep_college')) document.getElementById('ep_college').value = college;
          if (document.getElementById('ep_collegePlace')) document.getElementById('ep_collegePlace').value = collegePlace;
          if (document.getElementById('ep_course')) document.getElementById('ep_course').value = course;

          var personalModalEl = document.getElementById('personalDataPromptModal');
          if (personalModalEl && window.bootstrap) {
            var personalInst = window.bootstrap.Modal.getInstance(personalModalEl);
            if (personalInst) personalInst.hide();
          }

          setTimeout(function () {
            checkAndShowUnpaidModal();
          }, 400);
        } else {
          alertEl.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
          alertEl.textContent = serverMessage(result, 'Could not save profile details. Please try again.');
        }
      })
      .catch(function () {
        alertEl.className = 'alert alert-danger rounded-3 py-2 px-3 small mb-3';
        alertEl.textContent = 'Could not reach the server. Please check your connection and try again.';
      })
      .finally(function () {
        btn.disabled  = false;
        btn.innerHTML = origTxt;
      });
    };

    document.addEventListener('DOMContentLoaded', function () {
      var personalModalEl = document.getElementById('personalDataPromptModal');
      if (personalModalEl && window.bootstrap) {
        var personalInst = new window.bootstrap.Modal(personalModalEl, {
          backdrop: 'static',
          keyboard: false
        });
        personalInst.show();
      } else {
        checkAndShowUnpaidModal();
      }
    });
  })();

  function copyTextFromInput(inputId, labelName) {
    var input = document.getElementById(inputId);
    if (!input || !input.value || input.value === 'Not set') return;
    navigator.clipboard.writeText(input.value.trim()).then(function () {
      alert(labelName + ' copied to clipboard!');
    }).catch(function () {
      input.select();
      document.execCommand('copy');
      alert(labelName + ' copied to clipboard!');
    });
  }
  </script>

  <!-- Scroll-triggered reveal for the flowing thread layout -->
  <script>
  (function () {
    var targets = document.querySelectorAll('.reveal');
    if (!targets.length) return;

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || !('IntersectionObserver' in window)) {
      targets.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    targets.forEach(function (el) { observer.observe(el); });
  })();
  </script>


