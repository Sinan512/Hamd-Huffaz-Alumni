            <option value="Research" {{#if user.supportNeeded_research}}selected{{/if}}>Research</option>
            <option value="Competitive Exams" {{#if user.supportNeeded_exams}}selected{{/if}}>Competitive Exams</option>
            <option value="Study Abroad opportunities" {{#if user.supportNeeded_abroad}}selected{{/if}}>Study Abroad opportunities</option>
            <option value="English or Arabic language" {{#if user.supportNeeded_language}}selected{{/if}}>English or Arabic language</option>
            <option value="Computer skills" {{#if user.supportNeeded_computer}}selected{{/if}}>Computer skills</option>
            <option value="Online earning opportunities" {{#if user.supportNeeded_online}}selected{{/if}}>Online earning opportunities</option>
            <option value="Other" {{#if user.supportNeeded_other}}selected{{/if}}>Other</option>
          </select>
