  <!-- ==================== CONTRIBUTIONS ADMIN SCRIPT ==================== -->
  <script>
    (function () {
      var submittedData = {{{contributionsJson}}}.submitted || [];
      var unpaidData    = {{{contributionsJson}}}.unpaid || [];

      var searchInput   = document.getElementById('contribSearchInput');
      var statusFilter  = document.getElementById('contribStatusFilter');
      var tbody         = document.getElementById('contribTableBody');
      var exportBtn     = document.getElementById('contribExportExcelBtn');

      var currentFiltered = [];

      function escapeHtml(str) {
        return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function renderTable() {
        if (!tbody) return;
        var q = (searchInput ? searchInput.value : '').split(',').map(function(term){return term.trim().toLowerCase();})
        .filter(function(term){return term.length>0;});
        var st = statusFilter ? statusFilter.value : 'ALL';

        var list = [];
        if (st === 'UN PAID') {
          list = unpaidData;
        } else {
          list = submittedData.filter(function (item) {
            if (st !== 'ALL' && item.status !== st) return false;
            return true;
          });
        }

        if (q) {

          list = list.filter(function (item) {
            var name = (item.memberName || '').toLowerCase();
            var batch = (item.batch || '').toLowerCase();
            var adm = (item.admissionNumber || '').toLowerCase();
            var month = (item.monthLabel || '').toLowerCase();

            return q.every(function(term){
            return name.includes(term) || batch.includes(term) || adm.includes(term) || month.includes(term);

            });
          });
        }

        currentFiltered = list;

        if (list.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No contribution records found.</td></tr>';
          return;
        }

        if (st === 'UN PAID') {
          tbody.innerHTML = list.map(function (item) {
            return '<tr>' +
              '<td><div class="fw-bold text-dark">' + escapeHtml(item.memberName) + '</div></td>' +
              '<td><span class="badge bg-secondary-subtle text-secondary">Batch ' + escapeHtml(item.batch) + '</span> <small class="text-muted ms-1">' + escapeHtml(item.admissionNumber) + '</small></td>' +
              '<td><span class="fw-bold text-primary">' + escapeHtml(item.monthLabel) + '</span></td>' +
              '<td><span class="fw-bold">₹' + item.amount + '</span></td>' +
              '<td><span class="text-muted small">N/A</span></td>' +
              '<td><span class="badge bg-danger">UN PAID</span></td>' +
              '<td><span class="text-muted small">Not Paid Yet</span></td>' +
              '<td class="text-end"><span class="badge bg-light text-secondary border">Unpaid Month</span></td>' +
            '</tr>';
          }).join('');
        } else {
          tbody.innerHTML = list.map(function (item) {
            var statusBadge = '<span class="badge ' + item.badgeColor + '">' + escapeHtml(item.status) + '</span>';

            var monthBadges = '';
            if (item.months && item.months.length > 1) {
              monthBadges = '<div class="align-items-center" style="display:grid; grid-template-columns: repeat(3, auto); gap: 4px;">' +
                item.months.map(function (m) {
                  return '<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 11px;">' + escapeHtml(m.label) + '</span>';
                }).join('') +
              '</div>';
            } else {
              monthBadges = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 11px;">' + escapeHtml(item.monthLabel) + '</span>';
            }

            var amountHtml = '';
            if (item.monthCount && item.monthCount > 1) {
              amountHtml = '<div><div class="fw-bold text-dark fs-6">₹' + item.amount + '</div><span class="badge bg-light text-muted border small" style="font-size: 11px;">' + item.monthCount + ' mos (₹' + item.unitAmount + '/mo)</span></div>';
            } else {
              amountHtml = '<span class="fw-bold">₹' + item.amount + '</span>';
            }

            var imgHtml = item.hasScreenshot
              ? '<button type="button" class="btn btn-xs btn-outline-primary rounded-2 view-screenshot-btn" data-img="/admin/contributions/image/' + item.memberId + '/' + item.paymentId + '" data-name="' + escapeHtml(item.memberName) + '"><i class="bi bi-image me-1"></i>View Image</button>'
              : '<span class="text-muted small">No screenshot</span>';

            var detailsHtml = '<div class="small text-muted">Submitted: ' + escapeHtml(item.submittedAtFormatted) + '</div>';
            if (item.status === 'Approved' && item.approvedBy) {
              detailsHtml += '<div class="small text-success">Approved by ' + escapeHtml(item.approvedBy) + ' (' + escapeHtml(item.approvedAtFormatted) + ')</div>';
            } else if (item.status === 'Rejected') {
              detailsHtml += '<div class="small text-danger">Reason: ' + escapeHtml(item.rejectionReason) + '</div>';
            }

            var paymentIdsJson = escapeHtml(JSON.stringify(item.paymentIds || [item.paymentId]));
            var approveBtnText = (item.monthCount && item.monthCount > 1) ? '<i class="bi bi-check-lg me-1"></i>Approve (' + item.monthCount + ' Mos)' : '<i class="bi bi-check-lg me-1"></i>Approve';
            var rejectBtnText = (item.monthCount && item.monthCount > 1) ? '<i class="bi bi-x-lg me-1"></i>Reject (' + item.monthCount + ' Mos)' : '<i class="bi bi-x-lg me-1"></i>Reject';

            var actionsHtml = '';
            if (item.status === 'Pending') {
              actionsHtml = '<div class="btn-group btn-group-sm">' +
                '<button type="button" class="btn btn-sm btn-success rounded-start-3 approve-btn" data-member="' + item.memberId + '" data-payment="' + item.paymentId + '" data-payment-ids="' + paymentIdsJson + '">' + approveBtnText + '</button>' +
                '<button type="button" class="btn btn-sm btn-danger rounded-end-3 reject-btn" data-member="' + item.memberId + '" data-payment="' + item.paymentId + '" data-payment-ids="' + paymentIdsJson + '">' + rejectBtnText + '</button>' +
              '</div>';
            } else {
              actionsHtml = '<span class="small text-muted">Processed</span>';
            }

            return '<tr>' +
              '<td><div class="fw-bold text-dark">' + escapeHtml(item.memberName) + '</div></td>' +
              '<td><span class="badge bg-secondary-subtle text-secondary">Batch ' + escapeHtml(item.batch) + '</span> <small class="text-muted ms-1">' + escapeHtml(item.admissionNumber) + '</small></td>' +
              '<td>' + monthBadges + '</td>' +
              '<td>' + amountHtml + '</td>' +
              '<td>' + imgHtml + '</td>' +
              '<td>' + statusBadge + '</td>' +
              '<td>' + detailsHtml + '</td>' +
              '<td class="text-end">' + actionsHtml + '</td>' +
            '</tr>';
          }).join('');
        }
      }

      function refreshData() {
        return fetch('/admin/contributions', { headers: { 'Accept': 'application/json' } })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data && data.success) {
              submittedData = data.submitted || [];
              unpaidData    = data.unpaid || [];
              if (data.counts) {
                if (document.getElementById('cntAll')) document.getElementById('cntAll').textContent = data.counts.total;
                if (document.getElementById('cntPending')) document.getElementById('cntPending').textContent = data.counts.pending;
                if (document.getElementById('cntApproved')) document.getElementById('cntApproved').textContent = data.counts.approved;
                if (document.getElementById('cntRejected')) document.getElementById('cntRejected').textContent = data.counts.rejected;
                if (document.getElementById('cntUnpaid')) document.getElementById('cntUnpaid').textContent = data.counts.unpaid;
                if (document.getElementById('contribTotalBadge')) document.getElementById('contribTotalBadge').textContent = data.counts.total;
              }
              renderTable();
            }
          })
          .catch(function () {});
      }

      if (searchInput) searchInput.addEventListener('input', renderTable);
      if (statusFilter) statusFilter.addEventListener('change', renderTable);

      if (tbody) {
        tbody.addEventListener('click', function (e) {
          var viewBtn = e.target.closest('.view-screenshot-btn');
          if (viewBtn) {
            var imgSrc = viewBtn.getAttribute('data-img');
            var memberName = viewBtn.getAttribute('data-name');
            var imgEl = document.getElementById('contribModalImage');
            var titleEl = document.getElementById('viewScreenshotModalTitle');
            if (imgEl) imgEl.src = imgSrc;
            if (titleEl) titleEl.textContent = 'Payment Receipt - ' + memberName;
            var modalEl = document.getElementById('viewContribScreenshotModal');
            if (modalEl && window.bootstrap) {
              var inst = window.bootstrap.Modal.getInstance(modalEl) || new window.bootstrap.Modal(modalEl);
              inst.show();
            }
            return;
          }

          var appBtn = e.target.closest('.approve-btn');
          if (appBtn) {
            var memberId = appBtn.getAttribute('data-member');
            var paymentId = appBtn.getAttribute('data-payment');
            var paymentIdsRaw = appBtn.getAttribute('data-payment-ids');
            var paymentIds = [];
            try { paymentIds = JSON.parse(paymentIdsRaw || '[]'); } catch (e) { paymentIds = [paymentId]; }
            if (!paymentIds.length) paymentIds = [paymentId];

            var confirmMsg = paymentIds.length > 1
              ? 'Approve all ' + paymentIds.length + ' monthly contributions submitted with this screenshot?'
              : 'Approve this payment submission?';

            if (!confirm(confirmMsg)) return;
            appBtn.disabled = true;

            fetch('/admin/contributions/' + memberId + '/' + paymentId + '/approve', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ paymentIds: paymentIds })
            })
              .then(function (res) { return res.json(); })
              .then(function (resData) {
                if (resData && resData.success) {
                  refreshData();
                } else {
                  alert((resData && resData.message) || 'Approval failed.');
                  appBtn.disabled = false;
                }
              })
              .catch(function () { alert('Network error.'); appBtn.disabled = false; });
            return;
          }

          var rejBtn = e.target.closest('.reject-btn');
          if (rejBtn) {
            var memberId = rejBtn.getAttribute('data-member');
            var paymentId = rejBtn.getAttribute('data-payment');
            var paymentIdsRaw = rejBtn.getAttribute('data-payment-ids');

            document.getElementById('rejectMemberId').value = memberId;
            document.getElementById('rejectPaymentId').value = paymentId;
            document.getElementById('rejectPaymentIds').value = paymentIdsRaw || JSON.stringify([paymentId]);

            var rForm = document.getElementById('rejectContributionForm');
            if (rForm) rForm.reset();
            document.getElementById('customReasonWrapper').classList.add('d-none');

            var rejModalEl = document.getElementById('rejectContributionModal');
            if (rejModalEl && window.bootstrap) {
              var inst = window.bootstrap.Modal.getInstance(rejModalEl) || new window.bootstrap.Modal(rejModalEl);
              inst.show();
            }
            return;
          }
        });
      }

      var rRadios = document.querySelectorAll('input[name="rejectReasonOption"]');
      rRadios.forEach(function (radio) {
        radio.addEventListener('change', function () {
          var customWrap = document.getElementById('customReasonWrapper');
          if (customWrap) {
            if (this.value === 'other') {
              customWrap.classList.remove('d-none');
            } else {
              customWrap.classList.add('d-none');
            }
          }
        });
      });

      var rForm = document.getElementById('rejectContributionForm');
      if (rForm) {
        rForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var memberId = document.getElementById('rejectMemberId').value;
          var paymentId = document.getElementById('rejectPaymentId').value;
          var paymentIdsRaw = document.getElementById('rejectPaymentIds').value;
          var paymentIds = [];
          try { paymentIds = JSON.parse(paymentIdsRaw || '[]'); } catch (e) { paymentIds = [paymentId]; }
          if (!paymentIds.length) paymentIds = [paymentId];

          var selectedRadio = document.querySelector('input[name="rejectReasonOption"]:checked');
          var reasonOption = selectedRadio ? selectedRadio.value : 'screenshot not visible perfectly';
          var customReason = (document.getElementById('customRejectReason').value || '').trim();

          if (reasonOption === 'other' && !customReason) {
            alert('Please enter a custom rejection reason.');
            return;
          }

          var confirmBtn = document.getElementById('confirmRejectBtn');
          confirmBtn.disabled = true;

          fetch('/admin/contributions/' + memberId + '/' + paymentId + '/reject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reasonOption: reasonOption, customReason: customReason, paymentIds: paymentIds })
          })
            .then(function (res) { return res.json(); })
            .then(function (resData) {
              if (resData && resData.success) {
                var rejModalEl = document.getElementById('rejectContributionModal');
                if (rejModalEl && window.bootstrap) {
                  var inst = window.bootstrap.Modal.getInstance(rejModalEl);
                  if (inst) inst.hide();
                }
                refreshData();
              } else {
                alert((resData && resData.message) || 'Rejection failed.');
              }
            })
            .catch(function () { alert('Network error.'); })
            .finally(function () { confirmBtn.disabled = false; });
        });
      }

      if (exportBtn) {
        exportBtn.addEventListener('click', function () {
          if (!window.XLSX) {
            alert('Excel library not loaded.');
            return;
          }
          if (currentFiltered.length === 0) {
            alert('No data to export.');
            return;
          }

          var st = statusFilter ? statusFilter.value : 'ALL';
          var excelRows = [];

          if (st === 'UN PAID') {
            excelRows = currentFiltered.map(function (i) {
              return {
                'Member Name': i.memberName,
                'Admission No': i.admissionNumber,
                'Batch': i.batch,
                'Month & Year': i.monthLabel,
                'Amount': i.amount,
                'Status': i.status
              };
            });
          } else {
            excelRows = currentFiltered.map(function (i) {
              return {
                'Member Name': i.memberName,
                'Admission No': i.admissionNumber,
                'Batch': i.batch,
                'Month & Year': i.monthLabel,
                'Months Count': i.monthCount || 1,
                'Total Amount': i.amount,
                'Status': i.status,
                'Submitted At': i.submittedAtFormatted,
                'Approved By': i.approvedBy,
                'Approved At': i.approvedAtFormatted,
                'Rejection Reason': i.rejectionReason
              };
            });
          }

          var worksheet = XLSX.utils.json_to_sheet(excelRows);
          var workbook = XLSX.utils.book_new();
          XLSX.utils.book_append_sheet(workbook, worksheet, 'Contributions');
          XLSX.writeFile(workbook, 'Alumni_Contributions_' + st + '_' + Date.now() + '.xlsx');
        });
      }

      renderTable();
    })();
  </script>
  <!-- ===== SIDEBAR SECTION VIEW SWITCHER ===== -->
  <script>
    (function () {
      var VIEWS = [
        'dashboard-overview',
        'batches-section',
        'batch-leaders-section',
        'members-section',
        'events-section',
        'registrations-section',
        'articles-section',
        'payment-section',
        'gallery-section',
        'contributions-section'
      ];

      var menu = document.getElementById('sidebarMenu');
      if (!menu) return;

      var links = Array.prototype.slice.call(menu.querySelectorAll('a[href^="#"]'));

      function elements() {
        return VIEWS.map(function (id) { return document.getElementById(id); })
                    .filter(function (el) { return !!el; });
      }

      function normalize(hash) {
        var id = (hash || '').replace(/^#/, '');
        if (!id || id === 'top' || VIEWS.indexOf(id) === -1) return 'top';
        return id;
      }

      var tempHidden = [];

      function applyView(view) {
        var showAll = (view === 'top');

        // undo any wrapper hiding from the previous view
        tempHidden.forEach(function (el) { el.classList.remove('admin-view-hidden'); });
        tempHidden = [];

        elements().forEach(function (el) {
          el.classList.toggle('admin-view-hidden', !showAll && el.id !== view);
        });

        // Some sections are nested inside another section's wrapper
        // (e.g. Events lives inside the Members row). Reveal the target's
        // ancestors and hide their other children instead.
        if (!showAll) {
          var target = document.getElementById(view);
          var stop = document.getElementById('top') || document.body;
          var node = target;
          while (node && node.parentElement && node.parentElement !== stop && node !== stop) {
            var parent = node.parentElement;
            parent.classList.remove('admin-view-hidden');
            Array.prototype.slice.call(parent.children).forEach(function (child) {
              if (child !== node && !child.classList.contains('admin-view-hidden')) {
                child.classList.add('admin-view-hidden');
                tempHidden.push(child);
              }
            });
            node = parent;
          }
          if (target) target.classList.remove('admin-view-hidden');
        }


        links.forEach(function (a) {
          a.classList.toggle('active', normalize(a.getAttribute('href')) === view);
        });

        // Let Chart.js re-measure canvases that just became visible
        if (window.Chart && Chart.instances) {
          try {
            Object.keys(Chart.instances).forEach(function (k) { Chart.instances[k].resize(); });
          } catch (e) {}
        } else if (window.Chart && typeof Chart.helpers === 'object') {
          try { window.dispatchEvent(new Event('resize')); } catch (e) {}
        } else {
          try { window.dispatchEvent(new Event('resize')); } catch (e) {}
        }
      }

      function syncFromHash() {
        applyView(normalize(window.location.hash));
      }

      links.forEach(function (a) {
        a.addEventListener('click', function (e) {
          e.preventDefault();
          var view = normalize(a.getAttribute('href'));
          var newHash = '#' + view;
          if (window.location.hash !== newHash) {
            window.location.hash = newHash;
          } else {
            applyView(view);
          }
          window.scrollTo({ top: 0, behavior: 'smooth' });

          // Close the off-canvas sidebar on small screens
          if (window.innerWidth < 992) {
            var sb = document.getElementById('sidebar');
            var ov = document.getElementById('sidebarOverlay');
            if (sb) sb.classList.remove('show');
            if (ov) ov.classList.remove('show');
          }
        });
      });

      window.addEventListener('hashchange', syncFromHash);

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncFromHash);
      } else {
        syncFromHash();
      }
    })();
  </script>
</body>
</html>
