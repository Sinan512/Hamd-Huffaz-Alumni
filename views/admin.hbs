  <!-- ===== MEMBERS TABLE: batch filter + 10-per-page pagination ===== -->
  <script>
    (function () {
      var PAGE_SIZE = 10;
      var currentPage = 1;
      var activeBatch = '';

      var tbody      = document.getElementById('membersTableBody');
      var filterSel  = document.getElementById('batchFilterSelect');
      var prevBtn    = document.getElementById('membersPrevBtn');
      var nextBtn    = document.getElementById('membersNextBtn');
      var pageInfo   = document.getElementById('membersPageInfo');
      var countBadge = document.getElementById('memberCountBadge');
      var dotsWrap   = document.getElementById('membersPageDots');

      if (!tbody) return;

      /* Collect all data rows once (exclude the empty-state row) */
      var allRows = Array.from(tbody.querySelectorAll('tr[data-batch]'));

      /* ---- filter ---- */
      function getVisibleRows() {
        return allRows.filter(function (row) {
          var batchMatch = !activeBatch || row.getAttribute('data-batch') === activeBatch;
          var query      = (document.getElementById('memberSearchInput') || {}).value || '';
          var textMatch  = !query || row.innerText.toLowerCase().includes(query.toLowerCase().trim());
          return batchMatch && textMatch;
        });
      }

      /* ---- render ---- */
      function render() {
        var visible  = getVisibleRows();
        var total    = visible.length;
        var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        currentPage    = Math.min(currentPage, totalPages);

        var start = (currentPage - 1) * PAGE_SIZE;
        var end   = start + PAGE_SIZE;

        /* Show / hide rows */
        allRows.forEach(function (row) { row.style.display = 'none'; });
        visible.slice(start, end).forEach(function (row) { row.style.display = ''; });

        /* Empty state */
        var emptyRow = document.getElementById('membersEmptyRow');
        if (emptyRow) emptyRow.style.display = total === 0 ? '' : 'none';

        /* Info text */
        var from = total === 0 ? 0 : start + 1;
        var to   = Math.min(end, total);
        pageInfo.textContent   = 'Showing ' + from + '–' + to + ' of ' + total + ' members';
        countBadge.textContent = total;

        /* Buttons */
        prevBtn.disabled = currentPage <= 1;
        nextBtn.disabled = currentPage >= totalPages;

        /* Page number dots (max 7 shown) */
        dotsWrap.innerHTML = '';
        var maxDots = 7;
        var half    = Math.floor(maxDots / 2);
        var dotStart = Math.max(1, currentPage - half);
        var dotEnd   = Math.min(totalPages, dotStart + maxDots - 1);
        if (dotEnd - dotStart < maxDots - 1) dotStart = Math.max(1, dotEnd - maxDots + 1);

        for (var p = dotStart; p <= dotEnd; p++) {
          var btn   = document.createElement('button');
          var isAct = p === currentPage;
          btn.className   = 'btn btn-sm rounded-3 px-2 py-1 ' + (isAct ? 'btn-primary' : 'btn-outline-secondary');
          btn.style.fontSize = '12px';
          btn.style.minWidth = '30px';
          btn.textContent = p;
          btn.disabled    = isAct;
          (function (pg) {
            btn.addEventListener('click', function () { currentPage = pg; render(); });
          })(p);
          dotsWrap.appendChild(btn);
        }
      }

      /* ---- event listeners ---- */
      if (filterSel) {
        filterSel.addEventListener('change', function () {
          activeBatch = filterSel.value;
          currentPage = 1;
          render();
        });
      }

      prevBtn.addEventListener('click', function () { if (currentPage > 1) { currentPage--; render(); } });
      nextBtn.addEventListener('click', function () { currentPage++; render(); });

      /* Hook into existing search box */
      var searchInput = document.getElementById('memberSearchInput');
      if (searchInput) {
        searchInput.addEventListener('input', function () { currentPage = 1; render(); });
      }

      /* Initial render */
      render();
    })();
  </script>

  <!-- ===== EVENT DETAIL: open modal and load data on click ===== -->
  <script>
    var CATEGORY_BADGE = {
      'Reunion':    'bg-primary',
      'Official':   'bg-info',
      'Seminar':    'bg-warning text-dark',
      'Networking': 'bg-success',
      'General':    'bg-secondary'
    };

    async function openEventDetail(eventId) {
      var modalEl  = document.getElementById('eventDetailModal');
      var modal    = bootstrap.Modal.getOrCreateInstance(modalEl);

      /* Reset state */
      document.getElementById('eventDetailLoading').classList.remove('d-none');
      document.getElementById('eventDetailContent').classList.add('d-none');
      document.getElementById('eventDetailError').classList.add('d-none');
      document.getElementById('eventDetailImageWrapper').classList.add('d-none');

      modal.show();

      try {
        var res    = await fetch('/admin/events/' + eventId);
        var result = await res.json().catch(function () { return {}; });

        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Could not load event.');
        }

        /* Populate text fields */
        document.getElementById('eventDetailTitle').innerHTML =
          '<i class="bi bi-calendar-event text-amber me-2"></i>' + (result.title || 'Event Details');
        document.getElementById('eventDetailName').textContent        = result.title        || '';
        document.getElementById('eventDetailDescription').textContent = result.description  || '';
        document.getElementById('eventDetailMonth').textContent       = result.month        || '';
        document.getElementById('eventDetailDay').textContent         = result.day          || '';
        document.getElementById('eventDetailDateFormatted').textContent = result.dateFormatted || '';
        document.getElementById('eventDetailLocation').textContent    = result.location     || '—';

        var badgeEl = document.getElementById('eventDetailBadge');
        badgeEl.className = 'badge rounded-pill small ' + (CATEGORY_BADGE[result.category] || 'bg-secondary');
        badgeEl.textContent = result.category || '';

        /* Show image if present */
        if (result.hasImage) {
          var imgEl = document.getElementById('eventDetailImage');
          imgEl.src = '/admin/events/' + eventId + '/image?t=' + Date.now();
          document.getElementById('eventDetailImageWrapper').classList.remove('d-none');
        }

        document.getElementById('eventDetailLoading').classList.add('d-none');
        document.getElementById('eventDetailContent').classList.remove('d-none');
      } catch (err) {
        document.getElementById('eventDetailLoading').classList.add('d-none');
        var errEl = document.getElementById('eventDetailError');
        errEl.textContent = err.message || 'Could not load event details.';
        errEl.classList.remove('d-none');
      }
    }
  </script>

  <!-- ===== CREATE EVENT FORM ===== -->
  <script>
    (function () {
      var form          = document.getElementById('createEventForm');
      if (!form) return;
      var alertBox      = document.getElementById('createEventAlert');
      var submitBtn     = document.getElementById('createEventSubmit');
      var imageInput    = document.getElementById('eventImageInput');
      var previewWrapper = document.getElementById('eventImagePreviewWrapper');
      var previewImg    = document.getElementById('eventImagePreview');

      /* Live image preview */
      if (imageInput) {
        imageInput.addEventListener('change', function () {
          var file = imageInput.files[0];
          if (file && file.type.startsWith('image/')) {
            var reader = new FileReader();
            reader.onload = function (e) {
              previewImg.src = e.target.result;
              previewWrapper.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
          } else {
            previewWrapper.classList.add('d-none');
            previewImg.src = '';
          }
        });
      }

      function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = message;
      }
      function hideAlert() {
        alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = '';
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        hideAlert();

        var formData = new FormData(form);
        submitBtn.disabled = true;
        var originalText = submitBtn.textContent;
        submitBtn.textContent = 'Publishing...';

        try {
          var res = await fetch('/admin/events', { method: 'POST', body: formData });
          var result = await res.json().catch(function () { return {}; });

          if (res.ok) {
            showAlert('success', result.message || 'Event created successfully.');
            form.reset();
            previewWrapper.classList.add('d-none');
            previewImg.src = '';
            setTimeout(function () {
              hideAlert();
              var modalEl = document.getElementById('createEventModal');
              var modal   = bootstrap.Modal.getInstance(modalEl);
              if (modal) modal.hide();
              window.location.reload();
            }, 1500);
          } else {
            showAlert('danger', result.message || 'Could not save the event. Please try again.');
          }
        } catch (err) {
          showAlert('danger', 'Could not save the event. Please try again.');
        } finally {
          submitBtn.disabled    = false;
          submitBtn.textContent = originalText;
        }
      });
    })();
  </script>

  <script>
    // --- SIDEBAR OPEN / CLOSE ---
    const sidebar = document.getElementById('sidebar');
    const sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
    const sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
    const sidebarOverlay = document.getElementById('sidebarOverlay');

    function openSidebar() {
      sidebar.classList.add('show');
      sidebar.classList.remove('collapsed');
      document.body.classList.remove('sidebar-collapsed');
      if (sidebarOverlay) sidebarOverlay.classList.add('show');
    }

    function closeSidebar() {
      sidebar.classList.remove('show');
      if (sidebarOverlay) sidebarOverlay.classList.remove('show');
      if (window.innerWidth > 992) {
        sidebar.classList.add('collapsed');
        document.body.classList.add('sidebar-collapsed');
      }
    }

    if (sidebarToggleBtn) {
      sidebarToggleBtn.addEventListener('click', () => {
        const isOpen = window.innerWidth > 992
          ? !sidebar.classList.contains('collapsed')
          : sidebar.classList.contains('show');
        isOpen ? closeSidebar() : openSidebar();
      });
    }

    if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeSidebar);
    if (sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSidebar();
    });


    // --- CHART.JS INITIALIZATION (REAL DATA) ---
    document.addEventListener('DOMContentLoaded', () => {

      // Members per Batch (source of truth: BATCH_DETAILS collection)
      var rawBatchChart = (function () { try { return {{{batchChartData}}}; } catch (e) { console.error('Batch chart data invalid:', e); return {}; } })() || {};
      const batchChart = {
        labels: Array.isArray(rawBatchChart.labels) ? rawBatchChart.labels : [],
        values: Array.isArray(rawBatchChart.values) ? rawBatchChart.values : []
      };
      const barEl = document.getElementById('barChart');
      if (!barEl) return;

      const barCtx = barEl.getContext('2d');
      const gradientBar = barCtx.createLinearGradient(0, 0, 0, 300);
      gradientBar.addColorStop(0, '#8b5cf6');
      gradientBar.addColorStop(1, '#6366f1');

      if (!batchChart.labels.length) {
        const empty = document.getElementById('barChartEmpty');
        if (empty) empty.classList.remove('d-none');
        barEl.classList.add('d-none');
        return;
      }


      new Chart(barCtx, {
        type: 'bar',
        data: {
          labels: batchChart.labels,
          datasets: [{
            label: 'Members',
            data: batchChart.values,
            backgroundColor: gradientBar,
            borderRadius: 8,
            barThickness: 28
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 12 } }
            },
            y: {
              beginAtZero: true,
              grid: { color: '#f1f5f9' },
              ticks: { precision: 0, color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 12 } }
            }
          }
        }
      });

    });

  </script>


