<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Alumni Admin Portal</title>
  <link rel="icon" href="/logo/hamd-icon-white.png" />
  <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Apply saved theme before paint (avoids flash) -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('adminTheme');
        if (t !== 'dark' && t !== 'light') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-bs-theme', t);
      } catch (e) {}
    })();
  </script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- SheetJS (registered members Excel export) -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>


  <style>
    :root {
      --font-main: 'Plus Jakarta Sans', sans-serif;
      --bg-body: #f8fafc;
      --sidebar-width: 270px;
      --sidebar-bg: #0b0f19;
      --sidebar-card: #151c2c;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --card-bg: #ffffff;
      --card-border: rgba(226, 232, 240, 0.8);
      --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
      --card-shadow-hover: 0 12px 28px -4px rgba(0, 0, 0, 0.08), 0 4px 12px -2px rgba(0, 0, 0, 0.04);
      --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-main);
      background-color: var(--bg-body);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    /* --- SIDEBAR STYLING --- */
    .sidebar {
      width: var(--sidebar-width);
      background: linear-gradient(180deg, #0b0f19 0%, #111827 100%);
      height: 100vh;
      min-height: 100vh;
      overflow: hidden;
      color: #94a3b8;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1040;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-right: 1px solid rgba(255, 255, 255, 0.06);
      display: flex;
      flex-direction: column;
    }

    .sidebar .brand {
      flex: 0 0 auto;
      padding: 20px 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .sidebar .brand-logo img {
      height: 60px;
      max-width: 150px;
      object-fit: contain;
    }

    .sidebar-menu {
      padding: 20px 16px;
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: rgba(148, 163, 184, 0.35) transparent;
    }

    /* --- SIDEBAR SIMPLE SCROLLER --- */
    .sidebar-menu::-webkit-scrollbar {
      width: 6px;
    }

    .sidebar-menu::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.04);
      border-radius: 8px;
    }

    .sidebar-menu::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.35);
      border-radius: 8px;
    }

    .sidebar-menu::-webkit-scrollbar-thumb:hover {
      background: rgba(148, 163, 184, 0.6);
    }

    /* --- SECTION VIEW SWITCHING --- */
    .admin-view-hidden {
      display: none !important;
    }

    .sidebar-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #475569;
      padding: 12px 14px 6px 14px;
    }

    .sidebar a {
      display: flex;
      align-items: center;
      gap: 14px;
      color: #94a3b8;
      text-decoration: none;
      padding: 12px 16px;
      font-size: 14px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 4px;
      transition: all 0.2s ease;
    }

    .sidebar a i {
      font-size: 18px;
      transition: transform 0.2s ease;
    }

    .sidebar a:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.05);
    }

    .sidebar a:hover i {
      transform: translateX(2px);
    }

    .sidebar a.active {
      background: var(--primary-gradient);
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
    }

    .sidebar-user-card {
      margin: 16px;
      padding: 14px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* --- MAIN CONTENT AREA --- */
    .main {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .boxed {
      max-width: 1440px;
      margin: 0 auto;
    }

    /* --- NAVBAR STYLING --- */
    .navbar {
      background: #ffffff;
      border-bottom: 1px solid var(--card-border);
      padding: 14px 28px;
      position: sticky;
      top: 0;
      z-index: 1020;
      backdrop-filter: blur(8px);
    }

    .search-box {
      position: relative;
      max-width: 420px;
      width: 100%;
    }

    .search-box i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 16px;
    }

    .search-box input {
      padding-left: 42px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #f8fafc;
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .search-box input:focus {
      background: #ffffff;
      border-color: #6366f1;
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .nav-icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #475569;
      position: relative;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .nav-icon-btn:hover {
      background: #f1f5f9;
      color: #1e293b;
    }

    .nav-icon-btn .badge-dot {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 8px;
      height: 8px;
      background: #ef4444;
      border-radius: 50%;
      border: 2px solid #ffffff;
    }

    .user-profile-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 12px 6px 6px;
      border: 1px solid #e2e8f0;
      border-radius: 30px;
      background: #ffffff;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .user-profile-btn:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
    }

    /* --- CARDS & DASHBOARD WIDGETS --- */
    .card {
      border: 1px solid var(--card-border);
      border-radius: 16px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      transition: all 0.25s ease;

    }

    .card-header {
      background: transparent;
      border-bottom: 1px solid var(--card-border);
      padding: 20px 24px;
      font-weight: 700;
      font-size: 16px;
      color: #0f172a;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* --- STAT CARDS --- */
    .stat-card {
      position: relative;
      overflow: hidden;
      padding: 20px;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--card-shadow-hover);
    }

    .stat-icon-wrapper {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
    }

    .stat-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }

    .stat-value {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
      margin: 0;
    }

    .stat-trend {
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border-radius: 20px;
      margin-top: 8px;
    }

    .trend-up {
      background: #ecfdf5;
      color: #10b981;
    }

    /* STAT CARD GRADIENTS */
    .stat-indigo .stat-icon-wrapper { background: rgba(99, 102, 241, 0.12); color: #6366f1; }
    .stat-emerald .stat-icon-wrapper { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .stat-purple .stat-icon-wrapper { background: rgba(139, 92, 246, 0.12); color: #8b5cf6; }
    .stat-amber .stat-icon-wrapper { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .stat-rose .stat-icon-wrapper { background: rgba(244, 63, 94, 0.12); color: #f43f5e; }
    .stat-cyan .stat-icon-wrapper { background: rgba(6, 182, 212, 0.12); color: #06b6d4; }
    .stat-violet .stat-icon-wrapper { background: rgba(168, 85, 247, 0.12); color: #a855f7; }

    /* --- TABLE STYLING --- */
    .table-responsive {
      border-radius: 0 0 16px 16px;
    }

    .custom-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    .custom-table th {
      background: #f8fafc;
      color: #475569;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 14px 24px;
      border-bottom: 1px solid var(--card-border);
    }

    .custom-table td {
      padding: 16px 24px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 14px;
      color: #334155;
      vertical-align: middle;
    }

    .custom-table tbody tr {
      transition: background-color 0.15s ease;
    }

    .custom-table tbody tr:hover {
      background-color: #f8fafc;
    }

    .member-avatar-wrapper {
      position: relative;
      display: inline-block;
    }

    .member-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    .member-avatar-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      background: #eef2ff;
      color: #4f46e5;
      font-size: 22px;
    }

    .status-dot {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      border: 2px solid #ffffff;
    }

    .dot-active { background: #10b981; }
    .dot-verified { background: #3b82f6; }
    .dot-pending { background: #f59e0b; }

    /* BADGES */
    .badge-status {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge-active { background: #dcfce7; color: #15803d; }
    .badge-verified { background: #dbeafe; color: #1e40af; }
    .badge-pending { background: #fef3c7; color: #b45309; }

    .batch-tag {
      background: #f1f5f9;
      color: #475569;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 12px;
    }

    /* --- EVENTS LIST --- */
    .event-item {
      padding: 16px 20px;
      border-bottom: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
      gap: 16px;
      transition: background 0.15s ease;
    }

    .event-item:last-child {
      border-bottom: none;
    }

    .event-item:hover {
      background: #f8fafc;
    }

    .event-date-box {
      width: 50px;
      height: 52px;
      background: #f1f5f9;
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      text-align: center;
    }

    .event-date-month {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      color: #6366f1;
    }

    .event-date-day {
      font-size: 18px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1;
    }

    /* --- QUICK ACTIONS --- */
    .quick-action-btn {
      width: 100%;
      padding: 12px 16px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      color: #334155;
      margin-bottom: 10px;
      transition: all 0.2s ease;
    }

    .quick-action-btn:last-child {
      margin-bottom: 0;
    }

    .quick-action-btn:hover {
      background: var(--primary-gradient);
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
      transform: translateX(4px);
    }

    .quick-action-btn i {
      font-size: 16px;
    }

    /* --- ARTICLES GRID --- */
    .article-tile {
      position: relative;
      height: 100%;
      display: flex; flex-direction: column;
      border: 1px solid rgba(15,23,42,0.08);
      border-radius: 14px;
      overflow: hidden;
      background: #fff;
      transition: box-shadow .2s ease, transform .2s ease;
    }
    .article-tile:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(15,23,42,0.12); }
    .article-tile-img {
      height: 150px;
      background: linear-gradient(135deg, #dbeafe, #eff6ff);
      display: flex; align-items: center; justify-content: center;
      color: #60a5fa; font-size: 2rem;
    }
    .article-tile-img img { width: 100%; height: 100%; object-fit: cover; }
    .article-tile-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .article-tile-heading { font-weight: 700; font-size: 0.95rem; line-height: 1.35; }
    .article-tile-meta { display: flex; flex-wrap: wrap; gap: 12px; font-size: 11px; color: #64748b; }
    .article-tile-excerpt { font-size: 12.5px; color: #64748b; line-height: 1.6; }
    .article-tile-delete {
      position: absolute; top: 10px; right: 10px;
      width: 32px; height: 32px; border: 0; border-radius: 50%;
      background: rgba(220,38,38,0.92); color: #fff;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity .2s ease; cursor: pointer;
    }
    .article-tile:hover .article-tile-delete,
    .article-tile:focus-within .article-tile-delete { opacity: 1; }
    [data-bs-theme="dark"] .article-tile { background: #111827; border-color: rgba(255,255,255,0.08); }
    [data-bs-theme="dark"] .article-tile-heading { color: #e5e7eb; }

    /* --- GALLERY GRID --- */
    .gallery-tile {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
      background: #f8fafc;
    }

    .gallery-tile img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
    }

    .gallery-tile .gallery-caption {
      padding: 8px 10px;
      font-size: 12px;
      line-height: 1.35;
      color: #64748b;
      min-height: 34px;
    }

    .gallery-tile .gallery-delete {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 30px;
      height: 30px;
      border: 0;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(15, 23, 42, .65);
      color: #fff;
      opacity: 0;
      transition: opacity .15s ease-in-out;
    }

    .gallery-tile:hover .gallery-delete,
    .gallery-tile:focus-within .gallery-delete {
      opacity: 1;
    }

    .gallery-empty {
      padding: 32px 12px;
      text-align: center;
      color: #94a3b8;
      font-size: 14px;
    }

    /* --- ACTIVITY FEED --- */
    .activity-feed {
      position: relative;
      padding-left: 20px;
    }

    .activity-feed::before {
      content: '';
      position: absolute;
      left: 17px;
      top: 15px;
      bottom: 15px;
      width: 2px;
      background: #e2e8f0;
    }

    .activity-item {
      position: relative;
      padding-bottom: 20px;
      display: flex;
      gap: 16px;
    }

    .activity-item:last-child {
      padding-bottom: 0;
    }

    .activity-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      z-index: 1;
      flex-shrink: 0;
      box-shadow: 0 0 0 4px #ffffff;
    }

    .bg-emerald-soft { background: #dcfce7; color: #10b981; }
    .bg-indigo-soft { background: #e0e7ff; color: #6366f1; }
    .bg-amber-soft { background: #fef3c7; color: #f59e0b; }
    .bg-purple-soft { background: #f3e8ff; color: #a855f7; }

    /* SIDEBAR CLOSE BUTTON + OVERLAY */
    .sidebar-close-btn {
      background: rgba(255, 255, 255, 0.06);
      border: none;
      color: #94a3b8;
      width: 30px;
      height: 30px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      transition: all .2s ease;
      flex-shrink: 0;
    }
    .sidebar-close-btn:hover { background: rgba(255, 255, 255, 0.14); color: #fff; }

    .sidebar { transition: transform .25s ease; }
    .main { transition: margin-left .25s ease; }

    .sidebar.collapsed { transform: translateX(-100%); }
    body.sidebar-collapsed .main { margin-left: 0; }

    .sidebar-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
      z-index: 1035;
      opacity: 0;
      visibility: hidden;
      transition: opacity .2s ease;
    }
    .sidebar-overlay.show { opacity: 1; visibility: visible; }
    @media (min-width: 993px) {
      .sidebar-overlay { display: none; }
    }

    /* RESPONSIVE TOGGLES */

    @media (max-width: 992px) {
      .sidebar {
        transform: translateX(-100%);
      }
      .sidebar.show {
        transform: translateX(0);
      }
      .main {
        margin-left: 0;
      }
    }

    /* --- DARK MODE THEME --- */
    [data-bs-theme="dark"] {
      --bg-body: #0b0f19;
      --text-main: #e2e8f0;
      --text-muted: #94a3b8;
      --card-bg: #151c2c;
      --card-border: rgba(148, 163, 184, 0.16);
      --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.5), 0 2px 6px -1px rgba(0, 0, 0, 0.3);
      --card-shadow-hover: 0 12px 28px -4px rgba(0, 0, 0, 0.6), 0 4px 12px -2px rgba(0, 0, 0, 0.4);
      color-scheme: dark;
    }

    [data-bs-theme="dark"] body { background-color: var(--bg-body); color: var(--text-main); }
    [data-bs-theme="dark"] .navbar { background: #111827; border-bottom-color: var(--card-border); }
    [data-bs-theme="dark"] .search-box input { background: #0f172a; border-color: var(--card-border); color: #e2e8f0; }
    [data-bs-theme="dark"] .search-box input::placeholder { color: #64748b; }
    [data-bs-theme="dark"] .search-box input:focus { background: #0b1220; border-color: #6366f1; }
    [data-bs-theme="dark"] .nav-icon-btn { background: #1e293b; border-color: var(--card-border); color: #cbd5e1; }
    [data-bs-theme="dark"] .nav-icon-btn:hover { background: #263449; color: #ffffff; }
    [data-bs-theme="dark"] .user-profile-btn { background: #1e293b; border-color: var(--card-border); }
    [data-bs-theme="dark"] .user-profile-btn div[style*="color: #0f172a"] { color: #e2e8f0 !important; }
    [data-bs-theme="dark"] .card-header,
    [data-bs-theme="dark"] .stat-value,
    [data-bs-theme="dark"] .fw-800,
    [data-bs-theme="dark"] h1, [data-bs-theme="dark"] h2, [data-bs-theme="dark"] h3,
    [data-bs-theme="dark"] h4, [data-bs-theme="dark"] h5, [data-bs-theme="dark"] h6 { color: #f1f5f9; }
    [data-bs-theme="dark"] .text-slate-900,
    [data-bs-theme="dark"] .text-dark { color: #e2e8f0 !important; }
    [data-bs-theme="dark"] .bg-white { background-color: #151c2c !important; }
    [data-bs-theme="dark"] .modal-content,
    [data-bs-theme="dark"] .dropdown-menu { background-color: #151c2c; color: var(--text-main); }
    [data-bs-theme="dark"] .modal-header,
    [data-bs-theme="dark"] .modal-footer { border-color: var(--card-border); }
    [data-bs-theme="dark"] .form-control,
    [data-bs-theme="dark"] .form-select { background-color: #0f172a; border-color: var(--card-border); color: #e2e8f0; }
    [data-bs-theme="dark"] .form-control::placeholder { color: #64748b; }
    [data-bs-theme="dark"] .table { --bs-table-color: #e2e8f0; --bs-table-bg: transparent; }
    [data-bs-theme="dark"] .btn-light { background-color: #1e293b; border-color: var(--card-border); color: #e2e8f0; }
    [data-bs-theme="dark"] .btn-outline-secondary { color: #cbd5e1; border-color: var(--card-border); }
    [data-bs-theme="dark"] .list-group-item { background-color: transparent; color: var(--text-main); border-color: var(--card-border); }

    /* ---- Dark mode: custom table ---- */
    [data-bs-theme="dark"] .custom-table th {
      background: #1a2235;
      color: #94a3b8;
      border-bottom-color: var(--card-border);
    }
    [data-bs-theme="dark"] .custom-table td {
      color: #cbd5e1;
      border-bottom-color: rgba(148, 163, 184, 0.1);
    }
    [data-bs-theme="dark"] .custom-table tbody tr:hover {
      background-color: #1a2235;
    }
    
    /* ---- Dark mode: batch tag ---- */
    [data-bs-theme="dark"] .batch-tag {
      background: #1e293b;
      color: #94a3b8;
    }

    /* ---- Dark mode: event items ---- */
    [data-bs-theme="dark"] .event-item {
      border-bottom-color: rgba(148, 163, 184, 0.1);
    }
    [data-bs-theme="dark"] .event-item:hover {
      background: #1a2235;
    }
    [data-bs-theme="dark"] .event-date-box {
      background: #1e293b;
    }
    [data-bs-theme="dark"] .event-date-day {
      color: #e2e8f0;
    }

    /* ---- Dark mode: quick action buttons ---- */
    [data-bs-theme="dark"] .quick-action-btn {
      background: #1e293b;
      border-color: var(--card-border);
      color: #cbd5e1;
    }
    [data-bs-theme="dark"] .quick-action-btn:hover {
      background: var(--primary-gradient);
      color: #ffffff;
      border-color: transparent;
    }

    /* ---- Dark mode: gallery ---- */
    [data-bs-theme="dark"] .gallery-tile {
      border-color: var(--card-border);
      background: #1a2235;
    }
    [data-bs-theme="dark"] .gallery-caption {
      color: #94a3b8;
    }

    /* ---- Dark mode: activity feed ---- */
    [data-bs-theme="dark"] .activity-feed::before {
      background: rgba(148, 163, 184, 0.2);
    }
    [data-bs-theme="dark"] .activity-icon {
      box-shadow: 0 0 0 4px #151c2c;
    }

    /* ---- Dark mode: member avatars ---- */
    [data-bs-theme="dark"] .member-avatar,
    [data-bs-theme="dark"] .status-dot {
      border-color: #151c2c;
    }
    [data-bs-theme="dark"] .member-avatar-icon {
      border-color: #151c2c;
      background: #1e2a45;
      color: #818cf8;
    }

    /* ---- Dark mode: nav badge dot ---- */
    [data-bs-theme="dark"] .nav-icon-btn .badge-dot {
      border-color: #111827;
    }

    /* ---- Dark mode: Bootstrap bg-light / text-dark ---- */
    [data-bs-theme="dark"] .text-dark,
    [data-bs-theme="dark"] .fw-bold.text-dark {
      color: #e2e8f0 !important;
    }
    [data-bs-theme="dark"] .bg-light:not(.badge) {
      background-color: #1e293b !important;
      color: #cbd5e1 !important;
    }
    [data-bs-theme="dark"] .badge.bg-light {
      background-color: #1e293b !important;
      color: #94a3b8 !important;
    }
    [data-bs-theme="dark"] .table-light,
    [data-bs-theme="dark"] thead.table-light th {
      background-color: #1a2235 !important;
      color: #94a3b8 !important;
      border-color: var(--card-border) !important;
    }

    /* ---- Dark mode: soft-color backgrounds ---- */
    [data-bs-theme="dark"] .bg-indigo-soft { background: #1e2a45 !important; }
    [data-bs-theme="dark"] .bg-emerald-soft { background: #0f2e24 !important; }
    [data-bs-theme="dark"] .bg-amber-soft { background: #2e1f00 !important; }
    [data-bs-theme="dark"] .bg-purple-soft { background: #1e1040 !important; }

    /* ---- Dark mode: status badges ---- */
    [data-bs-theme="dark"] .badge-active { background: #0f2e24; color: #34d399; }
    [data-bs-theme="dark"] .badge-verified { background: #0f1f40; color: #60a5fa; }
    [data-bs-theme="dark"] .badge-pending { background: #2e1f00; color: #fbbf24; }
    [data-bs-theme="dark"] .trend-up { background: #0f2e24; color: #34d399; }

    /* ---- Dark mode: dropdown items ---- */
    [data-bs-theme="dark"] .dropdown-item {
      color: #cbd5e1;
    }
    [data-bs-theme="dark"] .dropdown-item:hover,
    [data-bs-theme="dark"] .dropdown-item:focus {
      background-color: #1e293b;
      color: #f1f5f9;
    }
    [data-bs-theme="dark"] .dropdown-divider {
      border-color: var(--card-border);
    }

    /* ---- Dark mode: form helpers ---- */
    [data-bs-theme="dark"] .form-label { color: #cbd5e1; }
    [data-bs-theme="dark"] .form-text  { color: #64748b; }
    [data-bs-theme="dark"] .bg-light-subtle {
      background-color: #1a2235 !important;
    }
    [data-bs-theme="dark"] code {
      color: #818cf8;
      background-color: #1e293b;
      padding: 1px 4px;
      border-radius: 4px;
    }

    /* ---- Dark mode: pagination & outline buttons ---- */
    [data-bs-theme="dark"] .btn-outline-secondary {
      background-color: transparent;
      color: #94a3b8;
      border-color: var(--card-border);
    }
    [data-bs-theme="dark"] .btn-outline-secondary:hover {
      background-color: #1e293b;
      color: #e2e8f0;
    }

    /* ---- Dark mode: table-hover in registrations section ---- */
    [data-bs-theme="dark"] .table-hover > tbody > tr:hover > * {
      background-color: #1a2235;
      color: #cbd5e1;
    }
    [data-bs-theme="dark"] .table th,
    [data-bs-theme="dark"] .table td {
      border-color: rgba(148, 163, 184, 0.12);
    }

    /* ---- Dark mode: borders ---- */
    [data-bs-theme="dark"] .border {
      border-color: var(--card-border) !important;
    }
    [data-bs-theme="dark"] .border-top { border-top-color: var(--card-border) !important; }
    [data-bs-theme="dark"] .border-bottom { border-bottom-color: var(--card-border) !important; }

    /* ---- Dark mode: pagination bar border ---- */
    [data-bs-theme="dark"] #membersPaginationBar {
      border-top-color: var(--card-border) !important;
    }

    /* ---- Registered members controls ---- */
    #registrations-section .card-header { gap: 12px; }
    .registration-controls,
    .registration-actions { display: flex; align-items: center; gap: 8px; }
    .registration-controls { min-width: 0; }
    #regEventSelect { width: 220px; min-width: 0; }
    #regDownloadExcelBtn,
    #regRefreshBtn { margin: 0; white-space: nowrap; }

    @media (max-width: 575.98px) {
      #registrations-section .card-header { align-items: stretch; }
      .registration-controls { width: 100%; flex-wrap: wrap; }
      #regEventSelect { flex: 1 1 100%; width: 100%; }
      .registration-actions { width: 100%; }
      #regDownloadExcelBtn { flex: 1 1 auto; }
      #regRefreshBtn { flex: 0 0 auto; }
    }

    /* ---- Mobile fixes: All Registered Members table ---- */
    @media (max-width: 767px) {

      /* Card header: stack title row and controls row vertically */
      #members-section .card-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
      }

      #members-section .card-header > div {
        width: 100%;
      }

      /* Make the filter + add-member row fill width and wrap if needed */
      #members-section .card-header > div:last-child {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
      }

      /* Batch filter select: grow to fill available space */
      #batchFilterSelect,
      #profileFilterSelect {
        flex: 1 1 auto;
        min-width: 0;
        width: auto !important;
        font-size: 12px;
      }

      /* Reduce table cell padding so columns don't overflow */
      #membersTable th,
      #membersTable td {
        padding: 10px 10px;
        font-size: 12px;
      }

      /* Hide profile status column on small screens to preserve table space. */
      #membersTable th[data-col="status"],
      #membersTable td[data-col="status"] {
        display: none;
      }

      .sortable-th {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
        transition: background-color 0.15s ease;
      }
      .sortable-th:hover {
        background-color: var(--surface-alt, rgba(0,0,0,0.04));
      }
      .sort-icon {
        font-size: 11px;
        display: inline-flex;
        align-items: center;
      }

      /* Member name + email: constrain width to prevent blowout */
      #membersTable td:first-child .fw-bold {
        max-width: 110px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      #membersTable td:first-child .text-muted {
        max-width: 110px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Shrink avatar icon on mobile */
      .member-avatar-icon {
        width: 34px;
        height: 34px;
        font-size: 17px;
      }

      /* Avatar cell: tighten the gap */
      #membersTable td:first-child .d-flex {
        gap: 8px;
      }

      /* Pagination bar: stack info text above buttons on very small screens */
      #membersPaginationBar {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 12px 14px;
      }

      #membersPaginationBar > div {
        width: 100%;
        justify-content: flex-end;
      }
    }

    /* Extra-small screens (< 480px): also hide Contact column header text */
    @media (max-width: 479px) {
      #membersTable th:nth-child(4) {
        font-size: 0;           /* hide text */
        padding-left: 4px;
        padding-right: 4px;
      }
      #membersTable th:nth-child(4)::after {
        content: "📞";          /* keep icon hint */
        font-size: 12px;
      }
    }

    /* ---- Dark mode: stat card decorative elements ---- */
    [data-bs-theme="dark"] .stat-indigo .stat-icon-wrapper { background: rgba(99, 102, 241, 0.18); }
    [data-bs-theme="dark"] .stat-emerald .stat-icon-wrapper { background: rgba(16, 185, 129, 0.18); }
    [data-bs-theme="dark"] .stat-purple .stat-icon-wrapper { background: rgba(139, 92, 246, 0.18); }
    [data-bs-theme="dark"] .stat-amber .stat-icon-wrapper { background: rgba(245, 158, 11, 0.18); }

  </style>
</head>
<body>

  <!-- SIDEBAR NAVIGATION -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-logo">
        <img src="/logo/hamd-full-white.png" alt="HAMD Logo">
      </div>
      <button type="button" class="sidebar-close-btn ms-auto" id="sidebarCloseBtn" aria-label="Close navigation">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>


    <div class="sidebar-menu" id="sidebarMenu">
      <div class="sidebar-section-title">Main Menu</div>
      <a class="active" href="#top"><i class="bi bi-grid-1x2-fill me-2"></i>Dashboard</a>
      <a href="#members-section"><i class="bi bi-people-fill me-2"></i>Members</a>
      <a href="#batches-section"><i class="bi bi-collection-fill me-2"></i>Batches</a>
      <a href="#batch-leaders-section"><i class="bi bi-person-badge-fill me-2"></i>Leaders</a>

      <div class="sidebar-section-title mt-3">Events &amp; Content</div>
      <a href="#events-section"><i class="bi bi-calendar2-event-fill me-2"></i>Events</a>
      <a href="#registrations-section"><i class="bi bi-check2-square me-2"></i>Registrations</a>
      <a href="#articles-section"><i class="bi bi-journal-text me-2"></i>Articles</a>
      <a href="#payment-section"><i class="bi bi-qr-code-scan me-2"></i>Payment Setup</a>
      <a href="#gallery-section"><i class="bi bi-images me-2"></i>Gallery</a>
      <a href="#contributions-section"><i class="bi bi-wallet2 me-2"></i>Contributions</a>
    </div>

  </aside>

  <!-- SIDEBAR OVERLAY (mobile) -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>


  <!-- MAIN WRAPPER -->
  <div class="main" id="top">

    
    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg">
      <div class="container-fluid boxed px-0">
        
        <div class="d-flex align-items-center gap-3 w-100">
          <!-- Mobile Sidebar Toggle -->
          <button class="btn btn-light" id="sidebarToggleBtn" aria-label="Toggle navigation">

            <i class="bi bi-list fs-4"></i>
          </button>

          <!-- Search Box -->
          <div class="search-box me-auto">
            <i class="bi bi-search"></i>
            <input type="text" id="memberSearchInput" class="form-control" placeholder="Search members by name, batch or email...">
          </div>

          <!-- Right Action Items -->
          <div class="d-flex align-items-center gap-3">
            
            <!-- Dark Mode Toggle -->
            <button type="button" class="nav-icon-btn border-0 p-0" id="themeToggleBtn" aria-label="Toggle dark mode" title="Toggle dark mode">
              <i class="bi bi-moon-stars fs-5" id="themeToggleIcon"></i>
            </button>

            <!-- User Profile Dropdown -->
            <div class="dropdown">
              <div class="user-profile-btn" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="{{#if admin.hasAvatar}}/admin/profile/avatar{{else}}https://ui-avatars.com/api/?background=6366f1&color=fff&name={{adminName}}{{/if}}"
                     class="user-avatar" alt="Admin" id="adminAvatarTop">
                <div class="d-none d-sm-block text-start me-1">
                  <div style="font-size: 13px; font-weight: 700; color: #0f172a;" id="adminNameTop">{{adminName}}</div>
                  <div style="font-size: 10px; font-weight: 600; color: #6366f1;">ADMIN</div>
                </div>
                <i class="bi bi-chevron-down small text-muted"></i>
              </div>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="width: 215px;">
                <li>
                  <button type="button" class="dropdown-item rounded-3" data-bs-toggle="modal" data-bs-target="#adminProfileModal">
                    <i class="bi bi-person me-2"></i>Edit Profile
                  </button>
                </li>
                <li>
                  <button type="button" class="dropdown-item rounded-3" data-bs-toggle="modal" data-bs-target="#adminPasswordModal">
                    <i class="bi bi-shield-lock me-2"></i>Change Password
                  </button>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <form method="post" action="/admin/logout" class="m-0">
                    <button type="submit" class="dropdown-item rounded-3 text-danger">
                      <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </button>
                  </form>
                </li>
              </ul>

            </div>

          </div>
        </div>

      </div>
    </nav>

    <!-- CONTENT BODY -->
    <div class="container-fluid boxed px-4 py-4">

      <!-- DASHBOARD OVERVIEW (banner + stat cards) -->
      <div id="dashboard-overview">

      <!-- WELCOME BANNER -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
          <h3 class="fw-800 text-slate-900 m-0" style="font-weight: 800; letter-spacing: -0.5px;">Dashboard Overview</h3>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-secondary btn-sm rounded-3 fw-semibold bg-white shadow-sm" onclick="window.location.reload();">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
          </button>
          <button class="btn btn-primary btn-sm rounded-3 fw-semibold shadow-sm" style="background: var(--primary-gradient); border: none;" data-bs-toggle="modal" data-bs-target="#addAlumniModal">
            <i class="bi bi-plus-lg me-1"></i> Add member
          </button>
        </div>
      </div>

      <!-- 7 STAT CARDS GRID -->
      <div class="row g-3 mb-4">
        
        <!-- Stat 1: Total Alumni -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-indigo h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Total Alumni</div>
                <h3 class="stat-value">{{stats.totalAlumni}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-graph-up-arrow"></i> {{stats.alumniGrowth}}</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-people-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 2: Total Batches -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-emerald h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Total Batches</div>
                <h3 class="stat-value">{{stats.totalBatches}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-check-circle-fill"></i> Active</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-collection-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 3: Batch Leaders -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-purple h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Batch Leaders</div>
                <h3 class="stat-value">{{stats.batchLeaders}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-shield-check"></i> Assigned</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-person-badge-fill"></i>
              </div>
            </div>
          </div>
        </div>


        <!-- Stat 4: Upcoming Events -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-amber h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Upcoming Events</div>
                <h3 class="stat-value">{{stats.upcomingEvents}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-calendar-check"></i> Scheduled</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-calendar-event-fill"></i>
              </div>
            </div>
          </div>
        </div>



      </div>

      </div><!-- /#dashboard-overview -->

      <!-- CHARTS SECTION -->
      <div class="row g-4 mb-4" id="batches-section">


        <!-- Members per Batch Bar Chart -->
        <div class="col-12">
          <div class="card h-100">
            <div class="card-header">
              <span><i class="bi bi-bar-chart-fill text-indigo me-2"></i>Members per Batch</span>
              <div style="justify-content: end;">
                <button
      class="btn btn-sm text-muted"
      type="button"
      title="Create Batch"
      data-bs-toggle="modal" data-bs-target="#createBatchModal">
      <i class="bi bi-plus-circle"></i>
    </button>
              <span class="badge bg-light text-dark">{{stats.totalBatches}} Batches</span>
              </div>
            </div>
            <div class="card-body">
              <div style="height: 320px; position: relative;">
                <canvas id="barChart"></canvas>
                <div id="barChartEmpty" class="d-none h-100 d-flex align-items-center justify-content-center text-muted small">
                  No batches created yet. Use "Create New Batch" to add one.
                </div>

              </div>
            </div>
          </div>
        </div>

      </div>


      <!-- BATCH LEADERS TABLE -->
      <div class="row g-4 mb-4" id="batch-leaders-section">
        <div class="col-12">
          <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge-fill text-indigo"></i>
                <span>Batch Leaders</span>
                <span class="badge bg-indigo-soft text-indigo rounded-pill ms-1" style="font-size:11px;" id="batchLeaderCountBadge">{{batchLeadersList.length}}</span>
              </div>
              <button class="btn btn-sm btn-primary rounded-3 text-white" data-bs-toggle="modal" data-bs-target="#assignLeaderModal">
                <i class="bi bi-plus-lg me-1"></i>Setup Leader Login
              </button>
            </div>

            <div class="table-responsive">
              <table class="custom-table" id="batchLeadersTable">
                <thead>
                  <tr>
                    <th>Batch Year</th>
                    <th>Password Status</th>
                    <th>Date Set</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody id="batchLeadersTableBody">
                  {{#each batchLeadersList}}
                  <tr data-year="{{this.year}}">
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <div class="member-avatar-wrapper">
                          <div class="member-avatar-icon">
                            <i class="bi bi-shield-lock"></i>
                          </div>
                        </div>
                        <div>
                          <div class="fw-bold text-dark">Batch {{this.year}}</div>
                          <div class="text-muted small">Leader Credentials</div>
                        </div>
                      </div>
                    </td>
                    <td>
                      {{#if this.hasPassword}}
                      <span class="badge bg-success-subtle text-success border">Configured</span>
                      {{else}}
                      <span class="badge bg-warning-subtle text-warning border">Pending Password</span>
                      {{/if}}
                    </td>
                    <td class="text-muted small fw-medium">{{this.assignedAt}}</td>
                    <td class="text-end">
                      <div class="d-flex gap-1 justify-content-end">
                        <button class="btn btn-sm btn-light border rounded-2 px-2 text-primary" title="Edit Password"
                                data-leader-id="{{this.id}}"
                                data-leader-year="{{this.year}}"
                                onclick="openLeaderCredentialsModal('{{this.id}}', '{{this.year}}')">
                          <i class="bi bi-key"></i>
                        </button>
                        <button class="btn btn-sm btn-light border rounded-2 px-2 text-danger" title="Remove Leader Setup"
                                onclick="deleteLeaderSetup('{{this.id}}', '{{this.year}}')">
                          <i class="bi bi-trash"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                  {{/each}}
                  {{#unless batchLeadersList}}
                  <tr id="batchLeadersEmptyRow">
                    <td colspan="4" class="text-center text-muted py-4">No batch leader passwords set up yet.</td>
                  </tr>
                  {{/unless}}
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>


      <!-- TABLES & SIDE PANELS -->
      <div class="row g-4 mb-4" id="members-section">
        
        <!-- All Members Table -->
        <div class="col-lg-12">
          <div class="card">
            <div class="card-header">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i>
                <span>All Registered Members</span>
