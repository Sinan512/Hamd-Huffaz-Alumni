          <!-- Upcoming and ended events -->
<div class="card mb-4" id="events-section">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-semibold">
      <i class="bi bi-calendar-event text-amber me-2"></i>
      Upcoming Events
    </span>

    <button
      class="btn btn-sm btn-light text-muted"
      type="button"
      title="Create Event"
      data-bs-toggle="modal"
      data-bs-target="#createEventModal">
      <i class="bi bi-plus-circle"></i>
    </button>
  </div>

  <div class="overflow-auto" style="max-height: 440px;">

    {{#each upcomingEvents}}
    <div
      class="event-item row g-2 align-items-center mx-0 px-3 py-2 border-bottom"
      data-event-id="{{this.id}}"
      role="button"
      onclick="openEventDetail('{{this.id}}')">

      <div class="col-auto">
        <div class="event-date-box">
          <span class="event-date-month">{{this.month}}</span>
          <span class="event-date-day">{{this.day}}</span>
        </div>
      </div>

      <div class="col overflow-hidden">
        <div class="fw-bold text-dark text-truncate small mb-1">
          {{this.title}}
        </div>

        <div class="text-muted small text-truncate">
          <i class="bi bi-geo-alt me-1"></i>{{this.location}}
        </div>
      </div>

      <div class="col-auto">
        <span class="badge {{this.badgeColor}} rounded-pill">
          {{this.category}}
        </span>
      </div>

      <div class="col-auto" onclick="event.stopPropagation()">
        <div class="d-flex gap-1">
          <button
            class="btn btn-sm btn-light border rounded-2 px-2 text-primary"
            type="button"
            title="Edit Event"
            onclick="openEditEventModal('{{this.id}}')">
            <i class="bi bi-pencil"></i>
          </button>

          <button
            class="btn btn-sm btn-light border rounded-2 px-2 text-danger"
            type="button"
            title="Delete Event"
            data-event-id="{{this.id}}"
            data-event-title="{{this.title}}"
            onclick="openDeleteEventModal(this.dataset.eventId, this.dataset.eventTitle)">
            <i class="bi bi-trash"></i>
          </button>
        </div>
      </div>
    </div>
    {{/each}}

    {{#if endedEvents.length}}
    <div class="sticky-top px-3 py-2 bg-light border-top border-bottom">
      <small class="fw-semibold text-muted text-uppercase">
        <i class="bi bi-clock-history me-1"></i>
        Ended Events
      </small>
    </div>

    {{#each endedEvents}}
    <div
      class="event-item row g-2 align-items-center mx-0 px-3 py-2 border-bottom bg-light-subtle opacity-75"
      data-event-id="{{this.id}}"
      role="button"
      onclick="openEventDetail('{{this.id}}')">

      <div class="col-auto">
        <div class="event-date-box bg-secondary-subtle">
          <span class="event-date-month text-muted">{{this.month}}</span>
          <span class="event-date-day text-muted">{{this.day}}</span>
        </div>
      </div>

      <div class="col overflow-hidden">
        <div class="fw-bold text-dark text-truncate small mb-1">
          {{this.title}}
        </div>

        <div class="text-muted small text-truncate">
          <i class="bi bi-geo-alt me-1"></i>{{this.location}}
        </div>
      </div>

      <div class="col-auto">
        <div class="d-flex align-items-center gap-1">
          <span class="badge bg-secondary rounded-pill">Ended</span>
        </div>
      </div>

      <div class="col-auto" onclick="event.stopPropagation()">
        <div class="d-flex gap-1">
          <button
            class="btn btn-sm btn-light border rounded-2 px-2 text-primary"
            type="button"
            title="Edit Event"
            onclick="openEditEventModal('{{this.id}}')">
            <i class="bi bi-pencil"></i>
          </button>

          <button
            class="btn btn-sm btn-light border rounded-2 px-2 text-danger"
            type="button"
            title="Delete Event"
            data-event-id="{{this.id}}"
            data-event-title="{{this.title}}"
            onclick="openDeleteEventModal(this.dataset.eventId, this.dataset.eventTitle)">
            <i class="bi bi-trash"></i>
          </button>
        </div>
      </div>
    </div>
    {{/each}}
    {{/if}}

    {{#unless hasEvents}}
    <div class="px-4 py-4 text-center text-muted small">
      No events yet. Use “Create Event” to add one.
    </div>
    {{/unless}}

  </div>
</div>


        </div>

      </div>

      <!-- REGISTERED MEMBERS PER EVENT -->
