<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Alumni Admin Portal</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Apply saved theme before paint (avoids flash) -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('adminTheme');
        if (t !== 'dark' && t !== 'light') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-bs-theme', t);
      } catch (e) {}
    })();
  </script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --font-main: 'Plus Jakarta Sans', sans-serif;
      --bg-body: #f8fafc;
      --sidebar-width: 270px;
      --sidebar-bg: #0b0f19;
      --sidebar-card: #151c2c;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --card-bg: #ffffff;
      --card-border: rgba(226, 232, 240, 0.8);
      --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
      --card-shadow-hover: 0 12px 28px -4px rgba(0, 0, 0, 0.08), 0 4px 12px -2px rgba(0, 0, 0, 0.04);
      --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-main);
      background-color: var(--bg-body);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    /* --- SIDEBAR STYLING --- */
    .sidebar {
      width: var(--sidebar-width);
      background: linear-gradient(180deg, #0b0f19 0%, #111827 100%);
      min-height: 100vh;
      color: #94a3b8;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1040;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-right: 1px solid rgba(255, 255, 255, 0.06);
      display: flex;
      flex-direction: column;
    }

    .sidebar .brand {
      padding: 24px 28px;
      font-size: 20px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .sidebar .brand-icon {
      width: 40px;
      height: 40px;
      background: var(--primary-gradient);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 20px;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    }

    .sidebar-menu {
      padding: 20px 16px;
      flex-grow: 1;
      overflow-y: auto;
    }

    .sidebar-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #475569;
      padding: 12px 14px 6px 14px;
    }

    .sidebar a {
      display: flex;
      align-items: center;
      gap: 14px;
      color: #94a3b8;
      text-decoration: none;
      padding: 12px 16px;
      font-size: 14px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 4px;
      transition: all 0.2s ease;
    }

    .sidebar a i {
      font-size: 18px;
      transition: transform 0.2s ease;
    }

    .sidebar a:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.05);
    }

    .sidebar a:hover i {
      transform: translateX(2px);
    }

    .sidebar a.active {
      background: var(--primary-gradient);
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
    }

    .sidebar-user-card {
      margin: 16px;
      padding: 14px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* --- MAIN CONTENT AREA --- */
    .main {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .boxed {
      max-width: 1440px;
      margin: 0 auto;
    }

    /* --- NAVBAR STYLING --- */
    .navbar {
      background: #ffffff;
      border-bottom: 1px solid var(--card-border);
      padding: 14px 28px;
      position: sticky;
      top: 0;
      z-index: 1020;
      backdrop-filter: blur(8px);
    }

    .search-box {
      position: relative;
      max-width: 420px;
      width: 100%;
    }

    .search-box i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 16px;
    }

    .search-box input {
      padding-left: 42px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #f8fafc;
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .search-box input:focus {
      background: #ffffff;
      border-color: #6366f1;
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .nav-icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #475569;
      position: relative;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .nav-icon-btn:hover {
      background: #f1f5f9;
      color: #1e293b;
    }

    .nav-icon-btn .badge-dot {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 8px;
      height: 8px;
      background: #ef4444;
      border-radius: 50%;
      border: 2px solid #ffffff;
    }

    .user-profile-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 12px 6px 6px;
      border: 1px solid #e2e8f0;
      border-radius: 30px;
      background: #ffffff;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .user-profile-btn:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
    }

    /* --- CARDS & DASHBOARD WIDGETS --- */
    .card {
      border: 1px solid var(--card-border);
      border-radius: 16px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      transition: all 0.25s ease;

    }

    .card-header {
      background: transparent;
      border-bottom: 1px solid var(--card-border);
      padding: 20px 24px;
      font-weight: 700;
      font-size: 16px;
      color: #0f172a;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* --- STAT CARDS --- */
    .stat-card {
      position: relative;
      overflow: hidden;
      padding: 20px;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--card-shadow-hover);
    }

    .stat-icon-wrapper {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
    }

    .stat-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }

    .stat-value {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
      margin: 0;
    }

    .stat-trend {
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border-radius: 20px;
      margin-top: 8px;
    }

    .trend-up {
      background: #ecfdf5;
      color: #10b981;
    }

    /* STAT CARD GRADIENTS */
    .stat-indigo .stat-icon-wrapper { background: rgba(99, 102, 241, 0.12); color: #6366f1; }
    .stat-emerald .stat-icon-wrapper { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .stat-purple .stat-icon-wrapper { background: rgba(139, 92, 246, 0.12); color: #8b5cf6; }
    .stat-amber .stat-icon-wrapper { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .stat-rose .stat-icon-wrapper { background: rgba(244, 63, 94, 0.12); color: #f43f5e; }
    .stat-cyan .stat-icon-wrapper { background: rgba(6, 182, 212, 0.12); color: #06b6d4; }
    .stat-violet .stat-icon-wrapper { background: rgba(168, 85, 247, 0.12); color: #a855f7; }

    /* --- TABLE STYLING --- */
    .table-responsive {
      border-radius: 0 0 16px 16px;
    }

    .custom-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    .custom-table th {
      background: #f8fafc;
      color: #475569;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 14px 24px;
      border-bottom: 1px solid var(--card-border);
    }

    .custom-table td {
      padding: 16px 24px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 14px;
      color: #334155;
      vertical-align: middle;
    }

    .custom-table tbody tr {
      transition: background-color 0.15s ease;
    }

    .custom-table tbody tr:hover {
      background-color: #f8fafc;
    }

    .member-avatar-wrapper {
      position: relative;
      display: inline-block;
    }

    .member-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    .member-avatar-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      background: #eef2ff;
      color: #4f46e5;
      font-size: 22px;
    }

    .status-dot {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      border: 2px solid #ffffff;
    }

    .dot-active { background: #10b981; }
    .dot-verified { background: #3b82f6; }
    .dot-pending { background: #f59e0b; }

    /* BADGES */
    .badge-status {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge-active { background: #dcfce7; color: #15803d; }
    .badge-verified { background: #dbeafe; color: #1e40af; }
    .badge-pending { background: #fef3c7; color: #b45309; }

    .batch-tag {
      background: #f1f5f9;
      color: #475569;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 12px;
    }

    /* --- EVENTS LIST --- */
    .event-item {
      padding: 16px 20px;
      border-bottom: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
      gap: 16px;
      transition: background 0.15s ease;
    }

    .event-item:last-child {
      border-bottom: none;
    }

    .event-item:hover {
      background: #f8fafc;
    }

    .event-date-box {
      width: 50px;
      height: 52px;
      background: #f1f5f9;
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      text-align: center;
    }

    .event-date-month {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      color: #6366f1;
    }

    .event-date-day {
      font-size: 18px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1;
    }

    /* --- QUICK ACTIONS --- */
    .quick-action-btn {
      width: 100%;
      padding: 12px 16px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      color: #334155;
      margin-bottom: 10px;
      transition: all 0.2s ease;
    }

    .quick-action-btn:last-child {
      margin-bottom: 0;
    }

    .quick-action-btn:hover {
      background: var(--primary-gradient);
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
      transform: translateX(4px);
    }

    .quick-action-btn i {
      font-size: 16px;
    }

    /* --- ACTIVITY FEED --- */
    .activity-feed {
      position: relative;
      padding-left: 20px;
    }

    .activity-feed::before {
      content: '';
      position: absolute;
      left: 17px;
      top: 15px;
      bottom: 15px;
      width: 2px;
      background: #e2e8f0;
    }

    .activity-item {
      position: relative;
      padding-bottom: 20px;
      display: flex;
      gap: 16px;
    }

    .activity-item:last-child {
      padding-bottom: 0;
    }

    .activity-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      z-index: 1;
      flex-shrink: 0;
      box-shadow: 0 0 0 4px #ffffff;
    }

    .bg-emerald-soft { background: #dcfce7; color: #10b981; }
    .bg-indigo-soft { background: #e0e7ff; color: #6366f1; }
    .bg-amber-soft { background: #fef3c7; color: #f59e0b; }
    .bg-purple-soft { background: #f3e8ff; color: #a855f7; }

    /* SIDEBAR CLOSE BUTTON + OVERLAY */
    .sidebar-close-btn {
      background: rgba(255, 255, 255, 0.06);
      border: none;
      color: #94a3b8;
      width: 30px;
      height: 30px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      transition: all .2s ease;
      flex-shrink: 0;
    }
    .sidebar-close-btn:hover { background: rgba(255, 255, 255, 0.14); color: #fff; }

    .sidebar { transition: transform .25s ease; }
    .main { transition: margin-left .25s ease; }

    .sidebar.collapsed { transform: translateX(-100%); }
    body.sidebar-collapsed .main { margin-left: 0; }

    .sidebar-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
      z-index: 1035;
      opacity: 0;
      visibility: hidden;
      transition: opacity .2s ease;
    }
    .sidebar-overlay.show { opacity: 1; visibility: visible; }
    @media (min-width: 993px) {
      .sidebar-overlay { display: none; }
    }

    /* RESPONSIVE TOGGLES */

    @media (max-width: 992px) {
      .sidebar {
        transform: translateX(-100%);
      }
      .sidebar.show {
        transform: translateX(0);
      }
      .main {
        margin-left: 0;
      }
    }

    /* --- DARK MODE THEME --- */
    [data-bs-theme="dark"] {
      --bg-body: #0b0f19;
      --text-main: #e2e8f0;
      --text-muted: #94a3b8;
      --card-bg: #151c2c;
      --card-border: rgba(148, 163, 184, 0.16);
      --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.5), 0 2px 6px -1px rgba(0, 0, 0, 0.3);
      --card-shadow-hover: 0 12px 28px -4px rgba(0, 0, 0, 0.6), 0 4px 12px -2px rgba(0, 0, 0, 0.4);
      color-scheme: dark;
    }

    [data-bs-theme="dark"] body { background-color: var(--bg-body); color: var(--text-main); }
    [data-bs-theme="dark"] .navbar { background: #111827; border-bottom-color: var(--card-border); }
    [data-bs-theme="dark"] .search-box input { background: #0f172a; border-color: var(--card-border); color: #e2e8f0; }
    [data-bs-theme="dark"] .search-box input::placeholder { color: #64748b; }
    [data-bs-theme="dark"] .search-box input:focus { background: #0b1220; border-color: #6366f1; }
    [data-bs-theme="dark"] .nav-icon-btn { background: #1e293b; border-color: var(--card-border); color: #cbd5e1; }
    [data-bs-theme="dark"] .nav-icon-btn:hover { background: #263449; color: #ffffff; }
    [data-bs-theme="dark"] .user-profile-btn { background: #1e293b; border-color: var(--card-border); }
    [data-bs-theme="dark"] .user-profile-btn div[style*="color: #0f172a"] { color: #e2e8f0 !important; }
    [data-bs-theme="dark"] .card-header,
    [data-bs-theme="dark"] .stat-value,
    [data-bs-theme="dark"] .fw-800,
    [data-bs-theme="dark"] h1, [data-bs-theme="dark"] h2, [data-bs-theme="dark"] h3,
    [data-bs-theme="dark"] h4, [data-bs-theme="dark"] h5, [data-bs-theme="dark"] h6 { color: #f1f5f9; }
    [data-bs-theme="dark"] .text-slate-900,
    [data-bs-theme="dark"] .text-dark { color: #e2e8f0 !important; }
    [data-bs-theme="dark"] .bg-white { background-color: #151c2c !important; }
    [data-bs-theme="dark"] .modal-content,
    [data-bs-theme="dark"] .dropdown-menu { background-color: #151c2c; color: var(--text-main); }
    [data-bs-theme="dark"] .modal-header,
    [data-bs-theme="dark"] .modal-footer { border-color: var(--card-border); }
    [data-bs-theme="dark"] .form-control,
    [data-bs-theme="dark"] .form-select { background-color: #0f172a; border-color: var(--card-border); color: #e2e8f0; }
    [data-bs-theme="dark"] .form-control::placeholder { color: #64748b; }
    [data-bs-theme="dark"] .table { --bs-table-color: #e2e8f0; --bs-table-bg: transparent; }
    [data-bs-theme="dark"] .btn-light { background-color: #1e293b; border-color: var(--card-border); color: #e2e8f0; }
    [data-bs-theme="dark"] .btn-outline-secondary { color: #cbd5e1; border-color: var(--card-border); }
    [data-bs-theme="dark"] .list-group-item { background-color: transparent; color: var(--text-main); border-color: var(--card-border); }

  </style>
</head>
<body>

  <!-- SIDEBAR NAVIGATION -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-icon">
        <i class="bi bi-mortarboard-fill"></i>
      </div>
      <div>
        <span>Alumni</span><span style="color: #6366f1;">Space</span>
        <div style="font-size: 10px; font-weight: 500; color: #64748b; margin-top: -2px;">MANAGEMENT SYSTEM</div>
      </div>
      <button type="button" class="sidebar-close-btn ms-auto" id="sidebarCloseBtn" aria-label="Close navigation">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>


    <div class="sidebar-menu">
      <div class="sidebar-section-title">Main Menu</div>
      <a class="active" href="#"><i class="bi bi-grid-1x2-fill me-2"></i>Dashboard</a>
      <a href="#members-section"><i class="bi bi-people-fill me-2"></i>Members</a>
      <a href="#batches-section"><i class="bi bi-collection-fill me-2"></i>Batches</a>
      <a href="#leaders-section"><i class="bi bi-person-badge-fill me-2"></i>Leaders</a>
      
      <div class="sidebar-section-title mt-3">Events & Content</div>
      <a href="#events-section"><i class="bi bi-calendar2-event-fill me-2"></i>Events</a>
      <a href="#announcements-section"><i class="bi bi-megaphone-fill me-2"></i>Announcements</a>
      <a href="#gallery-section"><i class="bi bi-images me-2"></i>Gallery</a>

      <div class="sidebar-section-title mt-3">Administration</div>
      <a href="#reports-section"><i class="bi bi-bar-chart-line-fill me-2"></i>Reports</a>
      <a href="#settings-section"><i class="bi bi-gear-fill me-2"></i>Settings</a>
    </div>

    <div class="sidebar-user-card">
      <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&auto=format&fit=crop&q=80" class="rounded-circle" width="38" height="38" alt="Admin">
      <div class="overflow-hidden">
        <div style="font-size: 13px; font-weight: 700; color: #fff;" class="text-truncate">{{adminName}}</div>
        <div style="font-size: 11px; color: #64748b;" class="text-truncate">admin@alumni.org</div>
      </div>
    </div>
  </aside>

  <!-- SIDEBAR OVERLAY (mobile) -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>


  <!-- MAIN WRAPPER -->
  <div class="main">
    
    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg">
      <div class="container-fluid boxed px-0">
        
        <div class="d-flex align-items-center gap-3 w-100">
          <!-- Mobile Sidebar Toggle -->
          <button class="btn btn-light" id="sidebarToggleBtn" aria-label="Toggle navigation">

            <i class="bi bi-list fs-4"></i>
          </button>

          <!-- Search Box -->
          <div class="search-box me-auto">
            <i class="bi bi-search"></i>
            <input type="text" id="memberSearchInput" class="form-control" placeholder="Search members by name, batch or email...">
          </div>

          <!-- Right Action Items -->
          <div class="d-flex align-items-center gap-3">
            
            <!-- Dark Mode Toggle -->
            <button type="button" class="nav-icon-btn border-0 p-0" id="themeToggleBtn" aria-label="Toggle dark mode" title="Toggle dark mode">
              <i class="bi bi-moon-stars fs-5" id="themeToggleIcon"></i>
            </button>

            <!-- User Profile Dropdown -->
            <div class="dropdown">
              <div class="user-profile-btn" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&auto=format&fit=crop&q=80" class="user-avatar" alt="User">
                <div class="d-none d-sm-block text-start me-1">
                  <div style="font-size: 13px; font-weight: 700; color: #0f172a;">{{adminName}}</div>
                  <div style="font-size: 10px; font-weight: 600; color: #6366f1;">SUPERADMIN</div>
                </div>
                <i class="bi bi-chevron-down small text-muted"></i>
              </div>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="width: 200px;">
                <li><a class="dropdown-item rounded-3" href="#"><i class="bi bi-person me-2"></i>My Profile</a></li>
                <li><a class="dropdown-item rounded-3" href="#"><i class="bi bi-shield-lock me-2"></i>Change Password</a></li>
                <li><a class="dropdown-item rounded-3" href="#"><i class="bi bi-sliders me-2"></i>Account Settings</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item rounded-3 text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
              </ul>
            </div>

          </div>
        </div>

      </div>
    </nav>

    <!-- CONTENT BODY -->
    <div class="container-fluid boxed px-4 py-4">

      <!-- WELCOME BANNER -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
          <h3 class="fw-800 text-slate-900 m-0" style="font-weight: 800; letter-spacing: -0.5px;">Dashboard Overview</h3>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-secondary btn-sm rounded-3 fw-semibold bg-white shadow-sm" onclick="window.location.reload();">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
          </button>
          <button class="btn btn-primary btn-sm rounded-3 fw-semibold shadow-sm" style="background: var(--primary-gradient); border: none;" data-bs-toggle="modal" data-bs-target="#addAlumniModal">
            <i class="bi bi-plus-lg me-1"></i> Add member
          </button>
        </div>
      </div>

      <!-- 7 STAT CARDS GRID -->
      <div class="row g-3 mb-4">
        
        <!-- Stat 1: Total Alumni -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-indigo h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Total Alumni</div>
                <h3 class="stat-value">{{stats.totalAlumni}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-graph-up-arrow"></i> {{stats.alumniGrowth}}</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-people-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 2: Total Batches -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-emerald h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Total Batches</div>
                <h3 class="stat-value">{{stats.totalBatches}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-check-circle-fill"></i> Active</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-collection-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 3: Batch Leaders -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-purple h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Batch Leaders</div>
                <h3 class="stat-value">{{stats.batchLeaders}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-shield-check"></i> Assigned</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-person-badge-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 4: Upcoming Events -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-amber h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Upcoming Events</div>
                <h3 class="stat-value">{{stats.upcomingEvents}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-calendar-check"></i> Scheduled</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-calendar-event-fill"></i>
              </div>
            </div>
          </div>
        </div>



      </div>

      <!-- CHARTS SECTION -->
      <div class="row g-4 mb-4">

        <!-- Members per Batch Bar Chart -->
        <div class="col-12">
          <div class="card h-100">
            <div class="card-header">
              <span><i class="bi bi-bar-chart-fill text-indigo me-2"></i>Members per Batch</span>
              <span class="badge bg-light text-dark">{{stats.totalBatches}} Batches</span>
            </div>
            <div class="card-body">
              <div style="height: 320px; position: relative;">
                <canvas id="barChart"></canvas>
                <div id="barChartEmpty" class="d-none h-100 d-flex align-items-center justify-content-center text-muted small">
                  No batches created yet. Use "Create New Batch" to add one.
                </div>

              </div>
            </div>
          </div>
        </div>

      </div>


      <!-- BATCH LEADERS TABLE -->
      <div class="row g-4 mb-4" id="batch-leaders-section">
        <div class="col-12">
          <div class="card">
            <div class="card-header">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge-fill text-indigo"></i>
                <span>Batch Leaders</span>
                <span class="badge bg-indigo-soft text-indigo rounded-pill ms-1" style="font-size:11px;" id="batchLeaderCountBadge">{{batchLeadersList.length}}</span>
              </div>
            </div>

            <div class="table-responsive">
              <table class="custom-table" id="batchLeadersTable">
                <thead>
                  <tr>
                    <th>Leader Profile</th>
                    <th>Batch Year</th>
                    <th>Assigned Date</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody id="batchLeadersTableBody">
                  {{#each batchLeadersList}}
                  <tr data-year="{{this.year}}" data-name="{{this.memberName}}">
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <div class="member-avatar-wrapper">
                          <div class="member-avatar-icon">
                            <i class="bi bi-person-badge"></i>
                          </div>
                        </div>
                        <div>
                          <div class="fw-bold text-dark">{{this.memberName}}</div>
                          <div class="text-muted small">Batch Leader</div>
                        </div>
                      </div>
                    </td>
                    <td><span class="batch-tag">{{this.year}}</span></td>
                    <td class="text-muted small fw-medium">{{this.assignedAt}}</td>
                    <td class="text-end">
                      <button class="btn btn-sm btn-light border rounded-2 px-2" title="View Profile">
                        <i class="bi bi-eye"></i>
                      </button>
                      <button class="btn btn-sm btn-light border rounded-2 px-2 text-primary" title="Edit">
                        <i class="bi bi-pencil"></i>
                      </button>
                    </td>
                  </tr>
                  {{/each}}
                  {{#unless batchLeadersList}}
                  <tr id="batchLeadersEmptyRow">
                    <td colspan="4" class="text-center text-muted py-4">No batch leaders assigned yet.</td>
                  </tr>
                  {{/unless}}
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>


      <!-- TABLES & SIDE PANELS -->
      <div class="row g-4 mb-4" id="members-section">
        
        <!-- All Members Table -->
        <div class="col-lg-8">
          <div class="card">
            <div class="card-header">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i>
                <span>All Registered Members</span>
                <span id="memberCountBadge" class="badge bg-primary-subtle text-primary rounded-pill ms-1" style="font-size:11px;"></span>
              </div>
              <div class="d-flex align-items-center gap-2">
                <select id="batchFilterSelect" class="form-select form-select-sm rounded-3" style="width:auto;font-size:13px;">
                  <option value="">All Batches</option>
                  {{#each batchYears}}
                  <option value="{{this}}">Batch {{this}}</option>
                  {{/each}}
                </select>
                <button class="btn btn-sm btn-link text-primary text-decoration-none fw-bold p-0 text-nowrap" data-bs-toggle="modal" data-bs-target="#addAlumniModal">
                  + Add Member
                </button>
              </div>
            </div>

            <div class="table-responsive">
              <table class="custom-table" id="membersTable">
                <thead>
                  <tr>
                    <th>Member Profile</th>
                    <th>Batch</th>
                    <th>Joined Date</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody id="membersTableBody">
                  {{#each allMembers}}
                  <tr data-batch="{{this.batch}}" data-name="{{this.name}}" data-email="{{this.email}}">
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <div class="member-avatar-wrapper">
                          <div class="member-avatar-icon">
                            <i class="bi bi-person-circle"></i>
                          </div>
                        </div>
                        <div>
                          <div class="fw-bold text-dark">{{this.name}}</div>
                          <div class="text-muted small">{{this.email}}</div>
                        </div>
                      </div>
                    </td>
                    <td><span class="batch-tag">{{this.batch}}</span></td>
                    <td class="text-muted small fw-medium">{{this.joinedDate}}</td>
                    <td class="text-end">
                      <button class="btn btn-sm btn-light border rounded-2 px-2" title="View Profile">
                        <i class="bi bi-eye"></i>
                      </button>
                      <button class="btn btn-sm btn-light border rounded-2 px-2 text-primary" title="Edit Member">
                        <i class="bi bi-pencil"></i>
                      </button>
                    </td>
                  </tr>
                  {{/each}}
                  {{#unless allMembers}}
                  <tr id="membersEmptyRow">
                    <td colspan="4" class="text-center text-muted py-4">No members registered yet.</td>
                  </tr>
                  {{/unless}}
                </tbody>
              </table>
            </div>

            <!-- Pagination bar -->
            <div class="d-flex align-items-center justify-content-between px-4 py-3 border-top" id="membersPaginationBar">
              <div class="text-muted small" id="membersPageInfo"></div>
              <div class="d-flex align-items-center gap-2">
                <button id="membersPrevBtn" class="btn btn-sm btn-outline-secondary rounded-3" disabled>
                  <i class="bi bi-chevron-left"></i> Prev
                </button>
                <div id="membersPageDots" class="d-flex gap-1"></div>
                <button id="membersNextBtn" class="btn btn-sm btn-outline-secondary rounded-3">
                  Next <i class="bi bi-chevron-right"></i>
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- Right Side Widgets -->
        <div class="col-lg-4">
          
          <!-- Upcoming Events -->
          <div class="card mb-4" id="events-section">
            <div class="card-header">
              <span><i class="bi bi-calendar-event text-amber me-2"></i>Upcoming Events</span>
              <button class="btn btn-sm btn-light text-muted p-0" data-bs-toggle="modal" data-bs-target="#createEventModal">
                <i class="bi bi-plus-circle"></i>
              </button>
            </div>
            <div>
              {{#each upcomingEvents}}
              <div class="event-item" data-event-id="{{this.id}}" style="cursor:pointer;"
                   onclick="openEventDetail('{{this.id}}')">
                <div class="event-date-box">
                  <span class="event-date-month">{{this.month}}</span>
                  <span class="event-date-day">{{this.day}}</span>
                </div>
                <div class="overflow-hidden">
                  <div class="fw-bold text-dark text-truncate small mb-1">{{this.title}}</div>
                  <div class="text-muted" style="font-size: 11px;"><i class="bi bi-geo-alt me-1"></i>{{this.location}}</div>
                </div>
                <span class="badge {{this.badgeColor}} ms-auto rounded-pill" style="font-size: 10px;">{{this.category}}</span>
              </div>
              {{/each}}
              {{#unless upcomingEvents}}
              <div class="px-4 py-3 text-muted small text-center">No events yet. Use "Create Event" to add one.</div>
              {{/unless}}
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="card">
            <div class="card-header">
              <span><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Quick Actions</span>
            </div>
            <div class="card-body">
              <button class="quick-action-btn" data-bs-toggle="modal" data-bs-target="#addAlumniModal">
                <span><i class="bi bi-person-plus me-2 text-primary"></i>Add Alumni Member</span>
                <i class="bi bi-chevron-right"></i>
              </button>
              <button class="quick-action-btn" data-bs-toggle="modal" data-bs-target="#createBatchModal">
                <span><i class="bi bi-folder-plus me-2 text-emerald"></i>Create New Batch</span>
                <i class="bi bi-chevron-right"></i>
              </button>
              <button class="quick-action-btn" data-bs-toggle="modal" data-bs-target="#assignLeaderModal">
                <span><i class="bi bi-person-badge me-2 text-purple"></i>Assign Batch Leader</span>
                <i class="bi bi-chevron-right"></i>
              </button>
              <button class="quick-action-btn" data-bs-toggle="modal" data-bs-target="#createEventModal">
                <span><i class="bi bi-calendar-plus me-2 text-amber"></i>Create Event</span>
                <i class="bi bi-chevron-right"></i>
              </button>
            </div>
          </div>

        </div>

      </div>

      <!-- RECENT ACTIVITY FEED -->
      <div class="card">
        <div class="card-header">
          <span><i class="bi bi-clock-history text-secondary me-2"></i>Recent Network Activity</span>
          <button class="btn btn-sm btn-link text-muted text-decoration-none">View Full Audit Log</button>
        </div>
        <div class="card-body">
          <div class="activity-feed">
            {{#each recentActivities}}
            <div class="activity-item">
              <div class="activity-icon {{this.iconBg}}">
                <i class="bi {{this.icon}}"></i>
              </div>
              <div>
                <div class="d-flex align-items-center gap-2">
                  <span class="fw-bold text-dark fs-6">{{this.title}}</span>
                  <span class="text-muted small" style="font-size: 11px;">• {{this.time}}</span>
                </div>
                <p class="text-muted small mb-0 mt-1">{{this.desc}}</p>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ==================== MODALS FOR QUICK ACTIONS ==================== -->

  <!-- Modal 1: Add Alumni -->
  <div class="modal fade" id="addAlumniModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="modal-fw-bold"><i class="bi bi-person-plus text-primary me-2"></i>Add New Alumni Member</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <form id="addAlumniForm">
            <div class="mb-3">
              <label class="form-label small fw-bold">Admission Number</label>
              <input type="text" name="admissionNumber" class="form-control rounded-3" placeholder="e.g. HA2021045" required>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Name</label>
              <input type="text" name="name" class="form-control rounded-3" placeholder="e.g. Tariq Mahmood" required>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Place</label>
              <input type="text" name="place" class="form-control rounded-3" placeholder="e.g. Kozhikode" required>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Batch</label>
              <select class="form-select rounded-3" name="batch" id="addAlumniBatchSelect" required>
                <option value="">Loading batches...</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Email</label>
              <input type="email" name="email" class="form-control rounded-3" placeholder="tariq@example.com" required>
            </div>

            <div id="addAlumniAlert" class="alert d-none rounded-3 py-2 px-3 small mb-0 mt-3" role="alert"></div>

            <div class="d-flex justify-content-end gap-2 mt-4">
              <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" id="addAlumniSubmit" class="btn btn-primary rounded-3 px-4" style="background: var(--primary-gradient); border:none;">Save Member</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal 2: Create Batch -->
  <div class="modal fade" id="createBatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="modal-fw-bold"><i class="bi bi-folder-plus text-emerald me-2"></i>Create New Batch</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <form id="createBatchForm">
            <div class="mb-3">
              <label class="form-label small fw-bold">Batch Year</label>
              <input type="number" name="year" id="createBatchYear" class="form-control rounded-3" placeholder="2027" min="1900" max="2999" required>
              <div id="createBatchPreview" class="form-text small text-muted mt-1">Enter a year to see how many members will be linked.</div>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Description / Title</label>
              <input type="text" name="description" class="form-control rounded-3" placeholder="e.g. Class of 2027 Engineering">
            </div>

            <div id="createBatchAlert" class="alert d-none rounded-3 py-2 px-3 small mb-0 mt-3" role="alert"></div>

            <div class="d-flex justify-content-end gap-2 mt-4">
              <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" id="createBatchSubmit" class="btn btn-success rounded-3 px-4">Create Batch</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal 3: Assign Leader -->
  <div class="modal fade" id="assignLeaderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="modal-fw-bold"><i class="bi bi-person-badge text-purple me-2"></i>Assign Batch Leader</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <form id="assignLeaderForm">
            <div class="mb-3">
              <label class="form-label small fw-bold">Select Batch</label>
              <select class="form-select rounded-3" name="year" id="leaderBatchSelect" required>
                <option value="">Loading batches...</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Assign Member</label>
              <select class="form-select rounded-3" name="memberId" id="leaderMemberSelect" required disabled>
                <option value="">Select a batch first</option>
              </select>
              <div class="form-text small" id="leaderMemberHint">Members of the selected batch will appear here.</div>
            </div>
            <div id="assignLeaderAlert" class="alert d-none rounded-3 py-2 px-3 small mb-0 mt-3"></div>
            <div class="d-flex justify-content-end gap-2 mt-4">
              <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" id="assignLeaderSubmit" class="btn btn-purple rounded-3 px-4 text-white" style="background:#8b5cf6;">Assign Leader</button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </div>

  <!-- Modal 4: Create Event -->
  <div class="modal fade" id="createEventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="modal-fw-bold"><i class="bi bi-calendar-plus text-amber me-2"></i>Create New Event</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <form id="createEventForm" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label small fw-bold">Event Title</label>
              <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Alumni Homecoming Gala" required>
            </div>
            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label small fw-bold">Date</label>
                <input type="date" name="date" class="form-control rounded-3" required>
              </div>
              <div class="col-6">
                <label class="form-label small fw-bold">Category</label>
                <select class="form-select rounded-3" name="category">
                  <option>Reunion</option>
                  <option>Official</option>
                  <option>Seminar</option>
                  <option>Networking</option>
                </select>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Location</label>
              <input type="text" name="location" class="form-control rounded-3" placeholder="e.g. Grand Ballroom / Zoom Link">
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Description</label>
              <textarea name="description" class="form-control rounded-3" rows="2" placeholder="Brief description of the event (optional)"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Event Image <span class="text-muted fw-normal">(optional, max 5 MB)</span></label>
              <input type="file" name="eventImage" id="eventImageInput" class="form-control rounded-3" accept="image/*">
              <div id="eventImagePreviewWrapper" class="mt-2 d-none">
                <img id="eventImagePreview" src="" alt="Preview" class="rounded-3 border" style="max-height:140px;max-width:100%;object-fit:cover;">
              </div>
            </div>
            <div id="createEventAlert" class="alert d-none rounded-3 py-2 px-3 small mb-0 mt-3" role="alert"></div>
            <div class="d-flex justify-content-end gap-2 mt-4">
              <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" id="createEventSubmit" class="btn btn-warning rounded-3 px-4 text-dark">Publish Event</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal 5: Event Detail (view image + info on click) -->
  <div class="modal fade" id="eventDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
