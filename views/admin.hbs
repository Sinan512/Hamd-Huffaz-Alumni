  <!-- SCRIPTS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // --- SIDEBAR TOGGLE FOR MOBILE ---
    const sidebar = document.getElementById('sidebar');
    const sidebarToggleBtn = document.getElementById('sidebarToggleBtn');

    if (sidebarToggleBtn) {
      sidebarToggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('show');
      });
    }

    // --- CLIENT-SIDE TABLE SEARCH ---
    const searchInput = document.getElementById('memberSearchInput');
    const tableBody = document.querySelector('#membersTable tbody');

    if (searchInput && tableBody) {
      searchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        const rows = tableBody.querySelectorAll('tr');

        rows.forEach(row => {
          const text = row.innerText.toLowerCase();
          if (text.includes(query)) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      });
    }

    // --- CHART.JS INITIALIZATION WITH PREMIUM GRADIENTS ---
    document.addEventListener('DOMContentLoaded', () => {
      
      // 1. Line Chart: Registrations
      const lineCtx = document.getElementById('lineChart').getContext('2d');
      const gradientLine = lineCtx.createLinearGradient(0, 0, 0, 300);
      gradientLine.addColorStop(0, 'rgba(99, 102, 241, 0.35)');
      gradientLine.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

      new Chart(lineCtx, {
        type: 'line',
        data: {
          labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'],
          datasets: [{
            label: 'Alumni Registrations',
            data: [42, 65, 58, 94, 88, 120, 145, 180],
            borderColor: '#6366f1',
            borderWidth: 3,
            backgroundColor: gradientLine,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#4f46e5',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 2,
            pointRadius: 5,
            pointHoverRadius: 7
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 12 } }
            },
            y: {
              grid: { color: '#f1f5f9' },
              ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 12 } }
            }
          }
        }
      });

      // 2. Bar Chart: Members per Batch
      const barCtx = document.getElementById('barChart').getContext('2d');
      const gradientBar = barCtx.createLinearGradient(0, 0, 0, 300);
      gradientBar.addColorStop(0, '#8b5cf6');
      gradientBar.addColorStop(1, '#6366f1');

      new Chart(barCtx, {
        type: 'bar',
        data: {
          labels: ['2021', '2022', '2023', '2024', '2025'],
          datasets: [{
            label: 'Members',
            data: [320, 280, 410, 240, 195],
            backgroundColor: gradientBar,
            borderRadius: 8,
            barThickness: 28
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 12 } }
            },
            y: {
              grid: { color: '#f1f5f9' },
              ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 12 } }
            }
          }
        }
      });

    });
  </script>


  <script>
    (function () {
      var form = document.getElementById('addAlumniForm');
      if (!form) return;
      var alertBox = document.getElementById('addAlumniAlert');
      var submitBtn = document.getElementById('addAlumniSubmit');

      function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = message;
      }

      function hideAlert() {
        alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = '';
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        hideAlert();

        var data = Object.fromEntries(new FormData(form).entries());
        submitBtn.disabled = true;
        var originalText = submitBtn.textContent;
        submitBtn.textContent = 'Saving...';

        try {
          var res = await fetch('/admin/members', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          var result = await res.json().catch(function () { return {}; });

          if (res.ok) {
            showAlert('success', result.message || 'Member added successfully.');
            form.reset();
            setTimeout(function () {
              hideAlert();
              var modalEl = document.getElementById('addAlumniModal');
              var modal = bootstrap.Modal.getInstance(modalEl);
              if (modal) modal.hide();
            }, 1500);
          } else {
            showAlert('danger', result.message || 'Could not save, please try again.');
          }
        } catch (err) {
          showAlert('danger', 'Could not save, please try again.');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
    })();
  </script>
</body>
</html>
