  <!-- ===== EDIT EVENT ===== -->
  <script>
    function openEditEventModal(eventId) {
      var modalEl = document.getElementById('editEventModal');
      var modal   = bootstrap.Modal.getOrCreateInstance(modalEl);
      var spinner = document.getElementById('editEventLoadingSpinner');
      var form    = document.getElementById('editEventForm');

      spinner.classList.remove('d-none');
      form.classList.add('d-none');
      document.getElementById('editEventAlert').className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3';
      modal.show();

      fetch('/admin/events/' + eventId)
        .then(function (r) { return r.json(); })
        .then(function (result) {
          if (!result.success) throw new Error(result.message || 'Could not load event.');

          document.getElementById('editEventId').value = eventId;

          /* Populate fields */
          document.getElementById('editEventTitle').value       = result.title       || '';
          document.getElementById('editEventLocation').value    = result.location    || '';
          document.getElementById('editEventDescription').value = result.description || '';

          /* Date: convert "DD MON YYYY" back to YYYY-MM-DD for input[type=date] */
          if (result.year && result.month && result.day) {
            var MONTHS = { JAN:'01',FEB:'02',MAR:'03',APR:'04',MAY:'05',JUN:'06',
                           JUL:'07',AUG:'08',SEP:'09',OCT:'10',NOV:'11',DEC:'12' };
            var mm = MONTHS[result.month] || '01';
            document.getElementById('editEventDate').value = result.year + '-' + mm + '-' + result.day;
          }

          /* Category */
          var catSelect = document.getElementById('editEventCategory');
          for (var i = 0; i < catSelect.options.length; i++) {
            if (catSelect.options[i].value === result.category) {
              catSelect.selectedIndex = i;
              break;
            }
          }

          /* Use Registration switch */
          document.getElementById('editEventRegistration').checked = !!result.registration;

          /* Reset image preview */
          document.getElementById('editEventImagePreviewWrapper').classList.add('d-none');
          document.getElementById('editEventImagePreview').src = '';
          document.getElementById('editEventImageInput').value = '';

          spinner.classList.add('d-none');
          form.classList.remove('d-none');
        })
        .catch(function (err) {
          spinner.classList.add('d-none');
          var alertEl = document.getElementById('editEventAlert');
          alertEl.className = 'alert alert-danger rounded-3 py-2 px-3 small mt-3';
          alertEl.textContent = err.message || 'Could not load event details.';
          form.classList.remove('d-none');
        });
    }

    (function () {
      /* Image preview for edit form */
      var imgInput = document.getElementById('editEventImageInput');
      if (imgInput) {
        imgInput.addEventListener('change', function () {
          var file = imgInput.files[0];
          var wrapper = document.getElementById('editEventImagePreviewWrapper');
          var preview = document.getElementById('editEventImagePreview');
          if (file && file.type.startsWith('image/')) {
            var reader = new FileReader();
            reader.onload = function (e) { preview.src = e.target.result; wrapper.classList.remove('d-none'); };
            reader.readAsDataURL(file);
          } else {
            wrapper.classList.add('d-none');
            preview.src = '';
          }
        });
      }

      /* Submit */
      var form = document.getElementById('editEventForm');
      if (!form) return;
      var alertEl   = document.getElementById('editEventAlert');
      var submitBtn = document.getElementById('editEventSubmit');

      function showAlert(type, msg) {
        alertEl.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertEl.textContent = msg;
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var id = document.getElementById('editEventId').value;
        if (!id) return;

        var formData = new FormData(form);
        submitBtn.disabled = true;
        var orig = submitBtn.textContent;
        submitBtn.textContent = 'Saving…';

        try {
          var res    = await fetch('/admin/events/' + id, { method: 'PUT', body: formData });
          var result = await res.json().catch(function () { return {}; });

          if (res.ok) {
            showAlert('success', result.message || 'Event updated.');
            setTimeout(function () {
              var modal = bootstrap.Modal.getInstance(document.getElementById('editEventModal'));
              if (modal) modal.hide();
              window.location.reload();
            }, 1200);
          } else {
            showAlert('danger', result.message || 'Could not update the event.');
          }
        } catch (err) {
          showAlert('danger', 'Could not update the event. Please try again.');
        } finally {
          submitBtn.disabled    = false;
          submitBtn.textContent = orig;
        }
      });
    })();
  </script>

