  <!-- Add Alumni: CSV bulk import -->
  <script>
    (function () {
      var form = document.getElementById('importCsvForm');
      if (!form) return;

      var input      = document.getElementById('csvFileInput');
      var alertBox   = document.getElementById('importCsvAlert');
      var errorList  = document.getElementById('importCsvErrors');
      var submitBtn  = document.getElementById('importCsvSubmit');
      var previewWrap= document.getElementById('csvPreviewWrap');
      var previewHead= document.getElementById('csvPreviewHead');
      var previewBody= document.getElementById('csvPreviewBody');
      var previewCnt = document.getElementById('csvPreviewCount');
      var templateLink = document.getElementById('csvTemplateLink');

      function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = message;
      }
      function hideAlert() {
        alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = '';
        errorList.className = 'small text-muted mt-2 mb-0 ps-3 d-none';
        errorList.innerHTML = '';
      }
      function listErrors(errors) {
        if (!errors || !errors.length) return;
        errorList.innerHTML = '';
        errors.forEach(function (msg) {
          var li = document.createElement('li');
          li.textContent = msg;
          errorList.appendChild(li);
        });
        errorList.className = 'small text-muted mt-2 mb-0 ps-3';
      }

      /* Minimal CSV split for the on-screen preview only. */
      function detectDelimiter(text) {
        var firstLine = text.split('\n')[0] || '';
        var counts = { ',': 0, ';': 0, '\t': 0 };
        var q = false;
        for (var i = 0; i < firstLine.length; i++) {
          var c = firstLine[i];
          if (c === '"') { q = !q; continue; }
          if (!q && counts[c] !== undefined) counts[c]++;
        }
        var best = ',';
        Object.keys(counts).forEach(function (d) { if (counts[d] > counts[best]) best = d; });
        return counts[best] > 0 ? best : ',';
      }

      function splitCsv(text) {
        var rows = [], row = [], field = '', inQuotes = false;
        text = text.replace(/^\uFEFF/, '').replace(/\r\n?/g, '\n');
        var delimiter = detectDelimiter(text);
        for (var i = 0; i < text.length; i++) {
          var ch = text[i];
          if (inQuotes) {
            if (ch === '"') { if (text[i + 1] === '"') { field += '"'; i++; } else { inQuotes = false; } }
            else { field += ch; }
          } else if (ch === '"') { inQuotes = true; }
          else if (ch === delimiter) { row.push(field); field = ''; }
          else if (ch === '\n') { row.push(field); field = ''; rows.push(row); row = []; }
          else { field += ch; }
        }
        row.push(field); rows.push(row);
        return rows.filter(function (r) { return r.some(function (c) { return String(c).trim() !== ''; }); });
      }

      function renderPreview(rows) {
        previewHead.innerHTML = '';
        previewBody.innerHTML = '';
        if (rows.length < 2) { previewWrap.classList.add('d-none'); return; }

        rows[0].forEach(function (cell) {
          var th = document.createElement('th');
          th.textContent = String(cell).trim();
          previewHead.appendChild(th);
        });
        rows.slice(1, 6).forEach(function (cells) {
          var tr = document.createElement('tr');
          rows[0].forEach(function (_, idx) {
            var td = document.createElement('td');
            td.textContent = String(cells[idx] === undefined ? '' : cells[idx]).trim();
            tr.appendChild(td);
          });
          previewBody.appendChild(tr);
        });

        var total = rows.length - 1;
        previewCnt.textContent = '(' + total + (total === 1 ? ' member' : ' members') +
                                 ' found' + (total > 5 ? ', showing first 5' : '') + ')';
        previewWrap.classList.remove('d-none');
      }

      input.addEventListener('change', function () {
        hideAlert();
        previewWrap.classList.add('d-none');
        var file = input.files && input.files[0];
        if (!file) return;
        if (file.size > 2 * 1024 * 1024) {
          showAlert('danger', 'The file is larger than 2 MB.');
          input.value = '';
          return;
        }
        var reader = new FileReader();
        reader.onload = function () {
          try { renderPreview(splitCsv(String(reader.result))); }
          catch (err) { previewWrap.classList.add('d-none'); }
        };
        reader.readAsText(file);
      });

      templateLink.addEventListener('click', function (e) {
        e.preventDefault();
        var csv = 'admissionNumber,name,place,batch,email\n' +
                  'HA2021045,Tariq Mahmood,Kozhikode,2021,tariq@example.com\n' +
                  'HA2021046,Ayisha Nasrin,Malappuram,2021,ayisha@example.com\n';
        var url = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
        var a = document.createElement('a');
        a.href = url;
        a.download = 'members-template.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        hideAlert();

        var file = input.files && input.files[0];
        if (!file) { showAlert('danger', 'Please choose a CSV file.'); return; }

        var body = new FormData();
        body.append('csvFile', file);

        submitBtn.disabled = true;
        var originalText = submitBtn.textContent;
        submitBtn.textContent = 'Importing...';

        try {
          var res = await fetch('/admin/members/import', { method: 'POST', body: body });
          var raw = await res.text();
          var result = {};
          var parsed = true;
          try { result = raw ? JSON.parse(raw) : {}; }
          catch (parseErr) { parsed = false; }

          if (!parsed) {
            showAlert('danger', 'Import failed (' + res.status + '). The server did not return a valid response.');
            return;
          }

          if (res.ok && result.success) {
            showAlert('success', result.message || 'Members imported successfully.');
            listErrors(result.errors);
            form.reset();
            previewWrap.classList.add('d-none');
            setTimeout(function () { window.location.reload(); }, 1800);
          } else {
            showAlert('danger', result.message || 'Could not import the file, please try again.');
            listErrors(result.errors);
          }
        } catch (err) {
          showAlert('danger', 'Could not import the file: ' + ((err && err.message) || 'network error') + '.');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
    })();
  </script>

  <!-- Add Alumni: batch dropdown fed from the BATCH_DETAILS collection -->
  <script>
    (function () {
      var select = document.getElementById('addAlumniBatchSelect');
      var modalEl = document.getElementById('addAlumniModal');
      if (!select || !modalEl) return;

      var loaded = false;
      var loading = false;

      function setOptions(html) { select.innerHTML = html; }

      async function loadBatchYears(force) {
        if (loading || (loaded && !force)) return;
        loading = true;
        setOptions('<option value="">Loading batches...</option>');
        try {
          var res = await fetch('/admin/batches');
          var data = await res.json().catch(function () { return {}; });
          var years = Array.isArray(data.years) ? data.years : [];
          if (!years.length) {
            setOptions('<option value="">No batches found \u2014 create a batch first</option>');
            loaded = false;
            return;
          }
          setOptions('<option value="">Select a batch</option>' +
            years.map(function (y) {
              return '<option value="' + y + '">Batch ' + y + '</option>';
            }).join(''));
          loaded = true;
        } catch (err) {
          setOptions('<option value="">Could not load batches</option>');
          loaded = false;
        } finally {
          loading = false;
        }
      }

      modalEl.addEventListener('show.bs.modal', function () { loadBatchYears(false); });

      /* Refresh after a new batch is created so the new year shows up. */
      window.refreshAddAlumniBatchYears = function () { loadBatchYears(true); };

      loadBatchYears(false);
    })();
  </script>

