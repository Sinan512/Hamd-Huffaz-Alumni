      <!-- PAYMENT SETUP -->
      <div class="card mb-4" id="payment-section">
        <div class="card-header">
          <span><i class="bi bi-qr-code-scan text-primary me-2"></i>Payment Details Setup</span>
          <span class="badge bg-secondary">PAYMENT_SETUP</span>
        </div>
        <div class="card-body">
          <form id="paymentSetupForm" enctype="multipart/form-data">
            <div id="paymentSetupAlert" class="alert d-none rounded-3 py-2 px-3 small mb-3"></div>

            <div class="row g-4 align-items-start">
              <!-- QR Code Upload & Preview -->
              <div class="col-12 col-md-5 col-lg-4">
                <label class="form-label fw-semibold mb-1">Payment QR Code</label>
                <div class="border rounded-3 p-3 text-center bg-body-tertiary position-relative" style="min-height: 210px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                  <div id="qrCodePreviewContainer" class="{{#unless paymentSetup.hasQrCode}}d-none{{/unless}} mb-2 position-relative">
                    <img id="qrCodePreviewImage" src="{{#if paymentSetup.hasQrCode}}/admin/payment-setup/qr-code{{/if}}" alt="QR Code Preview" class="rounded-3 border shadow-sm" style="max-height: 180px; max-width: 100%; object-fit: contain;">
                  </div>
                  <div id="qrCodePlaceholder" class="{{#if paymentSetup.hasQrCode}}d-none{{/if}} text-muted py-4">
                    <i class="bi bi-qr-code fs-1 d-block mb-2 text-secondary"></i>
                    <span class="small">No QR Code Image Saved</span>
                  </div>
                  <div class="w-100 mt-2">
                    <input type="file" name="qrCode" id="qrCodeInput" class="form-control form-control-sm" accept="image/*">
                    <div class="form-text text-muted small mt-1">Image size must be <strong>less than 2MB</strong>.</div>
                  </div>
                </div>
              </div>

              <!-- UPI ID & GPay Number -->
              <div class="col-12 col-md-7 col-lg-8">
                <div class="mb-3">
                  <label for="upiIdInput" class="form-label fw-semibold">UPI ID</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                    <input type="text" name="upiId" id="upiIdInput" class="form-control" placeholder="Enter UPI ID (e.g. name@upi)" value="{{paymentSetup.upiId}}">
                  </div>
                  <div class="form-text">Official UPI ID for accepting payments.</div>
                </div>

                <div class="mb-3">
                  <label for="gpayNumberInput" class="form-label fw-semibold">GPay Number</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-phone"></i></span>
                    <input type="text" name="gpayNumber" id="gpayNumberInput" class="form-control" placeholder="Enter GPay Number (e.g. 9876543210)" value="{{paymentSetup.gpayNumber}}">
                  </div>
                  <div class="form-text">GPay phone number for accepting payments.</div>
                </div>

                <div class="d-flex align-items-center gap-2 mt-4">
                  <button type="submit" id="savePaymentBtn" class="btn btn-primary rounded-3 px-4">
                    <i class="bi bi-floppy me-1"></i>Save Payment Setup
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>

