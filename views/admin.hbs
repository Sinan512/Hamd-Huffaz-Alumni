  <!-- SCRIPTS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- ===== MEMBERS TABLE: batch filter + 10-per-page pagination ===== -->
  <script>
    (function () {
      var PAGE_SIZE = 10;
      var currentPage = 1;
      var activeBatch = '';
      var activeProfileStatus = '';
      var currentSortKey = null;
      var currentSortDir = null; // 'asc' | 'desc' | null

      var table      = document.getElementById('membersTable');
      var tbody      = document.getElementById('membersTableBody');
      var filterSel  = document.getElementById('batchFilterSelect');
      var profileFilterSel = document.getElementById('profileFilterSelect');
      var downloadBtn = document.getElementById('membersDownloadExcelBtn');
      var prevBtn    = document.getElementById('membersPrevBtn');
      var nextBtn    = document.getElementById('membersNextBtn');
      var pageInfo   = document.getElementById('membersPageInfo');
      var countBadge = document.getElementById('memberCountBadge');
      var dotsWrap   = document.getElementById('membersPageDots');
      var emptyRow   = document.getElementById('membersEmptyRow');

      if (!tbody || !table) return;

      /* Collect all initial data rows once */
      var allRows = Array.from(tbody.querySelectorAll('tr[data-batch]'));

      var attrMap = {
        'admissionNumber': 'data-admission-number',
        'phone': 'data-phone',
        'whatsapp': 'data-whatsapp',
        'place': 'data-place',
        'address': 'data-address',
        'currentStatus': 'data-current-status',
        'jobRole': 'data-job-role',
        'workLocation': 'data-work-location',
        'college': 'data-college',
        'course': 'data-course',
        'admYear': 'data-adm-year',
        'leaveYear': 'data-leave-year',
        'eduQual': 'data-edu-qual',
        'religiousDegree': 'data-religious-degree',
        'higherEdu': 'data-higher-edu',
        'skills': 'data-skills',
        'languages': 'data-languages',
        'orgRoles': 'data-org-roles',
        'supportNeeded': 'data-support-needed',
        'fatherName': 'data-father-name',
        'motherName': 'data-mother-name',
        'familyCount': 'data-family-count',
        'earningMembers': 'data-earning-members',
        'hasDependents': 'data-has-dependents',
        'dependentsWho': 'data-dependents-who',
        'parentsDeceased': 'data-parents-deceased',
        'chronicIll': 'data-chronic-ill',
        'chronicIllDetails': 'data-chronic-ill-details',
        'ownHouse': 'data-own-house',
        'married': 'data-married',
        'childrenCount': 'data-children-count'
      };

      /* ---- helper to get cell sort value from row ---- */
      function getRowSortValue(row, key) {
        if (!key) return '';
        if (key === 'name') return (row.getAttribute('data-name') || '').trim();
        if (key === 'batch') {
          var b = Number(row.getAttribute('data-batch'));
          return isNaN(b) ? (row.getAttribute('data-batch') || '') : b;
        }
        if (key === 'status') {
          return row.getAttribute('data-profile-complete') === 'completed' ? 1 : 0;
        }

        var attrName = attrMap[key];
        if (attrName) {
          var val = row.getAttribute(attrName) || '';
          if (key === 'familyCount' || key === 'childrenCount' || key === 'admYear' || key === 'leaveYear') {
            var n = Number(val);
            return isNaN(n) ? val : n;
          }
          return val.trim();
        }

        return '';
      }

      /* ---- sort rows ---- */
      function sortRows(rows) {
        if (!currentSortKey || !currentSortDir) return rows;

        var isNumeric = (currentSortKey === 'batch' || currentSortKey === 'familyCount' || 
                         currentSortKey === 'childrenCount' || currentSortKey === 'admYear' || 
                         currentSortKey === 'leaveYear' || currentSortKey === 'status');

        return rows.slice().sort(function (a, b) {
          var va = getRowSortValue(a, currentSortKey);
          var vb = getRowSortValue(b, currentSortKey);

          if (isNumeric) {
            var na = typeof va === 'number' ? va : parseFloat(va) || 0;
            var nb = typeof vb === 'number' ? vb : parseFloat(vb) || 0;
            return currentSortDir === 'asc' ? na - nb : nb - na;
          }

          var sa = String(va || '');
          var sb = String(vb || '');
          var cmp = sa.localeCompare(sb, undefined, { numeric: true, sensitivity: 'base' });
          return currentSortDir === 'asc' ? cmp : -cmp;
        });
      }

      /* ---- filter ---- */
      function getVisibleRows() {
        var filtered = allRows.filter(function (row) {
          var batchMatch = !activeBatch || row.getAttribute('data-batch') === activeBatch;
          var profileMatch = !activeProfileStatus || row.getAttribute('data-profile-complete') === activeProfileStatus;
          var query      = (document.getElementById('memberSearchInput') || {}).value || '';
          var textMatch  = !query || row.textContent.toLowerCase().includes(query.toLowerCase().trim());
          return batchMatch && profileMatch && textMatch;
        });

        return sortRows(filtered);
      }

      /* ---- update sort header icons ---- */
      function updateSortIcons() {
        var ths = table.querySelectorAll('thead th.sortable-th');
        ths.forEach(function (th) {
          var key = th.getAttribute('data-sort-key');
          var iconSpan = th.querySelector('.sort-icon');
          if (!iconSpan) return;

          if (key === currentSortKey && currentSortDir) {
            th.classList.add('text-primary');
            if (currentSortDir === 'asc') {
              iconSpan.innerHTML = '<i class="bi bi-sort-alpha-down text-primary fw-bold"></i>';
            } else {
              iconSpan.innerHTML = '<i class="bi bi-sort-alpha-up text-primary fw-bold"></i>';
            }
          } else {
            th.classList.remove('text-primary');
            iconSpan.innerHTML = '<i class="bi bi-arrow-down-up text-muted opacity-50"></i>';
          }
        });
      }

      /* ---- update empty row colspan ---- */
      function updateColspan() {
        if (!emptyRow) return;
        var visibleThCount = table.querySelectorAll('thead th:not(.d-none)').length || 5;
        emptyRow.querySelector('td').setAttribute('colspan', visibleThCount);
      }

      /* ---- render ---- */
      function render() {
        var visible  = getVisibleRows();
        var total    = visible.length;
        var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        currentPage    = Math.min(currentPage, totalPages);

        var start = (currentPage - 1) * PAGE_SIZE;
        var end   = start + PAGE_SIZE;

        /* Show / hide rows & re-append in sorted order */
        allRows.forEach(function (row) { row.style.display = 'none'; });

        var pageSlice = visible.slice(start, end);
        pageSlice.forEach(function (row) {
          row.style.display = '';
          tbody.appendChild(row); // preserves sorted order in DOM
        });

        /* Empty state */
        if (emptyRow) {
          emptyRow.style.display = total === 0 ? '' : 'none';
          if (total === 0) tbody.appendChild(emptyRow);
        }

        /* Info text */
        var from = total === 0 ? 0 : start + 1;
        var to   = Math.min(end, total);
        pageInfo.textContent   = 'Showing ' + from + '–' + to + ' of ' + total + ' members';
        countBadge.textContent = total;
        if (downloadBtn) downloadBtn.disabled = total === 0;

        /* Buttons */
        prevBtn.disabled = currentPage <= 1;
        nextBtn.disabled = currentPage >= totalPages;

        /* Page number dots (max 7 shown) */
        dotsWrap.innerHTML = '';
        var maxDots = 7;
        var half    = Math.floor(maxDots / 2);
        var dotStart = Math.max(1, currentPage - half);
        var dotEnd   = Math.min(totalPages, dotStart + maxDots - 1);
        if (dotEnd - dotStart < maxDots - 1) dotStart = Math.max(1, dotEnd - maxDots + 1);

        for (var p = dotStart; p <= dotEnd; p++) {
          var btn   = document.createElement('button');
          var isAct = p === currentPage;
          btn.className   = 'btn btn-sm rounded-3 px-2 py-1 ' + (isAct ? 'btn-primary' : 'btn-outline-secondary');
          btn.style.fontSize = '12px';
          btn.style.minWidth = '30px';
          btn.textContent = p;
          btn.disabled    = isAct;
          (function (pg) {
            btn.addEventListener('click', function () { currentPage = pg; render(); });
          })(p);
          dotsWrap.appendChild(btn);
        }

        updateSortIcons();
        updateColspan();
      }

      /* ---- sort header click listeners ---- */
      var sortableThs = table.querySelectorAll('thead th.sortable-th');
      sortableThs.forEach(function (th) {
        th.addEventListener('click', function (e) {
          var key = th.getAttribute('data-sort-key');
          if (!key) return;

          if (currentSortKey === key) {
            // Toggle: asc -> desc -> asc
            currentSortDir = (currentSortDir === 'asc') ? 'desc' : 'asc';
          } else {
            currentSortKey = key;
            currentSortDir = 'asc';
          }

          currentPage = 1;
          render();
        });
      });

      /* ---- column toggle checkbox listeners ---- */
      function setColumnVisibility(colName, isVisible) {
        var ths = table.querySelectorAll('thead th[data-col="' + colName + '"]');
        var tds = table.querySelectorAll('tbody td[data-col="' + colName + '"]');

        ths.forEach(function (th) {
          th.classList.toggle('d-none', !isVisible);
        });
        tds.forEach(function (td) {
          td.classList.toggle('d-none', !isVisible);
        });
        updateColspan();
      }

      var colCheckboxes = document.querySelectorAll('.col-toggle-cb');
      colCheckboxes.forEach(function (cb) {
        cb.addEventListener('change', function () {
          var colName = cb.getAttribute('data-col');
          setColumnVisibility(colName, cb.checked);
        });
      });

      /* Select All Columns */
      var selectAllBtn = document.getElementById('membersColSelectAll');
      if (selectAllBtn) {
        selectAllBtn.addEventListener('click', function () {
          colCheckboxes.forEach(function (cb) {
            cb.checked = true;
            setColumnVisibility(cb.getAttribute('data-col'), true);
          });
        });
      }

      /* Reset to Default Columns */
      var resetDefaultBtn = document.getElementById('membersColResetDefault');
      if (resetDefaultBtn) {
        resetDefaultBtn.addEventListener('click', function () {
          var defaultCols = ['profile', 'batch', 'status', 'contact', 'actions'];
          colCheckboxes.forEach(function (cb) {
            var colName = cb.getAttribute('data-col');
            var isDef = defaultCols.includes(colName);
            cb.checked = isDef;
            setColumnVisibility(colName, isDef);
          });
        });
      }

      /* ---- filters ---- */
      if (filterSel) {
        filterSel.addEventListener('change', function () {
          activeBatch = filterSel.value;
          currentPage = 1;
          render();
        });
      }

      if (profileFilterSel) {
        profileFilterSel.addEventListener('change', function () {
          activeProfileStatus = profileFilterSel.value;
          currentPage = 1;
          render();
        });
      }

      function todayStamp() {
        var date = new Date();
        function pad(n) { return n < 10 ? '0' + n : String(n); }
        return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate());
      }

      /* ---- Dynamic Excel export of active visible columns ---- */
      function downloadFilteredMembers() {
        var visible = getVisibleRows();
        if (!visible.length) return;
        if (typeof XLSX === 'undefined') {
          alert('Excel export could not be loaded. Please check your internet connection and try again.');
          return;
        }

        // 1. Identify all visible columns except 'actions' and 'contact'
        var visibleThs = Array.from(table.querySelectorAll('thead th:not(.d-none)'))
          .filter(function (th) {
            var col = th.getAttribute('data-col');
            return col !== 'actions' && col !== 'contact';
          });

        var headers = ['#'];
        var colKeys = [];

        visibleThs.forEach(function (th) {
          var colName = th.getAttribute('data-col');
          colKeys.push(colName);
          // Header text
          var title = th.querySelector('span') ? th.querySelector('span').textContent.trim() : th.textContent.trim();
          if (colName === 'profile') {
            headers.push('Name', 'Email');
          } else {
            headers.push(title);
          }
        });

        // 2. Build rows
        var rows = [headers];

        visible.forEach(function (row, index) {
          var rowData = [index + 1];

          colKeys.forEach(function (colName) {
            if (colName === 'profile') {
              rowData.push(row.getAttribute('data-name') || '', row.getAttribute('data-email') || '');
            } else if (colName === 'batch') {
              rowData.push(row.getAttribute('data-batch') || '');
            } else if (colName === 'status') {
              rowData.push(row.getAttribute('data-profile-complete') === 'completed' ? 'Completed' : 'Incomplete');
            } else {
              var td = row.querySelector('td[data-col="' + colName + '"]');
              var val = td ? td.textContent.trim() : '';
              if (!val) {
                var attrName = attrMap[colName] || ('data-' + colName);
                val = (row.getAttribute(attrName) || '').trim();
              }
              rowData.push(val);
            }
          });

          rows.push(rowData);
        });

        var sheet = XLSX.utils.aoa_to_sheet(rows);

        // Auto column widths
        var colWidths = headers.map(function (h, i) {
          if (i === 0) return { wch: 6 };
          return { wch: Math.max(14, (h.length || 10) + 4) };
        });
        sheet['!cols'] = colWidths;

        var workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, sheet, 'Registered Members');
        XLSX.writeFile(workbook, 'registered-members-' + todayStamp() + '.xlsx');
      }

      if (downloadBtn) downloadBtn.addEventListener('click', downloadFilteredMembers);

      prevBtn.addEventListener('click', function () { if (currentPage > 1) { currentPage--; render(); } });
      nextBtn.addEventListener('click', function () { currentPage++; render(); });

      /* Hook into existing search box */
      var searchInput = document.getElementById('memberSearchInput');
      if (searchInput) {
        searchInput.addEventListener('input', function () { currentPage = 1; render(); });
      }

      /* Initial render */
      render();

      /* Allow other scripts (member delete / update) to refresh the table */
      window.refreshMembersTable = function () {
        allRows = Array.from(tbody.querySelectorAll('tr[data-batch]'));
        render();
      };
    })();
  </script>

  <!-- ===== EVENT DETAIL: open modal and load data on click ===== -->
  <script>
    var CATEGORY_BADGE = {
      'Reunion':    'bg-primary',
      'Official':   'bg-info',
      'Seminar':    'bg-warning text-dark',
      'Networking': 'bg-success',
      'General':    'bg-secondary'
    };

    async function openEventDetail(eventId) {
      var modalEl  = document.getElementById('eventDetailModal');
      var modal    = bootstrap.Modal.getOrCreateInstance(modalEl);

      /* Reset state */
      document.getElementById('eventDetailLoading').classList.remove('d-none');
      document.getElementById('eventDetailContent').classList.add('d-none');
      document.getElementById('eventDetailError').classList.add('d-none');
      document.getElementById('eventDetailImageWrapper').classList.add('d-none');

      modal.show();

      try {
        var res    = await fetch('/admin/events/' + eventId);
        var result = await res.json().catch(function () { return {}; });

        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Could not load event.');
        }

        /* Populate text fields */
        document.getElementById('eventDetailTitle').innerHTML =
          '<i class="bi bi-calendar-event text-amber me-2"></i>' + (result.title || 'Event Details');
        document.getElementById('eventDetailName').textContent        = result.title        || '';
        document.getElementById('eventDetailDescription').textContent = result.description  || '';
        document.getElementById('eventDetailMonth').textContent       = result.month        || '';
        document.getElementById('eventDetailDay').textContent         = result.day          || '';
        document.getElementById('eventDetailDateFormatted').textContent = result.dateFormatted || '';
        document.getElementById('eventDetailLocation').textContent    = result.location     || '—';

        var badgeEl = document.getElementById('eventDetailBadge');
        badgeEl.className = 'badge rounded-pill small ' + (CATEGORY_BADGE[result.category] || 'bg-secondary');
        badgeEl.textContent = result.category || '';

        /* Show image if present */
        if (result.hasImage) {
          var imgEl = document.getElementById('eventDetailImage');
          imgEl.src = '/admin/events/' + eventId + '/image?t=' + Date.now();
          document.getElementById('eventDetailImageWrapper').classList.remove('d-none');
        }

        document.getElementById('eventDetailLoading').classList.add('d-none');
        document.getElementById('eventDetailContent').classList.remove('d-none');
      } catch (err) {
        document.getElementById('eventDetailLoading').classList.add('d-none');
        var errEl = document.getElementById('eventDetailError');
        errEl.textContent = err.message || 'Could not load event details.';
        errEl.classList.remove('d-none');
      }
    }
  </script>

  <!-- ===== CREATE EVENT FORM ===== -->
  <script>
    (function () {
      var form          = document.getElementById('createEventForm');
      if (!form) return;
      var alertBox      = document.getElementById('createEventAlert');
      var submitBtn     = document.getElementById('createEventSubmit');
      var imageInput    = document.getElementById('eventImageInput');
      var previewWrapper = document.getElementById('eventImagePreviewWrapper');
      var previewImg    = document.getElementById('eventImagePreview');

      /* Live image preview */
      if (imageInput) {
        imageInput.addEventListener('change', function () {
          var file = imageInput.files[0];
          if (file && file.type.startsWith('image/')) {
            var reader = new FileReader();
            reader.onload = function (e) {
              previewImg.src = e.target.result;
              previewWrapper.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
          } else {
            previewWrapper.classList.add('d-none');
            previewImg.src = '';
          }
        });
      }

      function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = message;
      }
      function hideAlert() {
        alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = '';
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        hideAlert();

        var formData = new FormData(form);
        submitBtn.disabled = true;
        var originalText = submitBtn.textContent;
        submitBtn.textContent = 'Publishing...';

        try {
          var res = await fetch('/admin/events', { method: 'POST', body: formData });
          var result = await res.json().catch(function () { return {}; });

          if (res.ok) {
            showAlert('success', result.message || 'Event created successfully.');
            form.reset();
            previewWrapper.classList.add('d-none');
            previewImg.src = '';
            setTimeout(function () {
              hideAlert();
              var modalEl = document.getElementById('createEventModal');
              var modal   = bootstrap.Modal.getInstance(modalEl);
              if (modal) modal.hide();
              window.location.reload();
            }, 1500);
          } else {
            showAlert('danger', result.message || 'Could not save the event. Please try again.');
          }
        } catch (err) {
          showAlert('danger', 'Could not save the event. Please try again.');
        } finally {
          submitBtn.disabled    = false;
          submitBtn.textContent = originalText;
        }
      });
    })();
  </script>

  <script>
    // --- SIDEBAR OPEN / CLOSE ---
    const sidebar = document.getElementById('sidebar');
    const sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
    const sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
    const sidebarOverlay = document.getElementById('sidebarOverlay');

    function openSidebar() {
      sidebar.classList.add('show');
      sidebar.classList.remove('collapsed');
      document.body.classList.remove('sidebar-collapsed');
      if (sidebarOverlay) sidebarOverlay.classList.add('show');
    }

    function closeSidebar() {
      sidebar.classList.remove('show');
      if (sidebarOverlay) sidebarOverlay.classList.remove('show');
      if (window.innerWidth > 992) {
        sidebar.classList.add('collapsed');
        document.body.classList.add('sidebar-collapsed');
      }
    }

    if (sidebarToggleBtn) {
      sidebarToggleBtn.addEventListener('click', () => {
        const isOpen = window.innerWidth > 992
          ? !sidebar.classList.contains('collapsed')
          : sidebar.classList.contains('show');
        isOpen ? closeSidebar() : openSidebar();
      });
    }

    if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeSidebar);
    if (sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSidebar();
    });


    // --- CHART.JS INITIALIZATION (REAL DATA) ---
    document.addEventListener('DOMContentLoaded', () => {

      // Members per Batch (source of truth: BATCH_DETAILS collection)
      var rawBatchChart = (function () { try { return {{{batchChartData}}}; } catch (e) { console.error('Batch chart data invalid:', e); return {}; } })() || {};
      const batchChart = {
        labels: Array.isArray(rawBatchChart.labels) ? rawBatchChart.labels : [],
        values: Array.isArray(rawBatchChart.values) ? rawBatchChart.values : []
      };
      const barEl = document.getElementById('barChart');
      if (!barEl) return;

      const barCtx = barEl.getContext('2d');
      const gradientBar = barCtx.createLinearGradient(0, 0, 0, 300);
      gradientBar.addColorStop(0, '#8b5cf6');
      gradientBar.addColorStop(1, '#6366f1');

      if (!batchChart.labels.length) {
        const empty = document.getElementById('barChartEmpty');
        if (empty) empty.classList.remove('d-none');
        barEl.classList.add('d-none');
        return;
      }


      new Chart(barCtx, {
        type: 'bar',
        data: {
          labels: batchChart.labels,
          datasets: [{
            label: 'Members',
            data: batchChart.values,
            backgroundColor: gradientBar,
            borderRadius: 8,
            barThickness: 28
          }]
        },
        options: {
