                    <td data-col="chronicIll" class="d-none small text-capitalize">{{this.chronicIll}}</td>
                    <td data-col="chronicIllDetails" class="d-none small text-truncate" style="max-width:140px;" title="{{this.chronicIllDetails}}">{{this.chronicIllDetails}}</td>
