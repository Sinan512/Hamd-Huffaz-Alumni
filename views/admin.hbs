  <!-- Add Alumni: batch dropdown fed from the BATCH_DETAILS collection -->
  <script>
    (function () {
      var select = document.getElementById('addAlumniBatchSelect');
      var modalEl = document.getElementById('addAlumniModal');
      if (!select || !modalEl) return;

      var loaded = false;
      var loading = false;

      function setOptions(html) { select.innerHTML = html; }

      async function loadBatchYears(force) {
        if (loading || (loaded && !force)) return;
        loading = true;
        setOptions('<option value="">Loading batches...</option>');
        try {
          var res = await fetch('/admin/batches');
          var data = await res.json().catch(function () { return {}; });
          var years = Array.isArray(data.years) ? data.years : [];
          if (!years.length) {
            setOptions('<option value="">No batches found \u2014 create a batch first</option>');
            loaded = false;
            return;
          }
          setOptions('<option value="">Select a batch</option>' +
            years.map(function (y) {
              return '<option value="' + y + '">Batch ' + y + '</option>';
            }).join(''));
          loaded = true;
        } catch (err) {
          setOptions('<option value="">Could not load batches</option>');
          loaded = false;
        } finally {
          loading = false;
        }
      }

      modalEl.addEventListener('show.bs.modal', function () { loadBatchYears(false); });

      /* Refresh after a new batch is created so the new year shows up. */
      window.refreshAddAlumniBatchYears = function () { loadBatchYears(true); };

      loadBatchYears(false);
    })();
  </script>

  <script>
    (function () {
      var form = document.getElementById('createBatchForm');
      if (!form) return;
      var alertBox = document.getElementById('createBatchAlert');
      var submitBtn = document.getElementById('createBatchSubmit');
      var yearInput = document.getElementById('createBatchYear');
      var preview = document.getElementById('createBatchPreview');
      var previewTimer = null;

      function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = message;
      }

      function hideAlert() {
        alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = '';
      }

      /* Live preview of how many MEMBER_DETAILS documents will be linked. */
      yearInput.addEventListener('input', function () {
        var year = yearInput.value.trim();
        clearTimeout(previewTimer);

        if (!/^\d{4}$/.test(year)) {
          preview.textContent = 'Enter a year to see how many members will be linked.';
          return;
        }

        previewTimer = setTimeout(async function () {
          try {
            var res = await fetch('/admin/batches/' + year + '/members-count');
            var result = await res.json();
            var count = result.count || 0;
            if (result.exists) {
              preview.textContent = 'Batch ' + year + ' already exists (' + count +
                (count === 1 ? ' member' : ' members') + ' linked). Choose another year.';
            } else {
              preview.textContent = count + (count === 1 ? ' member' : ' members') + ' will be linked from batch ' + year + '.';
            }
          } catch (err) {
            preview.textContent = '';
          }

        }, 300);
      });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        hideAlert();

        var data = Object.fromEntries(new FormData(form).entries());
        submitBtn.disabled = true;
        var originalText = submitBtn.textContent;
        submitBtn.textContent = 'Creating...';

        try {
          var res = await fetch('/admin/batches', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          var result = await res.json().catch(function () { return {}; });

          if (res.ok) {
            showAlert('success', result.message || 'Batch created successfully.');
            if (typeof window.refreshAddAlumniBatchYears === 'function') {
              window.refreshAddAlumniBatchYears();
            }
            form.reset();
            preview.textContent = 'Enter a year to see how many members will be linked.';
            setTimeout(function () {
              var modalEl = document.getElementById('createBatchModal');
              var modal = bootstrap.Modal.getInstance(modalEl);
              if (modal) modal.hide();
              window.location.reload();
            }, 1200);
          } else {
            showAlert('danger', result.message || 'Could not create the batch, please try again.');
          }
        } catch (err) {
          showAlert('danger', 'Could not create the batch, please try again.');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
    })();
  </script>

  <!-- Assign Batch Leader: load batches, load that batch's members, save to BATCH_LEADERS -->
  <script>
    (function () {
      var form = document.getElementById('assignLeaderForm');
      if (!form) return;

      var modalEl = document.getElementById('assignLeaderModal');
      var batchSelect = document.getElementById('leaderBatchSelect');
      var memberSelect = document.getElementById('leaderMemberSelect');
      var hint = document.getElementById('leaderMemberHint');
      var alertBox = document.getElementById('assignLeaderAlert');
      var submitBtn = document.getElementById('assignLeaderSubmit');
      var batchesLoaded = false;

      function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = message;
      }

      function hideAlert() {
        alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = '';
      }

      function resetMembers(message) {
        memberSelect.innerHTML = '<option value="">' + message + '</option>';
        memberSelect.disabled = true;
      }

      async function loadBatches() {
        try {
          var res = await fetch('/admin/batches');
          var result = await res.json();
          var years = result.years || [];

          if (!years.length) {
            batchSelect.innerHTML = '<option value="">No batches found</option>';
            return;
          }

          batchSelect.innerHTML = '<option value="">Select a batch</option>' +
            years.map(function (y) { return '<option value="' + y + '">Batch ' + y + '</option>'; }).join('');
          batchesLoaded = true;
        } catch (err) {
          batchSelect.innerHTML = '<option value="">Could not load batches</option>';
        }
      }

      async function loadMembers(year) {
        resetMembers('Loading members...');
        hint.textContent = 'Loading members of batch ' + year + '...';

        try {
          var res = await fetch('/admin/batches/' + year + '/members');
          var result = await res.json();
          var members = result.members || [];

          if (!members.length) {
            resetMembers('No members found in this batch');
            hint.textContent = 'No members found in batch ' + year + '.';
            return;
          }

          memberSelect.innerHTML = '<option value="">Select a member</option>' +
            members.map(function (m) {
              var label = m.name + (m.admissionNumber ? ' (' + m.admissionNumber + ')' : '');
              return '<option value="' + m._id + '">' + label + '</option>';
            }).join('');
          memberSelect.disabled = false;
          hint.textContent = members.length + (members.length === 1 ? ' member' : ' members') + ' in batch ' + year + '.';
        } catch (err) {
          resetMembers('Could not load members');
          hint.textContent = 'Could not load the members of this batch.';
        }
      }

      if (modalEl) {
        modalEl.addEventListener('show.bs.modal', function () {
          hideAlert();
          if (!batchesLoaded) loadBatches();
        });
      }

      batchSelect.addEventListener('change', function () {
        hideAlert();
        var year = batchSelect.value;
        if (!year) {
          resetMembers('Select a batch first');
          hint.textContent = 'Members of the selected batch will appear here.';
          return;
        }
        loadMembers(year);
      });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        hideAlert();

        var data = Object.fromEntries(new FormData(form).entries());
        if (!data.year || !data.memberId) {
          showAlert('danger', 'Please select both a batch and a member.');
          return;
        }

        submitBtn.disabled = true;
        var originalText = submitBtn.textContent;
        submitBtn.textContent = 'Assigning...';

        try {
          var res = await fetch('/admin/leaders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          var result = await res.json().catch(function () { return {}; });

          if (res.ok) {
            showAlert('success', result.message || 'Batch leader assigned.');
            setTimeout(function () {
              var modal = bootstrap.Modal.getInstance(modalEl);
              if (modal) modal.hide();
              window.location.reload();
            }, 1200);
          } else {
            showAlert('danger', result.message || 'Could not assign the leader, please try again.');
          }
        } catch (err) {
          showAlert('danger', 'Could not assign the leader, please try again.');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
    })();
  </script>

  <!-- DARK MODE TOGGLE -->
  <script>
    (function () {
      var STORAGE_KEY = 'adminTheme';
      var root = document.documentElement;

      function preferred() {
        try {
          var saved = localStorage.getItem(STORAGE_KEY);
          if (saved === 'dark' || saved === 'light') return saved;
        } catch (e) {}
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function paintCharts(theme) {
        if (typeof Chart === 'undefined' || !Chart.getChart) return;
        var tick = theme === 'dark' ? '#94a3b8' : '#94a3b8';
        var grid = theme === 'dark' ? 'rgba(148,163,184,0.15)' : '#f1f5f9';
        document.querySelectorAll('canvas').forEach(function (cv) {
          var c = Chart.getChart(cv);
          if (!c || !c.options || !c.options.scales) return;
          Object.keys(c.options.scales).forEach(function (k) {
            var sc = c.options.scales[k];
            if (sc.ticks) sc.ticks.color = tick;
            if (sc.grid && sc.grid.display !== false) sc.grid.color = grid;
          });
          c.update('none');
        });
      }

      function apply(theme) {
        root.setAttribute('data-bs-theme', theme);
        var icon = document.getElementById('themeToggleIcon');
        if (icon) icon.className = (theme === 'dark' ? 'bi bi-sun fs-5' : 'bi bi-moon-stars fs-5');
        var btn = document.getElementById('themeToggleBtn');
        if (btn) {
          var label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
          btn.setAttribute('aria-label', label);
          btn.setAttribute('title', label);
        }
        paintCharts(theme);
      }

      apply(preferred());

      document.addEventListener('DOMContentLoaded', function () {
        apply(root.getAttribute('data-bs-theme') || preferred());
        var btn = document.getElementById('themeToggleBtn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem(STORAGE_KEY, next); } catch (e) {}
          apply(next);
        });
      });
    })();
  </script>

</body>

</html>
