        try {
          var res    = await fetch('/admin/leaders', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify(data)
          });
          var result = await res.json().catch(function () { return {}; });

          if (res.ok) {
            showAlert('success', result.message || 'Leader changed successfully.');
            setTimeout(function () {
              var modal = bootstrap.Modal.getInstance(document.getElementById('changeLeaderModal'));
              if (modal) modal.hide();
              window.location.reload();
            }, 1200);
          } else {
            showAlert('danger', result.message || 'Could not change the leader.');
          }
        } catch (err) {
          showAlert('danger', 'Could not change the leader. Please try again.');
        } finally {
          submitBtn.disabled    = false;
          submitBtn.textContent = orig;
        }
      });
    })();
  </script>

  <!-- ===== LEADER CREDENTIALS & DELETE ===== -->
  <script>
    function openLeaderCredentialsModal(leaderId, year) {
      document.getElementById('leaderCredentialsId').value = leaderId || '';
       document.getElementById('leaderCredentialsSubtitle').textContent =
        'Update password for Batch ' + (year || '') + ' leader login.';
      document.getElementById('leaderCredentialsPassword').value = '';
      document.getElementById('leaderCredentialsPassword').type = 'password';
      document.getElementById('toggleCredPasswordIcon').className = 'bi bi-eye';
      document.getElementById('leaderCredentialsAlert').className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3';
      document.getElementById('leaderCredentialsAlert').textContent = '';
      bootstrap.Modal.getOrCreateInstance(document.getElementById('leaderCredentialsModal')).show();
    }

    async function deleteLeaderSetup(leaderId, year) {
      if (!confirm('Are you sure you want to remove leader login setup for Batch ' + year + '?')) return;
      try {
        var res = await fetch('/admin/leaders/' + leaderId, { method: 'DELETE' });
        var result = await res.json();
        if (res.ok) {
          window.location.reload();
        } else {
          alert(result.message || 'Could not remove leader setup.');
        }
      } catch (err) {
        alert('Network error while removing leader setup.');
      }
    }

    (function () {
      /* Toggle password visibility */
      var toggleBtn  = document.getElementById('toggleCredPassword');
      var passInput  = document.getElementById('leaderCredentialsPassword');
      var toggleIcon = document.getElementById('toggleCredPasswordIcon');

      if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
          var show = passInput.type === 'password';
          passInput.type      = show ? 'text' : 'password';
          toggleIcon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
      }

      /* Submit */
      var form = document.getElementById('leaderCredentialsForm');
      if (!form) return;
      var alertEl   = document.getElementById('leaderCredentialsAlert');
      var submitBtn = document.getElementById('leaderCredentialsSubmit');

      function showAlert(type, msg) {
        alertEl.className   = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertEl.textContent = msg;
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var id = document.getElementById('leaderCredentialsId').value;
        if (!id) return;

        var data = Object.fromEntries(new FormData(form).entries());
        submitBtn.disabled    = true;
        var orig = submitBtn.textContent;
        submitBtn.textContent = 'Saving…';

        try {
          var res    = await fetch('/admin/leaders/' + id + '/credentials', {
            method:  'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify(data)
          });
          var result = await res.json().catch(function () { return {}; });

          if (res.ok) {
            showAlert('success', result.message || 'Credentials saved.');
            setTimeout(function () {
              var modal = bootstrap.Modal.getInstance(document.getElementById('leaderCredentialsModal'));
              if (modal) modal.hide();
            }, 1500);
          } else {
            showAlert('danger', result.message || 'Could not save credentials.');
          }
        } catch (err) {
          showAlert('danger', 'Could not save credentials. Please try again.');
        } finally {
          submitBtn.disabled    = false;
          submitBtn.textContent = orig;
        }
      });
    })();
  </script>



  <!-- DARK MODE TOGGLE -->
  <script>
    (function () {
      var STORAGE_KEY = 'adminTheme';
      var root = document.documentElement;

      function preferred() {
        try {
          var saved = localStorage.getItem(STORAGE_KEY);
          if (saved === 'dark' || saved === 'light') return saved;
        } catch (e) {}
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function paintCharts(theme) {
        if (typeof Chart === 'undefined' || !Chart.getChart) return;
        var tick = theme === 'dark' ? '#94a3b8' : '#94a3b8';
        var grid = theme === 'dark' ? 'rgba(148,163,184,0.15)' : '#f1f5f9';
        document.querySelectorAll('canvas').forEach(function (cv) {
          var c = Chart.getChart(cv);
          if (!c || !c.options || !c.options.scales) return;
          Object.keys(c.options.scales).forEach(function (k) {
            var sc = c.options.scales[k];
            if (sc.ticks) sc.ticks.color = tick;
            if (sc.grid && sc.grid.display !== false) sc.grid.color = grid;
          });
          c.update('none');
        });
      }

      function apply(theme) {
        root.setAttribute('data-bs-theme', theme);
        var icon = document.getElementById('themeToggleIcon');
        if (icon) icon.className = (theme === 'dark' ? 'bi bi-sun fs-5' : 'bi bi-moon-stars fs-5');
        var btn = document.getElementById('themeToggleBtn');
        if (btn) {
          var label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
          btn.setAttribute('aria-label', label);
          btn.setAttribute('title', label);
        }
        paintCharts(theme);
      }

      apply(preferred());

      document.addEventListener('DOMContentLoaded', function () {
        apply(root.getAttribute('data-bs-theme') || preferred());
        var btn = document.getElementById('themeToggleBtn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem(STORAGE_KEY, next); } catch (e) {}
          apply(next);
        });
      });
    })();
  </script>

  <!-- ==================== ARTICLE SCRIPTS ==================== -->
  <script>
    (function () {
      var form       = document.getElementById('addArticleForm');
      var fileInput  = document.getElementById('articleImageInput');
      var previewBox = document.getElementById('articleImagePreviewWrapper');
      var preview    = document.getElementById('articleImagePreview');
      var alertBox   = document.getElementById('addArticleAlert');
      var submitBtn  = document.getElementById('addArticleSubmit');
      var grid       = document.getElementById('articlesGrid');
      var emptyBox   = document.getElementById('articlesEmpty');
      var countBadge = document.getElementById('articleCountBadge');
      var modalEl    = document.getElementById('addArticleModal');
      if (!form || !grid) return;

      function esc(v) {
        return String(v == null ? '' : v)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      function showAlert(type, message) {
        if (!alertBox) return;
        alertBox.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = message;
      }
      function hideAlert() {
        if (alertBox) { alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3'; alertBox.textContent = ''; }
      }

      if (fileInput) {
        fileInput.addEventListener('change', function () {
          var file = fileInput.files && fileInput.files[0];
          if (!file) { previewBox.classList.add('d-none'); preview.src = ''; return; }
          var reader = new FileReader();
          reader.onload = function (ev) { preview.src = ev.target.result; previewBox.classList.remove('d-none'); };
          reader.readAsDataURL(file);
        });
      }

      function tile(a) {
        var img = a.hasImage
          ? '<img src="/admin/articles/' + a._id + '/image" alt="' + esc(a.heading) + '" loading="lazy">'
          : '<i class="bi bi-journal-richtext"></i>';
        return '' +
          '<div class="col-12 col-md-6 col-xl-4" data-article-id="' + a._id + '">' +
            '<div class="article-tile">' +
              '<div class="article-tile-img">' + img + '</div>' +
              '<div class="article-tile-body">' +
                '<div class="article-tile-heading">' + esc(a.heading) + '</div>' +
                '<div class="article-tile-meta">' +
                  '<span><i class="bi bi-person me-1"></i>' + esc(a.author || 'Unknown') + '</span>' +
                  '<span><i class="bi bi-calendar3 me-1"></i>' + esc(a.dateFormatted || '') + '</span>' +
                '</div>' +
                '<div class="article-tile-excerpt">' + esc(a.excerpt || '') + '</div>' +
              '</div>' +
              '<button type="button" class="article-tile-delete" data-delete-article="' + a._id + '" title="Delete article" aria-label="Delete article"><i class="bi bi-trash"></i></button>' +
            '</div>' +
          '</div>';
      }

      function render(articles) {
        grid.innerHTML = (articles || []).map(tile).join('');
        if (countBadge) countBadge.textContent = String((articles || []).length);
        if (emptyBox) emptyBox.classList.toggle('d-none', !!(articles && articles.length));
      }

      function refresh() {
        return fetch('/admin/articles', { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
          .then(function (res) { return res.json(); })
          .then(function (data) { if (data && data.success) render(data.articles || []); })
          .catch(function () { /* keep the server-rendered list */ });
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        hideAlert();
        submitBtn.disabled = true;
        var label = submitBtn.textContent;
        submitBtn.textContent = 'Saving...';

        fetch('/admin/articles', { method: 'POST', body: new FormData(form), credentials: 'same-origin' })
          .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, data: body }; }); })
          .then(function (result) {
            if (!result.ok || !result.data.success) {
              throw new Error((result.data && result.data.message) || 'Could not save the article.');
            }
            showAlert('success', result.data.message || 'Article uploaded.');
            form.reset();
            if (previewBox) { previewBox.classList.add('d-none'); preview.src = ''; }
            return refresh().then(function () {
              setTimeout(function () {
                hideAlert();
                if (window.bootstrap && modalEl) {
                  var inst = window.bootstrap.Modal.getInstance(modalEl) || new window.bootstrap.Modal(modalEl);
                  inst.hide();
                }
              }, 800);
            });
          })
          .catch(function (err) { showAlert('danger', err.message || 'Could not save the article.'); })
          .then(function () { submitBtn.disabled = false; submitBtn.textContent = label; });
      });

      grid.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-delete-article]');
        if (!btn) return;
        var id = btn.getAttribute('data-delete-article');
        if (!window.confirm('Delete this article permanently?')) return;
        btn.disabled = true;

        fetch('/admin/articles/' + id, { method: 'DELETE', headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (!data || !data.success) throw new Error((data && data.message) || 'Could not delete the article.');
            var card = grid.querySelector('[data-article-id="' + id + '"]');
            if (card) card.remove();
            var left = grid.querySelectorAll('[data-article-id]').length;
            if (countBadge) countBadge.textContent = String(left);
            if (emptyBox) emptyBox.classList.toggle('d-none', left > 0);
          })
          .catch(function (err) { window.alert(err.message || 'Could not delete the article.'); btn.disabled = false; });
      });
    })();
  </script>

  <!-- ==================== PAYMENT SETUP SCRIPTS ==================== -->
  <script>
    (function () {
      var form        = document.getElementById('paymentSetupForm');
      var qrInput     = document.getElementById('qrCodeInput');
      var previewBox  = document.getElementById('qrCodePreviewContainer');
      var previewImg  = document.getElementById('qrCodePreviewImage');
      var placeholder = document.getElementById('qrCodePlaceholder');
      var alertBox    = document.getElementById('paymentSetupAlert');
      var saveBtn     = document.getElementById('savePaymentBtn');

      function showAlert(type, message) {
        if (!alertBox) return;
        alertBox.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-3';
        alertBox.textContent = message;
      }

      function hideAlert() {
        if (!alertBox) return;
        alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-3';
        alertBox.textContent = '';
      }

      if (qrInput) {
        qrInput.addEventListener('change', function () {
          var file = qrInput.files && qrInput.files[0];
          if (!file) return;
          if (file.size > 2 * 1024 * 1024) {
            showAlert('danger', 'QR Code image must be less than 2MB.');
            qrInput.value = '';
            return;
          }
          hideAlert();
          previewImg.src = URL.createObjectURL(file);
          previewBox.classList.remove('d-none');
          placeholder.classList.add('d-none');
        });
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          hideAlert();

          var file = qrInput.files && qrInput.files[0];
          if (file && file.size > 2 * 1024 * 1024) {
            showAlert('danger', 'QR Code image must be less than 2MB.');
            return;
          }

          saveBtn.disabled = true;
          var originalText = saveBtn.innerHTML;
          saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';

          var formData = new FormData(form);

          fetch('/admin/payment-setup', {
            method: 'POST',
            body: formData
          })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }); })
            .then(function (result) {
              if (!result.ok || !result.data.success) {
                showAlert('danger', (result.data && result.data.message) || 'Could not save payment setup.');
                return;
              }
              showAlert('success', result.data.message || 'Payment details saved successfully.');
              if (result.data.paymentSetup && result.data.paymentSetup.hasQrCode) {
                previewImg.src = '/admin/payment-setup/qr-code?t=' + Date.now();
                previewBox.classList.remove('d-none');
                placeholder.classList.add('d-none');
              }
              qrInput.value = '';
            })
            .catch(function () {
              showAlert('danger', 'Network error while saving payment setup.');
            })
            .finally(function () {
              saveBtn.disabled = false;
              saveBtn.innerHTML = originalText;
            });
        });
      }
    })();
  </script>

  <!-- ==================== GALLERY SCRIPTS ==================== -->
  <script>
    (function () {
      var form       = document.getElementById('addGalleryForm');
      var fileInput  = document.getElementById('galleryImageInput');
      var previewBox = document.getElementById('galleryImagePreviewWrapper');
      var preview    = document.getElementById('galleryImagePreview');
      var alertBox   = document.getElementById('addGalleryAlert');
      var submitBtn  = document.getElementById('addGallerySubmit');
      var grid       = document.getElementById('galleryGrid');
      var emptyBox   = document.getElementById('galleryEmpty');
      var modalEl    = document.getElementById('addGalleryModal');

      function showAlert(type, message) {
        if (!alertBox) return;
        alertBox.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = message;
      }

      function hideAlert() {
        if (!alertBox) return;
        alertBox.className = 'alert d-none rounded-3 py-2 px-3 small mb-0 mt-3';
        alertBox.textContent = '';
      }

      function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function renderGallery(images) {
        if (!grid) return;
        grid.innerHTML = images.map(function (img) {
          var desc = escapeHtml(img.description);
          return '' +
            '<div class="col-6 col-md-4 col-lg-3" data-gallery-id="' + img._id + '">' +
              '<div class="gallery-tile">' +
                '<img src="/admin/gallery/' + img._id + '/image" alt="' + (desc || 'Gallery image') + '" loading="lazy">' +
                '<button type="button" class="gallery-delete" data-delete-gallery="' + img._id + '" title="Delete image" aria-label="Delete image">' +
                  '<i class="bi bi-trash"></i>' +
                '</button>' +
                '<div class="gallery-caption">' + (desc || '<span class="fst-italic">No description</span>') + '</div>' +
              '</div>' +
            '</div>';
        }).join('');
        if (emptyBox) emptyBox.classList.toggle('d-none', images.length > 0);
      }

      function refreshGallery() {
        return fetch('/admin/gallery', { headers: { 'Accept': 'application/json' } })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data && data.success) renderGallery(data.images || []);
          })
          .catch(function () { /* keep current grid on network error */ });
      }

      if (fileInput) {
        fileInput.addEventListener('change', function () {
          var file = fileInput.files && fileInput.files[0];
          if (!file) { previewBox.classList.add('d-none'); preview.src = ''; return; }
          preview.src = URL.createObjectURL(file);
          previewBox.classList.remove('d-none');
        });
      }

      if (modalEl) {
        modalEl.addEventListener('hidden.bs.modal', function () {
          form.reset();
          hideAlert();
          previewBox.classList.add('d-none');
          preview.src = '';
        });
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          hideAlert();

          var file = fileInput.files && fileInput.files[0];
          if (!file) { showAlert('danger', 'Please choose an image to upload.'); return; }
          if (file.size > 5 * 1024 * 1024) { showAlert('danger', 'Image must be 5 MB or smaller.'); return; }

          submitBtn.disabled = true;
          var original = submitBtn.textContent;
          submitBtn.textContent = 'Saving...';

          fetch('/admin/gallery', { method: 'POST', body: new FormData(form) })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }); })
            .then(function (result) {
              if (!result.ok || !result.data.success) {
                showAlert('danger', (result.data && result.data.message) || 'Could not save the image.');
                return;
              }
              showAlert('success', result.data.message || 'Image added to the gallery.');
              return refreshGallery().then(function () {
                setTimeout(function () {
                  var instance = bootstrap.Modal.getInstance(modalEl);
                  if (instance) instance.hide();
                }, 700);
              });
            })
            .catch(function () { showAlert('danger', 'Network error. Please try again.'); })
            .finally(function () {
              submitBtn.disabled = false;
              submitBtn.textContent = original;
            });
        });
      }

      if (grid) {
        grid.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-delete-gallery]');
          if (!btn) return;
          var id = btn.getAttribute('data-delete-gallery');
          if (!window.confirm('Delete this image from the gallery?')) return;

          btn.disabled = true;
          fetch('/admin/gallery/' + id, { method: 'DELETE', headers: { 'Accept': 'application/json' } })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }); })
            .then(function (result) {
              if (!result.ok || !result.data.success) { btn.disabled = false; return; }
              var tile = grid.querySelector('[data-gallery-id="' + id + '"]');
              if (tile) tile.remove();
              if (emptyBox) emptyBox.classList.toggle('d-none', grid.children.length > 0);
            })
            .catch(function () { btn.disabled = false; });
        });
      }
    })();
  </script>

<script>
/* ================= Registered members per event (Excel Export) ================= */
(function () {
  var selectEl  = document.getElementById('regEventSelect');
  var bodyEl    = document.getElementById('regMembersBody');
  var countEl   = document.getElementById('regCountBadge');
  var refreshEl = document.getElementById('regRefreshBtn');
  var excelEl   = document.getElementById('regDownloadExcelBtn');
  var currentMembers = [];
  if (!selectEl || !bodyEl) return;

  function esc(v) {
    return String(v == null ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function waNumber(raw) {
    var d = String(raw || '').replace(/[^0-9]/g, '');
    if (!d) return '';
    if (d.length === 10) d = '91' + d;
    if (d.length === 11 && d.charAt(0) === '0') d = '91' + d.slice(1);
    return d;
  }

  function row(m, i) {
    var wa   = waNumber(m.whatsapp || m.phone);
    var tel  = String(m.phone || '').replace(/\s+/g, '');
    var waBtn = wa
      ? '<a href="https://wa.me/' + esc(wa) + '?text=' + encodeURIComponent('Hello ' + (m.name || '')) + '" target="_blank" rel="noopener" class="btn btn-sm btn-success rounded-2 px-2" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>'
      : '<button class="btn btn-sm btn-light border rounded-2 px-2 text-muted" disabled title="No WhatsApp number"><i class="bi bi-whatsapp"></i></button>';

    var telBtn = tel
      ? '<a href="tel:' + esc(tel) + '" class="btn btn-sm btn-primary rounded-2 px-2" title="Call ' + esc(tel) + '"><i class="bi bi-telephone"></i></a>'
      : '<button class="btn btn-sm btn-light border rounded-2 px-2 text-muted" disabled title="No phone number"><i class="bi bi-telephone"></i></button>';

    return '<tr>' +
      '<td class="text-muted small">' + (i + 1) + '</td>' +
      '<td><div class="fw-semibold text-dark">' + esc(m.name) + '</div>' +
        (m.admissionNumber ? '<div class="text-muted" style="font-size:11px;">' + esc(m.admissionNumber) + '</div>' : '') +
      '</td>' +
      '<td class="small">' + (m.place ? esc(m.place) : '<span class="text-muted">—</span>') + '</td>' +
      '<td><span class="badge bg-light text-dark border">' + (m.batch ? esc(m.batch) : '—') + '</span></td>' +
      '<td class="small">' + eventsCell(m) + '</td>' +
      '<td class="text-end"><div class="d-flex gap-1 justify-content-end">' + waBtn + telBtn + '</div></td>' +
    '</tr>';
  }

  function eventsCell(m) {
    var list = Array.isArray(m.events) && m.events.length
      ? m.events
      : (selectEl.value ? [selectEl.options[selectEl.selectedIndex].text] : []);
    if (!list.length) return '<span class="text-muted">—</span>';
    return list.map(function (t) {
      return '<span class="badge bg-primary-subtle text-primary border me-1 mb-1" style="font-weight:600;">' + esc(t) + '</span>';
    }).join('');
  }

  function message(text) {
    bodyEl.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4 small">' + esc(text) + '</td></tr>';
  }

  function load() {
    var id  = selectEl.value;
    var url = id
      ? '/admin/events/' + encodeURIComponent(id) + '/registrations'
      : '/admin/registrations';

    currentMembers = [];
    setExcelEnabled(false);

    bodyEl.innerHTML = '<tr><td colspan="6" class="text-center py-4">' +
      '<span class="spinner-border spinner-border-sm text-secondary me-2"></span>' +
      '<span class="text-muted small">Loading registrations…</span></td></tr>';

    fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
      .then(function (res) { return res.json().catch(function () { throw new Error('Server error (' + res.status + ')'); }); })
      .then(function (data) {
        if (!data || !data.success) throw new Error((data && data.message) || 'Could not load registered members.');
        countEl.textContent = String(data.count || 0);
        if (!data.members || !data.members.length) {
          message(id ? 'No members registered for this event yet.' : 'No registered members yet.');
          return;
        }
        currentMembers = data.members;
        setExcelEnabled(true);
        bodyEl.innerHTML = data.members.map(row).join('');
      })
      .catch(function (err) {
        countEl.textContent = '0';
        currentMembers = [];
        setExcelEnabled(false);
        bodyEl.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4 small">' + esc(err.message) + '</td></tr>';
      });
  }

  /* ---------------- Excel export ---------------- */
  function setExcelEnabled(on) {
    if (excelEl) excelEl.disabled = !on;
  }

  function selectedEventTitle() {
    if (!selectEl.value) return '';
    var opt = selectEl.options[selectEl.selectedIndex];
    return opt ? String(opt.text || '').trim() : '';
  }

  function slugify(text) {
    return String(text || '').toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 60) || 'all-events';
  }

  function todayStamp() {
    var d = new Date();
    function p(n) { return (n < 10 ? '0' : '') + n; }
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());
  }

  function downloadExcel() {
    if (!currentMembers.length) return;

    if (typeof XLSX === 'undefined') {
      alert('Excel library could not be loaded. Please check your internet connection and try again.');
      return;
    }

    var eventTitle = selectedEventTitle();
    var perEvent   = !!selectEl.value;

    var headers = perEvent
      ? ['#', 'Name', 'Admission No', 'Place', 'Batch', 'Phone', 'WhatsApp']
      : ['#', 'Name', 'Admission No', 'Place', 'Batch', 'Phone', 'WhatsApp', 'Registered Events'];

    var rows = [headers];

    currentMembers.forEach(function (m, i) {
      var rowData = [
        i + 1,
        m.name || '—',
        m.admissionNumber || '—',
        m.place || '—',
        m.batch || '—',
        m.phone || '—',
        m.whatsapp || '—'
      ];
      if (!perEvent) {
        rowData.push(Array.isArray(m.events) && m.events.length ? m.events.join(', ') : '—');
      }
      rows.push(rowData);
    });

    var ws = XLSX.utils.aoa_to_sheet(rows);

    /* Set column widths */
    var cols = [
      { wch: 6 },  // #
      { wch: 26 }, // Name
      { wch: 16 }, // Admission No
      { wch: 18 }, // Place
      { wch: 12 }, // Batch
      { wch: 16 }, // Phone
      { wch: 16 }  // WhatsApp
    ];
    if (!perEvent) {
      cols.push({ wch: 35 }); // Events
    }
    ws['!cols'] = cols;

    var wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Registered Members');

    var fileName = 'registrations-' + slugify(eventTitle || 'all-events') + '-' + todayStamp() + '.xlsx';
    XLSX.writeFile(wb, fileName);
  }

  selectEl.addEventListener('change', load);
  if (refreshEl) refreshEl.addEventListener('click', load);
  if (excelEl) excelEl.addEventListener('click', downloadExcel);
  load();
})();
</script>

