<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Alumni Admin Portal</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --font-main: 'Plus Jakarta Sans', sans-serif;
      --bg-body: #f8fafc;
      --sidebar-width: 270px;
      --sidebar-bg: #0b0f19;
      --sidebar-card: #151c2c;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --card-bg: #ffffff;
      --card-border: rgba(226, 232, 240, 0.8);
      --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
      --card-shadow-hover: 0 12px 28px -4px rgba(0, 0, 0, 0.08), 0 4px 12px -2px rgba(0, 0, 0, 0.04);
      --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-main);
      background-color: var(--bg-body);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    /* --- SIDEBAR STYLING --- */
    .sidebar {
      width: var(--sidebar-width);
      background: linear-gradient(180deg, #0b0f19 0%, #111827 100%);
      min-height: 100vh;
      color: #94a3b8;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1040;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-right: 1px solid rgba(255, 255, 255, 0.06);
      display: flex;
      flex-direction: column;
    }

    .sidebar .brand {
      padding: 24px 28px;
      font-size: 20px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .sidebar .brand-icon {
      width: 40px;
      height: 40px;
      background: var(--primary-gradient);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 20px;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    }

    .sidebar-menu {
      padding: 20px 16px;
      flex-grow: 1;
      overflow-y: auto;
    }

    .sidebar-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #475569;
      padding: 12px 14px 6px 14px;
    }

    .sidebar a {
      display: flex;
      align-items: center;
      gap: 14px;
      color: #94a3b8;
      text-decoration: none;
      padding: 12px 16px;
      font-size: 14px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 4px;
      transition: all 0.2s ease;
    }

    .sidebar a i {
      font-size: 18px;
      transition: transform 0.2s ease;
    }

    .sidebar a:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.05);
    }

    .sidebar a:hover i {
      transform: translateX(2px);
    }

    .sidebar a.active {
      background: var(--primary-gradient);
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
    }

    .sidebar-user-card {
      margin: 16px;
      padding: 14px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* --- MAIN CONTENT AREA --- */
    .main {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .boxed {
      max-width: 1440px;
      margin: 0 auto;
    }

    /* --- NAVBAR STYLING --- */
    .navbar {
      background: #ffffff;
      border-bottom: 1px solid var(--card-border);
      padding: 14px 28px;
      position: sticky;
      top: 0;
      z-index: 1020;
      backdrop-filter: blur(8px);
    }

    .search-box {
      position: relative;
      max-width: 420px;
      width: 100%;
    }

    .search-box i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 16px;
    }

    .search-box input {
      padding-left: 42px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #f8fafc;
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .search-box input:focus {
      background: #ffffff;
      border-color: #6366f1;
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .nav-icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #475569;
      position: relative;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .nav-icon-btn:hover {
      background: #f1f5f9;
      color: #1e293b;
    }

    .nav-icon-btn .badge-dot {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 8px;
      height: 8px;
      background: #ef4444;
      border-radius: 50%;
      border: 2px solid #ffffff;
    }

    .user-profile-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 12px 6px 6px;
      border: 1px solid #e2e8f0;
      border-radius: 30px;
      background: #ffffff;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .user-profile-btn:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
    }

    /* --- CARDS & DASHBOARD WIDGETS --- */
    .card {
      border: 1px solid var(--card-border);
      border-radius: 16px;
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      transition: all 0.25s ease;

    }

    .card-header {
      background: transparent;
      border-bottom: 1px solid var(--card-border);
      padding: 20px 24px;
      font-weight: 700;
      font-size: 16px;
      color: #0f172a;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* --- STAT CARDS --- */
    .stat-card {
      position: relative;
      overflow: hidden;
      padding: 20px;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--card-shadow-hover);
    }

    .stat-icon-wrapper {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
    }

    .stat-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }

    .stat-value {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
      margin: 0;
    }

    .stat-trend {
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border-radius: 20px;
      margin-top: 8px;
    }

    .trend-up {
      background: #ecfdf5;
      color: #10b981;
    }

    /* STAT CARD GRADIENTS */
    .stat-indigo .stat-icon-wrapper { background: rgba(99, 102, 241, 0.12); color: #6366f1; }
    .stat-emerald .stat-icon-wrapper { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .stat-purple .stat-icon-wrapper { background: rgba(139, 92, 246, 0.12); color: #8b5cf6; }
    .stat-amber .stat-icon-wrapper { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .stat-rose .stat-icon-wrapper { background: rgba(244, 63, 94, 0.12); color: #f43f5e; }
    .stat-cyan .stat-icon-wrapper { background: rgba(6, 182, 212, 0.12); color: #06b6d4; }
    .stat-violet .stat-icon-wrapper { background: rgba(168, 85, 247, 0.12); color: #a855f7; }

    /* --- TABLE STYLING --- */
    .table-responsive {
      border-radius: 0 0 16px 16px;
    }

    .custom-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    .custom-table th {
      background: #f8fafc;
      color: #475569;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 14px 24px;
      border-bottom: 1px solid var(--card-border);
    }

    .custom-table td {
      padding: 16px 24px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 14px;
      color: #334155;
      vertical-align: middle;
    }

    .custom-table tbody tr {
      transition: background-color 0.15s ease;
    }

    .custom-table tbody tr:hover {
      background-color: #f8fafc;
    }

    .member-avatar-wrapper {
      position: relative;
      display: inline-block;
    }

    .member-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    .status-dot {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      border: 2px solid #ffffff;
    }

    .dot-active { background: #10b981; }
    .dot-verified { background: #3b82f6; }
    .dot-pending { background: #f59e0b; }

    /* BADGES */
    .badge-status {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge-active { background: #dcfce7; color: #15803d; }
    .badge-verified { background: #dbeafe; color: #1e40af; }
    .badge-pending { background: #fef3c7; color: #b45309; }

    .batch-tag {
      background: #f1f5f9;
      color: #475569;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 12px;
    }

    /* --- EVENTS LIST --- */
    .event-item {
      padding: 16px 20px;
      border-bottom: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
      gap: 16px;
      transition: background 0.15s ease;
    }

    .event-item:last-child {
      border-bottom: none;
    }

    .event-item:hover {
      background: #f8fafc;
    }

    .event-date-box {
      width: 50px;
      height: 52px;
      background: #f1f5f9;
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      text-align: center;
    }

    .event-date-month {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      color: #6366f1;
    }

    .event-date-day {
      font-size: 18px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1;
    }

    /* --- QUICK ACTIONS --- */
    .quick-action-btn {
      width: 100%;
      padding: 12px 16px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      color: #334155;
      margin-bottom: 10px;
      transition: all 0.2s ease;
    }

    .quick-action-btn:last-child {
      margin-bottom: 0;
    }

    .quick-action-btn:hover {
      background: var(--primary-gradient);
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
      transform: translateX(4px);
    }

    .quick-action-btn i {
      font-size: 16px;
    }

    /* --- ACTIVITY FEED --- */
    .activity-feed {
      position: relative;
      padding-left: 20px;
    }

    .activity-feed::before {
      content: '';
      position: absolute;
      left: 17px;
      top: 15px;
      bottom: 15px;
      width: 2px;
      background: #e2e8f0;
    }

    .activity-item {
      position: relative;
      padding-bottom: 20px;
      display: flex;
      gap: 16px;
    }

    .activity-item:last-child {
      padding-bottom: 0;
    }

    .activity-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      z-index: 1;
      flex-shrink: 0;
      box-shadow: 0 0 0 4px #ffffff;
    }

    .bg-emerald-soft { background: #dcfce7; color: #10b981; }
    .bg-indigo-soft { background: #e0e7ff; color: #6366f1; }
    .bg-amber-soft { background: #fef3c7; color: #f59e0b; }
    .bg-purple-soft { background: #f3e8ff; color: #a855f7; }

    /* RESPONSIVE TOGGLES */
    @media (max-width: 992px) {
      .sidebar {
        transform: translateX(-100%);
      }
      .sidebar.show {
        transform: translateX(0);
      }
      .main {
        margin-left: 0;
      }
    }
  </style>
</head>
<body>

  <!-- SIDEBAR NAVIGATION -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-icon">
        <i class="bi bi-mortarboard-fill"></i>
      </div>
      <div>
        <span>Alumni</span><span style="color: #6366f1;">Portal</span>
        <div style="font-size: 10px; font-weight: 500; color: #64748b; margin-top: -2px;">MANAGEMENT SYSTEM</div>
      </div>
    </div>

    <div class="sidebar-menu">
      <div class="sidebar-section-title">Main Menu</div>
      <a class="active" href="#"><i class="bi bi-grid-1x2-fill me-2"></i>Dashboard</a>
      <a href="#members-section"><i class="bi bi-people-fill me-2"></i>Members</a>
      <a href="#batches-section"><i class="bi bi-collection-fill me-2"></i>Batches</a>
      <a href="#leaders-section"><i class="bi bi-person-badge-fill me-2"></i>Leaders</a>
      
      <div class="sidebar-section-title mt-3">Events & Content</div>
      <a href="#events-section"><i class="bi bi-calendar2-event-fill me-2"></i>Events</a>
      <a href="#announcements-section"><i class="bi bi-megaphone-fill me-2"></i>Announcements</a>
      <a href="#gallery-section"><i class="bi bi-images me-2"></i>Gallery</a>

      <div class="sidebar-section-title mt-3">Administration</div>
      <a href="#reports-section"><i class="bi bi-bar-chart-line-fill me-2"></i>Reports</a>
      <a href="#settings-section"><i class="bi bi-gear-fill me-2"></i>Settings</a>
    </div>

    <div class="sidebar-user-card">
      <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&auto=format&fit=crop&q=80" class="rounded-circle" width="38" height="38" alt="Admin">
      <div class="overflow-hidden">
        <div style="font-size: 13px; font-weight: 700; color: #fff;" class="text-truncate">{{adminName}}</div>
        <div style="font-size: 11px; color: #64748b;" class="text-truncate">admin@alumni.org</div>
      </div>
    </div>
  </aside>

  <!-- MAIN WRAPPER -->
  <div class="main">
    
    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg">
      <div class="container-fluid boxed px-0">
        
        <div class="d-flex align-items-center gap-3 w-100">
          <!-- Mobile Sidebar Toggle -->
          <button class="btn btn-light d-lg-none" id="sidebarToggleBtn">
            <i class="bi bi-list fs-4"></i>
          </button>

          <!-- Search Box -->
          <div class="search-box me-auto">
            <i class="bi bi-search"></i>
            <input type="text" id="memberSearchInput" class="form-control" placeholder="Search members by name, batch or email...">
          </div>

          <!-- Right Action Items -->
          <div class="d-flex align-items-center gap-3">
            
            <!-- Quick Alert Notification -->
            <div class="dropdown">
              <div class="nav-icon-btn" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-bell fs-5"></i>
                <span class="badge-dot"></span>
              </div>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="width: 320px;">
                <li class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                  <span class="fw-bold fs-6">Notifications</span>
                  <span class="badge bg-primary-subtle text-primary rounded-pill">3 New</span>
                </li>
                <li><a class="dropdown-item py-2 rounded-3 text-wrap" href="#"><strong>Zaid Ibn Shafi</strong> registered as new alumni. <span class="text-muted d-block small">10m ago</span></a></li>
                <li><a class="dropdown-item py-2 rounded-3 text-wrap" href="#"><strong>Batch 2022</strong> leader updated. <span class="text-muted d-block small">2h ago</span></a></li>
                <li><a class="dropdown-item py-2 rounded-3 text-wrap" href="#">New event request pending approval. <span class="text-muted d-block small">1d ago</span></a></li>
              </ul>
            </div>

            <!-- User Profile Dropdown -->
            <div class="dropdown">
              <div class="user-profile-btn" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&auto=format&fit=crop&q=80" class="user-avatar" alt="User">
                <div class="d-none d-sm-block text-start me-1">
                  <div style="font-size: 13px; font-weight: 700; color: #0f172a;">{{adminName}}</div>
                  <div style="font-size: 10px; font-weight: 600; color: #6366f1;">SUPERADMIN</div>
                </div>
                <i class="bi bi-chevron-down small text-muted"></i>
              </div>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="width: 200px;">
                <li><a class="dropdown-item rounded-3" href="#"><i class="bi bi-person me-2"></i>My Profile</a></li>
                <li><a class="dropdown-item rounded-3" href="#"><i class="bi bi-shield-lock me-2"></i>Change Password</a></li>
                <li><a class="dropdown-item rounded-3" href="#"><i class="bi bi-sliders me-2"></i>Account Settings</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item rounded-3 text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
              </ul>
            </div>

          </div>
        </div>

      </div>
    </nav>

    <!-- CONTENT BODY -->
    <div class="container-fluid boxed px-4 py-4">

      <!-- WELCOME BANNER -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
          <h3 class="fw-800 text-slate-900 m-0" style="font-weight: 800; letter-spacing: -0.5px;">Dashboard Overview</h3>
          <p class="text-muted m-0 small">Welcome back, Super Admin! Here is what's happening with your alumni network today.</p>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-secondary btn-sm rounded-3 fw-semibold bg-white shadow-sm" onclick="window.location.reload();">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
          </button>
          <button class="btn btn-primary btn-sm rounded-3 fw-semibold shadow-sm" style="background: var(--primary-gradient); border: none;" data-bs-toggle="modal" data-bs-target="#addAlumniModal">
            <i class="bi bi-plus-lg me-1"></i> Add Alumni
          </button>
        </div>
      </div>

      <!-- 7 STAT CARDS GRID -->
      <div class="row g-3 mb-4">
        
        <!-- Stat 1: Total Alumni -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-indigo h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Total Alumni</div>
                <h3 class="stat-value">{{stats.totalAlumni}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-graph-up-arrow"></i> {{stats.alumniGrowth}}</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-people-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 2: Total Batches -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-emerald h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Total Batches</div>
                <h3 class="stat-value">{{stats.totalBatches}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-check-circle-fill"></i> Active</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-collection-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 3: Batch Leaders -->
        <div class="col-xl-3 col-md-6">
          <div class="card stat-card stat-purple h-100">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="stat-title">Batch Leaders</div>
                <h3 class="stat-value">{{stats.batchLeaders}}</h3>
                <span class="stat-trend trend-up"><i class="bi bi-shield-check"></i> Assigned</span>
              </div>
              <div class="stat-icon-wrapper">
                <i class="bi bi-person-badge-fill"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Stat 4: Upcoming Events -->
        <div class="col-xl-3 col-md-6">
