      <!-- ARTICLES -->
      <div class="card mb-4" id="articles-section">
        <div class="card-header">
          <span><i class="bi bi-journal-text text-primary me-2"></i>Articles
            <span id="articleCountBadge" class="badge bg-primary-subtle text-primary rounded-pill ms-2" style="font-size:11px;">{{articles.length}}</span>
          </span>
          <button class="btn btn-sm btn-primary rounded-3" data-bs-toggle="modal" data-bs-target="#addArticleModal">
            <i class="bi bi-upload me-1"></i>Upload Article
          </button>
        </div>
        <div class="card-body">
          <div id="articlesGrid" class="row g-3">
            {{#each articles}}
            <div class="col-12 col-md-6 col-xl-4" data-article-id="{{this._id}}">
              <div class="article-tile">
                <div class="article-tile-img">
                  {{#if this.hasImage}}
                  <img src="/admin/articles/{{this._id}}/image" alt="{{this.heading}}" loading="lazy">
                  {{else}}
                  <i class="bi bi-journal-richtext"></i>
                  {{/if}}
                </div>
                <div class="article-tile-body">
                  <div class="article-tile-heading">{{this.heading}}</div>
                  <div class="article-tile-meta">
                    <span><i class="bi bi-person me-1"></i>{{#if this.author}}{{this.author}}{{else}}Unknown{{/if}}</span>
                    <span><i class="bi bi-calendar3 me-1"></i>{{this.dateFormatted}}</span>
                  </div>
                  <div class="article-tile-excerpt">{{this.excerpt}}</div>
                </div>
                <button type="button" class="article-tile-delete" data-delete-article="{{this._id}}" title="Delete article" aria-label="Delete article">
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </div>
            {{/each}}
          </div>
          <div id="articlesEmpty" class="gallery-empty {{#if articles.length}}d-none{{/if}}">
            <i class="bi bi-journal-text d-block mb-2" style="font-size:1.6rem;"></i>
            No articles uploaded yet. Use "Upload Article" to publish the first one.
