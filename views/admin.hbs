                    <td data-col="hasDependents" class="d-none small text-capitalize">{{this.hasDependents}}</td>
                    <td data-col="dependentsWho" class="d-none small text-truncate" style="max-width:120px;" title="{{this.dependentsWho}}">{{this.dependentsWho}}</td>
