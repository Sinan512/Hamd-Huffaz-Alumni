  <script>
    // 1. Navbar Scroll Effect
    const nav = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 30) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    }, { passive: true });

    // 2. Profile Dropdown Toggle
    const profileBtn = document.getElementById('profile-btn');
    const profileDropdown = document.getElementById('profile-dropdown');

    function closeProfileDropdown() {
      if (!profileDropdown || !profileBtn) return;
      profileDropdown.classList.remove('show');
      profileBtn.setAttribute('aria-expanded', 'false');
    }

    if (profileBtn && profileDropdown) {
      profileBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = profileDropdown.classList.toggle('show');
        profileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (isOpen && typeof closeMobileNav === 'function') closeMobileNav();
      });

      profileDropdown.addEventListener('click', (e) => e.stopPropagation());
      document.addEventListener('click', closeProfileDropdown);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeProfileDropdown();
      });
    }

    // 3. Mobile Navigation Toggle
    const hamburger = document.getElementById('hamburger');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const mobileNav = document.getElementById('mobile-nav');
    const mobileOverlay = document.getElementById('mobile-overlay');

    function toggleMobileNav() {
      const isOpen = mobileNav.classList.toggle('open');
      if (isOpen) closeProfileDropdown();
      mobileOverlay.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', isOpen);
      hamburgerIcon.className = isOpen ? 'bi bi-x-lg' : 'bi bi-list';
    }

    function closeMobileNav() {
      mobileNav.classList.remove('open');
      mobileOverlay.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburgerIcon.className = 'bi bi-list';
    }

    if (hamburger) {
      hamburger.addEventListener('click', toggleMobileNav);
    }

    // 4. Interactive Particle Canvas (Themed from home.hbs)
    (function initParticles() {
      const canvas = document.getElementById('particles-canvas');
      const errorSection = document.getElementById('error-section');
      if (!canvas || !errorSection) return;

      const ctx = canvas.getContext('2d');
      let particles = [];
      let mouse = { x: null, y: null, radius: 130 };
      let lastW = 0, lastH = 0;

      function initCanvas() {
        const dpr = window.devicePixelRatio || 1;
        const w = errorSection.offsetWidth || window.innerWidth;
        const h = errorSection.offsetHeight || window.innerHeight;
        lastW = w; lastH = h;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function createParticle(w, h) {
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          r: Math.random() * 2.2 + 0.8,
          dx: (Math.random() - 0.5) * 0.45,
          dy: (Math.random() - 0.5) * 0.45,
          alpha: Math.random() * 0.55 + 0.2
        };
      }

      function init() {
        initCanvas();
        const count = Math.min(Math.floor(lastW / 14), 70);
        particles = Array.from({ length: count }, () => createParticle(lastW, lastH));
      }

      window.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      }, { passive: true });

      window.addEventListener('mouseleave', () => { mouse.x = null; mouse.y = null; });

      function draw() {
        requestAnimationFrame(draw);
        const w = lastW; const h = lastH;
        if (!w || !h) return;

        ctx.clearRect(0, 0, w, h);

        particles.forEach(p => {
          if (mouse.x !== null && mouse.y !== null) {
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < mouse.radius) {
              const force = (mouse.radius - dist) / mouse.radius;
              const angle = Math.atan2(dy, dx);
              p.x -= Math.cos(angle) * force * 2.5;
              p.y -= Math.sin(angle) * force * 2.5;
            }
          }

          p.x += p.dx;
          p.y += p.dy;

          if (p.x < 0) p.x = w;
          if (p.x > w) p.x = 0;
          if (p.y < 0) p.y = h;
          if (p.y > h) p.y = 0;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(147, 197, 253, ${p.alpha})`;
          ctx.fill();
        });
      }

      window.addEventListener('resize', () => { init(); }, { passive: true });
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      init();
      draw();
    })();

    // 5. Stack Trace Copy Utility
    function copyStackTrace() {
      const traceEl = document.getElementById('stack-trace-text');
      if (!traceEl) return;
      const text = traceEl.innerText || traceEl.textContent;
      navigator.clipboard.writeText(text).then(() => {
        const toast = document.getElementById('copy-toast');
        if (toast) {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2400);
        }
      }).catch(() => {
        alert('Could not copy trace directly.');
      });
    }
  </script>
