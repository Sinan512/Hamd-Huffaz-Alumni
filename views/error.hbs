<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if status}}{{status}} - {{/if}}{{message}} | HAMD Alumni Portal</title>
  <meta name="description" content="HAMD Alumni Portal - Huffaz Alumni Malik Deenar Parappalli Markaz." />
  <link rel="icon" href="/logo/hamd-icon-white.png" />
  <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />

  <!-- Google Fonts: Outfit & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <style>
    /* ============================================================
       CSS CUSTOM PROPERTIES & DESIGN SYSTEM (THEMED FROM HOME.HBS)
    ============================================================ */
    :root {
      --blue-50:   #eff6ff;
      --blue-100:  #dbeafe;
      --blue-200:  #bfdbfe;
      --blue-300:  #93c5fd;
      --blue-400:  #60a5fa;
      --blue-500:  #3b82f6;
      --blue-600:  #2563eb;
      --blue-700:  #1d4ed8;
      --blue-800:  #1e40af;
      --blue-900:  #1e3a8a;

      --navy:      #0b1120;
      --navy-card: #131c31;
      --navy-mid:  #1e293b;
      --slate:     #334155;
      --muted:     #64748b;
      --light:     #f8fafc;
      --white:     #ffffff;

      --emerald-500: #10b981;
      --rose-500:    #f43f5e;
      --amber-500:   #f59e0b;

      --grad-primary:  linear-gradient(135deg, #edeef1 0%, #d1dffc 50%, #c0d2f5 100%);
      --grad-hero:     linear-gradient(160deg, #0b1120 0%, #1e3a8a 50%, #1d4ed8 100%);
      --grad-aurora:   linear-gradient(120deg, #0b1120, #1e3a8a, #2563eb, #1e40af, #0b1120);
      --grad-glow:     linear-gradient(135deg, rgba(59, 130, 246, 0.4), rgba(37, 99, 235, 0.1));
      --grad-text:     linear-gradient(135deg, #93c5fd 0%, #60a5fa 50%, #bfdbfe 100%);

      --glass-bg:           rgba(255, 255, 255, 0.05);
      --glass-border:       rgba(255, 255, 255, 0.12);
      --glass-shadow:       0 20px 40px rgba(0, 0, 0, 0.35);

      --glass-light-bg:     rgba(255, 255, 255, 0.75);
      --glass-light-border: rgba(255, 255, 255, 0.9);
      --glass-light-shadow: 0 8px 30px rgba(37, 99, 235, 0.08);

      --radius-sm: 14px;
      --radius:    22px;
      --radius-lg: 32px;
      --radius-xl: 48px;

      --cubic-spring: cubic-bezier(0.16, 1, 0.3, 1);
      --transition:   all 0.35s var(--cubic-spring);
      --font:         'Outfit', 'Inter', sans-serif;
    }

    /* ============================================================
       RESET & BASE STYLES
    ============================================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
      overflow-x: hidden;
    }

    body {
      font-family: var(--font);
      background: var(--navy);
      color: #fff;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    ::selection { background: var(--blue-200); color: var(--blue-900); }
    a { text-decoration: none; color: inherit; transition: var(--transition); }
    img { max-width: 100%; height: auto; display: block; }

    /* ============================================================
       NAVBAR
    ============================================================ */
    #main-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 700;
      padding: 18px 0;
      transition: var(--transition);
      width: 100%;
      max-width: 100vw;
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
    }
    #main-nav.scrolled {
      background: rgba(11, 17, 32, 0.88);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.35);
      padding: 12px 0;
    }
    .nav-brand-box {
      display: flex; align-items: center; gap: 12px;
      font-weight: 800; font-size: 1.3rem; color: #fff;
    }
    .nav-brand-box .brand-icon {
      width: 38px; height: 38px;
      border-radius: 12px;
      background: var(--grad-primary);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem; color: #fff;
      box-shadow: 0 4px 16px rgba(37,99,235,0.4);
    }
    .nav-brand-box .brand-icon img {
      width: 24px; height: 24px; object-fit: contain;
    }
    .nav-brand-text { font-family: 'Outfit', sans-serif; letter-spacing: -0.02em; }
    .nav-brand-sub { font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--blue-300); display: block; }

    .desktop-nav-wrap {
      position: relative;
      display: flex; align-items: center; gap: 4px;
      background: rgba(255,255,255,0.06);
      padding: 4px; border-radius: 100px;
      border: 1px solid rgba(255,255,255,0.12);
      backdrop-filter: blur(12px);
      transition: var(--transition);
      overflow: hidden;
      flex-shrink: 1;
      min-width: 0;
    }
    .nav-link-item {
      position: relative;
      z-index: 2;
      color: rgba(255,255,255,0.85);
      font-size: 0.86rem;
      font-weight: 500;
      padding: 7px 16px;
      border-radius: 100px;
      transition: all 0.25s ease;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .nav-link-item:hover { color: #fff; background: rgba(255,255,255,0.12); }

    .nav-profile-btn {
      height: 38px;
      padding: 0 18px;
      border-radius: 100px;
      background: rgba(255,255,255,0.12);
      border: 1.5px solid rgba(255,255,255,0.28);
      backdrop-filter: blur(8px);
      color: #fff;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      transition: var(--transition);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      white-space: nowrap;
      font-family: var(--font);
    }
    .nav-profile-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(37,99,235,0.3);
      background: rgba(255,255,255,0.22);
    }

    .profile-dropdown {
      position: absolute;
      right: 0; top: calc(100% + 12px);
      min-width: 200px;
      background: rgba(19, 28, 49, 0.96);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: var(--radius-sm);
      box-shadow: 0 16px 48px rgba(0,0,0,0.45);
      padding: 10px;
      opacity: 0; visibility: hidden;
      transform: translateY(-8px) scale(0.95);
      transition: var(--transition);
      z-index: 900;
    }
    .profile-dropdown.show {
      opacity: 1; visibility: visible;
      transform: translateY(0) scale(1);
    }
    .profile-dropdown a {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px;
      border-radius: 10px;
      color: rgba(255,255,255,0.85);
      font-size: 0.88rem;
      font-weight: 500;
    }
    .profile-dropdown a:hover {
      background: rgba(59, 130, 246, 0.18);
      color: #fff;
      transform: translateX(3px);
    }

    .nav-hamburger {
      width: 40px; height: 40px;
      border-radius: 12px;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.15);
      color: #fff; font-size: 1.3rem; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .nav-hamburger:hover { transform: scale(1.05); }

    .mobile-nav-overlay {
      position: fixed; inset: 0;
      background: rgba(11,17,32,0.8);
      backdrop-filter: blur(12px);
      z-index: 650;
      opacity: 0; visibility: hidden;
      transition: var(--transition);
    }
    .mobile-nav-overlay.open { opacity: 1; visibility: visible; }
    .mobile-nav-card {
      position: fixed;
      top: 76px; left: 12px; right: 12px;
      background: rgba(19, 28, 49, 0.98);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: var(--radius);
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
      padding: 16px;
      display: flex; flex-direction: column; gap: 6px;
      z-index: 660;
      transform: translateY(-20px) scale(0.96);
      opacity: 0; visibility: hidden;
      transition: var(--transition);
      max-width: calc(100vw - 24px);
      box-sizing: border-box;
      overflow-y: auto;
      max-height: calc(100vh - 100px);
    }
    .mobile-nav-card.open {
      transform: translateY(0) scale(1);
      opacity: 1; visibility: visible;
    }
    .mobile-nav-card .nav-link-item {
      color: rgba(255,255,255,0.85);
      font-size: 0.98rem;
      padding: 12px 18px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .mobile-nav-card .nav-link-item:hover {
      background: rgba(59, 130, 246, 0.15);
      color: #fff;
    }

    @media (max-width: 991.98px) {
      .desktop-nav-wrap { display: none !important; }
    }

    /* ============================================================
       ERROR HERO WRAPPER
    ============================================================ */
    .error-wrapper {
      position: relative;
      flex: 1 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 140px 0 80px;
      isolation: isolate;
      min-height: 88vh;
    }

    .hero-aurora {
      position: absolute; inset: 0;
      background: var(--grad-aurora);
      background-size: 400% 400%;
      animation: aurora-shift 20s ease infinite;
      opacity: 0.85;
      z-index: 0;
    }
    @keyframes aurora-shift {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .hero-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(95px);
      opacity: 0.35;
      animation: blob-float 14s ease-in-out infinite;
      pointer-events: none;
      z-index: 0;
    }
    .hero-blob-1 {
      width: clamp(280px, 50vw, 550px); height: clamp(280px, 50vw, 550px);
      background: radial-gradient(circle, #3b82f6, #1d4ed8);
      top: -100px; right: -80px;
      animation-delay: 0s;
    }
    .hero-blob-2 {
      width: clamp(220px, 40vw, 420px); height: clamp(220px, 40vw, 420px);
      background: radial-gradient(circle, #60a5fa, #2563eb);
      bottom: -60px; left: -80px;
      animation-delay: -5s;
    }
    .hero-blob-3 {
      width: clamp(160px, 28vw, 320px); height: clamp(160px, 28vw, 320px);
      background: radial-gradient(circle, #93c5fd, #3b82f6);
      top: 40%; left: 48%;
      animation-delay: -9s;
    }
    @keyframes blob-float {
      0%, 100% { transform: translateY(0) scale(1); }
      50%  { transform: translateY(-35px) scale(1.06); }
    }

    #particles-canvas {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      opacity: 0.55;
      z-index: 1;
    }

    /* Error Main Card */
    .error-card-main {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: clamp(32px, 6vw, 64px) clamp(20px, 5vw, 56px);
      background: rgba(19, 28, 49, 0.65);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: var(--radius-xl);
      box-shadow: 0 32px 80px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.06);
      width: 100%;
      max-width: 820px;
      margin: 0 auto;
      animation: errorFadeIn 0.8s var(--cubic-spring) both;
    }
    @keyframes errorFadeIn {
      from { opacity: 0; transform: translateY(28px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(96, 165, 250, 0.15);
      border: 1px solid rgba(96, 165, 250, 0.35);
      border-radius: 100px;
      padding: 6px 20px;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--blue-200);
      margin-bottom: 20px;
      box-shadow: 0 4px 20px rgba(37,99,235,0.15);
    }

    .error-code-wrap {
      position: relative;
      display: inline-block;
      margin-bottom: 12px;
    }
    .error-code {
      font-size: clamp(5.5rem, 14vw, 9.5rem);
      font-weight: 900;
      line-height: 0.95;
      letter-spacing: -0.04em;
      font-family: 'Outfit', sans-serif;
      background: linear-gradient(135deg, #ffffff 0%, #93c5fd 30%, #60a5fa 70%, #bfdbfe 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: drop-shadow(0 10px 30px rgba(37, 99, 235, 0.45));
    }

    .error-title {
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      font-weight: 800;
      color: #fff;
      line-height: 1.2;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }
    .error-title span {
      background: var(--grad-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .error-subtitle {
      font-size: clamp(0.95rem, 2vw, 1.12rem);
      color: rgba(255, 255, 255, 0.72);
      line-height: 1.75;
      max-width: 580px;
      margin: 0 auto 36px;
      font-weight: 400;
    }

    .hero-actions {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 38px;
    }

    .btn-hero-primary {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 34px;
      background: linear-gradient(135deg, #17478a 0%, #1575eb 50%, #03457a 100%);
      color: #ffffff;
      border: none;
      border-radius: 100px;
      font-family: var(--font);
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 6px 28px rgba(37, 99, 235, 0.5);
      transition: var(--transition);
      position: relative; overflow: hidden;
    }
    .btn-hero-primary:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 12px 36px rgba(1, 40, 124, 0.65);
      color: #fff;
    }
    .btn-hero-primary:active { transform: translateY(-1px) scale(0.99); }

    .btn-hero-outline {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 30px;
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      border: 1.5px solid rgba(255, 255, 255, 0.25);
      border-radius: 100px;
      font-family: var(--font);
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      backdrop-filter: blur(12px);
      transition: var(--transition);
    }
    .btn-hero-outline:hover {
      background: rgba(255, 255, 255, 0.18);
      border-color: rgba(255,255,255,0.4);
      transform: translateY(-3px) scale(1.02);
      color: #fff;
    }

    /* ============================================================
       QUICK PORTAL NAVIGATION LINKS (GLASS CARDS)
    ============================================================ */
    .portal-quick-grid {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 32px;
      margin-top: 10px;
    }
    .portal-quick-label {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 20px;
    }
    .quick-nav-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-sm);
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      text-align: left;
      transition: var(--transition);
      color: #fff;
      height: 100%;
    }
    .quick-nav-card:hover {
      background: rgba(59, 130, 246, 0.15);
      border-color: rgba(96, 165, 250, 0.35);
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
      color: #fff;
    }
    .quick-nav-icon {
      width: 42px; height: 42px;
      border-radius: 12px;
      background: rgba(59, 130, 246, 0.2);
      border: 1px solid rgba(96, 165, 250, 0.25);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.25rem;
      color: var(--blue-300);
      flex-shrink: 0;
      transition: var(--transition);
    }
    .quick-nav-card:hover .quick-nav-icon {
      background: var(--blue-600);
      color: #fff;
      transform: scale(1.08);
    }
    .quick-nav-title {
      font-size: 0.92rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 2px;
    }
    .quick-nav-desc {
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.4;
      margin: 0;
    }

    /* ============================================================
       DEVELOPER STACK TRACE (DEBUG CONTAINER)
    ============================================================ */
    .debug-box {
      margin-top: 32px;
      text-align: left;
      background: #070c18;
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: var(--radius-sm);
      overflow: hidden;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    }
    .debug-header {
      background: rgba(239, 68, 68, 0.12);
      padding: 12px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(239, 68, 68, 0.2);
    }
    .debug-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #fca5a5;
    }
    .btn-copy-stack {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #e2e8f0;
      padding: 4px 12px;
      border-radius: 8px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-copy-stack:hover {
      background: rgba(255, 255, 255, 0.2);
      color: #fff;
    }
    .debug-pre {
      padding: 18px;
      margin: 0;
      max-height: 280px;
      overflow-y: auto;
      font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
      font-size: 0.82rem;
      line-height: 1.6;
      color: #e2e8f0;
      background: transparent;
      white-space: pre-wrap;
      word-break: break-all;
    }
    .debug-pre::-webkit-scrollbar {
      width: 6px;
    }
    .debug-pre::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.2);
      border-radius: 4px;
    }

    /* ============================================================
       FOOTER (THEMED EXACTLY LIKE HOME.HBS)
    ============================================================ */
    #footer {
      background: var(--navy);
      color: rgba(255,255,255,0.65);
      position: relative;
      overflow: hidden;
      isolation: isolate;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      margin-top: auto;
    }
    .footer-top { padding: 60px 0 40px; }
    .footer-brand {
      display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
      font-weight: 800; font-size: 1.35rem; color: #fff;
    }
    .footer-brand .brand-icon {
      width: 40px; height: 40px; border-radius: 12px;
      background: linear-gradient(135deg, #02182e 0%, #012160 50%, #031224 100%);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 16px rgba(37,99,235,0.3);
    }
    .footer-brand .brand-icon img {
      width: 26px; height: 26px; object-fit: contain;
    }
    .footer-tagline {
      font-size: 0.88rem; line-height: 1.7; max-width: 320px;
      margin-bottom: 22px; color: rgba(255,255,255,0.55);
    }
    .footer-social { display: flex; gap: 10px; }
    .footer-social-link {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.14);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.95rem; color: rgba(255,255,255,0.6);
      transition: var(--transition);
    }
    .footer-social-link:hover {
      background: var(--blue-600); color: #fff;
      border-color: var(--blue-600); transform: translateY(-3px);
    }

    .footer-heading {
      font-size: 0.78rem; font-weight: 800;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(255,255,255,0.4); margin-bottom: 18px;
    }
    .footer-links { list-style: none; margin: 0; padding: 0; }
    .footer-links li { margin-bottom: 10px; }
    .footer-links a {
      font-size: 0.88rem; color: rgba(255,255,255,0.6);
      transition: var(--transition);
      display: inline-flex; align-items: center; gap: 8px;
    }
    .footer-links a:hover { color: var(--blue-300); transform: translateX(4px); }

    .footer-divider { border-color: rgba(255,255,255,0.1); margin: 0; }
    .footer-bottom {
      padding: 20px 0;
