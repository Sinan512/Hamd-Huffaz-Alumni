<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Batch Leader</title>
  <link rel="icon" type="image/x-icon" href="/logo/favicon.ico">
  <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root {
      --font-main: 'Plus Jakarta Sans', sans-serif;
      --bg-body: #f8fafc;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --card-border: rgba(226, 232, 240, 0.9);
      --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
      --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    }

    * { box-sizing: border-box; }

    body {
      font-family: var(--font-main);
      background-color: var(--bg-body);
      color: var(--text-main);
      margin: 0;
    }

    .login-wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: linear-gradient(180deg, #0b0f19 0%, #111827 100%);
    }

    .login-card {
      width: 100%;
      max-width: 430px;
      background: #fff;
      border-radius: 20px;
      padding: 36px 32px;
      box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.45);
    }

    .login-badge {
      margin-bottom: 18px;
      text-align: center;
    }
    .login-badge img {
      height: 58px;
      max-width: 210px;
      object-fit: contain;
    }

    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .form-control {
      border-radius: 12px;
      padding: 11px 14px;
      border: 1px solid #e2e8f0;
      font-size: 14px;
    }

    .form-control:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
    }

    .btn-primary-grad {
      background: var(--primary-gradient);
      border: none;
      color: #fff;
      border-radius: 12px;
      padding: 12px 16px;
      font-weight: 700;
      font-size: 14px;
      width: 100%;
    }

    .btn-primary-grad:disabled { opacity: 0.7; }

    /* Dashboard */
    .topbar {
      background: linear-gradient(135deg, #0b0f19 0%, #1e1b4b 100%);
      color: #fff;
      padding: 26px 0 70px;
    }

    .avatar-circle {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 18px;
      border: 1px solid rgba(255, 255, 255, 0.18);
    }

    .stat-card, .table-card {
      background: #fff;
      border: 1px solid var(--card-border);
      border-radius: 16px;
      box-shadow: var(--card-shadow);
    }

    .stat-card { padding: 18px 20px; }
    .stat-label { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: .4px; }
    .stat-value { font-size: 26px; font-weight: 800; margin-top: 4px; }

    .table-card { overflow: hidden; }
    .table thead th {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .4px;
      color: var(--text-muted);
      background: #f8fafc;
      border-bottom: 1px solid var(--card-border);
      white-space: nowrap;
    }
    .table tbody td { font-size: 14px; vertical-align: middle; }
    .badge-soft {
      background: rgba(99, 102, 241, 0.1);
      color: #4f46e5;
      font-weight: 600;
      border-radius: 8px;
      padding: 5px 10px;
      font-size: 12px;
    }
    .pull-up { margin-top: -46px; }
    .hidden { display: none !important; }
  </style>
</head>
<body>

  <!-- ================= LOGIN ================= -->
  <div id="loginView" class="login-wrap">
    <div class="login-card">
      <div class="login-badge"><img src="/logo/hamd-full-light.png" alt="HAMD Logo"></div>
      <h1 class="h4 fw-bold mb-1">Batch Leader Login</h1>
      <p class="text-muted mb-4" style="font-size: 14px;">Sign in with your batch year, admission number and password.</p>

      <div id="loginError" class="alert alert-danger py-2 px-3 hidden" style="font-size: 13px; border-radius: 12px;"></div>

      <form id="loginForm" autocomplete="off">
        <div class="mb-3">
          <label class="form-label" for="year">Batch Year</label>
          <input class="form-control" id="year" name="year" type="text" placeholder="e.g. 2021" required>
        </div>
        <div class="mb-3">
          <label class="form-label" for="admissionNumber">Admission Number</label>
          <input class="form-control" id="admissionNumber" name="admissionNumber" type="text" placeholder="e.g. ADM1023" required>
        </div>
        <div class="mb-4">
          <label class="form-label" for="password">Password</label>
          <input class="form-control" id="password" name="password" type="password" placeholder="••••••••" required>
        </div>
        <button class="btn-primary-grad" id="loginBtn" type="submit">Sign in</button>
        <p class="text-muted text-center mb-0 mt-3" style="font-size: 12px;">
          <i class="bi bi-shield-lock me-1"></i>You will stay signed in on this device for 7 days.
        </p>
      </form>
    </div>
  </div>

  <!-- ================= DASHBOARD ================= -->
  <div id="dashboardView" class="hidden">
    <div class="topbar">
      <div class="container">
        <div class="d-flex flex-wrap align-items-center gap-3">
          <img src="/logo/hamd-full-dark.png" alt="HAMD Logo" style="height: 36px; max-width: 140px; object-fit: contain; margin-right: 4px;">
          <div class="avatar-circle" id="leaderInitials">BL</div>
          <div class="me-auto">
            <div class="fw-bold" style="font-size: 18px;" id="leaderName">Batch Leader</div>
            <div class="small opacity-75">
              Batch <span id="leaderYear">-</span> &middot; Admission No. <span id="leaderAdm">-</span>
            </div>
          </div>
          <button class="btn btn-sm btn-light rounded-pill px-3 fw-semibold" id="logoutBtn">
            <i class="bi bi-box-arrow-right me-1"></i>Logout
          </button>
        </div>
      </div>
    </div>

    <div class="container pull-up pb-5">
      <div class="row g-3 mb-3">
        <div class="col-6 col-md-4">
          <div class="stat-card">
            <div class="stat-label">Batch Year</div>
            <div class="stat-value" id="statYear">-</div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="stat-card">
            <div class="stat-label">Total Members</div>
            <div class="stat-value" id="statCount">0</div>
          </div>
        </div>
      </div>

      <div class="table-card">
        <div class="d-flex flex-wrap align-items-center gap-2 p-3 border-bottom">
          <h2 class="h6 fw-bold mb-0 me-auto">Batch Members</h2>
          <input class="form-control form-control-sm" id="searchInput" type="search"
                 placeholder="Search name, admission no, place…" style="max-width: 260px;">
        </div>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th style="width: 56px;">#</th>
                <th>Admission No.</th>
                <th>Name</th>
                <th>Place</th>
                <th>Batch</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody id="membersBody"></tbody>
          </table>
        </div>
        <div class="p-4 text-center text-muted hidden" id="emptyState" style="font-size: 14px;">
          <i class="bi bi-people d-block mb-2" style="font-size: 26px;"></i>
          No members found for this batch.
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var loginView = document.getElementById('loginView');
      var bootView = document.getElementById('bootView');
      var dashboardView = document.getElementById('dashboardView');
      var loginForm = document.getElementById('loginForm');
      var loginBtn = document.getElementById('loginBtn');
      var loginError = document.getElementById('loginError');
      var membersBody = document.getElementById('membersBody');
      var emptyState = document.getElementById('emptyState');
      var searchInput = document.getElementById('searchInput');
      var allMembers = [];

      function showError(msg) {
        loginError.textContent = msg;
        loginError.classList.remove('hidden');
      }

      function esc(value) {
        return String(value == null ? '' : value)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function renderMembers(list) {
        membersBody.innerHTML = list.map(function (m, i) {
          return '<tr>' +
            '<td class="text-muted">' + (i + 1) + '</td>' +
            '<td><span class="badge-soft">' + esc(m.admissionNumber || '—') + '</span></td>' +
            '<td class="fw-semibold">' + esc(m.name) + '</td>' +
            '<td>' + esc(m.place) + '</td>' +
            '<td>' + esc(m.batch) + '</td>' +
            '<td class="text-muted">' + esc(m.email) + '</td>' +
            '</tr>';
        }).join('');
        emptyState.classList.toggle('hidden', list.length > 0);
      }

      searchInput.addEventListener('input', function () {
        var q = this.value.trim().toLowerCase();
        if (!q) { renderMembers(allMembers); return; }
        renderMembers(allMembers.filter(function (m) {
          return [m.name, m.admissionNumber, m.place, m.email, m.batch]
            .join(' ').toLowerCase().indexOf(q) !== -1;
        }));
      });

      function showDashboard(data) {
        var name = (data.leader && data.leader.name) || 'Batch Leader';
        document.getElementById('leaderName').textContent = name;
        document.getElementById('leaderInitials').textContent =
          name.trim().split(/\s+/).slice(0, 2).map(function (p) { return p.charAt(0).toUpperCase(); }).join('') || 'BL';
        document.getElementById('leaderYear').textContent = data.leader.year;
        document.getElementById('leaderAdm').textContent = data.leader.admissionNumber;
        document.getElementById('statYear').textContent = data.leader.year;
        document.getElementById('statCount').textContent = (data.members || []).length;

        allMembers = data.members || [];
        renderMembers(allMembers);

        loginView.classList.add('hidden');
        dashboardView.classList.remove('hidden');
      }

      function showLogin() {
        allMembers = [];
        loginForm.reset();
        searchInput.value = '';
        dashboardView.classList.add('hidden');
        loginView.classList.remove('hidden');
      }

      var logoutBtn = document.getElementById('logoutBtn');
      logoutBtn.addEventListener('click', async function () {
        logoutBtn.disabled = true;
        try {
          await fetch('/leaders/logout', { method: 'POST', credentials: 'same-origin' });
        } catch (err) {
          /* ignore – the session is dropped locally either way */
        } finally {
          logoutBtn.disabled = false;
          showLogin();
        }
      });

      /* Restore an existing 7 day session on page load. */
      (async function restoreSession() {
        try {
          var res = await fetch('/leaders/session', { credentials: 'same-origin' });
          var data = await res.json();
          if (res.ok && data && data.authenticated) {
            showDashboard(data);
          }
        } catch (err) {
          /* not signed in – the login card stays visible */
        } finally {
          if (bootView) bootView.classList.add('hidden');
        }
      })();

      loginForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        loginError.classList.add('hidden');
        loginBtn.disabled = true;
        loginBtn.textContent = 'Signing in…';

        try {
          var response = await fetch('/leaders/login', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              year: document.getElementById('year').value,
              admissionNumber: document.getElementById('admissionNumber').value,
              password: document.getElementById('password').value
            })
          });
          var data = await response.json();

          if (!response.ok || !data.success) {
            showError(data.message || 'Unable to sign in.');
            return;
          }

          showDashboard(data);
        } catch (err) {
          showError('Network error. Please try again.');
        } finally {
          loginBtn.disabled = false;
          loginBtn.textContent = 'Sign in';
        }
      });
    })();
  </script>
</body>
</html>
