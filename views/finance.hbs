  <!-- Toast Container -->
  <div class="toast-container toast-container-custom">
    <div id="liveToast" class="toast align-items-center text-bg-primary border-0 rounded-3 shadow" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body" id="toastMessage">Action completed.</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- ============================================================
       THEME CONTROLLER SCRIPT (Zero-flash, auto-sync)
  ============================================================ -->
  <script>
    (function () {
      var themeToggleBtn = document.getElementById('themeToggleBtn');
      var themeIcon      = document.getElementById('themeIcon');

      function updateThemeIcons(theme) {
        if (!themeIcon) return;
        if (theme === 'dark') {
          themeIcon.className = 'bi bi-sun';
          document.querySelectorAll('.d-dark-inline').forEach(function (el) { el.classList.remove('d-none'); });
          document.querySelectorAll('.d-light-inline').forEach(function (el) { el.classList.add('d-none'); });
        } else {
          themeIcon.className = 'bi bi-moon-stars';
          document.querySelectorAll('.d-dark-inline').forEach(function (el) { el.classList.add('d-none'); });
          document.querySelectorAll('.d-light-inline').forEach(function (el) { el.classList.remove('d-none'); });
        }
      }

      var currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
      updateThemeIcons(currentTheme);

      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', function () {
          var active = document.documentElement.getAttribute('data-bs-theme');
          var next = active === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-bs-theme', next);
          try { localStorage.setItem('financeTheme', next); } catch (e) {}
          updateThemeIcons(next);
        });
      }
    })();
  </script>

  <!-- ============================================================
       TOAST NOTIFIER UTILITY
  ============================================================ -->
  <script>
    function showFinanceToast(message, type) {
      var toastEl = document.getElementById('liveToast');
      var toastMsg = document.getElementById('toastMessage');
      if (!toastEl || !toastMsg) return;

      toastMsg.textContent = message;
      toastEl.className = 'toast align-items-center border-0 rounded-3 shadow text-bg-' + (type || 'primary');
      var toast = new bootstrap.Toast(toastEl, { delay: 3500 });
      toast.show();
    }
  </script>

  {{#unless authenticated}}
  <!-- ============================================================
       LOGIN JAVASCRIPT
  ============================================================ -->
  <script>
    (function () {
      var loginForm = document.getElementById('financeLoginForm');
      var keyInput = document.getElementById('financeIdInput');
      var alertBox = document.getElementById('loginAlert');
      var submitBtn = document.getElementById('financeLoginSubmit');
      var toggleShowKey = document.getElementById('toggleShowKey');
      var toggleEyeIcon = document.getElementById('toggleEyeIcon');

      if (toggleShowKey && keyInput) {
        toggleShowKey.addEventListener('click', function () {
          if (keyInput.type === 'password') {
            keyInput.type = 'text';
            toggleEyeIcon.className = 'bi bi-eye-slash';
          } else {
            keyInput.type = 'password';
            toggleEyeIcon.className = 'bi bi-eye';
          }
        });
      }

      if (loginForm) {
        loginForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var idVal = (keyInput.value || '').trim();
          if (!idVal) {
            alertBox.textContent = 'Please enter your Finance Access Key / ID.';
            alertBox.classList.remove('d-none');
            return;
          }

          alertBox.classList.add('d-none');
          submitBtn.disabled = true;
          var originalText = submitBtn.innerHTML;
          submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Authenticating...';

          fetch('/finance/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ financeId: idVal })
          })
            .then(function (res) { return res.json(); })
            .then(function (data) {
              if (data && data.success) {
                window.location.href = data.redirect || '/finance';
              } else {
                alertBox.textContent = (data && data.message) || 'Invalid Finance Key. Please check and try again.';
                alertBox.classList.remove('d-none');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
              }
            })
            .catch(function () {
              alertBox.textContent = 'Network error while contacting server.';
              alertBox.classList.remove('d-none');
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalText;
            });
        });
      }
    })();
  </script>

  {{else}}
  <!-- ============================================================
       DASHBOARD JAVASCRIPT (Payment Setup & Contributions)
  ============================================================ -->
  <script>
    (function () {
      /* -------------------------------------------------------------
         1. PAYMENT SETUP CONTROLLER
      ------------------------------------------------------------- */
      var pForm       = document.getElementById('financePaymentSetupForm');
      var qrInput     = document.getElementById('qrCodeInput');
      var previewBox  = document.getElementById('qrCodePreviewContainer');
      var previewImg  = document.getElementById('qrCodePreviewImage');
      var placeholder = document.getElementById('qrCodePlaceholder');
      var pAlert      = document.getElementById('paymentSetupAlert');
      var pSaveBtn    = document.getElementById('savePaymentBtn');

      function showPaymentAlert(type, msg) {
        if (!pAlert) return;
        pAlert.className = 'alert alert-' + type + ' rounded-3 py-2 px-3 small mb-3';
        pAlert.textContent = msg;
        pAlert.classList.remove('d-none');
      }

      if (qrInput) {
        qrInput.addEventListener('change', function () {
          var file = qrInput.files && qrInput.files[0];
          if (!file) return;
          if (file.size > 2 * 1024 * 1024) {
            showPaymentAlert('danger', 'QR Code image must be less than 2MB.');
            qrInput.value = '';
            return;
          }
          if (pAlert) pAlert.classList.add('d-none');
          previewImg.src = URL.createObjectURL(file);
          previewBox.classList.remove('d-none');
          placeholder.classList.add('d-none');
        });
      }

      if (pForm) {
        pForm.addEventListener('submit', function (e) {
          e.preventDefault();
          if (pAlert) pAlert.classList.add('d-none');

          var file = qrInput.files && qrInput.files[0];
          if (file && file.size > 2 * 1024 * 1024) {
            showPaymentAlert('danger', 'QR Code image must be less than 2MB.');
            return;
          }

          pSaveBtn.disabled = true;
          var originalBtnHtml = pSaveBtn.innerHTML;
          pSaveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';

          var formData = new FormData(pForm);

          fetch('/finance/payment-setup', {
            method: 'POST',
            body: formData
          })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }); })
            .then(function (result) {
              if (!result.ok || !result.data.success) {
                showPaymentAlert('danger', (result.data && result.data.message) || 'Could not save payment setup.');
                return;
              }
              showPaymentAlert('success', result.data.message || 'Payment details saved successfully.');
              showFinanceToast('Payment details saved successfully!', 'success');

              if (result.data.paymentSetup && result.data.paymentSetup.hasQrCode) {
                previewImg.src = '/finance/payment-setup/qr-code?t=' + Date.now();
                previewBox.classList.remove('d-none');
                placeholder.classList.add('d-none');
              }
              qrInput.value = '';
            })
            .catch(function () {
              showPaymentAlert('danger', 'Network error while saving payment setup.');
            })
            .finally(function () {
              pSaveBtn.disabled = false;
              pSaveBtn.innerHTML = originalBtnHtml;
            });
        });
      }

      /* -------------------------------------------------------------
         2. ALUMNI CONTRIBUTIONS CONTROLLER
      ------------------------------------------------------------- */
      var initialData = {{{contributionsJson}}} || {};
      var submittedData = initialData.submitted || [];
      var unpaidData    = initialData.unpaid || [];

      var searchInput   = document.getElementById('contribSearchInput');
      var statusFilter  = document.getElementById('contribStatusFilter');
      var tbody         = document.getElementById('contribTableBody');
      var exportExcelBtn= document.getElementById('contribExportExcelBtn');
      var exportPdfBtn  = document.getElementById('contribExportPdfBtn');

      var currentFiltered = [];

      function escapeHtml(str) {
        return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function renderTable() {
        if (!tbody) return;
        var q = (searchInput ? searchInput.value : '').trim().toLowerCase();
        var st = statusFilter ? statusFilter.value : 'ALL';

        var list = [];
        if (st === 'UN PAID') {
          list = unpaidData;
        } else {
          list = submittedData.filter(function (item) {
            if (st !== 'ALL' && item.status !== st) return false;
            return true;
          });
        }

        if (q) {
          list = list.filter(function (item) {
            var name = (item.memberName || '').toLowerCase();
            var batch = (item.batch || '').toLowerCase();
            var adm = (item.admissionNumber || '').toLowerCase();
            var month = (item.monthLabel || '').toLowerCase();
            return name.includes(q) || batch.includes(q) || adm.includes(q) || month.includes(q);
          });
        }

        currentFiltered = list;

        if (list.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>No contribution records found matching criteria.</td></tr>';
          return;
        }

        if (st === 'UN PAID') {
          tbody.innerHTML = list.map(function (item) {
            return '<tr>' +
              '<td><div class="fw-bold">' + escapeHtml(item.memberName) + '</div></td>' +
              '<td><span class="badge bg-secondary-subtle text-secondary">Batch ' + escapeHtml(item.batch) + '</span> <small class="text-muted ms-1">' + escapeHtml(item.admissionNumber) + '</small></td>' +
              '<td><span class="fw-bold text-primary">' + escapeHtml(item.monthLabel) + '</span></td>' +
              '<td><span class="fw-bold">₹' + item.amount + '</span></td>' +
              '<td><span class="text-muted small">—</span></td>' +
              '<td><span class="badge-status badge-unpaid"><i class="bi bi-clock"></i>UN PAID</span></td>' +
              '<td><span class="text-muted small">Not Paid Yet</span></td>' +
              '<td class="text-end"><span class="badge bg-light text-secondary border">Unpaid Month</span></td>' +
            '</tr>';
          }).join('');
        } else {
          tbody.innerHTML = list.map(function (item) {
            var statusBadgeClass = item.status === 'Approved' ? 'badge-approved' : (item.status === 'Pending' ? 'badge-pending' : 'badge-rejected');
            var statusIcon = item.status === 'Approved' ? 'bi-check-circle-fill' : (item.status === 'Pending' ? 'bi-hourglass-split' : 'bi-x-circle-fill');
            var statusBadge = '<span class="badge-status ' + statusBadgeClass + '"><i class="bi ' + statusIcon + '"></i>' + escapeHtml(item.status) + '</span>';

            var imgHtml = item.hasScreenshot
              ? '<button type="button" class="btn btn-sm btn-outline-primary rounded-2 view-screenshot-btn" data-img="/finance/contributions/image/' + item.memberId + '/' + item.paymentId + '" data-name="' + escapeHtml(item.memberName) + '"><i class="bi bi-image me-1"></i>View Receipt</button>'
              : '<span class="text-muted small">No receipt</span>';

            var detailsHtml = '<div class="small text-muted">Submitted: ' + escapeHtml(item.submittedAtFormatted || '—') + '</div>';
            if (item.status === 'Approved' && item.approvedBy) {
              detailsHtml += '<div class="small text-success"><i class="bi bi-check me-1"></i>Approved by ' + escapeHtml(item.approvedBy) + ' (' + escapeHtml(item.approvedAtFormatted) + ')</div>';
            } else if (item.status === 'Rejected') {
              detailsHtml += '<div class="small text-danger"><i class="bi bi-info-circle me-1"></i>' + escapeHtml(item.rejectionReason || 'Rejected') + '</div>';
            }

            var actionsHtml = '';
            if (item.status === 'Pending') {
              actionsHtml = '<div class="btn-group btn-group-sm shadow-sm">' +
                '<button type="button" class="btn-action-approve approve-btn" data-member="' + item.memberId + '" data-payment="' + item.paymentId + '"><i class="bi bi-check-lg me-1"></i>Approve</button>' +
                '<button type="button" class="btn-action-reject reject-btn" data-member="' + item.memberId + '" data-payment="' + item.paymentId + '"><i class="bi bi-x-lg me-1"></i>Reject</button>' +
              '</div>';
            } else {
              actionsHtml = '<span class="small text-muted"><i class="bi bi-check2-all me-1"></i>Processed</span>';
            }

            return '<tr>' +
              '<td><div class="fw-bold">' + escapeHtml(item.memberName) + '</div></td>' +
              '<td><span class="badge bg-secondary-subtle text-secondary">Batch ' + escapeHtml(item.batch) + '</span> <small class="text-muted ms-1">' + escapeHtml(item.admissionNumber) + '</small></td>' +
              '<td><span class="fw-bold text-primary">' + escapeHtml(item.monthLabel) + '</span></td>' +
              '<td><span class="fw-bold">₹' + item.amount + '</span></td>' +
              '<td>' + imgHtml + '</td>' +
              '<td>' + statusBadge + '</td>' +
              '<td>' + detailsHtml + '</td>' +
              '<td class="text-end">' + actionsHtml + '</td>' +
            '</tr>';
          }).join('');
        }
      }

      function refreshContributionsData() {
        return fetch('/finance/contributions', { headers: { 'Accept': 'application/json' } })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data && data.success) {
              submittedData = data.submitted || [];
              unpaidData    = data.unpaid || [];

              if (data.counts) {
                var c = data.counts;
                if (document.getElementById('metricTotal')) document.getElementById('metricTotal').textContent = c.total;
                if (document.getElementById('metricPending')) document.getElementById('metricPending').textContent = c.pending;
                if (document.getElementById('metricApproved')) document.getElementById('metricApproved').textContent = c.approved;
                if (document.getElementById('metricRejected')) document.getElementById('metricRejected').textContent = c.rejected;
                if (document.getElementById('metricUnpaid')) document.getElementById('metricUnpaid').textContent = c.unpaid;

                if (document.getElementById('cntAll')) document.getElementById('cntAll').textContent = c.total;
                if (document.getElementById('cntPending')) document.getElementById('cntPending').textContent = c.pending;
                if (document.getElementById('cntApproved')) document.getElementById('cntApproved').textContent = c.approved;
                if (document.getElementById('cntRejected')) document.getElementById('cntRejected').textContent = c.rejected;
                if (document.getElementById('cntUnpaid')) document.getElementById('cntUnpaid').textContent = c.unpaid;
                if (document.getElementById('contribTotalBadge')) document.getElementById('contribTotalBadge').textContent = c.total;
              }
              renderTable();
            }
          })
          .catch(function (err) { console.error('Error refreshing contributions:', err); });
      }

      if (searchInput) searchInput.addEventListener('input', renderTable);
      if (statusFilter) statusFilter.addEventListener('change', renderTable);

      // Table Action Delegations
      if (tbody) {
        tbody.addEventListener('click', function (e) {
          // View screenshot modal
          var viewBtn = e.target.closest('.view-screenshot-btn');
          if (viewBtn) {
            var imgSrc = viewBtn.getAttribute('data-img');
            var memberName = viewBtn.getAttribute('data-name');
            var imgEl = document.getElementById('contribModalImage');
            var titleEl = document.getElementById('viewScreenshotModalTitle');
            if (imgEl) imgEl.src = imgSrc;
            if (titleEl) titleEl.textContent = 'Payment Receipt - ' + memberName;
            var modalEl = document.getElementById('viewScreenshotModal');
            if (modalEl && window.bootstrap) {
              var inst = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
              inst.show();
            }
            return;
          }

          // Approve submission
          var appBtn = e.target.closest('.approve-btn');
          if (appBtn) {
            var memberId = appBtn.getAttribute('data-member');
            var paymentId = appBtn.getAttribute('data-payment');
            if (!confirm('Approve this payment contribution?')) return;
            appBtn.disabled = true;

            fetch('/finance/contributions/' + memberId + '/' + paymentId + '/approve', {
              method: 'POST',
              headers: { 'Accept': 'application/json' }
            })
              .then(function (res) { return res.json(); })
              .then(function (resData) {
                if (resData && resData.success) {
                  showFinanceToast('Payment contribution approved successfully.', 'success');
                  refreshContributionsData();
                } else {
                  alert((resData && resData.message) || 'Approval failed.');
                  appBtn.disabled = false;
                }
              })
              .catch(function () { alert('Network error.'); appBtn.disabled = false; });
            return;
          }

          // Reject submission
          var rejBtn = e.target.closest('.reject-btn');
          if (rejBtn) {
            var memberId = rejBtn.getAttribute('data-member');
            var paymentId = rejBtn.getAttribute('data-payment');

            document.getElementById('rejectMemberId').value = memberId;
            document.getElementById('rejectPaymentId').value = paymentId;

            var rForm = document.getElementById('rejectContributionForm');
            if (rForm) rForm.reset();
            document.getElementById('customReasonWrapper').classList.add('d-none');

            var rejModalEl = document.getElementById('rejectContributionModal');
            if (rejModalEl && window.bootstrap) {
              var inst = bootstrap.Modal.getInstance(rejModalEl) || new bootstrap.Modal(rejModalEl);
              inst.show();
            }
            return;
          }
        });
      }

      // Reject Radio change listener
      var rRadios = document.querySelectorAll('input[name="rejectReasonOption"]');
      rRadios.forEach(function (radio) {
        radio.addEventListener('change', function () {
          var customWrap = document.getElementById('customReasonWrapper');
          if (customWrap) {
            if (this.value === 'other') {
              customWrap.classList.remove('d-none');
            } else {
              customWrap.classList.add('d-none');
            }
          }
        });
      });

      // Reject Form submission
      var rForm = document.getElementById('rejectContributionForm');
      if (rForm) {
        rForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var memberId = document.getElementById('rejectMemberId').value;
          var paymentId = document.getElementById('rejectPaymentId').value;

          var selectedRadio = document.querySelector('input[name="rejectReasonOption"]:checked');
          var reasonOption = selectedRadio ? selectedRadio.value : 'screenshot not visible perfectly';
          var customReason = (document.getElementById('customRejectReason').value || '').trim();

          if (reasonOption === 'other' && !customReason) {
            alert('Please specify the custom rejection reason.');
            return;
          }

          var confirmBtn = document.getElementById('confirmRejectBtn');
          confirmBtn.disabled = true;

          fetch('/finance/contributions/' + memberId + '/' + paymentId + '/reject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reasonOption: reasonOption, customReason: customReason })
          })
            .then(function (res) { return res.json(); })
            .then(function (resData) {
              if (resData && resData.success) {
                var rejModalEl = document.getElementById('rejectContributionModal');
                if (rejModalEl && window.bootstrap) {
                  var inst = bootstrap.Modal.getInstance(rejModalEl);
                  if (inst) inst.hide();
                }
                showFinanceToast('Payment submission rejected.', 'warning');
                refreshContributionsData();
              } else {
                alert((resData && resData.message) || 'Rejection failed.');
              }
            })
            .catch(function () { alert('Network error.'); })
            .finally(function () { confirmBtn.disabled = false; });
        });
      }

      /* -------------------------------------------------------------
         3. EXPORT TO EXCEL
      ------------------------------------------------------------- */
      if (exportExcelBtn) {
        exportExcelBtn.addEventListener('click', function () {
          if (!window.XLSX) {
            alert('Excel export engine is loading... Please try again.');
            return;
          }
          if (currentFiltered.length === 0) {
            alert('No contribution records to export.');
            return;
          }

          var st = statusFilter ? statusFilter.value : 'ALL';
          var excelRows = [];

          if (st === 'UN PAID') {
            excelRows = currentFiltered.map(function (i) {
              return {
                'Member Name': i.memberName,
                'Admission No': i.admissionNumber,
                'Batch': i.batch,
                'Month & Year': i.monthLabel,
                'Amount (INR)': i.amount,
                'Status': i.status
              };
            });
          } else {
            excelRows = currentFiltered.map(function (i) {
              return {
                'Member Name': i.memberName,
                'Admission No': i.admissionNumber,
                'Batch': i.batch,
                'Month & Year': i.monthLabel,
                'Amount (INR)': i.amount,
                'Status': i.status,
                'Submitted At': i.submittedAtFormatted,
                'Approved By': i.approvedBy,
                'Approved At': i.approvedAtFormatted,
                'Rejection Reason': i.rejectionReason
              };
            });
          }

          var worksheet = XLSX.utils.json_to_sheet(excelRows);
          var workbook = XLSX.utils.book_new();
          XLSX.utils.book_append_sheet(workbook, worksheet, 'Contributions');
          XLSX.writeFile(workbook, 'HAMD_Alumni_Contributions_' + st + '_' + Date.now() + '.xlsx');
        });
      }

      /* -------------------------------------------------------------
         4. EXPORT TO PDF (Clean AutoTable layout)
      ------------------------------------------------------------- */
      if (exportPdfBtn) {
        exportPdfBtn.addEventListener('click', function () {
          var jsPDF = (window.jspdf && window.jspdf.jsPDF) || window.jsPDF;
          if (!jsPDF) {
            alert('PDF engine is loading... Please try again.');
            return;
          }

          if (currentFiltered.length === 0) {
            alert('No contribution records to export.');
            return;
          }

          var doc = new jsPDF('landscape');
          var st = statusFilter ? statusFilter.value : 'ALL';

          // Header
          doc.setFontSize(16);
          doc.setTextColor(37, 99, 235);
          doc.text('HAMD Alumni - Financial Contributions Report', 14, 16);

          doc.setFontSize(10);
          doc.setTextColor(100);
          doc.text('Status Filter: ' + st + ' | Generated on: ' + new Date().toLocaleString('en-GB') + ' | Total Records: ' + currentFiltered.length, 14, 23);

          var tableHeaders = [['#', 'Member Name', 'Admission No', 'Batch', 'Month & Year', 'Amount', 'Status', 'Date & Notes']];
          var tableData = currentFiltered.map(function (item, idx) {
            var notes = '';
            if (item.status === 'Approved' && item.approvedBy) {
              notes = 'Approved by ' + item.approvedBy;
            } else if (item.status === 'Rejected') {
              notes = item.rejectionReason || 'Rejected';
            } else if (item.status === 'Pending') {
              notes = 'Submitted: ' + (item.submittedAtFormatted || '—');
            } else {
              notes = 'Unpaid Month';
            }

            return [
              idx + 1,
              item.memberName || '—',
              item.admissionNumber || '—',
              'Batch ' + (item.batch || '—'),
              item.monthLabel || '—',
              'Rs. ' + (item.amount || 30),
              item.status || '—',
              notes
            ];
          });

          if (typeof doc.autoTable === 'function') {
            doc.autoTable({
              startY: 28,
              head: tableHeaders,
              body: tableData,
              theme: 'grid',
              headStyles: { fillColor: [37, 99, 235], textColor: [255, 255, 255], fontStyle: 'bold' },
              alternateRowStyles: { fillColor: [248, 250, 252] },
              styles: { fontSize: 9, cellPadding: 3 }
            });
          }

          doc.save('HAMD_Contributions_' + st + '_' + Date.now() + '.pdf');
        });
      }

      // Initial Render
      renderTable();
    })();
  </script>
  {{/unless}}

</body>
</html>
